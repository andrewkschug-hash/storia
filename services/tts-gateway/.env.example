TTS_PROVIDER=elevenlabs
TTS_GATEWAY_PORT=8787
TTS_GENERATION_VERSION=1

# Paste keys here. Never put them in the Expo app.
# Voice Lab can also save an ElevenLabs key for you.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Google Cloud TTS — prefer Application Default Credentials (no secret in this file):
#   gcloud auth application-default login
#   gcloud config set project YOUR_STORIA_TTS_PROJECT_ID
GOOGLE_CLOUD_PROJECT=
# Optional fallback only (not needed if ADC is logged in):
GOOGLE_TTS_API_KEY=

# Local Google TTS safety budget (characters this calendar month, UTC).
# Required for any Google generation. Do not set this to Google's full free allowance.
# Missing or non-integer → fail closed. 900000 leaves a margin under Chirp 3 HD's 1M free tier.
GOOGLE_TTS_HARD_LIMIT_CHARS=900000

