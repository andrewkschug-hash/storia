TTS_PROVIDER=elevenlabs
TTS_GATEWAY_PORT=8787
TTS_GENERATION_VERSION=1

# Paste keys here. Never put them in the Expo app.
# Voice Lab can also save an ElevenLabs key for you.
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Google Cloud TTS — prefer Application Default Credentials (no secret in this file):
#   gcloud auth application-default login
#   gcloud config set project YOUR_STORIA_TTS_PROJECT_ID
GOOGLE_CLOUD_PROJECT=
# Optional fallback only (not needed if ADC is logged in):
GOOGLE_TTS_API_KEY=
