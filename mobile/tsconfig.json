{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "content/**/*.json"
  ],
  "exclude": [
    "scripts",
    "src/**/__tests__",
    "vitest.config.mts",
    "node_modules"
  ]
}
