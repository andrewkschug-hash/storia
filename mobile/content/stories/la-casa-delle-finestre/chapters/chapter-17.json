{
  "id": "la-casa-delle-finestre-17",
  "storyId": "la-casa-delle-finestre",
  "number": 17,
  "title": "Meeting",
  "titleIt": "Incontro",
  "locationIds": [
    "via-della-scuola",
    "scuola-media"
  ],
  "characterIds": [
