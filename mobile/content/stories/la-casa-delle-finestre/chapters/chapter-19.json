{
  "id": "la-casa-delle-finestre-19",
  "storyId": "la-casa-delle-finestre",
  "number": 19,
  "title": "Quinto changes",
  "titleIt": "Quinto cambia",
  "locationIds": [
    "via-della-scuola",
    "cortile-scuola",
    "scuola-media"
  ],
  "characterIds": [
    "irene-colombo",
