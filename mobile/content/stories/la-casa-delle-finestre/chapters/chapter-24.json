  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Dopo qualche giorno Alme la chiama in ufficio. Non è venerdì. È un giorno normale, di lavoro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dopo",
            "qualche",
            "giorno",
            "alme",
            "la",
            "chiamare",
            "in",
            "ufficio",
            "non",
            "essere",
            "venerdi",
            "essere",
            "un",
            "giorno",
            "normale",
            "di",
            "lavoro"
          ]
        },
        {
          "id": "s02",
          "text": "Il contratto è corto. Non lo rinnoviamo.",
          "speakerId": "alme",
          "kind": "dialogue",
          "lemmas": [
            "il",
            "contratto",
            "essere",
            "corto",
            "non",
            "lo",
            "rinnovare"
          ]
        },
        {
          "id": "s03",
          "text": "Irene lo sapeva, quasi. Non è un premio. Non è un arresto. È un no, amministrativo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "irene",
            "lo",
            "sapere",
            "quasi",
            "non",
            "essere",
            "un",
            "premio",
            "non",
            "essere",
            "un",
            "arresto",
            "essere",
            "un",
            "no",
            "amministrativo"
          ]
        },
        {
          "id": "s04",
          "text": "Alme non sorride come all'inizio. Dice: ha fatto il lavoro. Poi basta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "alme",
            "non",
            "sorridere",
            "come",
            "inizio",
            "dire",
            "avere",
            "fare",
            "il",
            "lavoro",
            "poi",
            "basta"
          ]
        },
        {
          "id": "s05",
          "text": "Grazie, dice Irene. Non è mio, questo paese. Non vendo la storia.",
          "speakerId": "irene-colombo",
          "kind": "dialogue",
          "lemmas": [
            "grazie",
            "dire",
            "irene",
            "non",
            "essere",
            "mio",
            "questo",
            "paese",
            "non",
            "vendere",
            "la",
            "storia"
          ]
        },
        {
          "id": "s06",
          "text": "Alme annuisce. Non aiuta due volte. Non offre un altro posto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "alme",
            "annuire",
            "non",
            "aiutare",
            "due",
            "volta",
            "non",
            "offrire",
            "un",
            "altro",
            "posto"
          ]
        },
        {
          "id": "s07",
          "text": "Irene lascia le chiavi del seminterrato, se c'erano. Lascia lo scanner. Lascia le scatole.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "irene",
            "lasciare",
            "le",
            "chiave",
            "del",
            "seminterrato",
            "se",
            "ce",
            "lasciare",
            "lo",
            "scanner",
            "lasciare",
            "le",
            "scatola"
          ]
        },
        {
          "id": "s08",
          "text": "L'archivio resta al comune. Lei no.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "archivio",
            "restare",
            "al",
            "comune",
            "lei",
            "no"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s09",
          "text": "In mansarda mette i vestiti in una borsa. Il quaderno resta, chiuso, in fondo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "in",
            "mansarda",
            "mettere",
            "i",
            "vestito",
            "in",
            "una",
            "borsa",
            "il",
            "quaderno",
            "restare",
            "chiudere",
            "in",
            "fondo"
          ]
        },
        {
          "id": "s10",
          "text": "Non è un romanzo da vendere. È un quaderno di lavoro. Non è suo da vendere.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "essere",
            "un",
            "romanzo",
            "da",
            "vendere",
            "essere",
            "un",
            "quaderno",
            "di",
            "lavoro",
            "non",
            "essere",
            "suo",
            "da",
            "vendere"
          ]
        },
        {
          "id": "s11",
          "text": "Loredana è in cucina. Offre un caffè. Non parla della figlia. Non parla delle finestre.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "loredana",
            "essere",
            "in",
            "cucina",
            "offrire",
            "un",
            "caffe",
            "non",
            "parlare",
            "della",
            "figlia",
            "non",
            "parlare",
            "delle",
            "finestra"
          ]
        },
        {
          "id": "s12",
          "text": "Buon viaggio, dice. Irene dice: mi dispiace, di nuovo, per i numeri.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "buon",
            "viaggio",
            "dire",
            "irene",
            "dire",
            "mi",
            "dispiacere",
            "di",
            "nuovo",
            "per",
            "i",
            "numero"
          ]
        },
        {
          "id": "s13",
          "text": "Loredana scuote la testa. Va. La scuola è vuota, dice, per abitudine, e Irene non corregge.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "loredana",
            "scuotere",
            "la",
            "testa",
            "andare",
            "la",
            "scuola",
            "essere",
            "vuoto",
            "dire",
            "per",
            "abitudine",
            "e",
            "irene",
            "non",
            "correggere"
          ]
        },
        {
          "id": "s14",
          "text": "Vuota: una parola che ha cambiato senso, e che il paese tiene uguale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "vuoto",
            "una",
            "parola",
            "che",
            "avere",
            "cambiare",
            "senso",
            "e",
            "che",
            "il",
            "paese",
            "tenere",
            "uguale"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s15",
          "text": "Irene scende in strada, di giorno, con la borsa. C'è un autobus, vicino alla piazza.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "irene",
            "scendere",
            "in",
            "strada",
            "di",
            "giorno",
            "con",
            "la",
            "borsa",
            "ce",
            "un",
            "autobus",
            "vicino",
            "alla",
            "piazza"
          ]
        },
        {
          "id": "s16",
          "text": "Prima guarda la scuola, un momento. La griglia è solo un edificio. Finestre, muro, cancello.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "prima",
            "guardare",
            "la",
            "scuola",
            "un",
            "momento",
            "la",
            "griglia",
            "essere",
            "solo",
            "un",
            "edificio",
            "finestra",
            "muro",
            "cancello"
          ]
        },
        {
          "id": "s17",
          "text": "Una finestra è scura, ordinaria. Non una lampada. Non un segnale. Una finestra.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "una",
            "finestra",
            "essere",
            "scuro",
            "ordinario",
            "non",
            "una",
            "lampada",
            "non",
            "un",
            "segnale",
            "una",
            "finestra"
          ]
        },
        {
          "id": "s18",
          "text": "Guarda in alto, come chi ha saputo. Poi guarda via. Parte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "guardare",
            "in",
            "alto",
            "come",
            "chi",
            "avere",
            "sapere",
            "poi",
            "guardare",
            "via",
            "partire"
          ]
        },
        {
          "id": "s19",
          "text": "Non resta. Non è eroina di San Quirico. È un'archivista con un contratto finito.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "restare",
            "non",
            "essere",
            "eroina",
            "di",
            "san",
            "quirico",
            "essere",
            "archivista",
            "con",
            "un",
            "contratto",
            "finire"
          ]
        },
        {
          "id": "s20",
          "text": "L'autobus parte. La scuola resta. Sembra vuota. Qualcuno c'è stato. Lei no, più.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "autobus",
            "partire",
            "la",
            "scuola",
            "restare",
            "sembrare",
            "vuoto",
            "qualcuno",
            "ce",
            "essere",
            "lei",
            "no",
            "piu"
          ]
        },
        {
          "id": "s23",
          "text": "Guarda un attimo il paese, poi la strada. Parte per davvero. L'archivio non è suo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "guardare",
            "un",
            "attimo",
            "il",
            "paese",
            "poi",
            "la",
            "strada",
            "partire",
            "per",
            "davvero",
            "archivio",
            "non",
            "essere",
            "suo"
          ]
        },
        {
          "id": "s41",
          "text": "Non torna. Non accende. Non vende. Guarda una volta, e basta. Poi il motore parte, e lei va via da questo piccolo paese.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
