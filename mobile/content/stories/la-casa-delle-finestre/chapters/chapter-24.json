  "events": [
    {
      "id": "ev-la-casa-delle-finestre-24",
      "summary": "The contract is not renewed. Irene leaves San Quirico. She does not sell the story. In daylight she looks at the grid once more: a building, one ordinary dark window.",
      "characterIds": [
        "irene-colombo",
        "alme"
      ],
      "locationIds": [
        "ufficio-alme",
        "via-della-scuola"
      ],
      "rememberedFacts": [
        "The contract is not renewed",
        "Irene leaves town",
        "She does not sell the story",
        "She still glances at the windows"
      ]
    }
  ],
  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Dopo qualche giorno Alme la chiama in ufficio. Non è venerdì. È un giorno normale, di lavoro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dopo",
            "qualche",
            "giorno",
            "alme",
            "la",
            "chiamare",
            "in",
            "ufficio",
            "non",
            "essere",
            "venerdi",
            "essere",
            "un",
            "giorno",
            "normale",
            "di",
            "lavoro"
          ]
        },
        {
          "id": "s02",
          "text": "Il contratto è corto. Non lo rinnoviamo.",
          "speakerId": "alme",
          "kind": "dialogue",
          "lemmas": [
            "il",
            "contratto",
            "essere",
            "corto",
            "non",
            "lo",
            "rinnovare"
          ]
        },
        {
          "id": "s03",
          "text": "Irene lo sapeva, quasi. Non è un premio. Non è un arresto. È un no, amministrativo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "irene",
            "lo",
            "sapere",
            "quasi",
            "non",
            "essere",
            "un",
            "premio",
            "non",
            "essere",
            "un",
            "arresto",
            "essere",
            "un",
            "no",
            "amministrativo"
          ]
        },
        {
          "id": "s04",
          "text": "Alme non sorride come all'inizio. Dice: ha fatto il lavoro. Poi basta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "alme",
            "non",
            "sorridere",
            "come",
            "inizio",
            "dire",
            "avere",
            "fare",
            "il",
            "lavoro",
            "poi",
            "basta"
          ]
        },
        {
          "id": "s05",
          "text": "Grazie, dice Irene. Non è mio, questo paese. Non vendo la storia.",
          "speakerId": "irene-colombo",
          "kind": "dialogue",
          "lemmas": [
            "grazie",
            "dire",
            "irene",
            "non",
            "essere",
            "mio",
            "questo",
            "paese",
            "non",
            "vendere",
            "la",
            "storia"
          ]
        },
        {
          "id": "s06",
          "text": "Alme annuisce. Non aiuta due volte. Non offre un altro posto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "alme",
            "annuire",
            "non",
            "aiutare",
            "due",
            "volta",
            "non",
            "offrire",
            "un",
            "altro",
            "posto"
          ]
        },
        {
          "id": "s07",
          "text": "Irene lascia le chiavi del seminterrato, se c'erano. Lascia lo scanner. Lascia le scatole.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "irene",
            "lasciare",
            "le",
            "chiave",
            "del",
            "seminterrato",
            "se",
            "ce",
            "lasciare",
            "lo",
            "scanner",
            "lasciare",
            "le",
            "scatola"
          ]
        },
        {
          "id": "s08",
          "text": "L'archivio resta al comune. Lei no.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "archivio",
            "restare",
            "al",
            "comune",
            "lei",
            "no"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s09",
          "text": "In mansarda mette i vestiti in una borsa. Il quaderno resta, chiuso, in fondo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "in",
            "mansarda",
            "mettere",
            "i",
            "vestito",
            "in",
            "una",
            "borsa",
            "il",
            "quaderno",
            "restare",
            "chiudere",
            "in",
            "fondo"
          ]
        },
        {
          "id": "s10",
          "text": "Non è un romanzo da vendere. È un quaderno di lavoro. Non è suo da vendere.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "essere",
            "un",
            "romanzo",
            "da",
            "vendere",
            "essere",
            "un",
            "quaderno",
            "di",
            "lavoro",
            "non",
            "essere",
            "suo",
            "da",
            "vendere"
          ]
        },
        {
          "id": "s11",
          "text": "Loredana è in cucina. Offre un caffè. Non parla della figlia. Non parla delle finestre.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "loredana",
            "essere",
            "in",
            "cucina",
            "offrire",
            "un",
            "caffe",
            "non",
            "parlare",
            "della",
            "figlia",
            "non",
            "parlare",
            "delle",
            "finestra"
          ]
        },
        {
          "id": "s12",
          "text": "Buon viaggio, dice. Irene dice: mi dispiace, di nuovo, per i numeri.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "buon",
            "viaggio",
            "dire",
            "irene",
            "dire",
            "mi",
            "dispiacere",
            "di",
            "nuovo",
            "per",
            "i",
            "numero"
          ]
        },
        {
          "id": "s13",
          "text": "Loredana scuote la testa. Va. La scuola è vuota, dice, per abitudine, e Irene non corregge.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "loredana",
            "scuotere",
            "la",
            "testa",
            "andare",
            "la",
            "scuola",
            "essere",
            "vuoto",
            "dire",
            "per",
            "abitudine",
            "e",
            "irene",
            "non",
            "correggere"
          ]
        },
        {
          "id": "s14",
          "text": "Vuota: una parola che ha cambiato senso, e che il paese tiene uguale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "vuoto",
            "una",
            "parola",
            "che",
            "avere",
            "cambiare",
            "senso",
            "e",
            "che",
            "il",
            "paese",
            "tenere",
            "uguale"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s15",
          "text": "Irene scende in strada, di giorno, con la borsa. C'è un autobus, vicino alla piazza.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "irene",
            "scendere",
            "in",
            "strada",
            "di",
            "giorno",
            "con",
            "la",
            "borsa",
            "ce",
            "un",
            "autobus",
            "vicino",
            "alla",
            "piazza"
          ]
        },
        {
          "id": "s16",
          "text": "Prima guarda la scuola, un momento. La griglia è solo un edificio. Finestre, muro, cancello.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "prima",
            "guardare",
            "la",
            "scuola",
            "un",
            "momento",
            "la",
            "griglia",
            "essere",
            "solo",
            "un",
            "edificio",
            "finestra",
            "muro",
            "cancello"
          ]
        },
        {
          "id": "s17",
          "text": "Una finestra è scura, ordinaria. Non una lampada. Non un segnale. Una finestra.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "una",
            "finestra",
            "essere",
            "scuro",
            "ordinario",
            "non",
            "una",
            "lampada",
            "non",
            "un",
            "segnale",
            "una",
            "finestra"
          ]
        },
        {
          "id": "s18",
          "text": "Guarda in alto, come chi ha saputo. Poi guarda via. Parte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "guardare",
            "in",
            "alto",
            "come",
            "chi",
            "avere",
            "sapere",
            "poi",
            "guardare",
            "via",
            "partire"
          ]
        },
        {
          "id": "s19",
          "text": "Non resta. Non è eroina di San Quirico. È un'archivista con un contratto finito.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "restare",
            "non",
            "essere",
            "eroina",
            "di",
            "san",
            "quirico",
            "essere",
            "archivista",
            "con",
            "un",
            "contratto",
            "finire"
          ]
        },
        {
          "id": "s20",
          "text": "L'autobus parte. La scuola resta. Sembra vuota. Qualcuno c'è stato. Lei no, più.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "autobus",
            "partire",
            "la",
            "scuola",
            "restare",
            "sembrare",
            "vuoto",
            "qualcuno",
            "ce",
            "essere",
            "lei",
            "no",
            "piu"
          ]
        },
        {
          "id": "s21",
          "text": "Non c'è un lavoro nuovo come premio. Non c'è Alme in manette alla fermata.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "ce",
            "un",
            "lavoro",
            "nuovo",
            "come",
            "premio",
            "non",
            "ce",
            "alme",
            "in",
            "manette",
            "alla",
            "fermata"
          ]
        },
        {
          "id": "s22",
          "text": "La luce non torna nella griglia mentre l'autobus gira. Irene non la cerca.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "luce",
            "non",
            "tornare",
            "nella",
            "griglia",
            "mentre",
            "autobus",
            "girare",
            "irene",
            "non",
            "la",
            "cercare"
          ]
        },
        {
          "id": "s23",
          "text": "Guarda un attimo il paese, poi la strada. Parte per davvero. L'archivio non è suo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "guardare",
            "un",
            "attimo",
            "il",
            "paese",
            "poi",
            "la",
            "strada",
            "partire",
            "per",
            "davvero",
            "archivio",
            "non",
            "essere",
            "suo"
          ]
        },
        {
          "id": "s24",
          "text": "San Quirico resta con le sue finestre. Lei resta con un quaderno chiuso, in fondo a una borsa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "san",
            "quirico",
            "restare",
            "con",
            "le",
            "suo",
            "finestra",
            "lei",
            "restare",
            "con",
            "un",
            "quaderno",
            "chiudere",
            "in",
            "fondo",
            "a",
            "una",
            "borsa"
          ]
        },
        {
          "id": "s25",
          "text": "Non è un lieto fine da film. È un contratto finito, e uno sguardo in alto, e poi via.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "essere",
            "un",
            "lieto",
            "fine",
            "da",
            "film",
            "essere",
            "un",
            "contratto",
            "finire",
            "e",
            "uno",
            "sguardo",
            "in",
            "alto",
            "e",
            "poi",
            "via"
          ]
        },
        {
          "id": "s26",
          "text": "Al comune ha lasciato l'archivio. In mansarda ha lasciato la stanza vuota, di lei, non della scuola.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "al",
            "comune",
            "avere",
            "lasciare",
            "archivio",
            "in",
            "mansarda",
            "avere",
            "lasciare",
            "la",
            "stanza",
            "vuoto",
            "di",
            "lei",
            "non",
            "della",
            "scuola"
          ]
        },
        {
          "id": "s27",
          "text": "Loredana ha detto vuota per abitudine. Irene è partita senza correggere la parola. Non era il momento di una lezione.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "loredana",
            "avere",
            "dire",
            "vuoto",
            "per",
            "abitudine",
            "irene",
            "essere",
            "partire",
            "senza",
            "correggere",
            "la",
            "parola",
            "non",
            "essere",
            "il",
            "momento",
            "di",
            "una",
            "lezione"
          ]
        },
        {
          "id": "s28",
          "text": "Sull'autobus non apre il quaderno. Guarda fuori. Una finestra scura, ordinaria, e basta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "autobus",
            "non",
            "aprire",
            "il",
            "quaderno",
            "guardare",
            "fuori",
            "una",
            "finestra",
            "scuro",
            "ordinario",
            "e",
            "basta"
          ]
        },
        {
          "id": "s29",
          "text": "Parte. Resta chi deve restare. Lei no. Questo è l'archivio che le resta: uno sguardo, e un no alla vendita.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "partire",
            "restare",
            "chi",
            "dovere",
            "restare",
            "lei",
            "no",
            "questo",
            "essere",
            "archivio",
            "che",
            "le",
            "restare",
            "uno",
            "sguardo",
            "e",
            "un",
            "no",
            "alla",
            "vendita"
          ]
        },
        {
          "id": "s30",
          "text": "Il contratto non rinnovato non è una punizione da film. È un no del comune, dopo un lavoro corto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "contratto",
            "non",
            "rinnovare",
            "non",
            "essere",
            "una",
            "punizione",
            "da",
            "film",
            "essere",
            "un",
            "no",
            "del",
            "comune",
            "dopo",
            "un",
            "lavoro",
            "corto"
          ]
        },
        {
          "id": "s31",
          "text": "Irene non chiede di restare. Non è suo. Guarda le finestre come chi ha saputo, e poi sale sull'autobus.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "irene",
            "non",
            "chiedere",
            "di",
            "restare",
            "non",
            "essere",
            "suo",
            "guardare",
            "le",
            "finestra",
            "come",
            "chi",
            "avere",
            "sapere",
            "e",
            "poi",
            "salire",
            "autobus"
          ]
        },
        {
          "id": "s32",
          "text": "Fine. Una finestra scura, ordinaria. La scuola sembra vuota. Lei parte. Basta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "fine",
            "una",
            "finestra",
            "scuro",
            "ordinario",
            "la",
            "scuola",
            "sembrare",
            "vuoto",
            "lei",
            "partire",
            "basta"
          ]
        },
        {
          "id": "s33",
          "text": "Non resta per diventare la donna delle finestre. Non è il suo archivio. È un paese, e un autobus, e via.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "restare",
            "per",
            "diventare",
            "la",
            "donna",
            "delle",
            "finestra",
            "non",
            "essere",
            "il",
            "suo",
            "archivio",
            "essere",
            "un",
            "paese",
            "e",
            "un",
            "autobus",
            "e",
            "via"
          ]
        },
        {
          "id": "s34",
          "text": "Guarda in alto un'ultima volta, di giorno. Poi non guarda più. Parte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "guardare",
            "in",
            "alto",
            "ultimo",
            "volta",
            "di",
            "giorno",
            "poi",
            "non",
            "guardare",
            "piu",
            "partire"
          ]
        },
        {
          "id": "s35",
          "text": "L'archivio del comune resta là, con Alme, con le scatole, con una macchina ferma, ormai. Lei porta via solo il quaderno chiuso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "archivio",
            "del",
            "comune",
            "restare",
            "la",
            "con",
            "alme",
            "con",
            "le",
            "scatola",
            "con",
            "una",
            "macchina",
            "fermo",
            "ormai",
            "lei",
            "portare",
            "via",
            "solo",
            "il",
            "quaderno",
            "chiudere"
          ]
        },
        {
          "id": "s36",
          "text": "Non vende. Non resta. Non è eroina. Guarda le finestre, parte, e la scuola sembra vuota. Questo è tutto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "vendere",
            "non",
            "restare",
            "non",
            "essere",
            "eroina",
            "guardare",
            "le",
            "finestra",
            "partire",
            "e",
            "la",
            "scuola",
            "sembrare",
            "vuoto",
            "questo",
            "essere",
            "tutto"
          ]
        },
        {
          "id": "s37",
          "text": "Dopo qualche giorno il no al contratto. Poi la cucina. Poi la borsa. Poi l'autobus. Poi lo sguardo, e via. Niente luce che torna.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dopo",
            "qualche",
            "giorno",
            "il",
            "no",
            "al",
            "contratto",
            "poi",
            "la",
            "cucina",
            "poi",
            "la",
            "borsa",
            "poi",
            "autobus",
            "poi",
            "lo",
            "sguardo",
            "e",
            "via",
            "niente",
            "luce",
            "che",
            "tornare"
          ]
        },
        {
          "id": "s38",
          "text": "L'archivio non è suo da vendere. La scuola non è sua da salvare da sola. Guarda, parte. Una finestra scura, ordinaria. Fine.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "archivio",
            "non",
            "essere",
            "suo",
            "da",
            "vendere",
            "la",
            "scuola",
            "non",
            "essere",
            "suo",
            "da",
            "salvare",
            "da",
            "sola",
            "guardare",
            "partire",
            "una",
            "finestra",
            "scuro",
            "ordinario",
            "fine"
          ]
        },
        {
          "id": "s39",
          "text": "Parte da San Quirico sul Nera di giorno. Non c'è premio. Non c'è arresto. C'è un autobus, e uno sguardo, e una scuola che sembra vuota.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "partire",
            "da",
            "san",
            "quirico",
            "sul",
            "nera",
            "di",
            "giorno",
            "non",
            "ce",
            "premio",
            "non",
            "ce",
            "arresto",
            "ce",
            "un",
            "autobus",
            "e",
            "uno",
            "sguardo",
            "e",
            "una",
            "scuola",
            "che",
            "sembrare",
            "vuoto"
          ]
        },
        {
          "id": "s40",
          "text": "Resta il paese. Resta la griglia. Resta la parola vuota, mutata, uguale in bocca a Loredana. Irene parte lo stesso.",
          "speakerId": null,
