{
  "id": "la-casa-delle-finestre-20",
  "storyId": "la-casa-delle-finestre",
  "number": 20,
  "title": "Friday",
  "titleIt": "Venerdì",
  "locationIds": [
    "comune",
    "ufficio-alme",
    "scatole-comune"
  ],
  "characterIds": [
    "irene-colombo",
