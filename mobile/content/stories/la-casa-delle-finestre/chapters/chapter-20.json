            "un",
            "altro",
            "martedi"
          ]
        },
        {
          "id": "s46",
          "text": "Alme resta in piedi. Irene resta seduta. Tra loro il tavolo. Nella tasca la chiavetta. Fuori il rumore.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
