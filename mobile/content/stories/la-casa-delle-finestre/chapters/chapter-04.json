          "id": "s68",
          "text": "La finestra otto resta sulla pagina di martedì.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "finestra",
            "otto",
            "restare",
            "sulla",
            "pagina",
            "di",
            "martedi"
          ]
        },
