          "text": "Ha solo due pagine, con i numeri.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "solo",
            "due",
            "pagina",
            "con",
            "i",
            "numero"
          ]
        },
        {
          "id": "s67",
          "text": "Irene lascia la penna accanto al quaderno chiuso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "irene",
            "lasciare",
            "la",
            "penna",
            "accanto",
            "al",
            "quaderno",
            "chiudere"
          ]
        },
