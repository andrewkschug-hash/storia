{
  "id": "la-casa-delle-finestre-15",
  "storyId": "la-casa-delle-finestre",
  "number": 15,
  "title": "Do not call",
  "titleIt": "Non chiamare",
  "locationIds": [
    "scuola-media",
    "comune",
    "ufficio-alme"
  ],
  "characterIds": [
    "irene-colombo",
