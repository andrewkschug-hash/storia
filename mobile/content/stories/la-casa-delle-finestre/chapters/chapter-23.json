  "events": [
    {
      "id": "ev-la-casa-delle-finestre-23",
      "summary": "At night the school grid is dark. Irene looks anyway. She opens the notebook, does not add a number, and closes it. She cannot sleep. The facing window stays dark. She is not sure she prefers this.",
      "characterIds": [
        "irene-colombo"
      ],
      "locationIds": [
        "mansarda-irene"
      ],
      "rememberedFacts": [
        "There is no night lamp now",
        "Irene still looks",
        "She closes the notebook without adding a number",
        "She is not sure she prefers the dark"
      ]
    }
  ],
  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Di sera Irene è in mansarda. Ha spento la luce della stanza.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "di",
            "sera",
            "irene",
            "essere",
            "in",
            "mansarda",
            "avere",
            "spegnere",
            "la",
            "luce",
            "della",
            "stanza"
          ]
        },
        {
          "id": "s02",
          "text": "Guarda la scuola. La griglia è scura. Tutte le finestre. Anche la tre, di fronte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "guardare",
            "la",
            "scuola",
            "la",
            "griglia",
            "essere",
            "scuro",
            "tutto",
            "le",
            "finestra",
            "anche",
            "la",
            "tre",
            "di",
            "fronte"
          ]
        },
        {
          "id": "s03",
          "text": "Non c'è una lampada. Non c'è una pausa. Non c'è un orario.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "ce",
            "una",
            "lampada",
            "non",
            "ce",
            "una",
            "pausa",
            "non",
            "ce",
            "un",
            "orario"
          ]
        },
        {
          "id": "s04",
          "text": "Sembra vuota. Lo sembrava anche prima. Adesso lo è, di notte, in un altro modo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sembrare",
            "vuoto",
            "lo",
            "sembrare",
            "anche",
            "prima",
            "adesso",
            "lo",
            "essere",
            "di",
            "notte",
            "in",
            "un",
            "altro",
            "modo"
          ]
        },
        {
          "id": "s05",
          "text": "Irene aspetta le nove, per abitudine. Poi le nove e dieci. Niente.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "irene",
            "aspettare",
            "le",
            "nove",
            "per",
            "abitudine",
            "poi",
            "le",
            "nove",
            "e",
            "dieci",
            "niente"
          ]
        },
        {
          "id": "s06",
          "text": "Ancora guarda. Non perché è una detective. Perché i suoi occhi hanno imparato quella riga.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ancora",
            "guardare",
            "non",
            "perche",
            "essere",
            "una",
            "detective",
            "perche",
            "i",
            "suo",
            "occhio",
            "avere",
            "imparare",
            "quello",
            "riga"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s07",
          "text": "Apre il quaderno sul tavolo. Le pagine coincidono ancora, sotto. I numeri ci sono.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "aprire",
            "il",
            "quaderno",
            "sul",
            "tavolo",
            "le",
            "pagina",
            "coincidere",
            "ancora",
            "sotto",
            "i",
            "numero",
            "ci",
            "essere"
          ]
        },
        {
          "id": "s08",
          "text": "Prende la penna. Non scrive un numero nuovo. Non scrive stasera niente, come un fatto da mappa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "prendere",
            "la",
            "penna",
            "non",
            "scrivere",
            "un",
            "numero",
            "nuovo",
            "non",
            "scrivere",
            "stasera",
            "niente",
            "come",
            "un",
            "fatto",
            "da",
            "mappa"
          ]
        },
        {
          "id": "s09",
          "text": "Chiude il quaderno. Lo lascia chiuso. L'abitudine si ferma qui, per scelta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "chiudere",
            "il",
            "quaderno",
            "lo",
            "lasciare",
            "chiudere",
            "abitudine",
            "si",
            "fermare",
            "qui",
            "per",
            "scelta"
          ]
        },
        {
          "id": "s10",
          "text": "Ha contato abbastanza. Ha capito abbastanza. Non tutto. Abbastanza per chiudere.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "contare",
            "abbastanza",
            "avere",
            "capire",
            "abbastanza",
            "non",
            "tutto",
            "abbastanza",
            "per",
            "chiudere"
          ]
        },
        {
          "id": "s11",
          "text": "Si mette a letto. Non dorme. Il buio della scuola entra nella stanza, senza luce.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "si",
            "mettere",
            "a",
            "letto",
            "non",
            "dormire",
            "il",
            "buio",
            "della",
            "scuola",
            "entrare",
            "nella",
            "stanza",
            "senza",
            "luce"
          ]
        },
        {
          "id": "s12",
          "text": "Ricorda le tre lente. Ricorda le due. Ricorda Sara di giorno, dietro la palestra.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ricordare",
            "le",
            "tre",
            "lento",
            "ricordare",
            "le",
            "due",
            "ricordare",
            "sara",
            "di",
            "giorno",
            "dietro",
            "la",
            "palestra"
          ]
        },
        {
          "id": "s13",
          "text": "Ricorda Loredana che piange sui numeri. Ricorda Quinto e le piante morte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ricordare",
            "loredana",
            "che",
            "piangere",
            "sui",
            "numero",
            "ricordare",
            "quinto",
            "e",
            "le",
            "pianta",
            "morto"
          ]
        },
        {
          "id": "s14",
          "text": "Nessun fantasma torna. Nessuna luce nuova. Solo la griglia, nera, come il primo giorno, e diversa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "nessuno",
            "fantasma",
            "tornare",
            "nessuno",
            "luce",
            "nuovo",
            "solo",
            "la",
            "griglia",
            "nero",
            "come",
            "il",
            "primo",
            "giorno",
            "e",
            "diverso"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s15",
          "text": "La finestra di fronte resta scura.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "finestra",
            "di",
            "fronte",
            "restare",
            "scuro"
          ]
        },
        {
          "id": "s16",
          "text": "Irene non è sicura di preferire questo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "irene",
            "non",
            "essere",
            "sicuro",
            "di",
            "preferire",
            "questo"
          ]
        },
        {
          "id": "s17",
          "text": "Prima aveva paura della luce. Adesso ha un buio onesto, e non dorme lo stesso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "prima",
            "avere",
            "paura",
            "della",
            "luce",
            "adesso",
            "avere",
            "un",
            "buio",
            "onesto",
            "e",
            "non",
            "dormire",
            "lo",
            "stesso"
          ]
        },
        {
          "id": "s18",
          "text": "Non apre di nuovo il quaderno. Non accende la lampada verso la scuola.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "aprire",
            "di",
            "nuovo",
            "il",
            "quaderno",
            "non",
            "accendere",
            "la",
            "lampada",
            "verso",
            "la",
            "scuola"
          ]
        },
        {
          "id": "s19",
          "text": "Ascolta le scale. Loredana non scende. Nessuno chiama. Venerdì è ancora oggi, o quasi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ascoltare",
            "le",
            "scala",
            "loredana",
            "non",
            "scendere",
            "nessuno",
            "chiamare",
            "venerdi",
            "essere",
            "ancora",
            "oggi",
            "o",
            "quasi"
          ]
        },
        {
          "id": "s20",
          "text": "Resta a guardare un poco. Poi si gira verso il muro. Gli occhi restano aperti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "restare",
            "a",
            "guardare",
            "un",
            "poco",
            "poi",
            "si",
            "girare",
            "verso",
            "il",
            "muro",
            "gli",
            "occhio",
            "restare",
            "aprire"
          ]
        },
        {
          "id": "s21",
          "text": "Senza luce. Con il quaderno chiuso. Con la scuola di fronte, vuota di lampada, non vuota di memoria.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "senza",
            "luce",
            "con",
            "il",
