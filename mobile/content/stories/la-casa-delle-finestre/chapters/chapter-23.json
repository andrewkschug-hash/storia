{
  "id": "la-casa-delle-finestre-23",
  "storyId": "la-casa-delle-finestre",
  "number": 23,
  "title": "Without light",
  "titleIt": "Senza luce",
  "locationIds": [
    "mansarda-irene",
    "scuola-media"
  ],
  "characterIds": [
    "irene-colombo"
  ],
  "difficultyLevel": 2,
  "events": [
    {
      "id": "ev-la-casa-delle-finestre-23",
      "summary": "At night the school grid is dark. Irene looks anyway. She opens the notebook, does not add a number, and closes it. She cannot sleep. The facing window stays dark. She is not sure she prefers this.",
      "characterIds": [
        "irene-colombo"
      ],
      "locationIds": [
        "mansarda-irene"
      ],
      "rememberedFacts": [
        "There is no night lamp now",
        "Irene still looks",
        "She closes the notebook without adding a number",
        "She is not sure she prefers the dark"
      ]
    }
  ],
  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Di sera Irene è in mansarda. Ha spento la luce della stanza.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "di",
            "sera",
            "irene",
            "essere",
            "in",
            "mansarda",
            "avere",
            "spegnere",
            "la",
            "luce",
            "della",
            "stanza"
          ]
        },
        {
          "id": "s02",
          "text": "Guarda la scuola. La griglia è scura. Tutte le finestre. Anche la tre, di fronte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "guardare",
            "la",
            "scuola",
            "la",
            "griglia",
            "essere",
            "scuro",
            "tutto",
            "le",
            "finestra",
            "anche",
            "la",
            "tre",
            "di",
            "fronte"
          ]
        },
        {
          "id": "s03",
          "text": "Non c'è una lampada. Non c'è una pausa. Non c'è un orario.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "ce",
            "una",
            "lampada",
            "non",
            "ce",
            "una",
            "pausa",
            "non",
            "ce",
            "un",
            "orario"
          ]
        },
        {
          "id": "s04",
          "text": "Sembra vuota. Lo sembrava anche prima. Adesso lo è, di notte, in un altro modo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sembrare",
            "vuoto",
            "lo",
            "sembrare",
            "anche",
            "prima",
            "adesso",
            "lo",
            "essere",
            "di",
            "notte",
            "in",
            "un",
            "altro",
            "modo"
          ]
        },
        {
          "id": "s05",
          "text": "Irene aspetta le nove, per abitudine. Poi le nove e dieci. Niente.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "irene",
            "aspettare",
            "le",
            "nove",
            "per",
            "abitudine",
            "poi",
            "le",
            "nove",
            "e",
            "dieci",
            "niente"
          ]
        },
        {
          "id": "s06",
          "text": "Ancora guarda. Non perché è una detective. Perché i suoi occhi hanno imparato quella riga.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ancora",
            "guardare",
            "non",
            "perche",
            "essere",
            "una",
            "detective",
            "perche",
            "i",
            "suo",
            "occhio",
            "avere",
            "imparare",
            "quello",
            "riga"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s07",
          "text": "Apre il quaderno sul tavolo. Le pagine coincidono ancora, sotto. I numeri ci sono.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "aprire",
            "il",
            "quaderno",
            "sul",
            "tavolo",
            "le",
            "pagina",
            "coincidere",
            "ancora",
            "sotto",
            "i",
            "numero",
            "ci",
            "essere"
          ]
        },
        {
          "id": "s08",
          "text": "Prende la penna. Non scrive un numero nuovo. Non scrive stasera niente, come un fatto da mappa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "prendere",
            "la",
            "penna",
            "non",
            "scrivere",
            "un",
            "numero",
            "nuovo",
            "non",
            "scrivere",
            "stasera",
            "niente",
            "come",
            "un",
            "fatto",
            "da",
            "mappa"
          ]
        },
        {
          "id": "s09",
          "text": "Chiude il quaderno. Lo lascia chiuso. L'abitudine si ferma qui, per scelta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "chiudere",
            "il",
            "quaderno",
            "lo",
            "lasciare",
            "chiudere",
            "abitudine",
            "si",
            "fermare",
            "qui",
            "per",
            "scelta"
          ]
        },
        {
          "id": "s10",
          "text": "Ha contato abbastanza. Ha capito abbastanza. Non tutto. Abbastanza per chiudere.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "contare",
            "abbastanza",
            "avere",
            "capire",
            "abbastanza",
            "non",
            "tutto",
            "abbastanza",
            "per",
            "chiudere"
          ]
        },
        {
          "id": "s11",
          "text": "Si mette a letto. Non dorme. Il buio della scuola entra nella stanza, senza luce.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "si",
            "mettere",
            "a",
            "letto",
            "non",
            "dormire",
            "il",
            "buio",
            "della",
            "scuola",
            "entrare",
            "nella",
            "stanza",
            "senza",
            "luce"
          ]
        },
        {
          "id": "s12",
          "text": "Ricorda le tre lente. Ricorda le due. Ricorda Sara di giorno, dietro la palestra.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ricordare",
            "le",
            "tre",
            "lento",
            "ricordare",
            "le",
            "due",
            "ricordare",
            "sara",
            "di",
            "giorno",
            "dietro",
            "la",
            "palestra"
          ]
        },
        {
          "id": "s13",
          "text": "Ricorda Loredana che piange sui numeri. Ricorda Quinto e le piante morte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ricordare",
            "loredana",
            "che",
            "piangere",
            "sui",
            "numero",
            "ricordare",
            "quinto",
            "e",
            "le",
            "pianta",
            "morto"
          ]
        },
        {
          "id": "s14",
          "text": "Nessun fantasma torna. Nessuna luce nuova. Solo la griglia, nera, come il primo giorno, e diversa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "nessuno",
            "fantasma",
            "tornare",
            "nessuno",
            "luce",
            "nuovo",
            "solo",
            "la",
            "griglia",
            "nero",
            "come",
            "il",
            "primo",
            "giorno",
            "e",
            "diverso"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s15",
          "text": "La finestra di fronte resta scura.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "finestra",
            "di",
            "fronte",
            "restare",
            "scuro"
          ]
        },
        {
          "id": "s16",
          "text": "Irene non è sicura di preferire questo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "irene",
            "non",
            "essere",
            "sicuro",
            "di",
            "preferire",
            "questo"
          ]
        },
        {
          "id": "s17",
          "text": "Prima aveva paura della luce. Adesso ha un buio onesto, e non dorme lo stesso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "prima",
            "avere",
            "paura",
            "della",
            "luce",
            "adesso",
            "avere",
            "un",
            "buio",
            "onesto",
            "e",
            "non",
            "dormire",
            "lo",
            "stesso"
          ]
        },
        {
          "id": "s18",
          "text": "Non apre di nuovo il quaderno. Non accende la lampada verso la scuola.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "aprire",
            "di",
            "nuovo",
            "il",
            "quaderno",
            "non",
            "accendere",
            "la",
            "lampada",
            "verso",
            "la",
            "scuola"
          ]
        },
        {
          "id": "s19",
          "text": "Ascolta le scale. Loredana non scende. Nessuno chiama. Venerdì è ancora oggi, o quasi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ascoltare",
            "le",
            "scala",
            "loredana",
            "non",
            "scendere",
            "nessuno",
            "chiamare",
            "venerdi",
            "essere",
            "ancora",
            "oggi",
            "o",
            "quasi"
          ]
        },
        {
          "id": "s20",
          "text": "Resta a guardare un poco. Poi si gira verso il muro. Gli occhi restano aperti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "restare",
            "a",
            "guardare",
            "un",
            "poco",
            "poi",
            "si",
            "girare",
            "verso",
            "il",
            "muro",
            "gli",
            "occhio",
            "restare",
            "aprire"
          ]
        },
        {
          "id": "s21",
          "text": "Senza luce. Con il quaderno chiuso. Con la scuola di fronte, vuota di lampada, non vuota di memoria.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "senza",
            "luce",
            "con",
            "il",
            "quaderno",
            "chiudere",
            "con",
            "la",
            "scuola",
            "di",
            "fronte",
            "vuoto",
            "di",
            "lampada",
            "non",
            "vuoto",
            "di",
            "memoria"
          ]
        },
        {
          "id": "s22",
          "text": "Il primo giorno la luce si muoveva. Stasera no. L'immagine si è girata, e lei l'ha lasciata girare.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "primo",
            "giorno",
            "la",
            "luce",
            "si",
            "muovere",
            "stasera",
            "no",
            "immagine",
            "si",
            "essere",
            "girare",
            "e",
            "lei",
            "avere",
            "lasciare",
            "girare"
          ]
        },
        {
          "id": "s23",
          "text": "Apre gli occhi nel buio della mansarda. Conta, senza voce, le finestre che non accende nessuno.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "aprire",
            "gli",
            "occhio",
            "nel",
            "buio",
            "della",
            "mansarda",
            "contare",
            "senza",
            "voce",
            "le",
            "finestra",
            "che",
            "non",
            "accendere",
            "nessuno"
          ]
        },
        {
          "id": "s24",
          "text": "Poi smette. Non è più il suo lavoro, quella riga. È una casa di fronte, di notte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "smettere",
            "non",
            "essere",
            "piu",
            "il",
            "suo",
            "lavoro",
            "quello",
            "riga",
            "essere",
            "una",
            "casa",
            "di",
            "fronte",
            "di",
            "notte"
          ]
        },
        {
          "id": "s25",
          "text": "Non vuole un nuovo mistero. Non arriva. Il silenzio è solo silenzio, e basta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "volere",
            "un",
            "nuovo",
            "mistero",
            "non",
            "arrivare",
            "il",
            "silenzio",
            "essere",
            "solo",
            "silenzio",
            "e",
            "basta"
          ]
        },
        {
          "id": "s26",
          "text": "Si gira ancora. La finestra tre resta scura. Lei non preferisce, non ancora. Resta in mezzo al sonno.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "si",
            "girare",
            "ancora",
            "la",
            "finestra",
            "tre",
            "restare",
            "scuro",
            "lei",
            "non",
            "preferire",
            "non",
            "ancora",
            "restare",
            "in",
            "mezzo",
            "al",
            "sonno"
          ]
        },
        {
          "id": "s27",
          "text": "Il quaderno è sul tavolo, chiuso. Domani forse parte. Stasera resta, senza luce, di proposito.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "quaderno",
            "essere",
            "sul",
            "tavolo",
            "chiudere",
            "domani",
            "forse",
            "partire",
            "stasera",
            "restare",
            "senza",
            "luce",
            "di",
            "proposito"
          ]
        },
        {
          "id": "s28",
          "text": "Ha aperto il quaderno una volta. Ha visto i numeri vecchi. Non ne ha aggiunti. Ha chiuso. Questo è il gesto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "aprire",
            "il",
            "quaderno",
            "una",
            "volta",
            "avere",
            "vedere",
            "i",
            "numero",
            "vecchio",
            "non",
            "ne",
            "avere",
            "aggiungere",
            "avere",
            "chiudere",
            "questo",
            "essere",
            "il",
            "gesto"
          ]
        },
        {
          "id": "s29",
          "text": "Non dorme perché il corpo ricorda le nove. Non perché un fantasma bussa. Il cuore va, poi no, poi di nuovo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "dormire",
            "perche",
            "il",
            "corpo",
            "ricordare",
            "le",
            "nove",
            "non",
            "perche",
            "un",
            "fantasma",
            "bussare",
            "il",
            "cuore",
            "andare",
            "poi",
            "no",
            "poi",
            "di",
            "nuovo"
          ]
        },
        {
          "id": "s30",
          "text": "Di fronte, buio. Lei non è sicura. Preferire il buio sarebbe facile, e non è facile.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "di",
            "fronte",
            "buio",
            "lei",
            "non",
            "essere",
            "sicuro",
            "preferire",
            "il",
            "buio",
            "essere",
            "facile",
            "e",
            "non",
            "essere",
            "facile"
          ]
        },
        {
          "id": "s31",
          "text": "Resta così fino a tardi. Poi, forse, dorme un poco, senza mappa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "restare",
            "cosi",
            "fino",
            "a",
            "tardi",
            "poi",
            "forse",
            "dormire",
            "un",
            "poco",
            "senza",
            "mappa"
          ]
        },
        {
          "id": "s32",
          "text": "Ha guardato la griglia come il primo giorno. Stavolta non ha contato per scrivere. Ha contato per smettere.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "guardare",
            "la",
            "griglia",
            "come",
            "il",
            "primo",
            "giorno",
            "stavolta",
            "non",
            "avere",
            "contare",
            "per",
            "scrivere",
            "avere",
            "contare",
            "per",
            "smettere"
          ]
        },
        {
          "id": "s33",
          "text": "La finestra di fronte è scura. Lei non sa se è meglio. Sa che il quaderno è chiuso. Questo basta, per il gesto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "finestra",
            "di",
            "fronte",
            "essere",
            "scuro",
            "lei",
            "non",
            "sapere",
            "se",
            "essere",
            "meglio",
            "sapere",
            "che",
            "il",
            "quaderno",
            "essere",
            "chiudere",
            "questo",
            "bastare",
            "per",
            "il",
            "gesto"
          ]
        },
        {
          "id": "s34",
          "text": "Nessun mostro nuovo. Nessuna luce che torna per un seguito. Solo sonno che non viene, e una scuola senza lampada.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "nessuno",
            "mostro",
            "nuovo",
            "nessuno",
            "luce",
            "che",
            "tornare",
            "per",
            "un",
            "seguito",
            "solo",
            "sonno",
            "che",
            "non",
            "venire",
            "e",
            "una",
            "scuola",
            "senza",
            "lampada"
          ]
        },
        {
          "id": "s35",
          "text": "Senza luce: il titolo è vero. Lei guarda lo stesso. Poi chiude gli occhi, e la griglia resta fuori.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "senza",
            "luce",
            "il",
            "titolo",
            "essere",
            "vero",
            "lei",
            "guardare",
            "lo",
            "stesso",
            "poi",
            "chiudere",
            "gli",
            "occhio",
            "e",
            "la",
            "griglia",
            "restare",
            "fuori"
          ]
        },
        {
          "id": "s36",
          "text": "Il quaderno non riceve una riga nuova. Questa è la decisione della notte, piccola e chiara.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "quaderno",
            "non",
            "ricevere",
            "una",
            "riga",
            "nuovo",
            "questo",
            "essere",
            "la",
            "decisione",
            "della",
            "notte",
            "piccolo",
            "e",
            "chiaro"
          ]
        },
        {
          "id": "s37",
          "text": "Ha paura del buio onesto, un poco. Ha paura anche di riaprire i numeri. Non riapre. Questo è il costo, e il taglio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "paura",
            "del",
            "buio",
            "onesto",
            "un",
            "poco",
            "avere",
            "paura",
            "anche",
            "di",
            "riaprire",
            "i",
            "numero",
            "non",
            "riaprire",
            "questo",
            "essere",
            "il",
            "costo",
            "e",
            "il",
            "taglio"
          ]
        },
        {
          "id": "s38",
          "text": "Sera senza luce. Mansarda. Scuola di fronte. Quaderno chiuso. Sonno che manca. Lei non è sicura di preferire. Fine della notte, quasi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sera",
            "senza",
            "luce",
            "mansarda",
            "scuola",
            "di",
            "fronte",
            "quaderno",
            "chiudere",
            "sonno",
            "che",
            "mancare",
            "lei",
            "non",
            "essere",
            "sicuro",
            "di",
            "preferire",
            "fine",
            "della",
            "notte",
            "quasi"
          ]
        },
        {
          "id": "s39",
          "text": "Ha smesso di numerare. Questo cambia lei, più della griglia. La griglia è uguale. Lei no.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "smettere",
            "di",
            "numerare",
            "questo",
            "cambiare",
            "lei",
            "piu",
            "della",
            "griglia",
            "la",
            "griglia",
            "essere",
            "uguale",
            "lei",
            "no"
          ]
        },
        {
          "id": "s40",
          "text": "Non aggiunge un numero. Non riapre. Non preferisce ancora. Guarda il buio di fronte, e resta. Questo è il capitolo, senza luce nuova.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "aggiungere",
