    {
      "id": "ev-la-casa-delle-finestre-21",
      "summary": "Still Friday, in Alme’s office. Alme says the closure protected children and also her job. She lets one box exist as already destroyed. She tells Irene to go to Piva or not; she will not help twice.",
      "characterIds": [
        "irene-colombo",
        "alme"
      ],
      "locationIds": [
        "ufficio-alme"
      ],
      "rememberedFacts": [
        "It is still Friday, in Alme’s office",
        "Alme says the closure protected children",
        "Alme also protected her job and the town’s story",
        "She allows one box to survive as already shredded",
        "This is not a full confession",
        "She says Irene may go to Piva or not; she will not help twice"
      ]
    }
  ],
  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "La porta è chiusa. Oggi è ancora venerdì. Fuori la macchina fa rumore.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "porta",
            "essere",
            "chiudere",
            "oggi",
            "essere",
            "ancora",
            "venerdi",
            "fuori",
            "la",
            "macchina",
            "fare",
            "rumore"
          ]
        },
        {
          "id": "s02",
          "text": "Alme resta in piedi. Irene resta seduta. Tra loro il tavolo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "alme",
            "restare",
            "in",
            "piedi",
            "irene",
            "restare",
            "sedere",
            "tra",
            "loro",
            "il",
            "tavolo"
          ]
        },
        {
          "id": "s03",
          "text": "Alme non urla. Non fa un discorso lungo. Parla a pezzi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "alme",
            "non",
            "urlare",
            "non",
            "fare",
            "un",
            "discorso",
            "lungo",
            "parlare",
            "a",
            "pezzo"
          ]
        },
        {
          "id": "s04",
          "text": "Abbiamo chiuso la scuola perché i bambini non potevano restare.",
          "speakerId": "alme",
          "kind": "dialogue",
          "lemmas": [
            "avere",
            "chiudere",
            "la",
            "scuola",
            "perche",
            "i",
            "bambino",
            "non",
            "potere",
            "restare"
          ]
        },
        {
          "id": "s05",
          "text": "Il muro non era sicuro. Questo è vero.",
          "speakerId": "alme",
          "kind": "dialogue",
          "lemmas": [
            "il",
            "muro",
            "non",
            "essere",
            "sicuro",
            "questo",
            "essere",
            "vero"
          ]
        },
        {
          "id": "s06",
          "text": "Irene ascolta. Non dice: e le crepe di Sara. Non fa l'avvocato.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "irene",
            "ascoltare",
            "non",
            "dire",
            "e",
            "le",
            "crepa",
            "di",
            "sara",
            "non",
            "fare",
            "avvocato"
          ]
        },
        {
          "id": "s07",
          "text": "Quindi abbiamo chiuso. Quindi il paese dice: è vuota.",
          "speakerId": "alme",
          "kind": "dialogue",
          "lemmas": [
            "quindi",
            "avere",
            "chiudere",
            "quindi",
            "il",
            "paese",
            "dire",
            "essere",
            "vuoto"
          ]
        },
        {
          "id": "s08",
          "text": "Però ho protetto anche il mio posto di lavoro. E la storia del paese.",
          "speakerId": "alme",
          "kind": "dialogue",
          "lemmas": [
            "pero",
            "avere",
            "proteggere",
            "anche",
            "il",
            "mio",
            "posto",
            "di",
            "lavoro",
            "e",
            "la",
            "storia",
            "del",
            "paese"
          ]
        },
        {
          "id": "s09",
          "text": "Non è tutta la verità. È abbastanza per chiudere una porta, due anni fa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "essere",
            "tutto",
            "la",
            "verita",
            "essere",
            "abbastanza",
            "per",
            "chiudere",
            "una",
            "porta",
            "due",
            "anno",
            "fa"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s10",
          "text": "Irene tiene la mano in tasca, sulla chiavetta. Alme guarda la tasca, poi no.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "irene",
            "tenere",
            "la",
            "mano",
            "in",
            "tasca",
            "sulla",
            "chiavetta",
            "alme",
            "guardare",
            "la",
            "tasca",
            "poi",
            "no"
          ]
        },
        {
          "id": "s11",
          "text": "Non chiede della copia. Non chiede di Sara. Chiede della scatola.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "chiedere",
            "della",
            "copia",
            "non",
            "chiedere",
            "di",
            "sara",
            "chiedere",
            "della",
            "scatola"
          ]
        },
        {
          "id": "s12",
          "text": "Quella del seminterrato. Io so.",
          "speakerId": "alme",
          "kind": "dialogue",
          "lemmas": [
            "quello",
            "del",
            "seminterrato",
            "io",
            "sapere"
          ]
        },
        {
          "id": "s13",
          "text": "Irene non mente di nuovo. Non parla. Annuisce, quasi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "irene",
            "non",
            "mentire",
            "di",
            "nuovo",
            "non",
            "parlare",
            "annuire",
            "quasi"
          ]
        },
        {
          "id": "s14",
          "text": "Per i fogli, quella scatola è già distrutta. Oggi. Venerdì.",
          "speakerId": "alme",
          "kind": "dialogue",
          "lemmas": [
            "per",
            "i",
            "foglio",
            "quello",
            "scatola",
            "essere",
            "gia",
            "distruggere",
            "oggi",
            "venerdi"
          ]
        },
        {
          "id": "s15",
          "text": "Non è coraggio. Non è pietà pulita. È una cosa piccola, e vile, e utile.",
          "speakerId": "alme",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "essere",
            "coraggio",
            "non",
            "essere",
            "pieta",
            "pulito",
            "essere",
            "una",
            "cosa",
            "piccolo",
            "e",
            "vile",
            "e",
            "utile"
          ]
        },
        {
          "id": "s16",
          "text": "Irene capisce: una scatola resta. Non un processo. Non la televisione.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "irene",
            "capire",
            "una",
            "scatola",
            "restare",
            "non",
            "un",
            "processo",
            "non",
            "la",
            "televisione"
          ]
        },
        {
          "id": "s17",
          "text": "Alme si siede, alla fine. Le mani sul tavolo, ferme.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "alme",
            "si",
            "sedere",
            "alla",
            "fine",
            "le",
            "mano",
            "sul",
            "tavolo",
            "fermo"
          ]
        },
        {
          "id": "s18",
          "text": "Non confesso in piazza. Non lo farò.",
          "speakerId": "alme",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "confessare",
            "in",
            "piazza",
            "non",
            "lo",
            "fare"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s19",
          "text": "Il rumore della macchina continua. Venerdì non si ferma per due donne.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "rumore",
            "della",
            "macchina",
            "continuare",
            "venerdi",
            "non",
            "si",
            "fermare",
            "per",
            "due",
            "donna"
          ]
        },
        {
          "id": "s20",
          "text": "Irene dovrebbe dire grazie, o no, o tutto. Dice poco.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "irene",
            "dovere",
            "dire",
            "grazie",
            "o",
            "no",
            "o",
            "tutto",
            "dire",
            "poco"
          ]
        },
        {
          "id": "s21",
          "text": "La scatola resta giù. Io non aiuto due volte.",
          "speakerId": "alme",
          "kind": "dialogue",
          "lemmas": [
            "la",
            "scatola",
            "restare",
            "giu",
            "io",
            "non",
            "aiutare",
            "due",
            "volta"
          ]
        },
        {
          "id": "s22",
          "text": "Adesso va dal maresciallo Piva, o non va. Questa è la sua scelta.",
          "speakerId": "alme",
          "kind": "dialogue",
          "lemmas": [
            "adesso",
            "andare",
            "dal",
            "maresciallo",
            "piva",
            "o",
            "non",
            "andare",
            "questo",
            "essere",
            "la",
            "suo",
            "scelta"
          ]
        },
        {
          "id": "s23",
          "text": "Non è un ordine. È una porta, aperta, dopo una porta chiusa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "essere",
            "un",
            "ordine",
            "essere",
            "una",
            "porta",
            "aprire",
            "dopo",
            "una",
            "porta",
            "chiudere"
          ]
        },
        {
          "id": "s24",
          "text": "Irene si alza. La chiavetta resta in tasca. Alme non la prende.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "irene",
            "si",
            "alzare",
            "la",
            "chiavetta",
            "restare",
            "in",
            "tasca",
            "alme",
            "non",
            "la",
            "prendere"
          ]
        },
        {
          "id": "s25",
          "text": "Non è finito il mistero in una stanza. È una scatola, e una scelta, e venerdì che continua.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "essere",
            "finire",
            "il",
            "mistero",
            "in",
            "una",
            "stanza",
            "essere",
            "una",
            "scatola",
            "e",
            "una",
            "scelta",
            "e",
            "venerdi",
            "che",
            "continuare"
          ]
        },
        {
          "id": "s26",
          "text": "Irene esce. Alme non dice arrivederci. Dice solo, piano: o Piva, o no.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "irene",
            "uscire",
            "alme",
            "non",
            "dire",
            "arrivederci",
            "dire",
            "solo",
            "piano",
            "o",
            "piva",
            "o",
            "no"
          ]
        },
        {
          "id": "s32",
          "text": "Fuori è ancora pomeriggio. La macchina lavora. Irene cammina verso i carabinieri, o ci pensa. Poi cammina.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "fuori",
            "essere",
            "ancora",
            "pomeriggio",
            "la",
            "macchina",
            "lavorare",
            "irene",
