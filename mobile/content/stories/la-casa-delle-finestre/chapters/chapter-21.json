{
  "id": "la-casa-delle-finestre-21",
  "storyId": "la-casa-delle-finestre",
  "number": 21,
  "title": "The director",
  "titleIt": "La dirigente",
  "locationIds": [
    "ufficio-alme"
  ],
  "characterIds": [
