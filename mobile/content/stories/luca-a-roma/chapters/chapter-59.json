      "order": 6,
      "sentences": [
        {
          "id": "s17",
          "text": "Prese la torcia tascabile dalla tasca del grembiule e illuminò l'interno del gruppo d'erogazione in ottone massiccio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
