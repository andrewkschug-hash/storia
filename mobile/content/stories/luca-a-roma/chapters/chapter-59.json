            "cura"
          ]
        },
        {
          "id": "s16",
          "text": "Ora bisognava diagnosticare l'origine precisa del guasto senza perdere nemmeno un minuto prezioso prima dell'arrivo della gente.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
