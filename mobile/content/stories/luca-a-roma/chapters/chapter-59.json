      "order": 9,
      "sentences": [
        {
          "id": "s26",
          "text": "Infilò la nuova guarnizione flessibile nella scanalatura circolare, spingendola a fondo con la parte piatta del portafiltro fino a sentire la perfetta aderenza elastica.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
