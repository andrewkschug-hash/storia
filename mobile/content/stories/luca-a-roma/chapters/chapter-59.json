    {
      "id": "p7",
      "order": 7,
      "sentences": [
        {
          "id": "s20",
          "text": "«Se non avessi fatto scorta di ricambi originali la settimana scorsa, adesso sarei in una situazione disperata,» pensò Luca tra sé mentre apriva la cassetta degli attrezzi di metallo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
