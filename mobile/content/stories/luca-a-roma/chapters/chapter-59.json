    {
      "id": "p8",
      "order": 8,
      "sentences": [
        {
          "id": "s23",
          "text": "Con un cacciavite a punta piatta e una pinza a becco sottile, Luca estrasse con estrema delicatezza e pazienza i frammenti della vecchia guarnizione indurita e deformata dal calore costante.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
