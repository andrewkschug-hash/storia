          ]
        },
        {
          "id": "s19",
          "text": "Era un anello piccolo e apparentemente insignificante, ma senza quella tenuta stagna l'acqua non poteva raggiungere la pressione ideale per estrarre l'espresso.",
          "speakerId": null,
          "kind": "narration",
