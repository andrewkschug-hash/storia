  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Martedì mattina Luca è tornato al caffè presto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "martedi",
            "mattina",
            "luca",
            "essere",
            "tornare",
            "al",
            "caffe",
            "presto"
          ]
        },
        {
          "id": "s02",
          "text": "Ieri il padrone ha detto di parlare questa mattina al caffè.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ieri",
            "il",
            "padrone",
            "avere",
            "dire",
            "di",
            "parlare",
            "questo",
            "mattina",
            "al",
            "caffe"
          ]
        },
        {
          "id": "s03",
          "text": "Ha detto che è una cosa importante.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "dire",
            "che",
            "essere",
            "una",
            "cosa",
            "importante"
          ]
        },
        {
          "id": "s04",
          "text": "Poi Luca ha aperto la porta e ha guardato la sala.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "luca",
            "avere",
            "aprire",
            "la",
            "porta",
            "e",
            "avere",
            "guardare",
            "la",
            "sala"
          ]
        },
        {
          "id": "s05",
          "text": "Ci sono ancora pochi clienti, meno di lunedì.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ci",
            "essere",
            "ancora",
            "poco",
            "cliente",
            "meno",
            "di",
            "lunedi"
          ]
        },
        {
          "id": "s06",
          "text": "I tavoli sono pronti, ma la sala è quasi vuota.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "i",
            "tavolo",
            "essere",
            "pronto",
            "ma",
            "la",
            "sala",
            "essere",
            "quasi",
            "vuoto"
          ]
        },
        {
          "id": "s07",
          "text": "Giulia è già al caffè e non ha sorriso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "giulia",
            "essere",
            "gia",
            "al",
            "caffe",
            "e",
            "non",
            "avere",
            "sorridere"
          ]
        },
        {
          "id": "s08",
          "text": "Il padrone è arrivato poco dopo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "padrone",
            "essere",
            "arrivare",
            "poco",
            "dopo"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s09",
          "text": "Poi ha chiamato Luca e Giulia vicino ai tavoli.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "avere",
            "chiamare",
            "luca",
            "e",
            "giulia",
            "vicino",
            "ai",
            "tavolo"
          ]
        },
        {
          "id": "s10",
          "text": "Dopo ha chiuso la porta un momento.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dopo",
            "avere",
            "chiudere",
            "la",
            "porta",
            "un",
            "momento"
          ]
        },
        {
          "id": "s11",
          "text": "Devo dirvi una notizia difficile sul caffè.",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "dovere",
            "dire",
            "una",
            "notizia",
            "difficile",
            "sul",
            "caffe"
          ]
        },
        {
          "id": "s12",
          "text": "Il caffè non va bene. Ci sono pochi clienti.",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "il",
            "caffe",
            "non",
            "andare",
            "bene",
            "ci",
            "essere",
            "poco",
            "cliente"
          ]
        },
        {
          "id": "s13",
          "text": "Prima sono entrati tanti clienti ogni giorno, ma adesso ci sono meno.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "prima",
            "essere",
            "entrare",
            "tanto",
            "cliente",
            "ogni",
            "giorno",
            "ma",
            "adesso",
            "ci",
            "essere",
            "meno"
          ]
        },
        {
          "id": "s14",
          "text": "Forse vendo il caffè o forse cambio tutto.",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "forse",
            "vendere",
            "il",
            "caffe",
            "o",
            "forse",
            "cambiare",
            "tutto"
          ]
        },
        {
          "id": "s15",
          "text": "Non ho deciso. Questa settimana è importante.",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "avere",
            "decidere",
            "questo",
            "settimana",
            "essere",
            "importante"
          ]
        },
        {
          "id": "s16",
          "text": "Luca ha ascoltato e non ha detto niente.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "ascoltare",
            "e",
            "non",
            "avere",
            "dire",
            "niente"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s17",
          "text": "La notizia è difficile per Luca e per Giulia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "notizia",
            "essere",
            "difficile",
            "per",
            "luca",
            "e",
            "per",
            "giulia"
          ]
        },
        {
          "id": "s18",
          "text": "Il padrone è preoccupato. Lo vedo.",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
            "il",
            "padrone",
            "essere",
            "preoccupato",
            "lo",
            "vedere"
          ]
        },
        {
          "id": "s19",
          "text": "E il mio lavoro?",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "e",
            "il",
            "mio",
            "lavorare"
          ]
        },
        {
          "id": "s20",
          "text": "Dipende. Non lo so ancora.",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "dipendere",
            "non",
            "lo",
            "sapere",
            "ancora"
          ],
          "phrases": [
            {
              "surface": "Dipende",
              "literalEn": "it depends",
              "naturalEn": "it depends",
              "tokenStart": 0,
              "tokenEnd": 0
            }
          ]
        },
        {
          "id": "s21",
          "text": "Dopo il padrone ha parlato, Giulia ha guardato Luca.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dopo",
            "il",
            "padrone",
            "avere",
            "parlare",
            "giulia",
            "avere",
            "guardare",
            "luca"
          ]
        },
        {
          "id": "s22",
          "text": "Poi ha detto una parola e ha guardato la sala vuota.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "avere",
            "dire",
            "una",
            "parola",
            "e",
            "avere",
            "guardare",
            "la",
            "sala",
            "vuoto"
          ]
        },
        {
          "id": "s23",
          "text": "Nel pomeriggio Giulia ha parlato con Luca nella sala.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "nel",
            "pomeriggio",
            "giulia",
            "avere",
            "parlare",
            "con",
            "luca",
            "nella",
            "sala"
          ]
        },
        {
          "id": "s24",
          "text": "Resto qui. Questo posto è importante.",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
            "restare",
            "qui",
            "questo",
            "posto",
            "essere",
            "importante"
          ]
        },
        {
          "id": "s25",
          "text": "Anch’io. Penso al lavoro e all’affitto ogni giorno.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "anche",
            "pensare",
            "al",
            "lavorare",
            "e",
            "affitto",
            "ogni",
            "giorno"
          ]
        },
        {
          "id": "s26",
          "text": "Luca ha pensato alla casa e al mese prossimo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "pensare",
            "alla",
            "casa",
            "e",
            "al",
            "mese",
            "prossimo"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s27",
          "text": "Poi ha servito i pochi clienti con calma.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "avere",
            "servire",
            "i",
            "poco",
            "cliente",
            "con",
            "calma"
          ]
        },
        {
          "id": "s28",
          "text": "Dopo ha pulito i tavoli e ha preparato la sala.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dopo",
            "avere",
            "pulito",
            "i",
            "tavolo",
            "e",
            "avere",
            "preparare",
            "la",
            "sala"
          ]
        },
        {
          "id": "s29",
          "text": "Ha portato caffè e acqua ai clienti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "portare",
            "caffe",
            "e",
            "acqua",
            "ai",
            "cliente"
          ]
        },
        {
          "id": "s30",
          "text": "Giulia ha lavorato con lui e non ha parlato molto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "giulia",
            "avere",
            "lavorare",
            "con",
            "lui",
            "e",
            "non",
            "avere",
            "parlare",
            "molto"
          ]
        },
        {
          "id": "s31",
          "text": "Alla sera il padrone è uscito presto, stanco.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "alla",
            "sera",
            "il",
            "padrone",
            "essere",
            "uscire",
            "presto",
            "stanco"
          ]
        },
        {
          "id": "s32",
          "text": "Poi ha chiuso la giornata e non ha detto altro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "avere",
            "chiudere",
            "la",
            "giornata",
            "e",
            "non",
            "avere",
            "dire",
            "altro"
          ]
        },
        {
          "id": "s33",
          "text": "Luca ha lavorato con Giulia fino a sera.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "lavorare",
            "con",
            "giulia",
            "fino",
            "a",
            "sera"
          ]
        },
        {
          "id": "s34",
          "text": "Dopo ha pensato a Sofia e al messaggio di ieri.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dopo",
            "avere",
            "pensare",
            "a",
            "sofia",
            "e",
            "al",
            "messaggio",
            "di",
            "ieri"
          ]
        }
      ]
    },
    {
      "id": "p5",
      "order": 5,
      "sentences": [
        {
          "id": "s35",
          "text": "Domani parlo con Sofia di questa notizia.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "domani",
            "parlare",
            "con",
            "sofia",
            "di",
            "questo",
            "notizia"
          ]
        },
        {
          "id": "s36",
          "text": "Bene. Dobbiamo fare un piano, non solo aspettare.",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
            "bene",
            "dovere",
            "fare",
            "un",
            "piano",
            "non",
            "solo",
            "aspettare"
          ]
        },
        {
          "id": "s37",
          "text": "Luca ha detto di sì, ma non ha ancora un piano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "dire",
            "di",
            "si_yes",
            "ma",
            "non",
            "avere",
            "ancora",
            "un",
            "piano"
          ]
        },
        {
          "id": "s38",
          "text": "Poi ha scritto un messaggio a Sofia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "avere",
            "scrivere",
            "un",
            "messaggio",
            "a",
            "sofia"
          ]
        },
        {
          "id": "s39",
          "text": "Ha scritto che c’è una notizia difficile al caffè.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "scrivere",
            "che",
            "ce",
            "una",
            "notizia",
            "difficile",
            "al",
            "caffe"
          ]
        },
        {
          "id": "s40",
          "text": "Sofia ha risposto tardi: «Capisco. Parliamo domani.»",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sofia",
            "avere",
            "rispondere",
            "tardi",
            "capire",
            "parlare",
            "domani"
          ]
        },
        {
          "id": "s41",
          "text": "Luca è preoccupato, ma ha un piano per domani.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "essere",
            "preoccupato",
            "ma",
            "avere",
            "un",
            "piano",
            "per",
            "domani"
          ]
        },
        {
          "id": "s42",
          "text": "Domani vuole capire di più.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "domani",
            "volere",
            "capire",
            "di",
            "piu"
          ]
        }
      ]
