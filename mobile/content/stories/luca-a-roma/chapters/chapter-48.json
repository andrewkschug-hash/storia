        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s11",
          "text": "«Nei giorni scorsi mi è capitata un'opportunità professionale molto importante e inaspettata che voglio raccontarvi con totale trasparenza, senza nascondervi alcun dettaglio.»",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "nei",
            "giorno",
            "scorso",
            "mi",
            "essere",
            "capitare",
            "opportunita",
