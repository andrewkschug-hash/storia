  "events": [
    {
      "id": "ev-48-letter-home",
      "summary": "Luca writes an intimate, honest letter to his parents in Pietralba explaining the hotel offer and his conscious decision to stay in Rome.",
      "characterIds": [
        "luca"
      ],
      "locationIds": [
        "quartiere",
        "strada"
      ],
      "rememberedFacts": [
        "Luca sits at his kitchen table on Sunday evening to write a heartfelt letter to his parents",
        "He acknowledges with deep gratitude that his work ethic in Rome comes from his upbringing in Pietralba",
        "He openly confesses the tempting security of the Grand Hotel offer and why he chose not to accept it",
        "He explains that staying in Rome is about becoming the author of his life rather than rejecting his roots",
        "He posts the sealed envelope in the red mailbox under the streetlights of San Lorenzo"
      ]
    }
  ],
  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Domenica sera, nel silenzio raccolto della sua stanza in affitto a San Lorenzo, Luca si è seduto al tavolo vicino alla finestra con un foglio bianco e una penna.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
