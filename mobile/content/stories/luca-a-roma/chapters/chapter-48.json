    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s06",
          "text": "«Cara mamma, caro papà, vi scrivo questa sera perché sento il bisogno profondo di parlarvi a cuore aperto, adesso che i primi venti freddi dell'inverno cominciano a farsi sentire anche qui a Roma.»",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "caro",
