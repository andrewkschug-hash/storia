    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s16",
          "text": "«Eppure, guardando da vicino quel bancone lussuoso ma freddo e visitando poi la bottega di falegnameria del mio amico Marco a San Lorenzo, ho compreso una verità che non posso più ignorare.»",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "eppure",
            "guardare",
            "da",
            "vicino",
            "quello",
            "bancone",
            "lussuoso",
            "ma",
