          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s24",
          "text": "Luca, invece, è rimasto completamente immobile, senza riuscire a pronunciare una sola parola.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "invece",
            "essere",
            "rimanere",
            "completamente",
            "immobile",
            "senza",
