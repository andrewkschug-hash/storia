  "events": [
    {
      "id": "ev-43-formal-announcement",
      "summary": "Signor Bruno formally announces to Luca and Giulia that he intends to sell the trattoria by the end of spring.",
      "characterIds": [
        "luca",
        "padrone",
        "giulia"
      ],
      "locationIds": [
        "lavoro-caffe"
      ],
      "rememberedFacts": [
        "Bruno meets Luca and Giulia after Saturday lunch service to announce the sale",
        "Bruno plans to complete the business transfer by the end of May",
        "Bruno promises full severance pay and glowing reference letters"
      ]
    },
    {
      "id": "ev-43-diverging-reactions",
      "summary": "Giulia reacts pragmatically by planning her severance and next job, while Luca is stunned by the threat to his Roman anchor.",
      "characterIds": [
        "luca",
        "padrone",
        "giulia"
      ],
      "locationIds": [
        "lavoro-caffe"
      ],
      "rememberedFacts": [
        "Giulia asks about contract continuity, notice periods, and recommendations",
        "Luca realizes the café was not just a job, but his core anchor in Rome",
        "Luca texts Sofia to meet in the evening after leaving the café"
      ]
    }
  ],
  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Il sabato pomeriggio il servizio del pranzo era terminato verso le due e mezza, lasciando nella sala il profumo caldo del caffè.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "sabato",
            "pomeriggio",
            "il",
            "servizio",
            "del",
            "pranzo",
            "essere",
            "terminare",
            "verso",
            "le",
            "due",
            "e",
            "mezzo",
            "lasciare",
            "nella",
            "sala",
            "il",
            "profumo",
            "caldo",
            "del",
            "caffe"
          ]
        },
        {
          "id": "s02",
          "text": "L'ultimo tavolo di clienti abituali aveva pagato il conto alla cassa ed era uscito nella luce dorata di ottobre.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ultimo",
            "tavolo",
            "di",
            "cliente",
            "abituale",
            "avere",
            "pagare",
            "il",
            "conto",
