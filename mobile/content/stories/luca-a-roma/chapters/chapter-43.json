            "cassa",
            "e",
            "essere",
            "uscire",
            "nella",
            "luce",
            "dorato",
            "di",
            "ottobre"
          ]
        },
        {
          "id": "s03",
          "text": "Dalla cucina, il cuoco Salvatore ha spento i fuochi, ha riposto i coltelli e ha salutato tutti prima di tornare a casa per il fine settimana.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dalla",
            "cucina",
            "il",
            "cuoco",
            "salvatore",
            "avere",
            "spegnere",
            "i",
            "fuoco",
            "avere",
            "riporre",
            "i",
            "coltello",
            "e",
            "avere",
            "salutare",
            "tutto",
            "primo",
            "di",
            "tornare",
            "a",
            "casa",
            "per",
            "il",
            "fine",
            "settimana"
          ]
        },
        {
          "id": "s04",
          "text": "Bruno ha girato la chiave nella toppa della porta a vetri, ha voltato il cartello su «Chiuso» e ha fatto un cenno calmo a Luca e Giulia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruno",
            "avere",
            "girare",
            "la",
            "chiave",
            "nella",
            "toppa",
            "della",
            "porta",
            "a",
            "vetro",
            "avere",
            "voltarsi",
            "il",
            "cartello",
            "su",
            "chiudere",
            "e",
            "avere",
            "fare",
            "un",
            "cenno",
            "calmo",
            "a",
            "luca",
            "e",
            "giulia"
          ]
        },
        {
          "id": "s05",
          "text": "«Lasciate i piatti per qualche minuto e venite a sedervi al tavolo quattro vicino alla finestra» ha detto il padrone con voce tranquilla.",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "lasciare",
            "i",
            "piatto",
            "per",
            "qualche",
            "minuto",
            "e",
            "venire",
            "a",
            "sedere",
            "al",
            "tavolo",
            "quattro",
            "vicino",
            "alla",
            "finestra",
            "avere",
            "dire",
            "il",
            "padrone",
            "con",
            "voce",
            "tranquillo"
          ]
        },
        {
          "id": "s06",
          "text": "Ha posato sul marmo una caraffa d'acqua fresca e tre bicchieri di vetro trasparente.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "posare",
            "sul",
            "marmo",
            "una",
            "caraffa",
            "acqua",
            "fresco",
            "e",
            "tre",
            "bicchiere",
            "di",
            "vetro",
            "trasparente"
          ]
        },
        {
          "id": "s07",
          "text": "Giulia e Luca si sono scambiati una rapida occhiata di intesa, sorpresi da quella richiesta formale proprio prima della pausa pomeridiana.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "giulia",
            "e",
            "luca",
            "si",
            "essere",
            "scambiare",
            "una",
            "rapido",
            "occhiata",
            "di",
            "intesa",
            "sorpreso",
            "da",
            "quello",
            "richiesta",
            "formale",
            "proprio",
            "primo",
            "della",
            "pausa",
            "pomeridiano"
          ]
        },
        {
          "id": "s08",
          "text": "Si sono seduti uno accanto all'altra sulle sedie di legno scuro, aspettando in silenzio che Bruno cominciasse a parlare.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "si",
            "essere",
            "sedersi",
            "uno",
            "accanto",
            "altro",
            "su",
            "sedia",
            "di",
            "legno",
            "scuro",
            "aspettare",
            "in",
            "silenzio",
            "che",
            "bruno",
            "cominciare",
            "a",
            "parlare"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s09",
          "text": "Bruno ha versato l'acqua nei tre bicchieri senza fretta, guardandoli negli occhi con grande franchezza e affetto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruno",
            "avere",
            "versare",
            "acqua",
            "nei",
            "tre",
            "bicchiere",
            "senza",
            "fretta",
            "guardare",
            "in",
            "occhio",
            "con",
            "grande",
            "franchezza",
            "e",
            "affetto"
          ]
        },
        {
          "id": "s10",
          "text": "«Vi ho chiamati qui perché voglio che sappiate la verità direttamente da me, prima che comincino a circolare voci incontrollate nel quartiere.»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "vi",
            "avere",
            "chiamare",
            "qui",
            "perche",
            "volere",
            "che",
            "sapere",
            "la",
            "verita",
            "direttamente",
            "da",
            "me",
            "primo",
            "che",
            "cominciare",
            "a",
            "circolare",
            "voce",
            "incontrollato",
            "nel",
            "quartiere"
          ]
        },
        {
          "id": "s11",
          "text": "«Ho parlato a lungo con il commercialista e con la mia famiglia: ho deciso ufficialmente di cedere la licenza e l'attività del locale entro la fine di maggio.»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "avere",
            "parlare",
            "a",
            "lungo",
            "con",
            "il",
            "commercialista",
            "e",
            "con",
            "la",
            "mio",
            "famiglia",
            "avere",
            "decidere",
            "ufficialmente",
            "di",
            "cedere",
            "la",
            "licenza",
            "e",
            "attivita",
            "del",
            "locale",
            "entro",
            "la",
            "fine",
            "di",
            "maggio"
          ]
        },
        {
          "id": "s12",
          "text": "«Il medico mi ha confermato che il ginocchio ha bisogno di riposo, e mia figlia a Bologna ha la sua carriera e non intende occuparsi del locale.»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "il",
            "medico",
            "mi",
            "avere",
            "confermare",
            "che",
            "il",
            "ginocchio",
            "avere",
            "bisogno",
            "di",
            "riposo",
            "e",
            "mio",
            "figlio",
            "a",
            "bologna",
            "avere",
            "la",
            "suo",
            "carriera",
            "e",
            "non",
            "intendere",
            "occupare",
            "del",
            "locale"
          ]
        },
        {
          "id": "s13",
          "text": "«Voglio che voi siate informati con anticipo, per avere tutto il tempo necessario di riflettere e organizzarvi.»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "volere",
            "che",
            "voi",
            "essere",
            "informare",
            "con",
            "anticipo",
            "per",
            "avere",
            "tutto",
            "il",
            "tempo",
            "necessario",
            "di",
            "riflettere",
            "e",
            "organizzare"
          ]
        },
        {
          "id": "s14",
          "text": "Le parole di Bruno sono risuonate chiare, pesanti e definitive nella sala silenziosa del locale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "le",
            "parola",
            "di",
            "bruno",
            "essere",
            "risuonare",
            "chiaro",
            "pesante",
            "e",
            "definitivo",
            "nella",
            "sala",
            "silenzioso",
            "del",
            "locale"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s15",
          "text": "Giulia è stata la prima a reagire, mostrando la sua consueta prontezza pratica e professionale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "giulia",
            "essere",
            "essere",
            "la",
            "primo",
            "a",
            "reagire",
            "mostrare",
            "la",
            "suo",
            "consueto",
            "prontezza",
            "pratica",
            "e",
            "professionale"
          ]
        },
        {
          "id": "s16",
          "text": "Lavorava nei bar e nei ristoranti del centro di Roma da molti anni e conosceva bene le dinamiche delle cessioni commerciali.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lavorare",
            "nei",
            "bar",
            "e",
            "nei",
            "ristorante",
            "del",
            "centro",
            "di",
            "roma",
            "da",
            "molto",
            "anno",
            "e",
            "conoscere",
            "bene",
            "le",
            "dinamica",
            "delle",
            "cessione",
            "commerciale"
          ]
        },
        {
          "id": "s17",
          "text": "«Capisco perfettamente la sua decisione, signor Bruno, ed è giusto che pensi alla sua salute e alla pensione» ha detto con tono rispettoso ma diretto.",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
            "capire",
            "perfettamente",
            "la",
            "suo",
            "decisione",
            "signore",
            "bruno",
            "e",
            "essere",
            "giusto",
            "che",
            "pensare",
            "alla",
            "suo",
            "salute",
            "e",
            "alla",
            "pensione",
            "avere",
            "dire",
            "con",
            "tono",
            "rispettoso",
            "ma",
            "diretto"
          ]
        },
        {
          "id": "s18",
          "text": "«Vorrei capire cosa succederà con i nostri contratti di lavoro: chi comprerà l'attività manterrà il personale attuale, oppure dobbiamo cominciare a cercare un nuovo impiego fin da subito?»",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
            "volere",
            "capire",
            "cosa",
            "succedere",
            "con",
            "i",
            "nostro",
            "contratto",
            "di",
            "lavoro",
            "chi",
            "comprare",
            "attivita",
            "mantenere",
            "il",
            "personale",
            "attuale",
            "oppure",
            "dovere",
            "cominciare",
            "a",
            "cercare",
            "un",
            "nuovo",
            "impiego",
            "fino",
            "da",
            "subito"
          ]
        },
        {
          "id": "s19",
          "text": "«Dipende da chi subentrerà nella gestione del locale» ha risposto Bruno con estrema sincerità.",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "dipendere",
            "da",
            "chi",
            "subentrare",
            "nella",
            "gestione",
            "del",
            "locale",
            "avere",
            "rispondere",
            "bruno",
            "con",
            "estremo",
            "sincerita"
          ]
        },
        {
          "id": "s20",
          "text": "«Ma vi garantisco che riceverete ogni euro della liquidazione e del trattamento di fine rapporto fino all'ultimo giorno di lavoro.»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "ma",
            "vi",
            "garantire",
            "che",
            "ricevere",
            "ogni",
            "euro",
            "della",
            "liquidazione",
            "e",
            "del",
            "trattamento",
            "di",
            "fine",
            "rapporto",
            "fino",
            "ultimo",
            "giorno",
            "di",
            "lavoro"
          ]
        },
        {
          "id": "s21",
          "text": "«Inoltre, scriverò per entrambi ottime lettere di referenze per qualunque datore di lavoro a Roma.»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "inoltre",
            "scrivere",
            "per",
            "entrambi",
            "ottimo",
            "lettera",
            "di",
            "referenza",
            "per",
            "qualunque",
            "datore",
            "di",
            "lavoro",
            "a",
            "roma"
          ]
        },
        {
          "id": "s22",
          "text": "«Chiedo soltanto che continuiate a lavorare con me con la solita serietà e cura fino alla chiusura definitiva della stagione primaverile.»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "chiedere",
            "soltanto",
            "che",
            "continuare",
            "a",
            "lavorare",
            "con",
            "me",
            "con",
            "la",
            "solito",
            "serieta",
            "e",
            "cura",
            "fino",
            "alla",
            "chiusura",
            "definitivo",
            "della",
            "stagione",
            "primaverile"
          ]
        },
        {
          "id": "s23",
          "text": "«Da parte mia non ci sono problemi, signor Bruno. Conosco diversi direttori di sala vicino a piazza Barberini e comincerò a informarmi con calma dopo le feste di Natale» ha risposto Giulia, già proiettata con lucidità verso i passi successivi.",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
            "da",
            "parte",
            "mio",
            "non",
            "ci",
            "essere",
            "problema",
            "signore",
            "bruno",
            "conoscere",
            "diverso",
            "direttore",
            "di",
            "sala",
            "vicino",
            "a",
            "piazza",
            "barberini",
            "e",
            "cominciare",
            "a",
            "informare",
            "con",
            "calmo",
            "dopo",
            "le",
            "festa",
            "di",
            "natale",
            "avere",
            "rispondere",
            "giulia",
            "gia",
            "proiettare",
            "con",
            "lucidita",
            "verso",
            "i",
            "passo",
