            "la",
            "cupola",
            "maestoso",
            "di",
            "san",
            "pietro",
            "emergere",
            "luminoso",
            "tra",
            "i",
            "primo",
            "vapore",
            "dorato",
            "del",
            "mattino"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s08",
          "text": "Fissando quel panorama straordinario e infinito, la mente di Luca è tornata spontaneamente a Pietralba e alla vita che aveva lasciato alle spalle diciotto mesi prima.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "fissare",
            "quello",
            "panorama",
            "straordinario",
            "e",
            "infinito",
            "la",
            "mente",
            "di",
            "luca",
            "essere",
            "tornare",
            "spontaneamente",
            "a",
            "pietralba",
            "e",
            "alla",
            "vita",
            "che",
            "avere",
            "lasciare",
            "alle",
            "spalla",
            "diciotto",
            "mese",
            "primo"
          ]
        },
        {
          "id": "s09",
          "text": "Poteva immaginare con assoluta nitidezza e precisione la domenica mattina nel suo piccolo paese natale tra le montagne.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "potere",
            "immaginare",
            "con",
            "assoluto",
            "nitidezza",
            "e",
            "precisione",
            "la",
