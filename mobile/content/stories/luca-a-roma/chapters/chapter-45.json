            "il",
            "timore",
            "costante",
            "di",
            "non",
            "essere",
            "altezza",
            "dei",
            "ritmo",
            "serrato",
            "della",
            "citta"
          ]
        },
        {
          "id": "s17",
          "text": "Eppure, era stato proprio affrontando quelle prove quotidiane che aveva imparato a superare la propria timidezza infantile, a gestire le responsabilità con disciplina e ad ascoltare con empatia le vite di centinaia di persone diverse.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "eppure",
            "essere",
            "essere",
            "proprio",
            "affrontare",
            "quello",
            "prova",
