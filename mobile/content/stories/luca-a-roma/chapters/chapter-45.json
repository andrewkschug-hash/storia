  "events": [
    {
      "id": "ev-45-solitary-walk",
      "summary": "Luca takes a solitary Sunday morning walk across Rome to the Aventine Hill, reflecting on his eighteen months in the city.",
      "characterIds": [
        "luca"
      ],
      "locationIds": [
        "quartiere",
        "centro",
        "strada"
      ],
      "rememberedFacts": [
        "Luca walks on Sunday morning from San Lorenzo up to the Orange Garden on the Aventine Hill",
        "He observes the quiet Sunday city from above, watching the rooftops and domes in the autumn morning light"
      ]
    },
    {
      "id": "ev-45-internal-crossroads",
      "summary": "Luca weighs the safe certainty of returning to Pietralba against the risky autonomy of building his own path in Rome.",
      "characterIds": [
        "luca"
      ],
      "locationIds": [
        "centro",
        "strada"
      ],
      "rememberedFacts": [
        "Pietralba represents safety, family tradition, and an already-written life",
        "Rome represents challenge, possibility, self-reliance, and personal transformation",
        "Luca resolves that whatever happens over the next seven months, he will be the one actively choosing his future"
      ]
    }
  ],
  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "La domenica mattina Roma si svegliava con una lentezza quieta e solenne che Luca aveva imparato ad amare.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "domenica",
            "mattina",
            "roma",
            "si",
            "svegliare",
            "con",
            "una",
            "lentezza",
            "quieto",
            "e",
            "solenne",
            "che",
            "luca",
            "avere",
            "imparare",
            "a",
            "amaro"
          ]
        },
        {
          "id": "s02",
          "text": "Erano appena passate le otto quando è uscito dal portone del suo palazzo a San Lorenzo, infilando le mani nelle tasche della giacca pesante per proteggersi dalla prima brezza fresca di novembre.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "appena",
            "passare",
            "le",
            "otto",
            "quando",
            "essere",
            "uscire",
            "dal",
            "portone",
            "del",
            "suo",
            "palazzo",
            "a",
            "san",
            "lorenzo",
            "infilare",
            "le",
            "mano",
            "in",
            "tasca",
            "della",
            "giacca",
            "pesante",
            "per",
            "proteggere",
            "dalla",
            "primo",
            "brezza",
            "fresco",
            "di",
            "novembre"
          ]
        },
        {
          "id": "s03",
          "text": "I marciapiedi di pietra erano quasi deserti: solo qualche anziano con il cappotto scuro comprava il quotidiano all'edicola dell'angolo, mentre l'aroma dolce e fragrante dei cornetti caldi usciva dai laboratori di pasticceria del quartiere.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "i",
            "marciapiede",
            "di",
            "pietra",
            "essere",
            "quasi",
            "deserto",
            "solo",
            "qualche",
            "anziano",
            "con",
            "il",
            "cappotto",
            "scuro",
            "comprare",
            "il",
            "quotidiano",
            "edicola",
            "angolo",
            "mentre",
            "aroma",
            "dolce",
            "e",
            "fragrante",
            "dei",
            "cornetto",
            "caldo",
            "uscire",
            "da",
            "laboratorio",
            "di",
            "pasticceria",
            "del",
            "quartiere"
          ]
        },
        {
          "id": "s04",
          "text": "Invece di prendere i mezzi pubblici, Luca ha deciso di camminare a lungo senza una meta precisa, lasciando che i passi guidassero liberamente i suoi pensieri.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "invece",
            "di",
            "prendere",
            "i",
            "mezzo",
            "pubblico",
            "luca",
            "avere",
            "decidere",
            "di",
            "camminare",
            "a",
            "lungo",
            "senza",
            "una",
            "meta",
            "preciso",
            "lasciare",
            "che",
            "i",
            "passo",
            "guidare",
            "liberamente",
            "i",
            "suo",
            "pensiero"
          ]
        },
        {
          "id": "s05",
          "text": "Ha attraversato gli archi imponenti dell'antico acquedotto romano vicino a Porta Maggiore, è salito lungo le pendici alberate e silenziose del colle Celio ed è arrivato infine sulla sommità elegante dell'Aventino.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "attraversare",
            "gli",
            "arco",
            "imponente",
            "antico",
            "acquedotto",
            "romano",
            "vicino",
            "a",
            "porta",
            "maggior",
            "essere",
            "salire",
            "lungo",
            "le",
            "pendice",
            "alberato",
            "e",
            "silenzioso",
            "del",
            "colle",
            "celio",
            "e",
            "essere",
            "arrivare",
            "infine",
            "sulla",
            "sommita",
            "elegante",
            "aventino"
          ]
        },
        {
          "id": "s06",
          "text": "È entrato nel Giardino degli Aranci tra il profumo aspro degli agrumi e si è appoggiato al muretto in mattoni della terrazza panoramica, dove la vista spaziava aperta su tutta la distesa sconfinata della città eterna.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
