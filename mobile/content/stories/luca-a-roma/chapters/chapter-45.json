            "agrume",
            "e",
            "si",
            "essere",
            "appoggiare",
            "al",
            "muretto",
            "in",
            "mattone",
            "della",
            "terrazza",
            "panoramico",
            "dove",
            "la",
            "vista",
            "spaziare",
            "aprire",
            "su",
            "tutto",
            "la",
            "distesa",
            "sconfinato",
            "della",
            "citta",
            "eterno"
          ]
        },
        {
          "id": "s07",
          "text": "Sotto di lui il fiume Tevere scorreva calmo tra gli alti argini di pietra, mentre la cupola maestosa di San Pietro emergeva luminosa tra i primi vapori dorati del mattino.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sotto",
