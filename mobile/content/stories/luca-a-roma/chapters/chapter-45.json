            "unicamente",
            "su",
            "proprio",
            "forza"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s14",
          "text": "Dall'altra parte di quella scelta c'era Roma, con la sua bellezza abbagliante ma anche con la sua implacabile, severa complessità quotidiana.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "altro",
            "parte",
            "di",
            "quello",
            "scelta",
            "ce",
            "roma",
            "con",
            "la",
            "suo",
            "bellezza",
            "abbagliante",
            "ma",
            "anche",
            "con",
            "la",
            "suo",
            "implacabile",
            "severo",
            "complessita",
            "quotidiano"
          ]
        },
        {
          "id": "s15",
          "text": "Quando era sceso dal treno con una vecchia valigia consumata alla stazione Termini, la capitale gli era sembrata un labirinto ostile, rumoroso ed estraneo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "quando",
            "essere",
            "scendere",
            "dal",
            "treno",
            "con",
            "una",
            "vecchio",
            "valigia",
            "consumato",
            "alla",
            "stazione",
            "termini",
            "la",
            "capitale",
            "gli",
            "essere",
            "sembrare",
            "un",
            "labirinto",
            "ostile",
            "rumoroso",
            "e",
            "estraneo"
          ]
        },
        {
          "id": "s16",
          "text": "Aveva conosciuto il freddo delle sere solitarie nella sua cameretta in affitto, la fatica estenuante dietro al bancone nelle ore di punta e il timore costante di non essere all'altezza dei ritmi serrati della città.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "conoscere",
            "il",
            "freddo",
            "delle",
            "sera",
            "solitario",
            "nella",
            "suo",
            "cameretta",
            "in",
