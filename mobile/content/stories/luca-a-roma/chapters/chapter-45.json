            "a",
            "superare",
            "la",
            "proprio",
            "timidezza",
            "infantile",
            "a",
            "gestire",
            "le",
            "responsabilita",
            "con",
            "disciplina",
            "e",
            "a",
            "ascoltare",
            "con",
            "empatia",
            "le",
            "vita",
            "di",
            "centinaio",
            "di",
            "persona",
            "diverso"
          ]
        },
        {
          "id": "s18",
          "text": "Roma non faceva regali e non perdonava le distrazioni, ma offriva in cambio a chiunque avesse il coraggio di lottare la libertà rara di reinventarsi e di scoprire il proprio autentico valore.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "roma",
