            "un",
            "tempo",
            "prezioso",
            "di",
            "studio",
            "e",
            "di",
            "preparazione",
            "attivo"
          ]
        },
        {
          "id": "s22",
          "text": "Se da un lato la trattoria di Bruno era stata il suo nido accogliente e protettivo, dall'altro la sua vendita inevitabile rappresentava la scossa salutare necessaria per uscire definitivamente dalla propria zona di comodità.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "se",
            "da",
            "un",
            "lato",
            "la",
            "trattoria",
            "di",
            "bruno",
            "essere",
            "essere",
            "il",
            "suo",
            "nido",
            "accogliente",
            "e",
            "protettivo",
            "altro",
            "la",
            "suo",
            "vendita",
            "inevitabile",
            "rappresentare",
            "la",
            "scossa",
