            "dalla",
            "proprio",
            "zona",
            "di",
            "comodita"
          ]
        },
        {
          "id": "s23",
          "text": "Non voleva più limitarsi a cercare un altro impiego qualunque come barista dipendente solo per pagare l'affitto e tirare avanti di mese in mese.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
