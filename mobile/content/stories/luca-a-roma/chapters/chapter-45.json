            "solo",
            "per",
            "pagare",
            "affitto",
            "e",
            "tirare",
            "avanti",
            "di",
            "mese",
            "in",
            "mese"
          ]
        },
        {
          "id": "s24",
          "text": "Desiderava che il suo lavoro servisse a creare un'esperienza autentica, fondata sulla qualità impeccabile delle materie prime, sulla cura dei prodotti e sull'ospitalità calorosa che Bruno gli aveva insegnato con tanta generosità.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "desiderare",
            "che",
            "il",
            "suo",
            "lavoro",
            "servire",
            "a",
            "creare",
            "esperienza",
            "autentico",
