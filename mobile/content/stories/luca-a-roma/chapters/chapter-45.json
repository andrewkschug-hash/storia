            "a",
            "chiunque",
            "avere",
            "il",
            "coraggio",
            "di",
            "lottare",
            "la",
            "liberta",
            "raro",
            "di",
            "reinventare",
            "e",
            "di",
            "scoprire",
            "il",
            "proprio",
            "autentico",
            "valore"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s19",
          "text": "Le parole lucide e sincere che Sofia gli aveva rivolto la sera precedente a Monti risuonavano ora dentro di lui con una straordinaria forza chiarificatrice.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "le",
            "parola",
            "lucido",
            "e",
            "sincero",
            "che",
            "sofia",
            "gli",
            "avere",
            "rivolgere",
            "la",
            "sera",
            "precedente",
            "a",
            "monti",
            "risuonare",
            "ora",
            "dentro",
            "di",
            "lui",
            "con",
            "una",
            "straordinario",
            "forza",
            "chiarificatore"
          ]
        },
        {
          "id": "s20",
          "text": "«Non guardare questi mesi come una condanna; sono un'opportunità enorme per capire chi vuoi diventare davvero.»",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "guardare",
            "questo",
            "mese",
            "come",
            "una",
            "condanna",
            "essere",
            "opportunita",
            "enorme",
            "per",
            "capire",
            "chi",
            "volere",
            "diventare",
            "davvero"
          ]
        },
        {
          "id": "s21",
          "text": "Luca ha compreso fino in fondo che i sette mesi che mancavano alla cessione del bar a maggio non dovevano essere vissuti come una lenta attesa passiva, ma come un tempo prezioso di studio e di preparazione attiva.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "comprendere",
            "fino",
            "in",
            "fondo",
            "che",
            "i",
            "sette",
            "mese",
            "che",
            "mancare",
            "alla",
            "cessione",
            "del",
            "bar",
            "a",
            "maggio",
            "non",
            "dovere",
            "essere",
            "vivere",
            "come",
            "una",
            "lento",
            "attesa",
            "passivo",
            "ma",
