    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s07",
          "text": "Il direttore del settore beverage e ristorazione, il dottor Valenti, li ha ricevuti nel salottino riservato adiacente al grande bancone in mogano massiccio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "direttore",
            "di",
            "settore",
            "beverage",
