    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s13",
          "text": "Il dottor Valenti ha poi illustrato i dettagli e le condizioni contrattuali dell'impiego con una trasparenza professionale che ha colpito profondamente Luca.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "dottore",
            "valenti",
            "avere",
            "poi",
            "illustrare",
            "il",
