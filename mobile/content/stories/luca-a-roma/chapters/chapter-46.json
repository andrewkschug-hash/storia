      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Martedì pomeriggio, durante la consueta pausa tra il servizio del pranzo e quello serale, Luca ha raggiunto Giulia all'uscita della metropolitana di Piazza Barberini.",
          "speakerId": null,
          "kind": "narration",
