    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s18",
          "text": "Luca ha ringraziato sinceramente il direttore per la proposta lusinghiera e ha chiesto con rispetto qualche settimana di tempo per riflettere con calma prima di dare una risposta definitiva.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
