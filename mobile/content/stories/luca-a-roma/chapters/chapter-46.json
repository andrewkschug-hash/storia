            "non",
            "dovere",
            "mai",
            "piu",
            "preoccupare",
            "di",
            "bolletta",
            "o",
            "crisi"
          ]
        },
        {
          "id": "s23",
          "text": "«Se accettassi questa proposta, la tua vita nella capitale sarebbe sistemata per sempre senza alcun rischio personale o finanziario.»",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
