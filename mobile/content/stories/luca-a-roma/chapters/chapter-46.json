            "adiacente",
            "a",
            "grande",
            "bancone",
            "in",
            "mogano",
            "massiccio"
          ]
        },
        {
          "id": "s08",
          "text": "Era un uomo distinto sulla cinquantina, con capelli brizzolati e un abito sartoriale grigio scuro che trasmetteva autorevolezza, rigore e precisione.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "un",
            "uomo",
            "distinto",
            "su",
            "cinquantina",
            "con",
            "capello",
