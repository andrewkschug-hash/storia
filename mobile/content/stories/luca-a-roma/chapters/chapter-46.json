            "grigio",
            "scuro",
            "che",
            "trasmettere",
            "autorevolezza",
            "rigore",
            "e",
            "precisione"
          ]
        },
        {
          "id": "s09",
          "text": "«Ho letto con grandissima attenzione e stima la lettera che il signor Bruno ha firmato per lei, Luca,» ha esordito il dottor Valenti, facendoli accomodare su due poltrone di velluto color crema.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "leggere",
            "con",
            "grande",
            "attenzione",
            "e",
