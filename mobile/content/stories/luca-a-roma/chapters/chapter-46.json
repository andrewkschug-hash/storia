      "summary": "Giulia takes Luca to visit the prestigious Grand Hotel near Via Veneto, introducing him to the beverage director, Signor Valenti.",
      "characterIds": [
        "luca",
        "giulia"
      ],
      "locationIds": [
        "centro",
        "strada"
      ],
      "rememberedFacts": [
        "Giulia introduces Luca to Signor Valenti at the Grand Hotel near Via Veneto",
        "Signor Valenti offers Luca a permanent contract starting in June with paid leave, full benefits, and high salary"
      ]
    },
    {
      "id": "ev-46-temptation-of-security",
      "summary": "Luca weighs the concrete safety and status of the corporate hotel offer against his emerging desire for independent craft.",
      "characterIds": [
