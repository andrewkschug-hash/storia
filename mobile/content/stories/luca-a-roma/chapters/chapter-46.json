            "il",
            "suo",
            "documento",
            "rimanere",
            "in",
            "cima",
            "a",
            "mio",
            "scrivania"
          ]
        },
        {
          "id": "s20",
          "text": "Appena sono usciti di nuovo sui marciapiedi ampi e ventilati di Via Veneto, Giulia è esplosa in un moto di entusiasmo incontenibile.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "appena",
