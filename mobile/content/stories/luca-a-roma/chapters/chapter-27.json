  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Mercoledì sera Luca ha visto Sofia vicino alla piazza.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "mercoledi",
            "sera",
            "luca",
            "avere",
            "vedere",
            "sofia",
            "vicino",
            "alla",
            "piazza"
          ]
        },
        {
          "id": "s02",
          "text": "È mercoledì sera, dopo il lavoro al caffè.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "mercoledi",
            "sera",
            "dopo",
            "il",
            "lavorare",
            "al",
            "caffe"
          ]
        },
        {
          "id": "s03",
          "text": "Sofia ha visto Luca e ha sorriso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sofia",
            "avere",
            "vedere",
            "luca",
            "e",
            "avere",
            "sorridere"
          ]
        },
        {
          "id": "s04",
          "text": "Bene. Parla. Ieri il messaggio è strano.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "bene",
            "parlare",
            "ieri",
            "il",
            "messaggio",
            "essere",
            "strano"
          ]
        },
        {
          "id": "s05",
          "text": "Luca ha iniziato a parlare della notizia difficile.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "iniziare",
            "a",
            "parlare",
            "della",
            "notizia",
            "difficile"
          ]
        },
        {
          "id": "s06",
          "text": "Il padrone forse vende il caffè. O cambia tutto.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "il",
            "padrone",
            "forse",
            "vendere",
            "il",
            "caffe",
            "o",
            "cambiare",
            "tutto"
          ]
        },
        {
          "id": "s07",
          "text": "Non ha deciso. Questa settimana è importante.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "avere",
            "decidere",
            "questo",
            "settimana",
            "essere",
            "importante"
          ]
        },
        {
          "id": "s08",
          "text": "Sofia ascoltava. Non ha detto niente.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sofia",
            "ascoltare",
            "non",
            "avere",
            "dire",
            "niente"
          ]
        },
        {
          "id": "s09",
          "text": "Luca ha detto tutto del caffè con calma.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "dire",
            "tutto",
            "del",
            "caffe",
            "con",
            "calma"
          ]
        },
        {
          "id": "s10",
          "text": "Poi hanno camminato un po’ nella strada.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "avere",
            "camminare",
            "un",
            "poco",
            "nella",
            "strada"
          ]
        },
        {
          "id": "s11",
          "text": "Parla di tutto: il caffè e il lavoro.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "parlare",
            "di",
            "tutto",
            "il",
            "caffe",
            "e",
            "il",
            "lavorare"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s12",
          "text": "Questa è una notizia difficile. Parla di più.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "questo",
            "essere",
            "una",
            "notizia",
            "difficile",
            "parlare",
            "di",
            "piu"
          ]
        },
        {
          "id": "s13",
          "text": "Ieri ci sono stati pochi clienti al caffè.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "ieri",
            "ci",
            "essere",
            "essere",
            "poco",
            "cliente",
            "al",
            "caffe"
          ]
        },
        {
          "id": "s14",
          "text": "I tavoli sono restati vuoti per molto tempo.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "i",
            "tavolo",
            "essere",
            "restare",
            "vuoto",
            "per",
            "molto",
            "tempo"
          ]
        },
        {
          "id": "s15",
          "text": "Io penso all’affitto e al lavoro ogni giorno.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "io",
            "pensare",
            "affitto",
            "e",
            "al",
            "lavorare",
            "ogni",
            "giorno"
          ]
        },
        {
          "id": "s16",
          "text": "Aspetta. Cosa sappiamo adesso?",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "aspettare",
            "cosa",
            "sapere",
            "adesso"
          ]
        },
        {
          "id": "s17",
          "text": "Sappiamo che i clienti sono pochi. Tu l’hai visto.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "sapere",
            "che",
            "i",
            "cliente",
            "essere",
            "poco",
            "tu",
            "avere",
            "vedere"
          ]
        },
        {
          "id": "s18",
          "text": "Non sappiamo se vende. Non ha deciso.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "sapere",
            "se",
            "vendere",
            "non",
            "avere",
            "decidere"
          ]
        },
        {
          "id": "s19",
          "text": "Luca ha guardato la strada e ha pensato.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "guardare",
            "la",
            "strada",
            "e",
            "avere",
            "pensare"
          ]
        },
        {
          "id": "s20",
          "text": "Hai ragione. Io ho paura, e la paura parla prima.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "avere",
            "ragione",
            "io",
            "avere",
            "paura",
            "e",
            "la",
            "paura",
            "parlare",
            "prima"
          ],
          "phrases": [
            {
              "surface": "Hai ragione",
              "literalEn": "you have reason",
              "naturalEn": "you’re right",
              "tokenStart": 0,
              "tokenEnd": 1
            }
          ]
        },
        {
          "id": "s21",
          "text": "La paura c’è. Ma non è un piano.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "la",
            "paura",
            "ce",
            "ma",
            "non",
            "essere",
            "un",
            "piano"
          ]
        },
        {
          "id": "s22",
          "text": "Al quartiere serve quel caffè.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "al",
            "quartiere",
            "servire",
            "quello",
            "caffe"
          ]
        },
        {
          "id": "s23",
          "text": "Il caffè del quartiere è importante per tutti.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "il",
            "caffe",
            "del",
            "quartiere",
            "essere",
            "importante",
            "per",
            "tutto"
          ]
        },
        {
          "id": "s24",
          "text": "La gente ci va da tanto tempo.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "la",
            "gente",
            "ci",
            "andare",
            "dare",
            "tanto",
            "tempo"
          ]
        },
        {
          "id": "s25",
          "text": "Sì. Ma adesso i soldi non sono abbastanza.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "si_yes",
            "ma",
            "adesso",
            "i",
            "soldi",
            "non",
            "essere",
            "abbastanza"
          ]
        },
        {
          "id": "s26",
          "text": "Pochi clienti non è la stessa cosa di vendere.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "poco",
            "cliente",
            "non",
            "essere",
            "la",
            "stesso",
            "cosa",
            "di",
            "vendere"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s27",
          "text": "È capire perché, e fare qualcosa prima.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "essere",
            "capire",
            "perche",
            "e",
            "fare",
            "qualcosa",
            "prima"
          ]
        },
        {
          "id": "s28",
          "text": "Giulia dice la stessa cosa. Dobbiamo fare un piano.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "giulia",
            "dire",
            "la",
            "stesso",
            "cosa",
            "dovere",
            "fare",
            "un",
            "piano"
          ]
        },
        {
          "id": "s29",
          "text": "Bene. Un piano piccolo è meglio di niente.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "bene",
            "un",
            "piano",
            "piccolo",
            "essere",
            "meglio",
            "di",
            "niente"
          ]
        },
        {
          "id": "s30",
          "text": "Che ne dici di parlare con la gente del quartiere?",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "che",
            "ne",
            "dire",
            "di",
            "parlare",
            "con",
            "la",
            "gente",
            "del",
            "quartiere"
          ],
          "phrases": [
            {
              "surface": "Che ne dici",
              "literalEn": "what of it do you say",
              "naturalEn": "what do you say",
              "tokenStart": 0,
              "tokenEnd": 2
            }
          ]
        },
        {
          "id": "s31",
          "text": "Possiamo. Ma io lavoro e non ho tanto tempo.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "potere",
            "ma",
            "io",
            "lavorare",
            "e",
            "non",
            "avere",
            "tanto",
            "tempo"
          ]
        },
        {
          "id": "s32",
          "text": "Hanno guardato un negozio e la strada del quartiere vicino.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "guardare",
            "un",
            "negozio",
            "e",
            "la",
            "strada",
            "del",
            "quartiere",
            "vicino"
          ]
        },
        {
          "id": "s33",
          "text": "La nonna conosce tante persone, vecchie e giovani.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "la",
            "nonna",
            "conoscere",
            "tanto",
            "persona",
            "vecchio",
            "e",
            "giovane"
          ]
        },
        {
          "id": "s34",
          "text": "Andiamo da Nonna Rosa. Magari lei ha un’idea.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "andare",
            "dare",
            "nonna",
            "rosa",
            "magari",
            "lei",
            "avere",
            "idea"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s35",
          "text": "Va bene. Venerdì andiamo da lei, dopo il lavoro.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "andare",
            "bene",
            "venerdi",
            "andare",
            "dare",
            "lei",
            "dopo",
            "il",
            "lavorare"
          ],
          "phrases": [
            {
              "surface": "Va bene",
              "literalEn": "it goes well",
              "naturalEn": "okay",
              "tokenStart": 0,
              "tokenEnd": 1
            }
          ]
        },
        {
          "id": "s36",
          "text": "Luca ha detto di sì con calma.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "dire",
            "di",
            "si_yes",
            "con",
            "calma"
          ]
        },
        {
          "id": "s37",
          "text": "Sofia ha scritto le domande per la nonna.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sofia",
            "avere",
            "scrivere",
            "le",
            "domanda",
            "per",
            "la",
            "nonna"
          ]
        },
        {
          "id": "s38",
          "text": "Luca ha pensato al lavoro di giovedì, al venerdì e alla nonna.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "pensare",
            "al",
            "lavorare",
            "di",
            "giovedi",
            "al",
            "venerdi",
            "e",
            "alla",
            "nonna"
          ]
        },
        {
          "id": "s39",
          "text": "Giovedì io lavoro. Tu prepari le domande.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "giovedi",
            "io",
            "lavorare",
            "tu",
            "preparare",
            "le",
            "domanda"
          ]
        },
        {
          "id": "s40",
          "text": "E io parlo con Giulia. Magari viene anche Marco.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "e",
            "io",
            "parlare",
            "con",
            "giulia",
            "magari",
            "venire",
            "anche",
            "marco"
          ]
        },
        {
          "id": "s41",
          "text": "Non risolviamo tutto questa sera. Ma non aspettiamo solo.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "risolvere",
            "tutto",
            "questo",
            "sera",
            "ma",
            "non",
            "aspettare",
            "solo"
          ]
        },
        {
          "id": "s42",
          "text": "Grazie. Mi serve la tua idea, non solo ascoltare.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "grazie",
            "mi",
            "servire",
            "la",
            "tuo",
            "idea",
            "non",
            "solo",
            "ascoltare"
          ]
        },
        {
          "id": "s43",
          "text": "La notizia del caffè è ancora difficile per Luca.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "notizia",
            "del",
            "caffe",
            "essere",
            "ancora",
            "difficile",
            "per",
            "luca"
          ]
        },
        {
          "id": "s44",
          "text": "Ma ora hanno Nonna Rosa, un piano piccolo e un primo passo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ma",
            "ora",
            "avere",
            "nonna",
            "rosa",
            "un",
            "piano",
            "piccolo",
            "e",
            "un",
            "primo",
            "passare"
          ]
        }
      ]
