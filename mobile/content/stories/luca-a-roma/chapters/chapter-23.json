        },
        {
          "id": "s08",
          "text": "Va bene.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "essere",
            "bene"
          ]
        },
        {
          "id": "s09",
          "text": "Luca porta acqua e caffè ai tavoli.",
