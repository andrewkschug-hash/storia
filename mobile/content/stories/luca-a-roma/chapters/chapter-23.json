          "kind": "dialogue",
          "lemmas": [
            "buongiorno",
            "giulia",
            "oggi",
            "ce",
            "molto",
            "lavoro"
          ]
        },
        {
          "id": "s05",
          "text": "Sì, molti clienti oggi. Aiutami, Luca.",
