          "lemmas": [
            "luca",
            "arrivare",
            "al",
            "lavoro",
            "e",
            "vedere",
            "molto",
            "cliente"
          ]
        },
        {
          "id": "s03",
          "text": "Giulia prepara i tavoli presto.",
