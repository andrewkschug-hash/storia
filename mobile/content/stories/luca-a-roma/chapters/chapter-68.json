            "e",
            "riflessivo"
          ],
          "speakerId": "padrone",
          "kind": "dialogue"
        },
        {
          "id": "s30",
          "text": "«Dovrei delegare la selezione dei chicchi e i parametri di tostatura alle decisioni del comitato aziendale del consorzio?»",
          "lemmas": [
