    {
      "id": "p13",
      "sentences": [
        {
          "id": "s50",
          "text": "Rimasto solo davanti alla vetrata mentre la notte scendeva dolcemente sui tetti di Roma, Luca ha respirato profondamente l'aria della stanza.",
          "lemmas": [
