            "prestazione"
          ],
          "speakerId": null,
          "kind": "narration"
        },
        {
          "id": "s04",
          "text": "Il quartiere ormai lo considerava uno di famiglia, e il laboratorio condiviso era diventato un punto di riferimento per l'intero rione.",
          "lemmas": [
            "il",
            "quartiere",
