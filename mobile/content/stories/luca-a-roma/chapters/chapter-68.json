          ],
          "speakerId": null,
          "kind": "narration"
        },
        {
          "id": "s52",
          "text": "Aveva scelto consapevolmente la strada dell'autonomia, della qualità senza compromessi e del lavoro fatto con cura a misura d'uomo.",
          "lemmas": [
