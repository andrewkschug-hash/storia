    {
      "id": "p3",
      "sentences": [
        {
          "id": "s09",
          "text": "«Signor Bruno, che gioia vederla qui!» esclamò Luca uscendo da dietro al bancone per accoglierlo con una stretta di mano calorosa e sincera.",
          "lemmas": [
