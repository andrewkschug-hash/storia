          "kind": "narration"
        }
      ],
      "order": 1
    },
    {
      "id": "p2",
      "sentences": [
        {
          "id": "s05",
          "text": "Le prime due settimane del mese misero subito in evidenza una realtà finanziaria impegnativa e preoccupante.",
          "lemmas": [
