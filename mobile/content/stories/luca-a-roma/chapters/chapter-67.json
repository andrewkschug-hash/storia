            "del",
            "mese",
            "successivo"
          ],
          "speakerId": null,
          "kind": "narration"
        },
        {
          "id": "s35",
          "text": "Quando l'ultimo ospite uscì salutando calorosamente, i tre amici si guardarono attorno nel laboratorio disordinato ma colmo di energia positiva.",
          "lemmas": [
            "quando",
