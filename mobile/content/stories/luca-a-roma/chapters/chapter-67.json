    {
      "id": "p10",
      "sentences": [
        {
          "id": "s37",
          "text": "«Questa non è soltanto una soluzione temporanea per pagare le bollette dell'inverno,» disse Marco versandosi una tazza di caffè avanzato e sedendosi su uno sgabello.",
          "lemmas": [
            "questo",
            "non",
