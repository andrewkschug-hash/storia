    {
      "id": "p5",
      "sentences": [
        {
          "id": "s17",
          "text": "L'idea prese forma rapidamente nei giorni successivi con un entusiasmo contagioso che scacciò ogni traccia di scoraggiamento dal laboratorio.",
          "lemmas": [
