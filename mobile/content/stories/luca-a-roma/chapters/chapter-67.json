            "continuamente",
            "in",
            "risposta",
            "alle",
            "sfida",
            "del",
            "tempo"
          ],
          "speakerId": null,
          "kind": "narration"
        }
      ],
      "order": 11
    },
    {
      "id": "p12",
      "sentences": [
        {
          "id": "s45",
          "text": "Nelle settimane che precedettero il Natale, le serate del sabato diventarono un appuntamento fisso e desiderato per decine di residenti del quartiere.",
          "lemmas": [
            "in",
            "settimana",
            "che",
            "precedere",
