    {
      "id": "p11",
      "sentences": [
        {
          "id": "s41",
          "text": "Luca ripensò con lucidità a quanto era accaduto e comprese che le difficoltà operative non erano incidenti di percorso da temere, ma lezioni preziose per rafforzare la struttura del progetto.",
          "lemmas": [
            "luca",
            "ripensare",
            "con",
            "lucidita",
            "a",
            "quanto",
            "essere",
            "accadere",
            "e",
