            "energia",
            "positivo"
          ],
          "speakerId": null,
          "kind": "narration"
        },
        {
          "id": "s36",
          "text": "Il bilancio economico della sola serata aveva coperto per intero le spese di riscaldamento ed elettricità dell'intera settimana.",
          "lemmas": [
