            "a",
            "venire"
          ],
          "speakerId": null,
          "kind": "narration"
        },
        {
          "id": "s48",
          "text": "Luca sentiva che la cooperazione tra i loro tre mestieri diversi era diventata la loro più grande forza competitiva e umana.",
          "lemmas": [
            "luca",
            "sentire",
            "che",
            "la",
