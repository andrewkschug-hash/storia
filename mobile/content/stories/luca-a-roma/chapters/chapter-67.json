            "autunno"
          ],
          "speakerId": "luca",
          "kind": "dialogue"
        },
        {
          "id": "s11",
          "text": "Claudia ascoltò con attenzione, osservando i numeri con sguardo calmo e riflessivo prima di rispondere con decisione serena.",
          "lemmas": [
            "claudia",
            "ascoltare",
