            "silenzioso"
          ],
          "speakerId": null,
          "kind": "narration"
        },
        {
          "id": "s04",
          "text": "Per Luca, Claudia e Marco, quella svolta stagionale rappresentava la prima vera prova di resistenza economica per il loro laboratorio condiviso.",
          "lemmas": [
            "per",
            "luca",
