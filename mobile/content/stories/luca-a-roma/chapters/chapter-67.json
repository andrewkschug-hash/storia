          ],
          "speakerId": null,
          "kind": "narration"
        },
        {
          "id": "s32",
          "text": "«Non avevo mai capito che il caffè potesse avere così tante sfumature diverse,» commentò una signora anziana con gli occhi pieni di meraviglia sincera.",
          "lemmas": [
