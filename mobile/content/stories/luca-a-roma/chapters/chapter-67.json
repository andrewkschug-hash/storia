    {
      "id": "p8",
      "sentences": [
        {
          "id": "s29",
          "text": "Quando arrivò il momento dell'assaggio guidato, Luca non usò parole difficili o formule tecniche da manuale, ma parlò con semplicità e passione sincera.",
          "lemmas": [
            "quando",
            "arrivare",
