            "relazione",
            "umano",
            "duraturo",
            "capace",
            "di",
            "resistere",
            "al",
            "gelo",
            "e",
            "al",
            "calo",
            "delle",
            "vendita"
          ],
          "speakerId": null,
          "kind": "narration"
        },
        {
          "id": "s44",
          "text": "Spazio Monti non era più un semplice negozio al dettaglio, ma un laboratorio vivo che sapeva reinventarsi continuamente in risposta alle sfide del tempo.",
          "lemmas": [
            "spazio",
