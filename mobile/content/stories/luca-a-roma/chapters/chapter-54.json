  "events": [
    {
      "id": "ev-54-final-service",
      "summary": "San Lorenzo gathers for the final evening service at Bruno's historic trattoria, culminating in a quiet, bittersweet farewell.",
      "characterIds": [
        "luca",
        "padrone",
        "sofia",
        "giulia"
      ],
      "locationIds": [
        "lavoro-caffe",
        "quartiere",
        "strada"
      ],
      "rememberedFacts": [
        "On Saturday evening, the neighborhood gathers for the final service at Bruno's historic venue in San Lorenzo",
        "Regular customers, Marco, Sofia, and Giulia all come together without melodrama to honor forty years of neighborhood life",
        "Luca works alongside Bruno behind the counter, observing the unhurried rituals that shaped his own professional habits",
        "After the last customer departs and the lights are turned off, Bruno gives Luca his worn brass coffee tamper",
        "Bruno quietly passes the torch with simple, unforgettable restraint: 'Adesso tocca a te'"
      ]
    }
  ],
