      "order": 3,
      "sentences": [
        {
          "id": "s13",
          "text": "Mentre preparava decine di tazzine consecutive senza sosta, Luca osservava ogni singolo angolo della stanza con una consapevolezza nuova, limpida e pungente.",
          "speakerId": null,
          "kind": "narration",
