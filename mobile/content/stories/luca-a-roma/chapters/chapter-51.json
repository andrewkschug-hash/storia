          ]
        },
        {
          "id": "s13",
          "text": "Dietro la splendida facciata di design con bancone in legno massello e lampade industriali, la postazione operativa mostrava lacune gravissime.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
