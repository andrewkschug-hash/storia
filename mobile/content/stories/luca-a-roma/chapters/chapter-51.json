          ]
        },
        {
          "id": "s18",
          "text": "Luca ha preso un respiro profondo, ha guardato negli occhi Claudia e ha deciso che lusingarli con complimenti vuoti sarebbe stato un errore imperdonabile.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
