      "order": 3,
      "sentences": [
        {
          "id": "s12",
          "text": "Matteo ha tentato di sdrammatizzare con una risata conciliante, ma Luca non si è lasciato impressionare e ha iniziato a osservare con occhio clinico e professionale la zona del bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
