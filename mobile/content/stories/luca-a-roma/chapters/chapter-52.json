          ]
        },
        {
          "id": "s09",
          "text": "«Inoltre abbiamo un accordo con un marchio storico di torrefazione, che coprirà i ventimila euro per rifare il bancone e installerà una macchina a tre gruppi di ultima generazione con bilance integrate.»",
          "speakerId": null,
          "kind": "dialogue",
          "lemmas": [
            "inoltre",
            "avere",
            "un",
