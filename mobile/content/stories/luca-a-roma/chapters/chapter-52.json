    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s18",
          "text": "Nella sala è sceso un silenzio denso e carico di gravità, mentre le tre diverse visioni sul futuro dello spazio culturale si confrontavano senza finzioni.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "nella",
            "sala",
