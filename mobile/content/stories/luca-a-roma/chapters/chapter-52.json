      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Lunedì mattina alle dieci in punto, Luca è tornato allo Spazio Monti trovando la via e la sala principale insolitamente tranquille, prive della folla vivace del fine settimana.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lunedi",
