            "tranquillo",
            "privo",
            "della",
            "folla",
            "vivace",
            "del",
            "fine",
            "settimana"
          ]
        },
        {
          "id": "s02",
          "text": "Fuori dai vicoli i furgoni dei fornitori scaricavano cassette di verdura fresca e casse di vino per i ristoranti del rione, mentre l'aria fredda di novembre pizzicava la pelle.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "fuori",
