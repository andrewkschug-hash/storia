            "vetrata",
            "affacciarsi",
            "sul",
            "cortile",
            "interno"
          ]
        },
        {
          "id": "s04",
          "text": "Il tavolo era coperto da faldoni contabili, preventivi edili, schede tecniche e copie di una proposta contrattuale formale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
