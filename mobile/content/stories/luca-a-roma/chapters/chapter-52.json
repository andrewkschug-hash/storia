            "una",
            "proposta",
            "contrattuale",
            "formale"
          ]
        },
        {
          "id": "s05",
          "text": "Claudia ha aperto subito la riunione senza convenevoli, posando gli occhiali da lettura sul tavolo e indicando con la penna una serie di cifre evidenziate in giallo su un foglio di calcolo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "claudia",
            "avere",
            "aperto",
            "subito",
            "la",
            "riunione",
