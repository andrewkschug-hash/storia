    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s07",
          "text": "Matteo ha preso la parola con il suo consueto entusiasmo cordiale, porgendo a Luca una cartellina con il documento contrattuale stampato su carta intestata.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "matteo",
