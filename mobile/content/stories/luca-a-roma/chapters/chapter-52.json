    {
      "id": "ev-52-contract-dilemma",
      "summary": "Luca reviews the formal partnership contract at Spazio Monti and faces a difficult dilemma between financial security and creative autonomy.",
      "characterIds": [
        "luca"
      ],
      "locationIds": [
        "quartiere",
        "centro",
        "strada"
      ],
      "rememberedFacts": [
        "On Monday morning, Matteo and Claudia present Luca with a formal contract at Spazio & Caffè Monti",
        "The offer includes a strong salary, fully paid counter renovation, and a top-tier multi-boiler espresso machine",
        "The sponsor requires a three-year exclusivity clause using their standard blend with zero room for micro-lot single origins",
        "Claudia defends the financial solvency of the venue while Matteo urges compromise to launch the project",
        "Luca asks for forty-eight hours to consider whether he can accept security at the cost of creative control"
      ]
    }
  ],
