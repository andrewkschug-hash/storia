        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s12",
          "text": "Prese un cucchiaio di liquido, lo aspirò con forza per nebulizzarlo sul palato e rimase in silenzio per diversi secondi, analizzando la struttura sensoriale con la fronte aggrottata.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
