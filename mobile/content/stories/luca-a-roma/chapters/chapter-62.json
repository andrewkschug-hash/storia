    },
    {
      "id": "p7",
      "order": 7,
      "sentences": [
        {
          "id": "s23",
          "text": "Quelle parole aprirono una nuova prospettiva nella mente di Luca, che fino a quel momento aveva vissuto ogni deviazione dai parametri ideali come un fallimento personale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
