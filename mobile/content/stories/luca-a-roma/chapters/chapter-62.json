        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s05",
          "text": "Luca aprì il sacchetto e versò una manciata di chicchi bruni su un piattino di ceramica bianca per esaminarne attentamente l'aspetto esteriore.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
