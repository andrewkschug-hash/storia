            "o",
            "contrariato",
            "dal",
            "giudizio",
            "critico"
          ]
        },
        {
          "id": "s16",
          "text": "«Hai perfettamente ragione, Luca,» disse appoggiando il cucchiaio sul piattino.",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "avere",
