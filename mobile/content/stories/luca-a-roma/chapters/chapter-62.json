      "order": 9,
      "sentences": [
        {
          "id": "s29",
          "text": "Servì il caffè estratto in due tazzine di ceramica create da Claudia e ne porse una a Marco con un gesto d'invito.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
