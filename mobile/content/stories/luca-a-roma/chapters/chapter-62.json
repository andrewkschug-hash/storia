      "order": 10,
      "sentences": [
        {
          "id": "s32",
          "text": "Anche Luca assaggiò la sua tazza e sentì un senso profondo di liberazione professionale sciogliere la tensione che portava dentro da giorni.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
