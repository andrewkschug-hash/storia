            "provocare",
            "dalla",
            "pioggia",
            "continuo",
            "della",
            "notte",
            "scorso"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s09",
          "text": "Luca preparò il tavolo di castagno per un assaggio tecnico alla brasiliana, posizionando tre ciotole di vetro spesso, due cucchiai d'argento specifici per il cupping professionale e un grande bollitore d'acqua purificata a novantatré gradi centigradi esatti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "preparare",
            "il",
            "tavolo",
            "di",
            "castagno",
            "per",
            "un",
