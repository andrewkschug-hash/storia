          ]
        }
      ]
    },
    {
      "id": "p6",
      "order": 6,
      "sentences": [
        {
          "id": "s19",
          "text": "Luca guardò Marco con interesse, incuriosito dal modo in cui il falegname affrontava le imperfezioni del materiale senza perdersi in recriminazioni inutili.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
