            "sensoriale",
            "con",
            "la",
            "fronte",
            "aggrottare"
          ]
        },
        {
          "id": "s13",
          "text": "«L'acidità è molto pronunciata, quasi tagliente,» diagnosticò Luca con franchezza professionale.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "acidita",
            "essere",
