            "spaccare",
            "e",
            "giuntura",
            "rovinare"
          ]
        },
        {
          "id": "s22",
          "text": "Il mestiere consiste nell'ascoltare il limite della materia e trovare il modo giusto per valorizzarla così com'è.»",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
