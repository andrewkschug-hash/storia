            "sul",
            "piattino"
          ]
        },
        {
          "id": "s17",
          "text": "«Nel laboratorio del mio amico volevamo interrompere la tostatura per paura di bruciare la parte esterna del chicco, e così abbiamo ottenuto un profilo più acido del previsto.",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "nel",
            "laboratorio",
            "del",
            "mio",
            "amico",
            "volere",
            "interrompere",
            "la",
            "tostatura",
            "per",
            "paura",
            "di",
            "bruciare",
            "la",
            "parte",
            "esterno",
            "del",
            "chicco",
            "e",
            "cosi",
            "avere",
            "ottenere",
            "un",
            "profilo",
            "piu",
            "acido",
            "del",
            "prevedere"
          ]
        },
        {
          "id": "s18",
          "text": "Ma la materia prima naturale non risponde mai a una formula matematica perfetta: è viva, mutevole e profondamente legata all'ambiente in cui viene lavorata.»",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
