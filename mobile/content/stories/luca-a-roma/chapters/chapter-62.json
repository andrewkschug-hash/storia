            "del",
            "chicco"
          ]
        }
      ]
    },
    {
      "id": "p5",
      "order": 5,
      "sentences": [
        {
          "id": "s15",
          "text": "Marco assaggiò a sua volta con il secondo cucchiaio, annuendo con calma serena invece di mostrarsi deluso o contrariato dal giudizio critico.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "marco",
            "assaggiare",
            "a",
            "suo",
            "volta",
