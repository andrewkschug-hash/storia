            "una",
            "curiosita",
            "vivo",
            "e",
            "insolito"
          ]
        },
        {
          "id": "s03",
          "text": "Appoggiò il sacco sul bancone accanto alla bilancia digitale e guardò Luca con un sorriso complice.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "appoggiare",
