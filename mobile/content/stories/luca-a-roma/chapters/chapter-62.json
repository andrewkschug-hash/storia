            "di",
            "uno",
            "sviluppo",
            "termico",
            "non",
            "completamente",
            "omogeneo"
          ]
        },
        {
          "id": "s07",
          "text": "«Che varietà è?» domandò Luca, annusando la fragranza secca che sprigionava note di mandorla tostata e una punta aspra di mela verde.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "che",
            "varieta",
            "essere",
            "domandare",
            "luca",
            "annusare",
            "la",
            "fragranza",
