            "con",
            "un",
            "tono",
            "piu",
            "disteso",
            "e",
            "misurato"
          ]
        },
        {
          "id": "s23",
          "text": "«Il tuo errore principale non riguarda la qualità del prodotto: riguarda l'illusione romantica con cui hai iniziato questa avventura.",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "il",
            "tuo",
            "errore",
            "principale",
            "non",
            "riguardare",
            "la",
            "qualita",
