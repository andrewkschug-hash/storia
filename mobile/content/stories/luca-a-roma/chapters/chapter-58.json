            "soltanto",
            "per",
            "bere",
            "un",
            "espresso",
            "decente",
            "lontano",
            "da",
            "tuo",
            "esperimento"
          ]
        },
        {
          "id": "s07",
          "text": "Luca sorrise, si sedette sull'ultimo sgabello in fondo al bancone e tirò fuori dalla borsa il quaderno dei conti con la copertina nera.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
