    {
      "id": "p5",
      "order": 5,
      "sentences": [
        {
          "id": "s15",
          "text": "Luca sospirò a fondo e raccontò la verità senza nascondere l'inquietudine economica che lo accompagnava da giorni.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
