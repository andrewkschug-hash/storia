          ]
        }
      ]
    },
    {
      "id": "p9",
      "order": 9,
      "sentences": [
        {
          "id": "s30",
          "text": "«Quindi cosa dovrei fare concretamente secondo te?» domandò Luca, cercando una direzione pratica e operativa.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
