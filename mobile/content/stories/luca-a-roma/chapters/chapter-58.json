          ]
        }
      ]
    },
    {
      "id": "p8",
      "order": 8,
      "sentences": [
        {
          "id": "s26",
          "text": "Luca ascoltava in silenzio, assorbendo ogni singola frase con un misto di umiltà e rinnovata concentrazione.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
