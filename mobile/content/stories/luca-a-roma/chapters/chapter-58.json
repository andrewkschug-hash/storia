        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s09",
          "text": "Bruno preparò due caffè senza alcuna fretta, ne spinse uno verso Luca e aprì il registro contabile esattamente sulla pagina dei totali di ottobre.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruno",
            "preparare",
            "due",
            "caffe",
            "senza",
            "alcuno",
            "fretta",
            "ne",
