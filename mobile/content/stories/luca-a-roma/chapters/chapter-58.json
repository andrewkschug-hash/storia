    {
      "id": "p7",
      "order": 7,
      "sentences": [
        {
          "id": "s22",
          "text": "Fece scendere una goccia d'acqua calda nella propria tazzina e riprese a parlare con un tono più disteso e misurato:",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
