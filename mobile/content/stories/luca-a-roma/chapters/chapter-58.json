            "luca",
            "presa",
            "autobus",
            "fino",
            "a",
            "san",
            "lorenzo"
          ]
        },
        {
          "id": "s02",
          "text": "Il quartiere universitario appariva vivace e rumoroso sotto un cielo autunnale che si andava schiarendo dopo la pioggia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
