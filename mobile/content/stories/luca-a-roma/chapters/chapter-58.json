            "con",
            "claudia"
          ]
        },
        {
          "id": "s11",
          "text": "Non disse una parola per due lunghi minuti, limitandosi a tamburellare con le dita nodose sul bordo di zinco del bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
