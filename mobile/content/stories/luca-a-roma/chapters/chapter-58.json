            "esattamente",
            "sulla",
            "pagina",
            "dei",
            "totale",
            "di",
            "ottobre"
          ]
        },
        {
          "id": "s10",
          "text": "I suoi occhi esperti scorsero rapidamente le entrate lorde, i costi della materia prima, le bollette dell'energia elettrica e la quota d'affitto condivisa con Claudia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
