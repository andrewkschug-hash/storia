            "umilta",
            "e",
            "rinnovare",
            "concentrazione"
          ]
        },
        {
          "id": "s27",
          "text": "«La mattina alle otto la gente compra tempo e velocità,» spiegò Bruno, tracciando una linea netta con il dito sul bancone.",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "la",
            "mattina",
            "alle",
            "otto",
            "la",
            "gente",
            "comprare",
            "tempo",
