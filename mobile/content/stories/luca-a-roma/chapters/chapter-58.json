            "distruggere",
            "la",
            "nostro",
            "identita",
            "artigianale"
          ]
        }
      ]
    },
    {
      "id": "p6",
      "order": 6,
      "sentences": [
        {
          "id": "s19",
          "text": "Bruno scosse la testa con vigore e batté il palmo della mano sul tavolo: «Claudia ha perfettamente ragione, ragazzo mio.",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "bruno",
            "scuotere",
            "la",
            "testa",
            "con",
