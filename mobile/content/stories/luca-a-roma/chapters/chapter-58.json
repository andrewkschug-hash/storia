            "praticamente",
            "deserto"
          ]
        },
        {
          "id": "s17",
          "text": "abbiamo le macchine accese, la luce e il riscaldamento, ma entrano appena due o tre persone in tutta la fascia pomeridiana.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "avere",
            "le",
            "macchina",
            "accendere",
            "la",
            "luce",
            "e",
