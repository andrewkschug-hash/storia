            "in",
            "quaranta",
            "di",
            "mestiere"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s05",
          "text": "«Guarda chi si rivede da queste parti,» disse Bruno, sollevando lo sguardo con un mezzo sorriso e appoggiando lo strofinaccio sul piano di lavoro.",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "guardare",
            "chi",
            "si",
            "rivedere",
            "da",
            "questo",
            "partire",
            "dire",
            "bruno",
            "sollevare",
            "lo",
            "sguardo",
            "con",
            "un",
            "mezzo",
            "sorriso",
            "e",
            "appoggiare",
            "lo",
            "strofinaccio",
            "sul",
            "piano",
            "di",
            "lavoro"
          ]
        },
        {
          "id": "s06",
          "text": "«Sei venuto a controllare se la tua vecchia postazione è ancora libera o sei passato soltanto per bere un espresso decente lontano dai tuoi esperimenti?»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "sei",
            "venire",
            "a",
            "controllare",
            "se",
            "la",
            "tuo",
            "vecchio",
            "postazione",
            "essere",
            "ancora",
            "libero",
            "o",
