            "ne",
            "essere",
            "diecimila",
            "a",
            "roma"
          ]
        },
        {
          "id": "s21",
          "text": "E un bar qualunque a Monti muore dopo sei mesi perché non può competere sui prezzi con i grandi distributori.»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
