            "ma",
            "come",
            "una",
            "persona",
            "capace",
            "di",
            "cogliere",
            "il",
            "pensiero",
            "e",
            "le",
            "paura",
            "piu",
            "profondo"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s15",
          "text": "«E tu cosa hai intenzione di fare adesso, Luca?» ha chiesto Sofia con tono calmo dopo un lungo momento di silenzio.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "e",
            "tu",
            "cosa",
            "avere",
            "intenzione",
            "di",
            "fare",
            "adesso",
            "luca",
            "avere",
            "chiedere",
            "sofia",
            "con",
            "tono",
            "calmo",
            "dopo",
            "un",
            "lungo",
            "momento",
            "di",
            "silenzio"
          ]
        },
        {
          "id": "s16",
          "text": "«Immagino che cercherò un altro lavoro come barista in un locale del centro» ha risposto Luca, guardando la superficie del proprio bicchiere.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "immaginare",
            "che",
            "cercare",
            "un",
            "altro",
            "lavoro",
            "come",
            "barista",
            "in",
            "un",
            "locale",
            "di",
            "centro",
            "avere",
            "rispondere",
            "luca",
            "guardare",
            "la",
            "superficie",
            "di",
            "proprio",
            "bicchiere"
          ]
        },
        {
          "id": "s17",
          "text": "«Con l'esperienza che ho accumulato da Bruno e le sue ottime lettere di referenze, penso che potrò trovare un nuovo posto nel giro di poche settimane.»",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "con",
            "esperienza",
            "che",
            "avere",
            "accumulare",
            "da",
            "bruno",
            "e",
            "le",
            "suo",
            "ottimo",
            "lettera",
            "di",
            "referenza",
            "pensare",
            "che",
            "potere",
            "trovare",
            "un",
            "nuovo",
            "posto",
            "in",
            "giro",
            "di",
            "poco",
            "settimana"
          ]
        },
        {
          "id": "s18",
          "text": "Sofia ha bevuto un sorso di chinotto e lo ha fissato con uno sguardo penetrante ma privo di qualsiasi giudizio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sofia",
            "avere",
            "bere",
            "un",
            "sorso",
            "di",
            "chinotto",
            "e",
            "il",
            "avere",
            "fissare",
            "con",
            "un",
            "sguardo",
            "penetrante",
            "ma",
            "privo",
            "di",
            "qualsiasi",
            "giudizio"
          ]
        },
        {
          "id": "s19",
          "text": "«Non dubito che tu possa trovare un impiego facilmente, Luca. Sei bravo nel tuo lavoro, sei instancabile e sei affidabile.»",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "dubitare",
            "che",
            "tu",
            "potere",
            "trovare",
            "un",
            "impiego",
            "facilmente",
            "luca",
            "essere",
            "bravo",
            "in",
            "suo",
            "lavoro",
            "essere",
            "instancabile",
            "e",
            "essere",
            "affidabile"
          ]
        },
        {
          "id": "s20",
          "text": "«Ma credi davvero che la risposta giusta per il tuo futuro sia semplicemente passare da un bancone all'altro?»",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "ma",
            "credere",
            "davvero",
            "che",
            "la",
            "risposta",
            "giusto",
            "per",
            "il",
            "suo",
            "futuro",
            "essere",
            "semplicemente",
            "passare",
            "da",
            "un",
            "bancone",
            "altro"
          ]
        },
        {
          "id": "s21",
          "text": "«Cosa intendi dire esattamente?» ha domandato Luca, sorpreso da quella domanda così diretta e penetrante.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "cosa",
            "intendere",
            "dire",
            "esattamente",
            "avere",
            "domandare",
            "luca",
            "sorpreso",
            "da",
            "quello",
            "domanda",
            "cosi",
            "diretto",
            "e",
            "penetrante"
          ]
        },
        {
          "id": "s22",
          "text": "«Mi sembra che tu abbia paura di perdere il bar di Bruno perché era il tuo rifugio sicuro, non perché fare il barista dipendente sia la tua vera ambizione di vita.»",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "me",
            "sembrare",
            "che",
            "tu",
            "avere",
            "paura",
            "di",
            "perdere",
            "il",
            "bar",
            "di",
            "bruno",
            "perche",
            "essere",
            "il",
            "suo",
            "rifugio",
            "sicuro",
            "non",
            "perche",
            "fare",
            "il",
            "barista",
            "dipendente",
            "essere",
            "la",
            "suo",
            "vero",
            "ambizione",
            "di",
            "vita"
          ]
        },
        {
          "id": "s23",
          "text": "«Non penso che il tuo percorso a Roma debba ridursi a versare caffè per altri padroni senza avere una visione chiara di quello che desideri costruire con le tue mani.»",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "non",
