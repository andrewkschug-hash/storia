            "da",
            "bruno",
            "perche",
            "dovere",
            "pagare",
            "affitto",
            "essere",
            "rimanere",
            "li",
            "perche",
            "si",
            "sentire",
            "protetto",
            "e",
            "stimare"
          ]
        },
        {
          "id": "s27",
          "text": "Tuttavia, non si era mai fermato a domandarsi quale fosse il suo vero sogno professionale ed esistenziale a Roma.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "tuttavia",
            "non",
            "si",
            "essere",
            "mai",
            "fermare",
            "a",
            "domandare",
            "quale",
            "essere",
            "il",
            "suo",
            "vero",
            "sogno",
            "professionale",
            "e",
            "esistenziale",
            "a",
            "roma"
          ]
        },
        {
          "id": "s28",
          "text": "«Hai ragione, Sofia» ha ammesso Luca con un sospiro pesante, sentendo crollare una parte rassicurante delle sue certezze.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "avere",
            "ragione",
            "sofia",
            "avere",
            "ammettere",
            "luca",
            "con",
            "un",
            "sospiro",
            "pesante",
            "sentire",
            "crollare",
            "una",
            "parte",
            "rassicurante",
            "di",
            "suo",
            "certezza"
          ]
        },
        {
          "id": "s29",
          "text": "«Ho sempre pensato a come rimanere a Roma giorno per giorno, ma non mi sono mai chiesto quale vita voglio davvero costruire qui con le mie forze e con la mia testa.»",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "avere",
            "sempre",
            "pensare",
            "a",
            "come",
            "rimanere",
            "a",
