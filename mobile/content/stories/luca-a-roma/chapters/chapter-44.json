  "events": [
    {
      "id": "ev-44-monti-meeting",
      "summary": "Luca meets Sofia in Rione Monti to share the news about Bruno's trattoria being put up for sale.",
      "characterIds": [
        "luca",
        "sofia"
      ],
      "locationIds": [
        "quartiere"
      ],
      "rememberedFacts": [
        "Luca and Sofia meet at Piazza della Madonna dei Monti on Saturday evening",
        "Luca explains Bruno's decision to sell the business by May and Giulia's pragmatic reaction",
        "Sofia listens carefully and observes Luca's inner anxiety about his future"
      ]
    },
    {
      "id": "ev-44-sofia-challenge",
      "summary": "Sofia challenges Luca to distinguish between merely surviving in Rome and actively deciding what life he wants to build.",
      "characterIds": [
        "luca",
        "sofia"
      ],
      "locationIds": [
        "quartiere",
        "strada"
      ],
      "rememberedFacts": [
        "Sofia questions whether simply finding another barista job is what Luca actually wants",
        "Luca realizes he has been drifting safely rather than making active choices about his life",
        "Sofia encourages Luca to treat the remaining seven months as an opportunity for transformation"
      ]
    }
  ],
  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Verso le sette di sera, Luca è arrivato a piedi nel rione Monti attraverso i vicoli stretti e acciottolati di via dei Serpenti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "verso",
            "le",
            "sette",
            "di",
            "sera",
            "luca",
            "essere",
            "arrivare",
            "a",
            "piede",
            "in",
            "rione",
            "monti",
            "attraverso",
            "il",
            "vicolo",
            "stretto",
            "e",
            "acciottolato",
            "di",
            "via",
            "di",
            "serpente"
          ]
        },
        {
          "id": "s02",
          "text": "I palazzi color ocra erano illuminati dalle lanterne calde della sera, mentre il profumo di caldarroste si diffondeva nell'aria di ottobre.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "palazzo",
            "colore",
            "ocra",
            "essere",
            "illuminare",
            "da",
            "lanterna",
