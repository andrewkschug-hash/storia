            "padrone",
            "senza",
            "avere",
            "una",
            "visione",
            "chiaro",
            "di",
            "quello",
            "che",
            "desiderare",
            "costruire",
            "con",
            "le",
            "suo",
            "mano"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s24",
          "text": "Le parole di Sofia hanno colpito Luca con una precisione chirurgica, illuminando una verità che non aveva mai avuto il coraggio di ammettere apertamente a se stesso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "le",
            "parola",
            "di",
            "sofia",
            "avere",
            "colpire",
            "luca",
            "con",
            "una",
            "precisione",
            "chirurgico",
            "illuminare",
            "una",
            "verita",
            "che",
            "non",
            "avere",
            "mai",
            "avere",
            "il",
            "coraggio",
            "di",
            "ammettere",
            "apertamente",
            "a",
            "se",
            "stesso"
          ]
        },
        {
          "id": "s25",
          "text": "In quel momento ha compreso la differenza fondamentale tra il semplice sopravvivere a Roma e lo scegliere consapevolmente la propria strada.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "in",
            "quello",
            "momento",
            "avere",
            "comprendere",
            "la",
            "differenza",
            "fondamentale",
            "tra",
            "il",
            "semplice",
            "sopravvivere",
            "a",
            "roma",
            "e",
            "il",
            "scegliere",
            "consapevolmente",
            "la",
            "proprio",
            "strada"
          ]
        },
        {
          "id": "s26",
          "text": "Negli ultimi diciotto mesi aveva sempre reagito agli eventi della capitale: aveva trovato una stanza perché aveva bisogno di un letto; aveva accettato il lavoro da Bruno perché doveva pagare l'affitto; era rimasto lì perché si sentiva protetto e stimato.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "in",
            "ultimo",
            "diciotto",
            "mese",
            "avere",
            "sempre",
            "reagire",
            "a",
            "evento",
            "di",
            "capitale",
            "avere",
            "trovare",
            "una",
            "stanza",
            "perche",
            "avere",
            "bisogno",
            "di",
            "un",
