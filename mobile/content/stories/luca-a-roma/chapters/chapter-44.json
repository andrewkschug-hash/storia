            "mentre",
            "il",
            "profumo",
            "di",
            "caldarrosta",
            "si",
            "diffondere",
            "aria",
            "di",
            "ottobre"
          ]
        },
        {
          "id": "s03",
          "text": "Nella piccola piazza della Madonna dei Monti c'era un gruppo vivace di studenti e residenti seduti sui gradini della fontana di pietra antica.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "in",
            "piccolo",
            "piazza",
            "di",
            "madonna",
            "di",
            "monti",
            "ce",
            "un",
            "gruppo",
            "vivace",
            "di",
            "studente",
            "e",
            "residente",
            "sedere",
            "su",
            "gradino",
            "di",
            "fontana",
            "di",
            "pietra",
            "antico"
          ]
        },
        {
          "id": "s04",
          "text": "Sofia era seduta su una panchina di metallo con il suo quaderno da disegno sulle ginocchia, mentre tracciava con cura le ombre degli archi storici.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sofia",
            "essere",
            "sedere",
            "su",
            "una",
            "panchina",
            "di",
            "metallo",
            "con",
            "il",
            "suo",
            "quaderno",
            "da",
            "disegno",
            "su",
            "ginocchio",
            "mentre",
            "tracciare",
            "con",
            "cura",
            "le",
            "ombra",
            "di",
            "arco",
            "storico"
          ]
        },
        {
          "id": "s05",
          "text": "Appena ha visto Luca arrivare, ha chiuso la matita nel quaderno e si è alzata con un sorriso accogliente.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "appena",
            "avere",
            "vedere",
            "luca",
            "arrivare",
            "avere",
            "chiudere",
            "la",
            "matita",
            "in",
            "quaderno",
            "e",
            "si",
            "essere",
            "alzare",
            "con",
            "un",
            "sorriso",
            "accogliente"
          ]
        },
        {
          "id": "s06",
          "text": "«Ciao Luca. Dal tuo messaggio sembrava che fosse successo qualcosa di grave ed urgente» ha detto, notando subito la sua espressione tesa e preoccupata.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "ciao",
            "luca",
            "da",
            "suo",
            "messaggio",
            "sembrare",
            "che",
            "essere",
            "succedere",
            "qualcosa",
            "di",
            "grave",
            "e",
            "urgente",
            "avere",
            "dire",
            "notare",
            "subito",
            "la",
            "suo",
            "espressione",
            "teso",
            "e",
            "preoccupato"
          ]
        },
        {
          "id": "s07",
          "text": "«Ciao Sofia. Ho davvero bisogno di parlare con te con calma. Andiamo a prendere qualcosa da bere dove c'è meno confusione?»",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "ciao",
            "sofia",
            "avere",
            "davvero",
            "bisogno",
            "di",
            "parlare",
            "con",
            "te",
            "con",
            "calma",
            "andare",
            "a",
            "prendere",
            "qualcosa",
            "da",
            "bere",
            "dove",
            "ce",
            "meno",
            "confusione"
          ]
        },
        {
          "id": "s08",
          "text": "Sofia ha annuito con dolcezza, ha riposto il blocco nella borsa di tela e si sono incamminati insieme verso un piccolo bar con i tavolini all'aperto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sofia",
            "avere",
            "annuire",
            "con",
            "dolcezza",
            "avere",
            "riporre",
            "il",
            "blocco",
            "in",
            "borsa",
            "di",
            "tela",
            "e",
            "si",
            "essere",
            "incamminare",
            "insieme",
            "verso",
            "un",
            "piccolo",
            "bar",
            "con",
            "il",
            "tavolino",
            "aperto"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s09",
          "text": "Hanno trovato un tavolino appartato sotto un pergolato di foglie di vite, riparato dal flusso continuo dei passanti del fine settimana.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "trovare",
            "un",
            "tavolino",
            "appartato",
            "sotto",
            "un",
            "pergolato",
            "di",
            "foglia",
            "di",
            "vite",
            "riparare",
            "da",
            "flusso",
            "continuo",
            "di",
            "passante",
            "di",
            "fine",
            "settimana"
          ]
        },
        {
          "id": "s10",
          "text": "Il cameriere ha portato un'acqua frizzante per Luca e un chinotto freddo con una fetta di limone per Sofia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "cameriere",
            "avere",
            "portare",
            "acqua",
            "frizzante",
            "per",
            "luca",
            "e",
            "un",
            "chinotto",
            "freddo",
            "con",
            "una",
            "fetta",
            "di",
            "limone",
            "per",
            "sofia"
          ]
        },
        {
          "id": "s11",
          "text": "Luca ha raccontato tutto con calma: l'inventario del giovedì, le bollette raddoppiate, la riunione del sabato e la decisione di Bruno di cedere il locale entro maggio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "raccontare",
            "tutto",
            "con",
            "calma",
            "inventario",
            "di",
            "giovedi",
            "le",
            "bolletta",
            "raddoppiare",
            "la",
            "riunione",
            "di",
            "sabato",
            "e",
            "la",
            "decisione",
            "di",
            "bruno",
            "di",
            "cedere",
            "il",
            "locale",
            "entro",
            "maggio"
          ]
        },
        {
          "id": "s12",
          "text": "Ha descritto anche la reazione immediata di Giulia, che pensava già ai contatti con gli alberghi di lusso vicino a piazza Barberini.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "descrivere",
            "anche",
            "la",
            "reazione",
            "immediato",
            "di",
            "giulia",
            "che",
            "pensare",
            "gia",
            "a",
            "contatto",
            "con",
            "gli",
            "albergo",
            "di",
            "lusso",
            "vicino",
            "a",
            "piazza",
            "barberini"
          ]
        },
        {
          "id": "s13",
          "text": "Sofia ha ascoltato ogni dettaglio con grande attenzione, senza mai interrompere il filo del suo racconto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sofia",
            "avere",
            "ascoltare",
            "ogni",
            "dettaglio",
            "con",
            "grande",
            "attenzione",
            "senza",
            "mai",
            "interrompere",
            "il",
            "filo",
            "di",
            "suo",
            "racconto"
          ]
        },
        {
          "id": "s14",
          "text": "I suoi occhi scuri osservavano Luca non soltanto come un'amica affettuosa, ma come una persona capace di cogliere i pensieri e le paure più profonde.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "suo",
            "occhio",
            "scuro",
            "osservare",
            "luca",
            "non",
            "soltanto",
            "come",
