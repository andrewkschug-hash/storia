  "events": [
    {
      "id": "ev-41-morning-mastery",
      "summary": "Luca opens the café with complete confidence and handles the morning rush effortlessly with Giulia.",
      "characterIds": [
        "luca",
        "giulia"
      ],
      "locationIds": [
        "lavoro-caffe"
      ],
      "rememberedFacts": [
        "Luca opens the café on Via Merulana at 6:30 AM without supervision",
        "Luca knows the habits of morning regulars by memory",
        "Luca and Giulia work in seamless coordination behind the counter"
      ]
    },
    {
      "id": "ev-41-bruno-disturbance",
      "summary": "Signor Bruno arrives late carrying accountant files, visibly exhausted, and leaves before lunch service.",
      "characterIds": [
        "luca",
        "padrone",
        "giulia"
      ],
      "locationIds": [
        "lavoro-caffe"
      ],
      "rememberedFacts": [
        "Bruno arrives at 8:45 AM instead of his usual 7:30 AM",
        "Bruno carries a heavy binder from his commercialista and sits at the back table",
        "Bruno leaves before lunch, entrusting the register and afternoon to Luca"
      ]
    }
  ],
  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "I primi giorni di ottobre avevano portato un'aria fresca e pulita sulle strade di Roma.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "i",
            "primo",
            "giorno",
            "di",
            "ottobre",
            "avere",
            "portare",
            "aria",
            "fresco",
            "e",
            "pulito",
            "su",
            "strada",
            "di",
            "roma"
          ]
        },
        {
          "id": "s02",
          "text": "Alle sei e un quarto del mattino, via Merulana era ancora quasi deserta, illuminata dai lampioni gialli.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "alle",
            "sei",
            "e",
            "un",
            "quarto",
            "del",
            "mattino",
            "via",
            "merulana",
            "essere",
            "ancora",
            "quasi",
            "deserto",
            "illuminato",
            "da",
            "lampione",
            "giallo"
          ]
        },
        {
          "id": "s03",
          "text": "Luca camminava a passo svelto con le mani nelle tasche della giacca leggera.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "camminare",
            "a",
            "passo",
            "svelto",
            "con",
            "le",
            "mano",
            "in",
            "tasca",
            "della",
            "giacca",
            "leggero"
          ]
        },
        {
          "id": "s04",
          "text": "Non aveva più bisogno della sveglia; il suo corpo conosceva ormai il ritmo naturale della città.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "avere",
            "piu",
            "bisogno",
            "della",
            "sveglia",
            "il",
            "suo",
            "corpo",
            "conoscere",
            "ormai",
            "il",
            "ritmo",
            "naturale",
            "della",
            "citta"
          ]
        },
        {
          "id": "s05",
          "text": "Davanti al locale, ha aperto il lucchetto pesante e ha sollevato la saracinesca con un movimento sicuro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "davanti",
            "al",
            "locale",
            "avere",
            "aperto",
            "il",
            "lucchetto",
            "pesante",
            "e",
            "avere",
            "sollevare",
            "la",
            "saracinesca",
            "con",
            "un",
            "movimento",
            "sicuro"
          ]
        },
        {
          "id": "s06",
          "text": "Un anno prima, quel rumore metallico gli metteva addosso una sottile ansia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "un",
            "anno",
            "primo",
            "quello",
            "rumore",
            "metallico",
            "gli",
            "mettere",
            "addosso",
            "una",
            "sottile",
            "ansia"
          ]
        },
        {
          "id": "s07",
          "text": "Oggi invece significava soltanto che la giornata stava cominciando.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "oggi",
            "invece",
            "significare",
            "soltanto",
            "che",
            "la",
            "giornata",
            "stare",
            "cominciare"
          ]
        },
        {
          "id": "s08",
          "text": "È entrato nel bar, ha acceso le luci e ha avviato la grande macchina del caffè.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "entrare",
            "nel",
            "bar",
            "avere",
            "accendere",
            "le",
            "luce",
            "e",
            "avere",
            "avviare",
            "la",
            "grande",
            "macchina",
            "del",
            "caffe"
          ]
        },
        {
          "id": "s09",
          "text": "Mentre la caldaia saliva di pressione, ha preparato le tazzine e le caraffe di latte sul banco di marmo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "mentre",
            "la",
            "caldaia",
            "salire",
            "di",
            "pressione",
            "avere",
            "preparare",
            "le",
            "tazzina",
            "e",
            "le",
            "caraffa",
            "di",
            "latte",
            "sul",
            "banco",
            "di",
            "marmo"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s10",
          "text": "Alle sette meno un quarto è arrivato il furgone del forno con i cornetti caldi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "alle",
            "sette",
            "meno",
            "un",
            "quarto",
            "essere",
            "arrivare",
            "il",
            "furgone",
            "del",
            "forno",
            "con",
            "i",
            "cornetto",
            "caldo"
          ]
        },
        {
          "id": "s11",
          "text": "Luca ha firmato la bolla di consegna sul bancone con naturalezza.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "firmare",
            "la",
            "bolla",
            "di",
            "consegna",
            "sul",
            "bancone",
            "con",
            "naturalezza"
          ]
        },
        {
          "id": "s12",
          "text": "Poco dopo è entrata Giulia con la sua solita energia diretta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poco",
            "dopo",
            "essere",
            "entrare",
            "giulia",
            "con",
            "la",
            "suo",
            "solito",
            "energia",
            "diretto"
          ]
        },
        {
          "id": "s13",
          "text": "«Buongiorno, Luca. La macchina è già pronta?»",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
            "buongiorno",
            "luca",
            "la",
            "macchina",
            "essere",
            "gia",
            "pronto"
          ]
        },
        {
          "id": "s14",
          "text": "«Prontissima. Il vapore è a regime e i cornetti sono appena arrivati.»",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "pronto",
            "il",
            "vapore",
            "essere",
            "a",
            "regime",
            "e",
            "i",
            "cornetto",
            "essere",
            "appena",
            "arrivare"
          ]
        },
        {
          "id": "s15",
          "text": "Tra le sette e le otto e mezza, il locale si è riempito di clienti del quartiere.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "tra",
            "le",
            "sette",
            "e",
            "le",
            "otto",
            "e",
            "mezzo",
            "il",
            "locale",
            "si",
            "essere",
            "riempire",
            "di",
            "cliente",
            "del",
            "quartiere"
          ]
        },
        {
          "id": "s16",
          "text": "Luca e Giulia lavoravano spalla a spalla con un'intesa perfetta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "e",
            "giulia",
            "lavorare",
            "spalla",
            "a",
            "spalla",
            "con",
            "intesa",
            "perfetto"
          ]
        },
        {
          "id": "s17",
          "text": "Mentre Giulia batteva gli scontrini alla cassa, Luca estraeva espressi e montava il latte senza sbagliare un ordine.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "mentre",
            "giulia",
            "battere",
            "gli",
            "scontrino",
            "alla",
            "cassa",
            "luca",
            "estrarre",
            "espresso",
            "e",
            "montare",
            "il",
            "latte",
            "senza",
            "sbagliare",
            "un",
            "ordine"
          ]
        },
        {
          "id": "s18",
          "text": "Sapeva a memoria che il signor Moretti voleva il caffè ristretto in vetro con mezza bustina di zucchero.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sapere",
            "a",
            "memoria",
            "che",
            "il",
            "signore",
            "moretti",
            "volere",
            "il",
            "caffe",
            "ristretto",
            "in",
            "vetro",
            "con",
            "mezzo",
            "bustina",
            "di",
            "zucchero"
          ]
        },
        {
          "id": "s19",
          "text": "In quei momenti, Luca provava una soddisfazione profonda: non era più un ragazzo spaesato, ma una presenza riconosciuta a Roma.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "in",
            "quello",
            "momento",
            "luca",
            "provare",
            "una",
            "soddisfazione",
            "profondo",
            "non",
            "essere",
            "piu",
            "un",
            "ragazzo",
            "spaesato",
            "ma",
            "una",
            "presenza",
            "riconoscere",
            "a",
            "roma"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s20",
          "text": "Di solito, il padrone Bruno arrivava verso le sette e mezza.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "di",
            "solito",
            "il",
            "padrone",
            "bruno",
            "arrivare",
            "verso",
            "le",
            "sette",
            "e",
            "mezzo"
          ]
        },
        {
          "id": "s21",
          "text": "Entrava con il giornale, salutava tutti ad alta voce e prendeva un macchiato prima di mettersi alla cassa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "entrare",
            "con",
            "il",
            "giornale",
            "salutare",
            "tutto",
            "a",
            "alto",
            "voce",
            "e",
            "prendere",
            "un",
            "macchiato",
            "primo",
            "di",
            "mettere",
            "alla",
            "cassa"
          ]
        },
        {
          "id": "s22",
          "text": "Ma quel mercoledì le lancette dell'orologio sono arrivate alle otto e mezza senza che Bruno si vedesse.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ma",
            "quello",
            "mercoledi",
            "le",
            "lancetta",
            "orologio",
            "essere",
            "arrivare",
            "alle",
            "otto",
            "e",
            "mezzo",
            "senza",
            "che",
            "bruno",
            "si",
            "vedere"
          ]
        },
        {
          "id": "s23",
          "text": "Alle nove meno un quarto, la porta a vetri si è aperta lentamente.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "alle",
            "nove",
            "meno",
            "un",
            "quarto",
            "la",
            "porta",
            "a",
            "vetro",
            "si",
            "essere",
            "aprire",
            "lentamente"
          ]
        },
        {
          "id": "s24",
          "text": "Bruno è entrato con un passo pesante, tenendo sotto il braccio un grosso faldone scuro di documenti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruno",
            "essere",
            "entrare",
            "con",
            "un",
            "passo",
            "pesante",
            "tenere",
            "sotto",
            "il",
            "braccio",
            "un",
            "grosso",
            "faldone",
            "scuro",
            "di",
            "documento"
          ]
        },
        {
          "id": "s25",
          "text": "Non ha salutato i clienti al banco e non ha tolto il cappotto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "avere",
            "salutare",
            "i",
            "cliente",
            "al",
            "banco",
            "e",
            "non",
            "avere",
            "togliere",
            "il",
            "cappotto"
          ]
        },
        {
          "id": "s26",
          "text": "È andato dritto verso il tavolino in fondo alla sala e si è seduto con un sospiro, massaggiandosi la gamba.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "andare",
            "dritto",
            "verso",
            "il",
            "tavolino",
            "in",
            "fondo",
            "alla",
            "sala",
            "e",
            "si",
            "essere",
            "sedersi",
            "con",
            "un",
            "sospiro",
            "massaggiare",
            "la",
            "gamba"
          ]
        },
        {
          "id": "s27",
          "text": "Giulia si è avvicinata a Luca dietro la macchina del caffè e ha parlato a voce bassa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "giulia",
            "si",
            "essere",
            "avvicinare",
            "a",
            "luca",
            "dietro",
            "la",
            "macchina",
            "del",
            "caffe",
            "e",
            "avere",
            "parlare",
            "a",
            "voce",
            "basso"
          ]
        },
        {
          "id": "s28",
          "text": "«Hai visto Bruno? Sembra che ci sia qualcosa di strano questa mattina.»",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
            "avere",
            "vedere",
            "bruno",
            "sembrare",
            "che",
            "ci",
            "essere",
            "qualcosa",
            "di",
            "strano",
            "questo",
            "mattina"
          ]
        },
        {
          "id": "s29",
          "text": "«Sì, l'ho notato subito. Non credo che stia molto bene fisicamente, oppure ha qualche pensiero serio.»",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "si_yes",
            "il",
            "notare",
            "subito",
            "non",
            "credere",
            "che",
            "stare",
            "molto",
            "bene",
            "fisicamente",
            "oppure",
            "avere",
            "qualche",
            "pensiero",
            "serio"
          ]
        },
        {
          "id": "s30",
          "text": "«Penso che i conti con il commercialista siano più pesanti del previsto. Guarda quella cartella: è stato nello studio del dottor Marini fino a tardi ieri sera.»",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
            "pensare",
            "che",
            "i",
            "conto",
            "con",
            "il",
            "commercialista",
            "essere",
            "piu",
            "pesante",
            "del",
            "prevedere",
            "guardare",
            "quello",
            "cartella",
            "essere",
            "essere",
            "in",
            "studio",
            "del",
            "dottore",
            "marini",
            "fino",
            "a",
            "tardi",
            "ieri",
            "sera"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s31",
          "text": "Luca ha preparato una tazzina di macchiato caldo e l'ha portata al tavolo in fondo alla sala.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "preparare",
            "una",
            "tazzina",
            "di",
            "macchiato",
            "caldo",
            "e",
            "la",
            "portare",
            "al",
            "tavolo",
            "in",
            "fondo",
            "alla",
            "sala"
          ]
        },
        {
          "id": "s32",
          "text": "Sul tavolo c'erano fogli pieni di numeri e tabelle di bilancio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sul",
            "tavolo",
            "ce",
            "foglio",
            "pieno",
            "di",
            "numero",
            "e",
            "tabella",
            "di",
            "bilancio"
          ]
        },
        {
          "id": "s33",
          "text": "«Ecco il caffè, signor Bruno.»",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "ecco",
            "il",
            "caffe",
            "signore",
            "bruno"
          ]
        },
        {
          "id": "s34",
          "text": "Bruno ha alzato gli occhi con uno sguardo stanco ma affettuoso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruno",
            "avere",
            "alzare",
            "gli",
            "occhio",
            "con",
            "uno",
            "sguardo",
            "stanco",
            "ma",
            "affettuoso"
          ]
        },
        {
          "id": "s35",
          "text": "«Grazie, Luca. È importante che il locale funzioni bene anche quando io arrivo in ritardo.»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "grazie",
            "luca",
            "essere",
            "importante",
            "che",
            "il",
            "locale",
            "funzionare",
            "bene",
            "anche",
            "quando",
            "io",
            "arrivare",
            "in",
            "ritardo"
          ]
        },
        {
          "id": "s36",
          "text": "Ha bevuto un sorso, guardando per un momento la sala piena di voci.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "bere",
            "un",
            "sorso",
            "guardare",
            "per",
            "un",
            "momento",
            "la",
            "sala",
            "pieno",
            "di",
            "voce"
          ]
        },
        {
          "id": "s37",
          "text": "«Trentacinque anni, Luca. A volte sembra che il tempo voli via in un soffio, e a volte sembra che pesi come un macigno.»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "trentacinque",
            "anno",
            "luca",
            "a",
            "volta",
            "sembrare",
            "che",
            "il",
            "tempo",
            "volare",
            "via",
            "in",
            "un",
            "soffio",
            "e",
            "a",
            "volta",
            "sembrare",
            "che",
            "pesare",
            "come",
            "un",
            "macigno"
          ]
        },
        {
          "id": "s38",
          "text": "Luca ha esitato un istante; temeva che qualunque parola potesse sembrare fuori luogo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "esitare",
            "un",
            "istante",
            "temere",
            "che",
            "qualunque",
            "parola",
            "potere",
            "sembrare",
            "fuori",
            "luogo"
          ]
        },
        {
          "id": "s39",
          "text": "«È normale che dopo tanti anni ci siano giorni più pesanti, signor Bruno. Se ha bisogno che io faccia qualche ora in più, me lo dica pure.»",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "essere",
            "normale",
            "che",
            "dopo",
            "tanto",
            "anno",
            "ci",
            "essere",
            "giorno",
            "piu",
            "pesante",
            "signore",
            "bruno",
            "se",
            "avere",
            "bisogno",
            "che",
            "io",
            "fare",
            "qualche",
            "ora",
            "in",
            "piu",
            "me",
            "lo",
            "dire",
            "pure"
          ]
        },
        {
          "id": "s40",
          "text": "Bruno gli ha dato una pacca leggera sul braccio.",
