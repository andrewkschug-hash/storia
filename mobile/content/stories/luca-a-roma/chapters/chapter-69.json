            "ostacolo",
            "operativo"
          ],
          "speakerId": null,
          "kind": "narration"
        },
        {
          "id": "s08",
          "text": "Ogni imprevisto gli sembrava allora una catastrofe definitiva capace di distruggere il suo sogno sul nascere.",
          "lemmas": [
