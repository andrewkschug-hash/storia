          "speakerId": null,
          "kind": "narration"
        },
        {
          "id": "s16",
          "text": "Senza la paura economica di ottobre non avrebbe mai compreso l'importanza di una gestione rigorosa e trasparente dei costi aziendali.",
          "lemmas": [
