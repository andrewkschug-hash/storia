            "continuamente",
            "dal",
            "mondo",
            "circostante"
          ],
          "speakerId": "luca",
          "kind": "dialogue"
        },
        {
          "id": "s36",
          "text": "«Pensavo che la bravura tecnica fosse l'unica cosa che contasse e che ammettere un limite o chiedere aiuto fosse un segno imperdonabile di debolezza.»",
          "lemmas": [
            "pensare",
            "che",
            "la",
            "bravura",
