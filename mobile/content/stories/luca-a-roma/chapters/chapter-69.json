          ],
          "speakerId": null,
          "kind": "narration"
        },
        {
          "id": "s31",
          "text": "I tre amici sono rimasti a lungo intorno al tavolo a ripercorrere i momenti più divertenti e significativi dell'anno trascorso.",
          "lemmas": [
            "i",
            "tre",
            "amico",
