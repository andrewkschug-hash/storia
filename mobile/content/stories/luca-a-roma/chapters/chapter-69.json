            "chiedere",
            "aiuto",
            "essere",
            "un",
            "segno",
            "imperdonabile",
            "di",
            "debolezza"
          ],
          "speakerId": "luca",
          "kind": "dialogue"
        },
        {
          "id": "s37",
          "text": "Marco ha sorriso, spezzando un pezzo di pane con le dita robuste e piene di graffi di lavoro.",
          "lemmas": [
            "marco",
            "avere",
            "sorriso",
            "spezzare",
