    {
      "id": "p2",
      "sentences": [
        {
          "id": "s05",
          "text": "Aprendo il primo quaderno con la copertina nera, Luca ritrovò le annotazioni confuse e ansiose scritte durante i primi mesi di attività.",
          "lemmas": [
