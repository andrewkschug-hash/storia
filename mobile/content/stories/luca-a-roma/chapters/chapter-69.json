          ],
          "speakerId": null,
          "kind": "narration"
        },
        {
          "id": "s51",
          "text": "Il metallo freddo e levigato dal tempo rispondeva al tocco con una sicurezza rassicurante e familiare.",
          "lemmas": [
            "il",
            "metallo",
            "freddo",
