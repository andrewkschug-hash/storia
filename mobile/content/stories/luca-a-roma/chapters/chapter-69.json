    {
      "id": "p9",
      "sentences": [
        {
          "id": "s34",
          "text": "«Se penso a come sono arrivato a Roma un anno fa, mi sembra di guardare la vita di un'altra persona,» ha confidato Luca versandosi un altro goccio di caffè.",
          "lemmas": [
            "se",
            "pensare",
            "a",
            "come",
            "essere",
            "arrivare",
            "a",
            "roma",
            "un",
            "anno",
