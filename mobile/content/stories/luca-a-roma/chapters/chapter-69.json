          ],
          "speakerId": null,
          "kind": "narration"
        },
        {
          "id": "s15",
          "text": "Senza l'ingorgo di settembre non avrebbe mai imparato a organizzare i movimenti con fluidità ed economia di gesti.",
          "lemmas": [
            "senza",
            "ingorgo",
            "di",
