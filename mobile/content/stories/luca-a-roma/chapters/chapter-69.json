    {
      "id": "p5",
      "sentences": [
        {
          "id": "s18",
          "text": "Passando all'analisi dei dati finanziari complessivi dell'anno, i numeri confermavano un quadro di straordinaria solidità e salute economica.",
          "lemmas": [
