          ],
          "speakerId": null,
          "kind": "narration"
        }
      ],
      "order": 11
    },
    {
      "id": "p12",
      "sentences": [
        {
          "id": "s46",
          "text": "Aveva imparato l'arte più difficile e preziosa di tutte: l'arte dell'equilibrio dinamico.",
          "lemmas": [
