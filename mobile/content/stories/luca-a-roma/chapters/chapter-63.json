      "order": 5,
      "sentences": [
        {
          "id": "s14",
          "text": "Anche Chiara, che era seduta al tavolo in fondo concentrata sulla sua traduzione, si tolse subito le cuffie e si alzò senza la minima esitazione per dare una mano.",
          "speakerId": null,
          "kind": "narration",
