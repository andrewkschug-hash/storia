            "con",
            "formula",
            "rigido"
          ]
        },
        {
          "id": "s10",
          "text": "Era un momento di pura e semplice vulnerabilità condivisa, in cui una bottega di quartiere doveva mostrare la sua anima più autentica e accogliente.",
          "speakerId": null,
          "kind": "narration",
