    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s08",
          "text": "Per un attimo brevissimo, Luca sentì riaffiorare l'antico riflesso dell'ansia da controllo: come avrebbe potuto gestire quell'invasione improvvisa senza creare caos nel locale?",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
