          ]
        },
        {
          "id": "s21",
          "text": "I due fattorini, che tremavano nei loro abiti umidi, accettarono le tazze con occhi pieni di stupore e gratitudine sincera.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
