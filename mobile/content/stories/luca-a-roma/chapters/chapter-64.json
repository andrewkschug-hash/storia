          ]
        },
        {
          "id": "s13",
          "text": "Aveva osservato gli ultimi dieci minuti di quella battaglia solitaria contro i decimali, notando la rigidità crescente nei muscoli delle spalle di Luca.",
          "speakerId": null,
          "kind": "narration",
