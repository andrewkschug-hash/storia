    {
      "id": "p5",
      "order": 5,
      "sentences": [
        {
          "id": "s14",
          "text": "Luca sollevò lo sguardo, un po' imbarazzato per essere stato sorpreso in preda a quella frenesia analitica.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
