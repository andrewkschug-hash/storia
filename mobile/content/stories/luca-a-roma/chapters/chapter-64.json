          ]
        },
        {
          "id": "s15",
          "text": "«Sto solo cercando di ottenere un'estrazione perfetta e costante per ogni cliente,» si giustificò, indicando le cifre annotate sul quaderno.",
          "speakerId": "luca",
          "kind": "dialogue",
