      "order": 7,
      "sentences": [
        {
          "id": "s23",
          "text": "Proprio in quel momento entrò Marco dalla porta principale, portando con sé un vassoio di legno d'olivo intagliato a mano con venature ondulate e irregolari.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
