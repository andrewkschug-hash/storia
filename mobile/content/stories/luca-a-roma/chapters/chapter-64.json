        {
          "id": "s24",
          "text": "Sentendo le ultime parole di Chiara, il falegname appoggiò il vassoio sul banco e scosse la testa con una risata bonaria e profonda.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
