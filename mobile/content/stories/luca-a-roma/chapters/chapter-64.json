          ]
        },
        {
          "id": "s12",
          "text": "Era Chiara, che si era avvicinata senza far rumore con la sua tazza di ceramica vuota tra le mani per chiedere un rabbocco pomeridiano di caffè.",
          "speakerId": null,
          "kind": "narration",
