          ]
        },
        {
          "id": "s25",
          "text": "«Ascolta quello che ti dice Chiara, ragazzo mio,» intervenne Marco battendo una mano robusta sulla spalla di Luca.",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
