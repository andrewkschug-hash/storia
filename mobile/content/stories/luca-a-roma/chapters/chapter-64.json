          ]
        },
        {
          "id": "s16",
          "text": "«Un vero professionista dell'espresso dovrebbe saper controllare tutte le variabili: macinatura, grammatura, temperatura dell'acqua, tempo di contatto e pressione della pompa.",
          "speakerId": "luca",
          "kind": "dialogue",
