          ]
        },
        {
          "id": "s09",
          "text": "Emise un sospiro visibilmente frustrato, buttò via la pastiglia di caffè esausta nel cassetto battifiltro con un colpo secco e prese la penna per cancellare l'ennesima riga di appunti meticolosi.",
          "speakerId": null,
          "kind": "narration",
