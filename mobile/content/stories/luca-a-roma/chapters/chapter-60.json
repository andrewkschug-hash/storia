            "ceramica"
          ]
        },
        {
          "id": "s23",
          "text": "Entrambi sentivano che la collaborazione non rappresentava una rinuncia alla propria autonomia, ma l'unico strumento concreto per proteggerla e renderla duratura nel tempo.",
          "speakerId": null,
          "kind": "narration",
