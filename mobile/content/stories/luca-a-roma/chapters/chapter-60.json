          ]
        },
        {
          "id": "s19",
          "text": "«Così uniamo le nostre energie e le nostre competenze,» osservò Claudia con evidente soddisfazione mentre rileggeva la bozza dell'accordo.",
          "speakerId": null,
          "kind": "dialogue",
          "lemmas": [
