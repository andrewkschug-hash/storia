            "due",
            "attivita"
          ]
        },
        {
          "id": "s09",
          "text": "«Sono perfettamente d'accordo con la tua visione, Luca,» rispose mentre tracciava tre colonne distinte con precisione.",
          "speakerId": null,
          "kind": "dialogue",
          "lemmas": [
