    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s08",
          "text": "Claudia sorrise con intesa profonda e prese un foglio bianco per annotare i punti fondamentali del nuovo patto operativo tra le loro due attività.",
          "speakerId": null,
          "kind": "narration",
