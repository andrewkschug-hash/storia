            "a",
            "fare",
            "continuo"
          ]
        },
        {
          "id": "s17",
          "text": "La fermata della metropolitana di Cavour aveva appena scaricato centinaia di pendolari diretti verso Via Nazionale e il centro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
