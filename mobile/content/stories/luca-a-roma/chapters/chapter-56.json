    {
      "id": "p7",
      "order": 7,
      "sentences": [
        {
          "id": "s24",
          "text": "Il suo metodo artigianale, perfetto per servire dieci clienti all'ora, cominciò a mostrare i suoi limiti sotto la pressione del tempo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
