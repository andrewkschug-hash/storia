      "order": 8,
      "sentences": [
        {
          "id": "s27",
          "text": "Fu allora che un uomo sui cinquant'anni, con una valigetta di pelle scura e l'impermeabile abbottonato, si avvicinò al bancone guardando l'orologio da polso per la seconda volta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
