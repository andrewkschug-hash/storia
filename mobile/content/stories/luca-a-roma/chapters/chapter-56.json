            "il",
            "risultato",
            "con",
            "cura",
            "millimetrico"
          ]
        },
        {
          "id": "s09",
          "text": "Voleva che ogni tazzina servita allo Spazio Monti avesse la stessa limpidezza aromatica e la stessa acidità bilanciata del primo giorno.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
