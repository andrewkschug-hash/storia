            "suo",
            "attrezzatura"
          ]
        },
        {
          "id": "s07",
          "text": "Non era soltanto un'abitudine ereditata dal lavoro con Bruno, ma un rito che gli dava sicurezza.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
