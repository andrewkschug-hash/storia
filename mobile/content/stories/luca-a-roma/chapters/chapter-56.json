            "per",
            "due",
            "secondo"
          ]
        },
        {
          "id": "s37",
          "text": "Non era arrabbiato con il cliente, ma sentì una puntura all'orgoglio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "essere",
