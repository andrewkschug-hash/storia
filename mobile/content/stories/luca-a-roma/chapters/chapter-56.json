    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s06",
          "text": "Ogni mattina Luca dedicava venti minuti alla preparazione accurata delle sue attrezzature.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
