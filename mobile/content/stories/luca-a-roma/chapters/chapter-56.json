            "ma",
            "sentire",
            "una",
            "puntura",
            "orgoglio"
          ]
        },
        {
          "id": "s38",
          "text": "Luca pensava alla qualità dell'estrazione; invece, i clienti avevano semplicemente bisogno di un caffè prima di iniziare la giornata di lavoro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
