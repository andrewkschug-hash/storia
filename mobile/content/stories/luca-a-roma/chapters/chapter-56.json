      "order": 6,
      "sentences": [
        {
          "id": "s22",
          "text": "Chi entrava prima delle nove non aveva tempo per osservare la bellezza del legno di castagno: aveva fretta di raggiungere l'ufficio.",
          "speakerId": null,
          "kind": "narration",
