          ]
        },
        {
          "id": "s18",
          "text": "Nel giro di pochi minuti, una dozzina di persone entrarono nello Spazio Monti, spingendo la porta con decisione e portando dentro il rumore della strada.",
          "speakerId": null,
          "kind": "narration",
