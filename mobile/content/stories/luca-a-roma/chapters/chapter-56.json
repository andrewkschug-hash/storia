    },
    {
      "id": "p11",
      "order": 11,
      "sentences": [
        {
          "id": "s40",
          "text": "Nei venti minuti successivi, Luca cercò di accelerare i movimenti, ma la fretta non fece che aumentare il disordine.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
