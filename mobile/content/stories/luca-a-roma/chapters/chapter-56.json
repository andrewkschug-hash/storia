        }
      ]
    },
    {
      "id": "p12",
      "order": 12,
      "sentences": [
        {
          "id": "s43",
          "text": "Alle dieci meno un quarto nello Spazio Monti tornò il silenzio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
