        },
        {
          "id": "s21",
          "text": "Luca salutò tutti con un sorriso cortese, ma sentì immediatamente che il ritmo calmo dell'alba era diventato improvvisamente frenetico.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
