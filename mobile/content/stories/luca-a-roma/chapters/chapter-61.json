      "order": 8,
      "sentences": [
        {
          "id": "s24",
          "text": "Luca appoggiò con estrema delicatezza la caraffa di vetro e la tazza sul sottobicchiere di legno d'olivo, pronto a illustrare il tempo esatto di infusione e il momento ideale per degustare il primo sorso aromatico.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
