    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s08",
          "text": "Luca la osservò con curiosità professionale da dietro il bancone, ammirando la naturalezza con cui aveva preso possesso di quello spazio pensato per lo studio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
