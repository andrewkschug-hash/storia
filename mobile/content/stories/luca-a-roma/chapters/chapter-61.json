    {
      "id": "p5",
      "order": 5,
      "sentences": [
        {
          "id": "s15",
          "text": "La ragazza ascoltò la spiegazione con un sorriso gentile ma sobrio, annuendo senza perdersi in convenevoli superflui.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
