    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s11",
          "text": "Il cuore di Luca ebbe un piccolo sussulto di entusiasmo artigianale: era la prima volta che un cliente chiedeva un consiglio così specifico sulle caratteristiche della bevanda.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
