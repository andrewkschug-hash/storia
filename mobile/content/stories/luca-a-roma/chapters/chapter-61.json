            "marco"
          ]
        },
        {
          "id": "s03",
          "text": "Luca stava riordinando i panni umidi e pulendo con meticolosa attenzione la doccetta d'acciaio del gruppo centrale quando il campanello sopra la porta suonò con un tocco leggero.",
          "speakerId": null,
          "kind": "narration",
