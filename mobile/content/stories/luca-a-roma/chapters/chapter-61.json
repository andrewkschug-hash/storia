          ]
        },
        {
          "id": "s23",
          "text": "Le sue dita correvano veloci sulla tastiera con un ritmo ininterrotto e concentrato che non ammetteva distrazioni esterne.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
