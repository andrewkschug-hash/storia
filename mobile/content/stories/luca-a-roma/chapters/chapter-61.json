      "order": 7,
      "sentences": [
        {
          "id": "s21",
          "text": "Versò il caffè limpido nella caraffa di vetro resistente al calore, prese una delle tazzine di ceramica smaltata modellate a mano da Claudia e attraversò la sala a passi felpati.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
