            "chiaro"
          ]
        },
        {
          "id": "s13",
          "text": "«Viene coltivato a oltre duemila metri di altitudine da piccoli produttori della regione di Sidamo.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "venire",
