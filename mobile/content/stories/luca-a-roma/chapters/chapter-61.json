            "passo",
            "felpato"
          ]
        },
        {
          "id": "s22",
          "text": "Chiara era già completamente immersa nel suo schermo, circondata da fogli stampati con annotazioni rosse a margine e dizionari aperti di lingua francese.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
