      "order": 6,
      "sentences": [
        {
          "id": "s18",
          "text": "Luca pesò con precisione millimetrica ventiquattro grammi di caffè, macinò i chicchi con granulometria media e sciacquò il filtro di carta con acqua caldissima per eliminare ogni sapore residuo di cellulosa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
