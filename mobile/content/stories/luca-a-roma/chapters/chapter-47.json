            "e",
            "avere",
            "accarezzare",
            "la",
            "superficie",
            "liscio",
            "del",
            "noce",
            "primo",
            "di",
            "rispondere",
            "con",
            "calmo",
            "e",
            "convinzione"
          ]
        },
        {
          "id": "s21",
          "text": "«Anche se ci sono notti in cui non dormo per l'ansia dei conti e nonostante le bollette siano sempre un'incognita, quando una cosa viene bene so che ci ho messo io le mani dall'inizio alla fine.»",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "anche",
            "se",
            "ci",
            "essere",
            "notte",
            "in",
            "cui",
            "non",
            "dormire",
            "per",
            "ansia",
            "dei",
            "conto",
            "e",
            "nonostante",
            "le",
            "bolletta",
            "essere",
            "sempre",
            "incognita",
            "quando",
            "una",
            "cosa",
            "venire",
            "bene",
            "sapere",
            "che",
            "ci",
            "avere",
            "mettere",
            "io",
            "le",
            "mano",
            "inizio",
            "alla",
            "fine"
          ]
        },
        {
          "id": "s22",
          "text": "«Nelle grandi aziende sei solo un esecutore anonimo che segue disegni standardizzati preparati da altri secondo procedure rigide, ripetitive e impersonali.»",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "in",
            "grande",
            "azienda",
            "sei",
            "solo",
            "un",
            "esecutore",
            "anonimo",
            "che",
            "seguire",
            "disegno",
            "standardizzato",
            "preparare",
            "da",
            "altro",
            "secondo",
            "procedura",
            "rigido",
            "ripetitivo",
            "e",
            "impersonale"
          ]
        },
        {
          "id": "s23",
          "text": "«Qui dentro ogni singolo errore lo pago personalmente di tasca mia, ma ogni tavolo che esce da quella porta porta la mia firma, la mia cura artigianale e la mia identità autentica.»",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "qui",
            "dentro",
            "ogni",
            "singolo",
            "errore",
            "lo",
            "pagare",
            "personalmente",
            "di",
            "tasca",
            "mio",
            "ma",
            "ogni",
            "tavolo",
            "che",
            "uscire",
            "da",
            "quello",
            "porta",
            "porta",
            "la",
            "mio",
            "firma",
            "la",
            "mio",
            "cura",
            "artigianale",
            "e",
            "la",
            "mio",
            "identita",
            "autentico"
          ]
        },
        {
          "id": "s24",
          "text": "«Non è una questione di guadagnare di più o di fare una vita comoda: dipende da quanto valore dai al fatto di essere l'unico vero autore delle tue giornate e del tuo lavoro.»",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "essere",
            "una",
            "questione",
            "di",
            "guadagnare",
            "di",
            "piu",
            "o",
            "di",
            "fare",
            "una",
            "vita",
            "comodo",
            "dipendere",
            "da",
            "quanto",
            "valore",
            "da",
            "al",
            "fare",
            "di",
            "essere",
            "unico",
            "vero",
            "autore",
            "delle",
            "suo",
            "giornata",
            "e",
            "del",
            "tuo",
            "lavoro"
          ]
        }
      ]
    },
    {
      "id": "p5",
      "order": 5,
      "sentences": [
        {
          "id": "s25",
          "text": "Quando è uscito dalla bottega di San Lorenzo nella fresca aria della sera romana, Luca sentiva la testa affollata da pensieri contrastanti.",
          "speakerId": null,
          "kind": "narration",
