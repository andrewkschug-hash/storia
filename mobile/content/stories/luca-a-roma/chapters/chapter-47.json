            "non",
            "avere",
            "potere",
            "essere",
            "piu",
            "netto",
            "e",
            "immediato"
          ]
        },
        {
          "id": "s03",
          "text": "La bottega di Marco si apriva su un cortile interno nascosto tra vecchi palazzi di ringhiera, annunciata dal profumo penetrante del legno di noce, della resina e dell'olio di lino cotto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "bottega",
            "di",
            "marco",
            "si",
            "aprire",
            "su",
            "un",
            "cortile",
            "interno",
            "nascosto",
            "tra",
            "vecchio",
            "palazzo",
            "di",
            "ringhiera",
            "annunciare",
            "dal",
            "profumo",
            "penetrante",
            "del",
            "legno",
            "di",
            "noce",
            "della",
            "resina",
            "e",
            "olio",
            "di",
            "lino",
            "cuocere"
          ]
        },
        {
          "id": "s04",
          "text": "Varcata la soglia di ferro battuto, l'aria era densa di una sottile polvere dorata che danzava sotto la luce cruda dei tubi al neon, mentre il ronzio vibrante della sega a nastro si mescolava alle note gracchianti di una vecchia radio accesa su una mensola polverosa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "varcare",
            "la",
            "soglia",
            "di",
            "ferro",
            "battere",
            "aria",
            "essere",
            "denso",
            "di",
            "una",
            "sottile",
            "polvere",
            "dorato",
            "che",
            "danzare",
            "sotto",
            "la",
            "luce",
            "crudo",
            "dei",
            "tubo",
            "al",
            "neon",
            "mentre",
            "il",
            "ronzio",
            "vibrante",
            "della",
            "sega",
            "a",
            "nastro",
            "si",
            "mescolare",
            "alle",
            "nota",
            "gracchiante",
            "di",
            "una",
            "vecchio",
            "radio",
            "accendere",
            "su",
            "una",
            "mensola",
            "polveroso"
          ]
        },
        {
          "id": "s05",
          "text": "Tutto intorno si accumulavano assi di rovere massiccio, morsetti d'acciaio, barattoli di vernice naturale e trucioli che scricchiolavano morbidamente sotto i piedi ad ogni passo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "tutto",
            "intorno",
            "si",
            "accumulare",
            "asse",
            "di",
            "rovere",
            "massiccio",
            "morsetto",
            "acciaio",
            "barattolo",
            "di",
            "vernice",
            "naturale",
            "e",
            "truciolo",
            "che",
            "scricchiolare",
            "morbidamente",
            "sotto",
            "i",
            "piede",
            "a",
            "ogni",
            "passo"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s06",
          "text": "Marco era chino sopra un grande tavolo da pranzo lungo tre metri, intento a levigare a mano una tavola di noce scuro con movimenti ampi, lenti e metodici.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "marco",
            "essere",
            "chino",
            "sopra",
            "un",
            "grande",
            "tavolo",
            "da",
            "pranzo",
            "lungo",
            "tre",
            "metro",
            "intento",
            "a",
            "levigare",
            "a",
            "mano",
            "una",
            "tavola",
            "di",
            "noce",
            "scuro",
            "con",
            "movimento",
            "ampio",
            "lento",
            "e",
            "metodico"
          ]
        },
        {
          "id": "s07",
          "text": "Indossava un grembiule di tela grezza coperto di segatura e aveva gli occhi protetti da occhiali da lavoro trasparenti, con le maniche della camicia arrotolate fino ai gomiti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "indossare",
            "un",
            "grembiule",
            "di",
            "tela",
            "grezzo",
            "coprire",
            "di",
