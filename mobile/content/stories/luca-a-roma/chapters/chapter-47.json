  "title": "Marco's Workshop",
  "titleIt": "Il laboratorio di Marco",
  "cefrLevel": "B1",
  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Due giorni dopo la visita al Grand Hotel Splendor, terminate le pulizie del bar di Bruno, Luca ha preso il tram per raggiungere il laboratorio di Marco nel cuore popolare di San Lorenzo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "due",
            "giorno",
            "dopo",
            "la",
            "visita",
            "al",
            "grand",
            "hotel",
            "splendor",
            "terminare",
            "le",
            "pulizia",
            "del",
            "bar",
            "di",
            "bruno",
            "luca",
            "avere",
            "prendere",
            "il",
            "tram",
            "per",
            "raggiungere",
            "il",
            "laboratorio",
            "di",
            "marco",
            "nel",
            "cuore",
            "popolare",
            "di",
            "san",
            "lorenzo"
          ]
        },
        {
          "id": "s02",
          "text": "Il contrasto con l'eleganza ovattata e silenziosa di Via Veneto non avrebbe potuto essere più netto e immediato.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "contrasto",
