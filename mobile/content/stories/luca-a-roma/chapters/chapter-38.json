{
  "id": "luca-a-roma-38",
  "storyId": "luca-a-roma",
  "number": 38,
  "title": "Dinner with Sofia",
  "titleIt": "Cena con Sofia",
  "difficultyLevel": 2,
  "locationIds": [
    "centro",
    "quartiere"
  ],
  "characterIds": [
