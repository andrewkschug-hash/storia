  "events": [
    {
      "id": "ev-38-dinner",
      "summary": "Luca and Sofia talk over dinner about extra hours; Luca decides to ask the owner for more hours but not all of them.",
      "characterIds": [
        "luca",
        "sofia"
      ],
      "locationIds": [
        "centro"
      ],
      "rememberedFacts": [
        "Luca wants more hours but not all hours",
        "He will ask the padrone for a clear schedule with free Monday and Wednesday evenings",
        "Sofia asks what he wants; she does not decide for him"
      ]
    }
  ],
  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Due sere dopo, Luca e Sofia si sono incontrati per una cena nel centro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "due",
            "sera",
            "dopo",
            "luca",
            "e",
            "sofia",
            "si",
            "essere",
            "incontrare",
            "per",
            "una",
            "cena",
            "nel",
            "centro"
          ]
        },
        {
          "id": "s02",
          "text": "Il posto era piccolo e tranquillo, con poca luce e pochi tavoli.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "posto",
            "essere",
            "piccolo",
            "e",
            "tranquillo",
            "con",
            "poco",
            "luce",
            "e",
            "poco",
            "tavolo"
          ]
        },
        {
          "id": "s03",
          "text": "Sofia è arrivata un po’ tardi, perché il lavoro era lungo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sofia",
            "essere",
            "arrivare",
            "un",
            "poco",
            "tardi",
            "perche",
            "il",
            "lavorare",
            "essere",
            "lungo"
          ]
        },
        {
          "id": "s04",
          "text": "Allora. Il caffè resta. Tu sei contento delle ore nuove?",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "allora",
            "il",
            "caffe",
            "restare",
            "tu",
            "essere",
            "contento",
            "delle",
            "ora",
            "nuovo"
          ]
        },
        {
          "id": "s05",
          "text": "Sì. Ho più soldi. L’affitto di questo mese è più sicuro.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "si_yes",
            "avere",
            "piu",
            "soldi",
            "affitto",
            "di",
            "questo",
            "mese",
            "essere",
            "piu",
            "sicuro"
          ]
        },
        {
          "id": "s06",
          "text": "Ma ho anche meno tempo. La settimana è già piena.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "ma",
            "avere",
            "anche",
            "meno",
            "tempo",
            "la",
            "settimana",
            "essere",
            "gia",
            "pieno"
          ]
        },
        {
          "id": "s07",
          "text": "Luca ha preso l’acqua. Sofia ha ascoltato, e non ha deciso per lui.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "prendere",
            "acqua",
            "sofia",
            "avere",
            "ascoltare",
            "e",
            "non",
            "avere",
            "decidere",
            "per",
            "lui"
          ]
        },
        {
          "id": "s08",
          "text": "Cosa vuoi, di vero? Non cosa ha detto il padrone.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "cosa",
            "volere",
            "di",
            "vero",
            "non",
            "cosa",
            "avere",
            "dire",
            "il",
            "padrone"
          ]
        },
        {
          "id": "s09",
          "text": "Voglio restare a Roma. Voglio lavorare. Ma non voglio solo il lavoro.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "volere",
            "restare",
            "a",
            "roma",
            "volere",
            "lavorare",
            "ma",
            "non",
            "volere",
            "solo",
            "il",
            "lavorare"
          ]
        },
        {
          "id": "s10",
          "text": "Voglio tempo per gli amici e per la casa.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "volere",
            "tempo",
            "per",
            "gli",
            "amico",
            "e",
            "per",
            "la",
            "casa"
          ]
        },
        {
          "id": "s11",
          "text": "Questo è chiaro. Allora le ore non devono prendere tutta la settimana.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "questo",
            "essere",
            "chiaro",
            "allora",
            "le",
            "ora",
            "non",
            "dovere",
            "prendere",
            "tutto",
            "la",
            "settimana"
          ]
        },
        {
          "id": "s12",
          "text": "Mentre parlavano, la sala era tranquilla.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "mentre",
            "parlare",
            "la",
            "sala",
            "essere",
            "tranquillo"
          ]
        },
        {
          "id": "s13",
          "text": "Hanno mangiato pasta e hanno parlato del lavoro di Sofia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "mangiare",
            "pasta",
            "e",
            "avere",
            "parlare",
            "del",
            "lavorare",
            "di",
            "sofia"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s14",
          "text": "Il mio lavoro è tanto. Qualche sera sono stanca. Qualche sera sto bene.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "il",
            "mio",
            "lavorare",
            "essere",
            "tanto",
            "qualche",
            "sera",
            "essere",
            "stanco",
            "qualche",
            "sera",
            "stare",
            "bene"
          ]
        },
        {
          "id": "s15",
          "text": "Anch’io. Dopo il sabato, le ore nuove sembrano grandi.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "anche",
            "dopo",
            "il",
            "sabato",
            "le",
            "ora",
            "nuovo",
            "sembrare",
            "grande"
          ]
        },
        {
          "id": "s16",
          "text": "Se accetti tutte le ore, quando vedi gli amici?",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "se",
            "accettare",
            "tutto",
            "le",
            "ora",
            "quando",
            "vedere",
            "gli",
            "amico"
          ]
        },
        {
          "id": "s17",
          "text": "Non so. Forse vedo gli amici poco. E questo non mi piace.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "sapere",
            "forse",
            "vedere",
            "gli",
            "amico",
            "poco",
            "e",
            "questo",
            "non",
            "mi",
            "piacere"
          ]
        },
        {
          "id": "s18",
          "text": "Allora non è un sì o un no. È una domanda di orario.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "allora",
            "non",
            "essere",
            "un",
            "si_yes",
            "o",
            "un",
            "no",
            "essere",
            "una",
            "domanda",
            "di",
            "orario"
          ]
        },
        {
          "id": "s19",
          "text": "Luca ha pensato all’affitto, poi agli amici, poi a Giulia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "pensare",
            "affitto",
            "poi",
            "ai",
            "amico",
            "poi",
            "a",
            "giulia"
          ]
        },
        {
          "id": "s20",
          "text": "Giulia fa il piano della settimana. Io posso chiedere un orario chiaro.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "giulia",
            "fare",
            "il",
            "piano",
            "della",
            "settimana",
            "io",
            "potere",
            "chiedere",
            "un",
            "orario",
            "chiaro"
          ]
        },
        {
          "id": "s21",
          "text": "Sì. Parla al padrone di quello che ti serve. Lui ascolta.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "si_yes",
            "parlare",
            "al",
            "padrone",
            "di",
            "quello",
            "che",
            "ti",
            "servire",
            "lui",
            "ascoltare"
          ]
        },
        {
          "id": "s22",
          "text": "Quando Sofia ha detto “ti serve”, Luca ha capito la cosa importante.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "quando",
            "sofia",
            "avere",
            "dire",
            "ti",
            "servire",
            "luca",
            "avere",
            "capire",
            "la",
            "cosa",
            "importante"
          ]
        },
        {
          "id": "s23",
          "text": "Non doveva avere paura di chiedere. Doveva solo essere chiaro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "dovere",
            "avere",
            "paura",
            "di",
            "chiedere",
            "dovere",
            "solo",
            "essere",
            "chiaro"
          ]
        },
        {
          "id": "s24",
          "text": "Vuoi più ore, ma non tutte. Va bene così.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "volere",
            "piu",
            "ora",
            "ma",
            "non",
            "tutto",
            "andare",
            "bene",
            "cosi"
          ],
          "phrases": [
            {
              "surface": "Va bene",
              "literalEn": "it goes well",
              "naturalEn": "okay",
              "tokenStart": 6,
              "tokenEnd": 7
            }
          ]
        },
        {
          "id": "s25",
          "text": "Hanno parlato di questa settimana, non di un anno lungo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "parlare",
            "di",
            "questo",
            "settimana",
            "non",
            "di",
            "un",
            "anno",
            "lungo"
          ]
        },
        {
          "id": "s26",
          "text": "Lunedì e mercoledì, la sera, voglio restare libero.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "lunedi",
            "e",
            "mercoledi",
            "la",
            "sera",
            "volere",
            "restare",
            "libero"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s27",
          "text": "Martedì e giovedì posso lavorare di più, se il padrone vuole.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "martedi",
            "e",
            "giovedi",
            "potere",
            "lavorare",
            "di",
            "piu",
            "se",
            "il",
            "padrone",
            "volere"
          ]
        },
        {
          "id": "s28",
          "text": "Sabato e domenica sono difficili, perché il caffè ha bisogno di persone.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "sabato",
            "e",
            "domenica",
            "essere",
            "difficile",
            "perche",
            "il",
            "caffe",
            "avere",
            "bisogno",
            "di",
            "persona"
          ]
        },
        {
          "id": "s29",
          "text": "Questo mi sembra un piano. Non è grande, ma è un inizio.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "questo",
            "mi",
            "sembrare",
            "un",
            "piano",
            "non",
            "essere",
            "grande",
            "ma",
            "essere",
            "un",
            "iniziare"
          ],
          "phrases": [
            {
              "surface": "Mi sembra",
              "literalEn": "it seems to me",
              "naturalEn": "it seems to me",
              "tokenStart": 1,
              "tokenEnd": 2
            }
          ]
        },
        {
          "id": "s30",
          "text": "Sofia non ha fatto tante parole. Ha fatto domande, e ha ascoltato.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sofia",
            "non",
            "avere",
            "fare",
            "tanto",
            "parola",
            "avere",
            "fare",
            "domanda",
            "e",
            "avere",
            "ascoltare"
          ]
        },
        {
          "id": "s31",
          "text": "Per me sei un’amica, non solo la persona dei primi giorni.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "per",
            "io",
            "essere",
            "amico",
            "non",
            "solo",
            "la",
            "persona",
            "dei",
            "primo",
            "giorno"
          ]
        },
        {
          "id": "s32",
          "text": "Lo so. Adesso parliamo perché vogliamo, non perché sei nuovo.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "lo",
            "sapere",
            "adesso",
            "parlare",
            "perche",
            "volere",
            "non",
            "perche",
            "essere",
            "nuovo"
          ]
        },
        {
          "id": "s33",
          "text": "Luca ha sorriso. La cena era piccola. Ogni parola era chiara.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "sorridere",
            "la",
            "cena",
            "essere",
            "piccolo",
            "ogni",
            "parola",
            "essere",
            "chiaro"
          ]
        },
        {
          "id": "s34",
          "text": "Domani parlo con il padrone. Chiedo più ore, ma non tutte.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "domani",
            "parlare",
            "con",
            "il",
            "padrone",
            "chiedere",
            "piu",
            "ora",
            "ma",
            "non",
            "tutto"
          ]
        },
        {
          "id": "s35",
          "text": "Bene. E se il padrone dice no alle ore?",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "bene",
            "e",
            "se",
            "il",
            "padrone",
            "dire",
            "no",
            "alle",
            "ora"
          ]
        },
        {
          "id": "s36",
          "text": "Allora cerco un altro modo. Ma prima chiedo.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "allora",
            "cercare",
            "un",
            "altro",
            "modo",
            "ma",
            "prima",
            "chiedere"
          ]
        },
        {
          "id": "s37",
          "text": "Dopo la cena hanno camminato un poco verso il quartiere.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dopo",
            "la",
            "cena",
            "avere",
            "camminare",
            "un",
            "poco",
            "verso",
            "il",
            "quartiere"
          ]
        },
        {
          "id": "s38",
          "text": "Roma di sera era piena di gente, e loro parlavano piano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "roma",
            "di",
            "sera",
            "essere",
            "pieno",
            "di",
            "gente",
            "e",
            "loro",
            "parlare",
            "piano"
          ]
        },
        {
          "id": "s39",
          "text": "Non hanno deciso tutto. Hanno deciso cosa fare il giorno dopo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "avere",
            "decidere",
            "tutto",
            "avere",
            "decidere",
            "cosa",
            "fare",
            "il",
            "giorno",
            "dopo"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s40",
          "text": "Ci vediamo presto. Non restare solo tra le ore del caffè.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "ci",
            "vedere",
            "presto",
            "non",
            "restare",
            "solo",
            "tra",
            "le",
            "ora",
            "del",
            "caffe"
          ],
          "phrases": [
            {
              "surface": "Ci vediamo",
              "literalEn": "we see each other",
              "naturalEn": "see you",
              "tokenStart": 0,
              "tokenEnd": 1
            }
          ]
        },
        {
          "id": "s41",
          "text": "Non resto solo. Lunedì e mercoledì la sera sono liberi.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "restare",
            "solo",
            "lunedi",
            "e",
            "mercoledi",
            "la",
            "sera",
            "essere",
            "libero"
          ]
        },
        {
          "id": "s42",
          "text": "Sofia ha fatto un segno di sì, contenta in un modo tranquillo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sofia",
            "avere",
            "fare",
            "un",
            "segno",
            "di",
            "si_yes",
            "contento",
            "in",
            "un",
            "modo",
            "tranquillo"
          ]
        },
        {
          "id": "s43",
          "text": "Quando Luca è tornato a casa, ha scritto due parole sul telefono.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "quando",
            "luca",
            "essere",
            "tornare",
            "a",
            "casa",
            "avere",
            "scrivere",
            "due",
            "parola",
            "sul",
            "telefono"
          ]
        },
        {
          "id": "s44",
          "text": "Domani: orario chiaro con il padrone. Più ore, non tutte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "domani",
            "orario",
            "chiaro",
            "con",
            "il",
            "padrone",
            "piu",
            "ora",
            "non",
            "tutto"
          ]
        },
        {
          "id": "s45",
          "text": "Ha messo il telefono vicino alla finestra e ha aspettato un momento.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "mettere",
            "il",
            "telefono",
            "vicino",
            "alla",
            "finestra",
            "e",
            "avere",
            "aspettare",
            "un",
            "momento"
          ]
        },
        {
          "id": "s46",
          "text": "Il caffè restava. Le ore nuove restavano. Ora c’era anche un piano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "caffe",
            "restare",
            "le",
            "ora",
            "nuovo",
            "restare",
            "ora",
            "ce",
            "anche",
            "un",
            "piano"
          ]
        },
        {
          "id": "s47",
          "text": "Era una cosa piccola e chiara per la settimana nuova.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "una",
            "cosa",
            "piccolo",
            "e",
            "chiaro",
            "per",
            "la",
            "settimana",
            "nuovo"
          ]
        },
        {
          "id": "s49",
          "text": "Ha pensato a Marco, ancora in cerca di lavoro, e a Giulia con il suo piano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "pensare",
            "a",
            "marco",
            "ancora",
            "in",
            "cercare",
            "di",
            "lavorare",
            "e",
            "a",
            "giulia",
            "con",
            "il",
            "suo",
            "piano"
          ]
        },
        {
          "id": "s50",
          "text": "Poi ha chiuso la luce. Domani iniziava con una domanda chiara.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "avere",
            "chiudere",
            "la",
            "luce",
            "domani",
            "iniziare",
