          ]
        },
        {
          "id": "s08",
          "text": "Ma sapeva che la passione artigianale, da sola, non bastava per garantire la sopravvivenza economica del laboratorio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
