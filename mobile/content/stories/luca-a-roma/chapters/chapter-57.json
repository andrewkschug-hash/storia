      "order": 7,
      "sentences": [
        {
          "id": "s22",
          "text": "Subito dopo vennero i costi fissi della struttura.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "subito",
            "dopo",
            "venire",
