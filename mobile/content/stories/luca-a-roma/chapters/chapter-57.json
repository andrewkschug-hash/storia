            "piu",
            "di",
            "duemila",
            "ingresso",
            "complessivo"
          ]
        },
        {
          "id": "s11",
          "text": "La gente del rione entra con curiosità, assaggia il tuo caffè al banco e osserva i miei vasi in esposizione.",
          "speakerId": null,
          "kind": "dialogue",
          "lemmas": [
