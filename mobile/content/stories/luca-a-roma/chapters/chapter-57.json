          ]
        },
        {
          "id": "s30",
          "text": "Al Bar Centrale lavorava come dipendente: non aveva responsabilità fiscali, non doveva preoccuparsi delle bollette dell'energia e alla fine del mese riceveva una busta paga garantita senza alcun rischio d'impresa.",
          "speakerId": null,
          "kind": "narration",
