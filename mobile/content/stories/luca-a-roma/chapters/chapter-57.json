    {
      "id": "p6",
      "order": 6,
      "sentences": [
        {
          "id": "s19",
          "text": "Cominciarono a esaminare i conti voce per voce, annotando ogni singola uscita sul foglio di calcolo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
