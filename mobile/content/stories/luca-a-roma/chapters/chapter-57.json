            "con",
            "la",
            "punta",
            "della",
            "matita"
          ]
        },
        {
          "id": "s10",
          "text": "«Nel mese di ottobre abbiamo registrato più di duemila ingressi complessivi.",
          "speakerId": null,
          "kind": "dialogue",
          "lemmas": [
            "nel",
