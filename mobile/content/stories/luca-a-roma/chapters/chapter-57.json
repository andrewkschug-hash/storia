      "order": 9,
      "sentences": [
        {
          "id": "s28",
          "text": "Nella sala illuminata dalla lampada calò un silenzio pesante, rotto solo dal ticchettio regolare della pioggia contro la vetrata.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
