    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s09",
          "text": "«Cominciamo dagli incassi lordi,» disse Claudia, aprendo il registro delle vendite e scorrendo le colonne con la punta della matita.",
          "speakerId": null,
          "kind": "dialogue",
          "lemmas": [
