            "attivita"
          ]
        },
        {
          "id": "s06",
          "text": "Dopo trentuno giorni di apertura ininterrotta, l'entusiasmo dell'inizio doveva fare i conti con la realtà dei numeri.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
