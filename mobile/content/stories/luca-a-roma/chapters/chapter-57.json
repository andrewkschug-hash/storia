    {
      "id": "p11",
      "order": 11,
      "sentences": [
        {
          "id": "s34",
          "text": "Claudia posò la matita sul quaderno, lo guardò dritto negli occhi e scosse la testa con decisione calma ma inflessibile:",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
