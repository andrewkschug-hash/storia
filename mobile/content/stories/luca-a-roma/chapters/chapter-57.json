    {
      "id": "p5",
      "order": 5,
      "sentences": [
        {
          "id": "s16",
          "text": "Tuttavia, Claudia girò la pagina e appoggiò sul tavolo la prima cartellina delle fatture da saldare.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "tuttavia",
