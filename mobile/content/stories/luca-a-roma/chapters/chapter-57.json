    {
      "id": "p8",
      "order": 8,
      "sentences": [
        {
          "id": "s25",
          "text": "Quando Claudia spinse il tasto di calcolo per ottenere il risultato netto finale, sul display apparve una cifra sorprendentemente modesta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
