            "fare",
            "una",
            "domanda",
            "preciso"
          ]
        },
        {
          "id": "s40",
          "text": "«Quante ore siamo aperti ogni giorno senza vendere quasi niente?",
          "speakerId": null,
          "kind": "dialogue",
          "lemmas": [
