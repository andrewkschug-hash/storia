        },
        {
          "id": "s35",
          "text": "«No, Luca.",
          "speakerId": null,
          "kind": "dialogue",
          "lemmas": [
            "no",
            "luca"
          ]
        },
        {
          "id": "s36",
          "text": "Non dobbiamo abbassare la qualità del nostro lavoro.",
          "speakerId": null,
          "kind": "dialogue",
          "lemmas": [
            "non",
            "dovere",
            "abbassare",
            "la",
