            "laboratorio",
            "esistere"
          ]
        },
        {
          "id": "s38",
          "text": "Il problema centrale del nostro bilancio non è il costo dei chicchi buoni.»",
          "speakerId": null,
          "kind": "dialogue",
          "lemmas": [
