    {
      "id": "p12",
      "order": 12,
      "sentences": [
        {
          "id": "s39",
          "text": "Fece una pausa, indicò il grafico delle presenze orarie disegnato sulla pagina destra e fece una domanda precisa:",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
