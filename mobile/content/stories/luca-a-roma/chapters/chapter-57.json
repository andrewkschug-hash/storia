          ]
        },
        {
          "id": "s41",
          "text": "Dalle dieci e mezza del mattino fino alle quattro del pomeriggio abbiamo luci accese, riscaldamento e macchine in pressione, ma entrano appena tre persone all'ora.",
          "speakerId": null,
          "kind": "dialogue",
          "lemmas": [
            "da",
            "dieci",
            "e",
            "mezzo",
