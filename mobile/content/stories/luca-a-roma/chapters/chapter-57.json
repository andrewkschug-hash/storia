  "events": [
    {
      "id": "ev-57-month-end-accounts",
      "summary": "On a rainy Sunday afternoon at Spazio Monti, Luca and Claudia calculate their first monthly balance sheet, discovering that high ingredient costs and midday empty hours leave a paper-thin net margin.",
      "characterIds": [
        "luca"
      ],
      "locationIds": [
        "quartiere",
        "centro",
        "strada"
      ],
      "rememberedFacts": [
        "On Sunday afternoon, Luca and Claudia close Spazio Monti to draw up their first monthly financial balance sheet",
        "Gross sales look encouraging with over two thousand visitors in October, but high ingredient costs and fixed facility bills consume most revenue",
        "Luca’s net take-home compensation for the month is lower than his old barista base salary at Bar Centrale",
        "Luca considers switching to cheaper commercial coffee beans to save money, but Claudia firmly rejects lowering quality",
        "Claudia points out that the true problem is the empty midday hours between ten-thirty and four, prompting Luca to realize craft must be economically sustainable"
      ]
    }
  ],
  "paragraphs": [
    {
