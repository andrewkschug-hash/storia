      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Domenica pomeriggio alle cinque, quando la luce grigia di fine ottobre cominciava a spegnersi sui tetti di Via dei Serpenti, lo Spazio Monti era chiuso al pubblico.",
          "speakerId": null,
          "kind": "narration",
