          ]
        },
        {
          "id": "s15",
          "text": "Assaggiando un piccolo sorso a occhi chiusi, ha ritrovato quell'armonia perfetta tra dolcezza naturale e corpo vellutato che aveva cercato ostinatamente per mesi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
