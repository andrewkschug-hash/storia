      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Nelle quarantott'ore successive all'incontro di Monti, Luca non ha sprecato neppure un minuto a lamentarsi delle condizioni rigide dello sponsor o a sognare scorciatoie facili e romantiche.",
          "speakerId": null,
          "kind": "narration",
