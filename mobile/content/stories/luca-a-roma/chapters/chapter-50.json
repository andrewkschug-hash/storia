    {
      "id": "p5",
      "order": 5,
      "sentences": [
        {
          "id": "s22",
          "text": "L'uomo ha preso dal portafoglio le monete per pagare la consumazione, lasciando una generosa mancia sul banco di zinco, e ha estratto dalla tasca interna della giacca un elegante biglietto da visita in cartoncino spesso avorio con lettere incise in rilievo dorato.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "uomo",
            "avere",
            "prendere",
