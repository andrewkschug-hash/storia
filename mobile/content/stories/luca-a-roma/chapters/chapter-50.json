  "events": [
    {
      "id": "ev-50-discerning-customer",
      "summary": "A discerning stranger visits Bruno's café, tastes Luca's single-origin espresso, and invites him to discuss a professional project in Rione Monti.",
      "characterIds": [
        "luca",
        "padrone"
      ],
      "locationIds": [
        "lavoro-caffe",
        "quartiere",
        "strada"
      ],
      "rememberedFacts": [
        "Bruno permits Luca to offer a single-origin Ethiopian coffee alongside the traditional blend",
        "A quiet, observant customer named Matteo notices the second grinder and orders an espresso without sugar",
        "Matteo watches Luca's precise technique and praises the controlled acidity and craft balance of the cup",
        "Matteo reveals he directs a cultural literary café in Rione Monti and invites Luca to a meeting on Saturday",
        "Luca holds Matteo's business card, realizing an external professional opportunity has arrived"
      ]
    }
  ],
