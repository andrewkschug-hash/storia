    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s12",
          "text": "Luca ha annuito con garbo e si è messo subito all'opera, sentendo su di sé l'attenzione discreta ma precisissima del cliente, che seguiva ogni suo singolo gesto senza distogliere lo sguardo.",
          "speakerId": null,
          "kind": "narration",
