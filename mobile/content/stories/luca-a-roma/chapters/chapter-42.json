  "events": [
    {
      "id": "ev-42-evening-audit",
      "summary": "Luca assists Bruno with evening inventory and supplier invoices, discovering the tight financial reality of the business.",
      "characterIds": [
        "luca",
        "padrone"
      ],
      "locationIds": [
        "lavoro-caffe"
      ],
      "rememberedFacts": [
        "Luca and Bruno review supplier invoices and payment deadlines after closing",
        "Utility bills and supplier costs have risen while profit margins have narrowed",
        "Luca learns the real operating balance of the trattoria behind the counter"
      ]
    },
    {
      "id": "ev-42-bruno-reflection",
      "summary": "Bruno shares his physical weariness and reflects on his thirty-five years of commercial life.",
      "characterIds": [
        "luca",
        "padrone"
      ],
      "locationIds": [
        "lavoro-caffe"
      ],
      "rememberedFacts": [
        "Bruno asks about Luca's father and discusses the physical toll of aging",
        "Bruno expresses doubt that the business can continue without major structural investment",
        "Bruno tells Luca that behind every good coffee lies a fragile economic balance"
      ]
    }
  ],
  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Il giovedì sera il bar chiudeva alle otto in punto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "giovedi",
            "sera",
            "il",
            "bar",
            "chiudere",
            "alle",
            "otto",
            "in",
            "punto"
          ]
        },
        {
          "id": "s02",
          "text": "Giulia aveva finito il suo turno, aveva pulito la macchina del caffè e se n'era andata verso la metropolitana.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "giulia",
            "avere",
            "finire",
            "il",
            "suo",
            "turno",
            "avere",
            "pulito",
            "la",
            "macchina",
            "del",
            "caffe",
            "e",
            "se",
            "ne",
            "andare",
            "verso",
            "la",
            "metropolitana"
          ]
        },
        {
          "id": "s03",
          "text": "Luca aveva abbassato la saracinesca fino a metà, lasciando entrare soltanto l'aria fresca della sera.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "abbassare",
            "la",
            "saracinesca",
            "fino",
            "a",
            "meta",
            "lasciare",
            "entrare",
            "soltanto",
            "aria",
            "fresco",
            "della",
            "sera"
          ]
        },
        {
          "id": "s04",
          "text": "Mentre spazzava il pavimento di marmo, ha notato che Bruno era ancora seduto al tavolo in fondo alla sala.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "mentre",
            "spazzare",
            "il",
            "pavimento",
            "di",
            "marmo",
            "avere",
            "notare",
            "che",
            "bruno",
            "essere",
            "ancora",
            "sedersi",
            "al",
            "tavolo",
            "in",
            "fondo",
            "alla",
            "sala"
          ]
        },
        {
          "id": "s05",
          "text": "Sotto la luce calda di una lampada sospesa, il vecchio padrone aveva aperto due grandi scatole di cartone e una dozzina di cartelle colorate.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sotto",
            "la",
            "luce",
            "caldo",
            "di",
            "una",
            "lampada",
            "sospeso",
            "il",
            "vecchio",
            "padrone",
            "avere",
            "aperto",
            "due",
            "grande",
            "scatola",
            "di",
            "cartone",
            "e",
            "una",
            "dozzina",
            "di",
            "cartella",
            "colorato"
          ]
        },
        {
          "id": "s06",
          "text": "«Luca, hai cinque minuti prima di andare a casa?» ha chiesto Bruno con voce calma, senza alzare lo sguardo dai fogli.",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "luca",
            "avere",
            "cinque",
            "minuto",
            "primo",
            "di",
            "andare",
            "a",
            "casa",
            "avere",
            "chiedere",
            "bruno",
            "con",
            "voce",
            "calmo",
            "senza",
            "alzare",
            "lo",
            "sguardo",
            "da",
            "foglio"
          ]
        },
        {
          "id": "s07",
          "text": "«Certo, signor Bruno. Ho quasi finito di riordinare il banco. Ha bisogno di aiuto con quelle carte?»",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "certo",
            "signore",
            "bruno",
            "avere",
            "quasi",
            "finire",
            "di",
            "riordinare",
            "il",
            "banco",
            "avere",
            "bisogno",
            "di",
            "aiuto",
            "con",
            "quello",
            "carta"
          ]
        },
        {
          "id": "s08",
          "text": "«Sì. Siediti qui con me. È importante che tu veda come funzionano davvero i numeri di questo posto.»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "si_yes",
            "sedere",
            "qui",
            "con",
            "me",
            "essere",
            "importante",
            "che",
            "tu",
            "vedere",
            "come",
            "funzionare",
            "davvero",
            "i",
            "numero",
            "di",
            "questo",
            "posto"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s09",
          "text": "Luca ha appoggiato la scopa nell'angolo, si è tolto il grembiule e si è seduto di fronte a Bruno.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "appoggiare",
            "la",
            "scopa",
            "angolo",
            "si",
            "essere",
            "togliere",
            "il",
            "grembiule",
            "e",
            "si",
            "essere",
            "sedersi",
            "di",
            "fronte",
            "a",
            "bruno"
          ]
        },
        {
          "id": "s10",
          "text": "Sul tavolo c'erano le fatture dei fornitori divise per categoria: il latte fresco, la torrefazione del caffè, i prodotti del forno e le bevande.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sul",
            "tavolo",
            "ce",
            "le",
            "fattura",
            "dei",
            "fornitore",
            "diviso",
            "per",
            "categoria",
            "il",
            "latte",
            "fresco",
            "la",
            "torrefazione",
            "del",
            "caffe",
            "i",
            "prodotto",
            "del",
            "forno",
            "e",
            "le",
            "bevanda"
          ]
        },
        {
          "id": "s11",
          "text": "Accanto c'era un elenco scritto a mano con tutte le scadenze dei pagamenti di ottobre.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "accanto",
            "ce",
            "un",
            "elenco",
            "scrivere",
            "a",
            "mano",
            "con",
            "tutto",
            "le",
            "scadenza",
            "dei",
            "pagamento",
            "di",
            "ottobre"
          ]
        },
        {
          "id": "s12",
          "text": "Bruno gli ha passato una cartella rossa con i conti degli ultimi sei mesi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruno",
            "gli",
            "avere",
            "passare",
            "una",
            "cartella",
            "rosso",
            "con",
            "i",
            "conto",
            "di",
            "ultimo",
            "sei",
            "mese"
          ]
        },
        {
          "id": "s13",
          "text": "«Prendi questa calcolatrice, Luca. Somma le voci dell'elettricità e del gas.»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "prendere",
            "questo",
            "calcolatrice",
            "luca",
            "somma",
            "le",
            "voce",
            "elettricita",
            "e",
            "del",
            "gas"
          ]
        },
        {
          "id": "s14",
          "text": "Luca ha digitato i numeri uno alla volta sul display grigio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "digitare",
            "i",
            "numero",
            "uno",
            "alla",
            "volta",
            "sul",
            "display",
            "grigio"
          ]
        },
        {
          "id": "s15",
          "text": "Quando ha visto il totale, è rimasto sorpreso: le bollette erano raddoppiate rispetto all'anno prima.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "quando",
            "avere",
            "vedere",
            "il",
            "totale",
            "essere",
            "rimanere",
            "sorprendere",
            "le",
            "bolletta",
            "essere",
            "raddoppiare",
            "rispetto",
            "anno",
            "primo"
          ]
        },
        {
          "id": "s16",
          "text": "«I clienti vedono il bar sempre pieno la mattina e pensano che guadagniamo una fortuna» ha detto Bruno con un mezzo sorriso amaro.",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "i",
            "cliente",
            "vedere",
            "il",
            "bar",
            "sempre",
            "pieno",
            "la",
            "mattina",
            "e",
            "pensare",
            "che",
            "guadagnare",
            "una",
            "fortuna",
            "avere",
            "dire",
            "bruno",
            "con",
            "un",
            "mezzo",
            "sorriso",
            "amaro"
          ]
        },
        {
          "id": "s17",
          "text": "«Ma se il costo del caffè crudo e dell'elettricità sale ogni mese e noi teniamo il prezzo dell'espresso a un euro e venti, il margine di guadagno scompare quasi del tutto.»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "ma",
            "se",
            "il",
            "costo",
            "del",
            "caffe",
            "crudo",
            "e",
            "elettricita",
            "salire",
            "ogni",
            "mese",
            "e",
            "noi",
            "tenere",
            "il",
            "prezzo",
            "espresso",
            "a",
            "un",
            "euro",
            "e",
            "venti",
            "il",
            "margine",
            "di",
            "guadagno",
            "scomparire",
            "quasi",
            "del",
            "tutto"
          ]
        },
        {
          "id": "s18",
          "text": "Per la prima volta, Luca capiva la differenza fondamentale tra il fatturato totale e l'utile netto reale che rimaneva alla fine del mese.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "per",
            "la",
            "primo",
            "volta",
            "luca",
            "capire",
            "la",
            "differenza",
            "fondamentale",
            "tra",
            "il",
            "fatturato",
            "totale",
            "e",
            "utile",
            "netto",
            "reale",
            "che",
            "rimanere",
            "alla",
            "fine",
            "del",
            "mese"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s19",
          "text": "Bruno ha preso un foglio di bilancio timbrato dal commercialista e lo ha allungato sul tavolo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruno",
            "avere",
            "prendere",
            "un",
            "foglio",
            "di",
            "bilancio",
            "timbrare",
            "dal",
            "commercialista",
            "e",
            "lo",
            "avere",
            "allungare",
            "sul",
            "tavolo"
          ]
        },
        {
          "id": "s20",
          "text": "«Temo che le spese fisse siano diventate troppo pesanti per una sola persona.»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "temere",
            "che",
            "le",
            "spesa",
            "fisso",
            "essere",
            "diventare",
            "troppo",
            "pesante",
            "per",
            "una",
            "solo",
            "persona"
          ]
        },
        {
          "id": "s21",
          "text": "«C'è l'affitto del locale da pagare ogni mese, le tasse comunali sui rifiuti e le rate del vecchio prestito bancario per la cucina.»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "esserci",
            "affitto",
            "del",
            "locale",
            "da",
            "pagare",
            "ogni",
            "mese",
            "le",
            "tassa",
            "comunale",
            "su",
            "rifiuto",
            "e",
            "le",
            "rata",
            "del",
            "vecchio",
            "prestito",
            "bancario",
            "per",
            "la",
            "cucina"
          ]
        },
        {
          "id": "s22",
          "text": "«Non si può aumentare il prezzo del caffè di trenta centesimi per compensare i costi?» ha chiesto Luca con prudenza.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "si",
            "potere",
            "aumentare",
            "il",
            "prezzo",
            "del",
            "caffe",
            "di",
            "trenta",
            "centesimo",
            "per",
            "compensare",
            "i",
            "costo",
            "avere",
            "chiedere",
            "luca",
            "con",
            "prudenza"
          ]
        },
        {
          "id": "s23",
          "text": "«Dubito che i residenti del quartiere accetterebbero un aumento così forte senza lamentarsi o andare al bar della piazza accanto.»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "dubitare",
            "che",
            "i",
            "residente",
            "del",
            "quartiere",
            "accettare",
            "un",
            "aumento",
            "cosi",
            "forte",
            "senza",
            "lamentarsi",
            "o",
            "andare",
            "al",
            "bar",
            "della",
            "piazza",
            "accanto"
          ]
        },
        {
          "id": "s24",
          "text": "«A Roma il caffè non è soltanto una bevanda, è un'abitudine sociale. Se tocchi quel prezzo, tocchi un equilibrio delicato.»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "a",
            "roma",
            "il",
            "caffe",
            "non",
            "essere",
            "soltanto",
            "una",
            "bevanda",
            "essere",
            "abitudine",
            "sociale",
            "se",
            "toccare",
            "quello",
            "prezzo",
            "toccare",
            "un",
            "equilibrio",
            "delicato"
          ]
        },
        {
          "id": "s25",
          "text": "«È necessario che un locale trovi nuove entrate, magari con gli aperitivi serali o con una ristorazione più curata, ma per fare questo servono investimenti e forze fresche.»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "essere",
            "necessario",
            "che",
            "un",
            "locale",
            "trovare",
            "nuovo",
            "entrata",
            "magari",
            "con",
            "gli",
            "aperitivo",
            "serale",
            "o",
            "con",
            "una",
            "ristorazione",
            "piu",
            "curato",
            "ma",
            "per",
            "fare",
            "questo",
            "servire",
            "investimento",
            "e",
            "forza",
            "fresco"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s26",
          "text": "Bruno ha posato la penna sul quaderno e si è appoggiato allo schienale della sedia di legno, massaggiandosi la gamba con entrambe le mani.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruno",
            "avere",
            "posare",
            "la",
            "penna",
            "sul",
            "quaderno",
            "e",
            "si",
            "essere",
            "appoggiare",
            "a",
            "schienale",
            "della",
            "sedia",
            "di",
            "legno",
            "massaggiare",
            "la",
            "gamba",
            "con",
            "entrambi",
            "le",
            "mano"
          ]
        },
        {
          "id": "s27",
          "text": "I suoi occhi mostravano una stanchezza profonda che non derivava soltanto dalle ore di lavoro di quella giornata.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "i",
            "suo",
            "occhio",
            "mostrare",
            "una",
            "stanchezza",
            "profondo",
            "che",
            "non",
            "derivare",
            "soltanto",
            "da",
            "ora",
            "di",
            "lavoro",
            "di",
            "quello",
            "giornata"
          ]
        },
        {
          "id": "s28",
          "text": "«Dimmi una cosa, Luca. Quanti anni ha tuo padre?»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "dire",
            "una",
            "cosa",
            "luca",
            "quanto",
            "anno",
            "avere",
            "tuo",
            "padre"
          ]
        },
        {
          "id": "s29",
          "text": "«Ne compie sessanta a novembre» ha risposto Luca, stupito da quella domanda personale.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "ne",
            "compiere",
            "sessanta",
            "a",
            "novembre",
            "avere",
            "rispondere",
            "luca",
            "stupito",
            "da",
            "quello",
            "domanda",
            "personale"
          ]
        },
        {
          "id": "s30",
          "text": "«Lavora ancora nei campi a Pietralba, ma la sera si siede presto davanti al camino perché la schiena gli fa male.»",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "lavorare",
            "ancora",
            "nei",
            "campo",
            "a",
            "pietralba",
            "ma",
            "la",
            "sera",
            "si",
            "sedere",
            "presto",
            "davanti",
            "al",
            "camino",
            "perche",
            "la",
            "schiena",
            "gli",
            "fare",
            "male"
          ]
        },
        {
          "id": "s31",
          "text": "Bruno ha annuito lentamente con lo sguardo rivolto verso gli specchi vuoti del bar.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruno",
            "avere",
            "annuire",
            "lentamente",
            "con",
            "lo",
            "sguardo",
            "rivolgere",
            "verso",
            "gli",
            "specchio",
            "vuoto",
            "del",
            "bar"
          ]
        },
        {
          "id": "s32",
          "text": "«Ecco. Tuo padre capisce esattamente cosa intendo. A una certa età, il corpo comincia a chiedere il conto di ogni sforzo passato.»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "ecco",
            "tuo",
            "padre",
            "capire",
            "esattamente",
            "cosa",
            "intendere",
            "a",
            "una",
            "certo",
            "eta",
            "il",
            "corpo",
            "cominciare",
            "a",
            "chiedere",
            "il",
            "conto",
            "di",
            "ogni",
            "sforzo",
            "passare"
          ]
        },
        {
          "id": "s33",
          "text": "«Non è che mi manchi la passione; è che ogni mattina sento il peso di trentacinque anni di sveglie all'alba.»",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "essere",
            "che",
            "mi",
            "mancare",
            "la",
            "passione",
            "essere",
            "che",
            "ogni",
            "mattina",
            "sentire",
            "il",
            "peso",
            "di",
            "trentacinque",
            "anno",
            "di",
            "sveglia",
            "alba"
          ]
        },
        {
          "id": "s34",
          "text": "Luca ha ascoltato in silenzio, sentendo una stretta al cuore: capiva che Bruno non stava parlando soltanto di bollette e fornitori, ma stava confidando la fine della propria resistenza fisica.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "ascoltare",
            "in",
            "silenzio",
            "sentire",
            "una",
