      "order": 4,
      "sentences": [
        {
          "id": "s17",
          "text": "Luca ha preso la tazzina di porcellana calda tra le mani, ha mescolato delicatamente la crema con un cucchiaino d'argento per uniformare gli strati aromatici e ha avvicinato il bordo alle labbra.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
