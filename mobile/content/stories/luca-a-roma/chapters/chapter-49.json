          ]
        },
        {
          "id": "s10",
          "text": "Nel secondo esperimento ha stretto eccessivamente le macine per rimediare, ma il caffè è uscito a gocce dolorosamente lente, bruciandosi contro il metallo surriscaldato e sprigionando un sapore amaro e pungente di cenere.",
          "speakerId": null,
          "kind": "narration",
