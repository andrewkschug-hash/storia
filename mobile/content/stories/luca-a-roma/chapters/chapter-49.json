    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s06",
          "text": "Ha posizionato una bilancia digitale di precisione accanto al macinacaffè e ha aperto il primo sacchetto, accogliendo un profumo intenso, floreale e complesso che non somigliava affatto alla tradizionale miscela commerciale del bar.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
