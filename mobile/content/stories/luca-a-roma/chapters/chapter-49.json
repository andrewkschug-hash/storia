          ]
        },
        {
          "id": "s18",
          "text": "Il primo sorso ha rivelato un profilo gustativo completamente inedito e sorprendente rispetto all'amarezza bruciata dei classici caffè da banco a cui era sempre stato abituato e che i clienti coprivano con cucchiai di zucchero.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
