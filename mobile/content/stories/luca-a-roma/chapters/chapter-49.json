          ]
        },
        {
          "id": "s20",
          "text": "Non era una bevanda perfetta e forse molti clienti tradizionali del quartiere l'avrebbero trovata troppo complessa o insolita al primo impatto, ma possedeva un'identità viva, vibrante, autentica e inconfondibile.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
