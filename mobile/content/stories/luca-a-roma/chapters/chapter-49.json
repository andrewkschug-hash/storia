          ]
        },
        {
          "id": "s11",
          "text": "Quattro tazzine scartate e raffreddate si allineavano già sul banco, testimoniando la faticosa resistenza della materia contro le facili illusioni della mente.",
          "speakerId": null,
          "kind": "narration",
