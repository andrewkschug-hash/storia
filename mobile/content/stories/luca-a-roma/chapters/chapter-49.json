  "events": [
    {
      "id": "ev-49-after-hours-experiment",
      "summary": "After closing time at Bruno's, Luca stays late to experiment with specialty coffee beans, combining scientific discipline with artisanal craft.",
      "characterIds": [
        "luca",
        "padrone"
      ],
      "locationIds": [
        "lavoro-caffe",
        "quartiere",
        "strada"
      ],
      "rememberedFacts": [
        "Bruno gives Luca the spare keys to stay after closing and use the café's professional espresso machine",
        "Luca brings three bags of specialty single-origin coffee beans purchased from an artisanal roastery in Ostiense",
        "His initial extractions fail due to grind size and water flow issues, producing sour or burnt results",
        "By calibrating grind, dose, and extraction time, Luca produces a balanced cup with citrus and chocolate notes",
        "Luca logs his exact parameters in a notebook, taking his first concrete step as an active creator"
      ]
    }
  ],
  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Martedì sera, verso le nove e mezza, Bruno ha abbassato a metà la serranda metallica del locale, ha consegnato a Luca la copia delle chiavi di scorta e si è congedato con un cenno affettuoso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
