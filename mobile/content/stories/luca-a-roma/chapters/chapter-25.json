              "naturalEn": "we’ll see",
              "tokenStart": 1,
              "tokenEnd": 1
            }
          ]
        },
        {
          "id": "s18",
          "text": "Luca ha servito i pochi clienti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "servire",
            "i",
            "poco",
            "cliente"
          ]
        },
        {
          "id": "s19",
          "text": "Ha portato caffè e ha ascoltato i clienti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "portare",
            "caffe",
            "e",
            "avere",
            "ascoltare",
            "i",
            "cliente"
          ]
        },
        {
          "id": "s20",
          "text": "Ogni cliente era importante.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ogni",
            "cliente",
            "essere",
            "importante"
          ]
        },
        {
          "id": "s22",
          "text": "Nel pomeriggio la sala restava ancora quasi vuota.",
