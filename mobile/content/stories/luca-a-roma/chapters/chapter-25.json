          "kind": "narration",
          "lemmas": [
            "non",
            "lo",
            "sapere",
            "e",
            "volere",
            "capire"
          ]
        },
        {
          "id": "s29",
          "text": "Alla sera il padrone ha chiamato Luca e Giulia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "alla",
            "sera",
            "il",
            "padrone",
            "avere",
            "chiamare",
            "luca",
            "e",
            "giulia"
          ]
        },
        {
          "id": "s30",
          "text": "Domani mattina parliamo. È importante.",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "domani",
            "mattina",
            "parlare",
            "essere",
