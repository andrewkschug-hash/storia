          "lemmas": [
            "luca",
            "guardare",
            "la",
            "sala",
            "e",
            "i",
            "tavolo",
            "vuoto"
          ]
        },
        {
          "id": "s05",
          "text": "Poi ha aperto la porta e ha preparato i tavoli con calma.",
