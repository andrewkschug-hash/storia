  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Lunedì mattina il caffè è diverso dal solito.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lunedi",
            "mattina",
            "il",
            "caffe",
            "essere",
            "diverso",
            "dal",
            "solito"
          ]
        },
        {
          "id": "s02",
          "text": "Ci sono meno clienti e la sala è tranquilla.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ci",
            "essere",
            "meno",
            "cliente",
            "e",
            "la",
            "sala",
            "essere",
            "tranquillo"
          ]
        },
        {
          "id": "s03",
          "text": "Luca è arrivato presto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "essere",
            "arrivare",
            "presto"
          ]
        },
        {
          "id": "s04",
          "text": "Luca guarda la sala e i tavoli vuoti.",
