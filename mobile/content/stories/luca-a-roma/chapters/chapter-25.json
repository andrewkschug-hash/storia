          "lemmas": [
            "il",
            "padrone",
            "essere",
            "preoccupato",
            "io",
            "lo",
            "vedere"
          ]
        },
        {
          "id": "s24",
          "text": "Anch’io. Il caffè non va bene, e il mio lavoro non va bene.",
