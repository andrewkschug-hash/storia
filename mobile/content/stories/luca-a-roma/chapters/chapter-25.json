            "non",
            "avere",
            "dire",
            "niente",
            "a",
            "giulia",
            "e",
            "a",
            "luca"
          ]
        },
        {
          "id": "s17",
          "text": "Lavoriamo. Vediamo come va oggi.",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "lavorare",
            "vedere",
            "come",
            "andare",
            "oggi"
          ],
          "phrases": [
