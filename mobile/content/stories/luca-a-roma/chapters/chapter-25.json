              "naturalEn": "it depends",
              "tokenStart": 0,
              "tokenEnd": 0
            }
          ]
        },
        {
          "id": "s11",
          "text": "Fuori non faceva freddo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "fuori",
            "non",
            "fare",
            "freddo"
          ]
        },
        {
          "id": "s12",
          "text": "Il problema sembrava un altro.",
