  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Lunedì mattina Luca torna al lavoro dopo la domenica.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lunedi",
            "mattina",
            "luca",
            "tornare",
            "al",
            "lavorare",
            "dopo",
            "la",
            "domenica"
          ]
        },
        {
          "id": "s02",
          "text": "Il quartiere è tranquillo e il tempo è bello.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "quartiere",
            "essere",
            "tranquillo",
            "e",
            "il",
            "tempo",
            "essere",
            "bello"
          ]
        },
        {
          "id": "s03",
          "text": "Luca conosce bene il caffè, ma oggi qualcosa è diverso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "conoscere",
            "bene",
            "il",
            "caffe",
            "ma",
            "oggi",
            "qualcosa",
            "essere",
            "diverso"
          ]
        },
        {
          "id": "s04",
          "text": "La sala è più tranquilla del solito.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "sala",
            "essere",
            "piu",
            "tranquillo",
            "del",
            "solito"
          ]
        },
        {
          "id": "s05",
          "text": "Ci sono meno clienti. I tavoli sono pronti, ma sono vuoti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ci",
            "essere",
            "meno",
            "cliente",
            "i",
            "tavolo",
            "essere",
            "pronto",
            "ma",
            "essere",
            "vuoto"
          ]
        },
        {
          "id": "s06",
          "text": "Luca aspetta vicino alla porta. Quasi nessuno entra.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "aspettare",
            "vicino",
            "alla",
            "porta",
            "quasi",
            "nessuno",
            "entrare"
          ]
        },
        {
          "id": "s07",
          "text": "Guarda i tavoli vuoti e la strada fuori.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "guardare",
            "i",
            "tavolo",
            "vuoto",
            "e",
            "la",
            "strada",
            "fuori"
          ]
        },
        {
          "id": "s08",
          "text": "Luca è arrivato presto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "essere",
            "arrivare",
            "presto"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s09",
          "text": "Ha aperto la porta e ha preparato i tavoli con calma.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "aprire",
            "la",
            "porta",
            "e",
            "avere",
            "preparare",
            "i",
            "tavolo",
            "con",
            "calma"
          ]
        },
        {
          "id": "s10",
          "text": "Sono entrati pochi clienti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "entrare",
            "poco",
            "cliente"
          ]
        },
        {
          "id": "s11",
          "text": "Luca ha servito caffè e acqua al primo cliente. Giulia ha guardato i tavoli e non ha sorriso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "servire",
            "caffe",
            "e",
            "acqua",
            "al",
            "primo",
            "cliente",
            "giulia",
            "avere",
            "guardare",
            "i",
            "tavolo",
            "e",
            "non",
            "avere",
            "sorridere"
          ]
        },
        {
          "id": "s12",
          "text": "Questa settimana è strana. Quasi nessuno entra.",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
            "questo",
            "settimana",
            "essere",
            "strano",
            "quasi",
            "nessuno",
            "entrare"
          ]
        },
        {
          "id": "s13",
          "text": "Dipende dal tempo, forse.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "dipendere",
            "dal",
            "tempo",
            "forse"
          ],
          "phrases": [
            {
              "surface": "Dipende",
              "literalEn": "it depends",
              "naturalEn": "it depends",
              "tokenStart": 0,
              "tokenEnd": 0
            }
          ]
        },
        {
          "id": "s14",
          "text": "Fuori il tempo è bello, ma il caffè ha un problema.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "fuori",
            "il",
            "tempo",
            "essere",
            "bello",
            "ma",
            "il",
            "caffe",
            "avere",
            "un",
            "problema"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s15",
          "text": "Il padrone è arrivato tardi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "padrone",
            "essere",
            "arrivare",
            "tardi"
          ]
        },
        {
          "id": "s16",
          "text": "Non ha detto niente a Giulia e a Luca.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "avere",
            "dire",
            "niente",
            "a",
            "giulia",
            "e",
            "a",
            "luca"
          ]
        },
        {
          "id": "s17",
          "text": "Lavoriamo. Vediamo come va oggi.",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "lavorare",
            "vedere",
            "come",
            "andare",
            "oggi"
          ],
          "phrases": [
            {
              "surface": "Vediamo",
              "literalEn": "we see",
              "naturalEn": "we'll see",
              "tokenStart": 1,
              "tokenEnd": 1
            }
          ]
        },
        {
          "id": "s18",
          "text": "Luca ha servito i pochi clienti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "servire",
            "i",
            "poco",
            "cliente"
          ]
        },
        {
          "id": "s19",
          "text": "Ha portato caffè e ha ascoltato i clienti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "portare",
            "caffe",
            "e",
            "avere",
            "ascoltare",
            "i",
            "cliente"
          ]
        },
        {
          "id": "s20",
          "text": "Ogni cliente è importante per il caffè del quartiere.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ogni",
            "cliente",
            "essere",
            "importante",
            "per",
            "il",
            "caffe",
            "del",
            "quartiere"
          ]
        },
        {
          "id": "s21",
          "text": "Nel pomeriggio la sala è ancora quasi vuota.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "nel",
            "pomeriggio",
            "la",
            "sala",
            "essere",
            "ancora",
            "quasi",
            "vuoto"
          ]
        },
        {
          "id": "s22",
          "text": "Il padrone guarda la sala e non parla molto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "padrone",
            "guardare",
            "la",
            "sala",
            "e",
            "non",
            "parlare",
            "molto"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s23",
          "text": "Il padrone è preoccupato. Lo vedo.",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
            "il",
            "padrone",
            "essere",
            "preoccupato",
            "lo",
            "vedere"
          ]
        },
        {
          "id": "s24",
          "text": "Anch’io. Il caffè non va bene, e il mio lavoro non va bene.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "anche",
            "il",
            "caffe",
            "non",
            "andare",
            "bene",
            "e",
            "il",
            "mio",
            "lavorare",
            "non",
            "andare",
            "bene"
          ]
        },
        {
          "id": "s25",
          "text": "Luca ha pensato al lavoro e all’affitto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "pensare",
            "al",
            "lavorare",
            "e",
            "affitto"
          ]
        },
        {
          "id": "s26",
          "text": "Non capisce perché ci sono pochi clienti adesso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "capire",
            "perche",
            "ci",
            "essere",
            "poco",
            "cliente",
            "adesso"
          ]
        },
        {
          "id": "s27",
          "text": "Alla sera il padrone ha chiamato Luca e Giulia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "alla",
            "sera",
            "il",
            "padrone",
            "avere",
            "chiamare",
            "luca",
            "e",
            "giulia"
          ]
        },
        {
          "id": "s28",
          "text": "Domani mattina parliamo. È importante.",
          "speakerId": "padrone",
          "kind": "dialogue",
          "lemmas": [
            "domani",
            "mattina",
            "parlare",
            "essere",
            "importante"
          ]
        }
      ]
    },
    {
      "id": "p5",
      "order": 5,
      "sentences": [
        {
          "id": "s29",
          "text": "La sera Luca è tornato a casa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "sera",
            "luca",
            "essere",
            "tornare",
            "a",
            "casa"
          ]
        },
        {
          "id": "s30",
          "text": "Ha contato i soldi per l’affitto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "contare",
            "i",
            "soldi",
            "per",
            "affitto"
          ]
        },
        {
          "id": "s31",
          "text": "Ha i soldi per questo mese, ma il mese prossimo è difficile.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "i",
            "soldi",
            "per",
            "questo",
            "mese",
            "ma",
            "il",
            "mese",
            "prossimo",
            "essere",
            "difficile"
          ]
        },
        {
          "id": "s32",
          "text": "Luca pensa all’affitto e al lavoro al caffè.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "pensare",
            "affitto",
            "e",
            "al",
            "lavorare",
            "al",
            "caffe"
          ]
        },
        {
          "id": "s33",
          "text": "A casa è vicino alla finestra e pensa al caffè.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "a",
            "casa",
            "essere",
            "vicino",
            "alla",
            "finestra",
            "e",
            "pensare",
            "al",
            "caffe"
          ]
        },
        {
          "id": "s34",
          "text": "Il quartiere è tranquillo, ma Luca non è tranquillo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "quartiere",
            "essere",
            "tranquillo",
            "ma",
            "luca",
            "non",
            "essere",
            "tranquillo"
          ]
        },
        {
          "id": "s35",
          "text": "Poi ha scritto un messaggio a Sofia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "avere",
            "scrivere",
            "un",
            "messaggio",
            "a",
            "sofia"
          ]
        },
        {
          "id": "s36",
          "text": "Ha scritto: «Il lavoro è strano questa settimana.»",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "scrivere",
            "il",
            "lavorare",
            "essere",
            "strano",
            "questo",
            "settimana"
          ]
        },
        {
          "id": "s37",
          "text": "Sofia ha risposto tardi: «Va bene. Parliamo presto.»",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sofia",
            "avere",
            "rispondere",
            "tardi",
            "andare",
            "bene",
            "parlare",
            "presto"
          ]
        },
        {
          "id": "s38",
          "text": "Domani al caffè Luca vuole capire di più.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "domani",
            "al",
            "caffe",
            "luca",
            "volere",
            "capire",
            "di",
            "piu"
          ]
        }
      ]
    }
