            "avere",
            "preparare",
            "i",
            "tavolo",
            "con",
            "calma"
          ]
        },
        {
          "id": "s06",
          "text": "Aspettava i clienti vicino alla porta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "aspettare",
            "i",
            "cliente",
            "vicino",
            "alla",
            "porta"
          ]
        },
        {
          "id": "s07",
          "text": "La mattina sono entrati pochi clienti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "mattina",
            "essere",
            "entrare",
            "poco",
            "cliente"
          ]
        },
        {
          "id": "s08",
          "text": "Giulia ha guardato i tavoli e non ha sorriso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "giulia",
            "avere",
            "guardare",
            "i",
            "tavolo",
            "e",
            "non",
            "avere",
            "sorridere"
          ]
        },
        {
          "id": "s09",
          "text": "Questa settimana è strana. Quasi nessuno entra.",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
            "questo",
            "settimana",
            "essere",
            "strano",
            "quasi",
            "nessuno",
            "entrare"
          ]
        },
        {
          "id": "s10",
          "text": "Dipende dal tempo, forse.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "dipendere",
            "dal",
            "tempo",
            "forse"
