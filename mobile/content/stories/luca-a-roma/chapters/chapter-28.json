      ]
    }
  ],
  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Giovedì pomeriggio Marco è arrivato al caffè di Luca.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "giovedi",
            "pomeriggio",
            "marco",
            "essere",
            "arrivare",
            "al",
            "caffe",
            "di",
            "luca"
          ]
        },
        {
          "id": "s02",
          "text": "C’erano pochi clienti e la sala era tranquilla.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ce",
            "poco",
            "cliente",
            "e",
            "la",
            "sala",
            "essere",
            "tranquillo"
          ]
        },
        {
          "id": "s03",
          "text": "Luca lo ha visto vicino alla porta del caffè e ha sorriso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "lo",
            "avere",
            "vedere",
            "vicino",
            "alla",
            "porta",
            "del",
            "caffe",
            "e",
            "avere",
            "sorridere"
          ]
        },
        {
          "id": "s04",
          "text": "Marco non ha sorriso. Ha parlato con voce stanca.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "marco",
            "non",
            "avere",
            "sorridere",
            "avere",
            "parlare",
            "con",
            "voce",
            "stanco"
          ]
        },
        {
          "id": "s05",
          "text": "Ciao Luca. Posso stare un momento? Non ho soldi.",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "ciao",
            "luca",
            "potere",
            "stare",
            "un",
            "momento",
            "non",
            "avere",
            "soldi"
          ]
        },
        {
          "id": "s06",
          "text": "Stai. Non c’è problema. L’acqua è per te, Marco.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "stare",
            "non",
            "ce",
            "problema",
            "acqua",
            "essere",
            "per",
            "tu",
            "marco"
          ],
          "phrases": [
            {
              "surface": "Non c’è problema",
              "literalEn": "there is not problem",
              "naturalEn": "no problem",
              "tokenStart": 1,
              "tokenEnd": 3
            }
          ]
        },
        {
          "id": "s07",
          "text": "Giulia ha portato l’acqua senza chiedere il prezzo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "giulia",
            "avere",
            "portare",
            "acqua",
            "senza",
            "chiedere",
            "il",
            "prezzo"
          ]
        },
        {
          "id": "s08",
          "text": "Ha capito subito. Marco aveva bisogno di amici.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "capire",
            "subito",
            "marco",
            "avere",
            "bisogno",
            "di",
            "amico"
          ]
        },
        {
          "id": "s09",
          "text": "Marco si è seduto e ha guardato i tavoli vuoti. Ha preso l’acqua con calma.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "marco",
            "si",
            "essere",
            "sedere",
            "e",
            "avere",
            "guardare",
            "i",
            "tavolo",
            "vuoto",
            "avere",
            "prendere",
            "acqua",
            "con",
            "calma"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s10",
          "text": "Marco cercava lavoro ogni giorno da due settimane.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "marco",
            "cercare",
            "lavorare",
            "ogni",
            "giorno",
            "dare",
            "due",
            "settimana"
          ]
        },
        {
          "id": "s11",
          "text": "Ieri ha telefonato a Luca e ha chiesto aiuto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ieri",
            "avere",
            "telefonare",
            "a",
            "luca",
            "e",
            "avere",
            "chiedere",
            "aiutare"
          ]
        },
        {
          "id": "s12",
          "text": "Lunedì ha scritto a tre negozi del quartiere.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lunedi",
            "avere",
            "scrivere",
            "a",
            "tre",
            "negozio",
            "del",
            "quartiere"
          ]
        },
        {
          "id": "s13",
          "text": "Adesso sono a Roma. Cerco lavoro ogni giorno.",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "adesso",
            "essere",
            "a",
            "roma",
            "cercare",
            "lavorare",
            "ogni",
            "giorno"
          ]
        },
        {
          "id": "s14",
          "text": "Sì. Sei con noi. Cerchiamo insieme un modo.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "si_yes",
            "essere",
            "con",
            "noi",
            "cercare",
            "insieme",
            "un",
            "modo"
          ]
        },
        {
          "id": "s15",
          "text": "Sì. Ma il lavoro no. Cerco e non trovo niente.",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "si_yes",
            "ma",
            "il",
            "lavorare",
            "no",
            "cercare",
            "e",
            "non",
            "trovare",
            "niente"
          ]
        },
        {
          "id": "s16",
          "text": "Luca ascoltava e non ha detto niente.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "ascoltare",
            "e",
            "non",
            "avere",
            "dire",
            "niente"
          ]
        },
        {
          "id": "s17",
          "text": "Il problema erano i soldi e il tempo ogni giorno.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "problema",
            "essere",
            "i",
            "soldi",
            "e",
            "il",
            "tempo",
            "ogni",
            "giorno"
          ]
        },
        {
          "id": "s18",
          "text": "Marco aveva paura di non trovare un posto di lavoro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "marco",
            "avere",
            "paura",
            "di",
            "non",
            "trovare",
            "un",
            "posto",
            "di",
            "lavorare"
          ]
        },
        {
          "id": "s19",
          "text": "Luca ha ascoltato Marco con calma e senza fretta. Poi ha portato pane al tavolo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "ascoltare",
            "marco",
            "con",
            "calma",
            "e",
            "senza",
            "fretta",
            "poi",
            "avere",
            "portare",
            "pane",
            "al",
            "tavolo"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s20",
          "text": "Luca ha parlato della notizia difficile del caffè.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "parlare",
            "della",
            "notizia",
            "difficile",
            "del",
            "caffe"
          ]
        },
        {
          "id": "s21",
          "text": "Il padrone forse vende il caffè. O cambia tutto.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "il",
            "padrone",
            "forse",
            "vendere",
            "il",
            "caffe",
            "o",
            "cambiare",
            "tutto"
          ]
        },
        {
          "id": "s22",
          "text": "Non ha deciso. Questa settimana è molto importante.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "avere",
            "decidere",
            "questo",
            "settimana",
            "essere",
            "molto",
            "importante"
          ]
        },
        {
          "id": "s23",
          "text": "Anch’io ho paura. Qui anche il mio lavoro è difficile.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "anche",
            "avere",
            "paura",
            "qui",
            "anche",
            "il",
            "mio",
            "lavorare",
            "essere",
            "difficile"
          ]
        },
        {
          "id": "s24",
          "text": "Allora siamo in due con la stessa paura oggi.",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "allora",
            "essere",
            "in",
            "due",
            "con",
            "la",
            "stesso",
            "paura",
            "oggi"
          ]
        },
        {
          "id": "s25",
          "text": "Ha detto così e poi ha sorriso un poco.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "dire",
            "cosi",
            "e",
            "poi",
            "avere",
            "sorridere",
            "un",
            "poco"
          ]
        },
        {
          "id": "s26",
          "text": "Giulia è passata tra i tavoli e ha ascoltato tutto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "giulia",
            "essere",
            "passare",
            "tra",
            "i",
            "tavolo",
            "e",
            "avere",
            "ascoltare",
            "tutto"
          ]
        },
        {
          "id": "s27",
          "text": "Resta il caffè? Un giorno serve più gente qui.",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
            "restare",
            "il",
            "caffe",
            "un",
            "giorno",
            "servire",
            "piu",
            "gente",
            "qui"
          ]
        },
        {
          "id": "s28",
          "text": "Magari. Adesso cerco ancora. Non voglio solo aspettare.",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "magari",
            "adesso",
            "cercare",
            "ancora",
            "non",
            "volere",
            "solo",
            "aspettare"
          ]
        },
        {
          "id": "s29",
          "text": "Sento qualcosa? Ti chiamo. Ci penso io, Marco.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "sentire",
            "qualcosa",
            "ti",
            "chiamare",
            "ci",
            "pensare",
            "io",
            "marco"
          ],
          "phrases": [
            {
              "surface": "Ci penso io",
              "literalEn": "I think about it I",
              "naturalEn": "I’ll take care of it",
              "tokenStart": 3,
              "tokenEnd": 5
            }
          ]
        },
        {
          "id": "s30",
          "text": "Marco ha detto grazie. Per un momento ha sorriso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "marco",
            "avere",
            "dire",
            "grazie",
            "per",
            "un",
            "momento",
            "avere",
            "sorridere"
          ]
        },
        {
          "id": "s30b",
          "text": "Luca ha preparato un altro caffè e ha lavorato vicino alla porta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "preparare",
            "un",
            "altro",
            "caffe",
            "e",
            "avere",
            "lavorare",
            "vicino",
            "alla",
            "porta"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s31",
          "text": "Prima di partire Marco ha chiesto di Sofia e del piano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "prima",
            "di",
            "partire",
            "marco",
            "avere",
            "chiedere",
            "di",
            "sofia",
            "e",
            "del",
            "piano"
          ]
        },
        {
          "id": "s32",
          "text": "Luca ha parlato del piano con Nonna Rosa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "parlare",
            "del",
            "piano",
            "con",
            "nonna",
            "rosa"
          ]
        },
        {
          "id": "s33",
          "text": "Sofia ha scritto le domande per la nonna ieri sera.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sofia",
            "avere",
            "scrivere",
            "le",
            "domanda",
            "per",
            "la",
            "nonna",
            "ieri",
            "sera"
          ]
        },
        {
          "id": "s34",
          "text": "Domani andiamo da Nonna Rosa dopo il lavoro al caffè.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "domani",
            "andare",
            "dare",
            "nonna",
            "rosa",
            "dopo",
            "il",
            "lavorare",
            "al",
            "caffe"
          ]
        },
        {
          "id": "s35",
          "text": "Vengo anche io. Non ho lavoro, ma ho tempo.",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "venire",
            "anche",
            "io",
            "non",
            "avere",
            "lavorare",
            "ma",
            "avere",
            "tempo"
          ]
        },
        {
          "id": "s36",
          "text": "Vieni. Insieme è meglio per tutti noi.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "venire",
            "insieme",
            "essere",
            "meglio",
            "per",
            "tutto",
            "noi"
          ]
        },
        {
          "id": "s37",
          "text": "Io resto al caffè. Domani parlo con il padrone.",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
            "io",
            "restare",
            "al",
            "caffe",
            "domani",
            "parlare",
            "con",
            "il",
            "padrone"
          ]
        },
        {
          "id": "s38",
          "text": "Giulia ha sorriso a Marco con calma e voce gentile.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "giulia",
            "avere",
            "sorridere",
            "a",
            "marco",
            "con",
            "calma",
            "e",
            "voce",
            "gentile"
          ]
        },
        {
          "id": "s39",
          "text": "Marco è uscito nella strada del quartiere.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "marco",
            "essere",
            "uscire",
            "nella",
            "strada",
            "del",
            "quartiere"
          ]
        },
        {
          "id": "s40",
          "text": "Luca è rimasto a lavorare fino a sera.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "essere",
            "rimanere",
            "a",
            "lavorare",
            "fino",
            "a",
            "sera"
          ]
        },
        {
          "id": "s41",
          "text": "La sala era quasi vuota, ma il caffè era aperto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "sala",
            "essere",
            "quasi",
            "vuoto",
            "ma",
            "il",
            "caffe",
            "essere",
            "aprire"
          ]
        },
        {
          "id": "s42",
          "text": "I problemi erano due, ma gli amici erano gli stessi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "i",
            "problema",
            "essere",
            "due",
            "ma",
            "gli",
            "amico",
            "essere",
            "gli",
            "stesso"
          ]
        }
      ]
    }
