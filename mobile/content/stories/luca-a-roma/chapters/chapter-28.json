      "summary": "Marco still has money trouble and looks for work; Luca listens and invites him to Nonna.",
      "characterIds": [
        "luca",
        "marco"
      ],
      "locationIds": [
        "lavoro-caffe"
      ],
      "rememberedFacts": [
        "Marco needs work and money",
        "The ticket crisis is over but stress continues",
        "Marco will come to Nonna Rosa on Friday if he can"
      ]
    }
  ],
  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Giovedì Marco è arrivato al caffè nel pomeriggio, quando c’erano pochi clienti e la sala era tranquilla.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "giovedi",
            "marco",
            "essere",
            "arrivare",
            "al",
            "caffe",
            "nel",
            "pomeriggio",
            "quando",
            "ce",
            "poco",
            "cliente",
            "e",
            "la",
            "sala",
            "essere",
            "tranquillo"
          ]
        },
        {
          "id": "s03",
          "text": "Luca lo ha visto e ha sorriso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "lo",
            "avere",
            "vedere",
            "e",
            "avere",
            "sorridere"
          ]
        },
        {
          "id": "s04",
          "text": "Marco non sembrava tranquillo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "marco",
            "non",
            "sembrare",
            "tranquillo"
          ]
        },
        {
          "id": "s05",
          "text": "Ciao. Posso stare un momento? Non ho bisogno di caffè.",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "ciao",
            "potere",
            "stare",
            "un",
            "momento",
            "non",
            "avere",
            "bisogno",
            "di",
            "caffe"
          ]
        },
        {
          "id": "s06",
          "text": "Non ho tanti soldi. L’acqua va bene.",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "avere",
            "tanto",
            "soldi",
            "acqua",
            "andare",
            "bene"
          ]
        },
        {
          "id": "s07",
          "text": "Stai. Non c’è problema. L’acqua è per te.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "stare",
            "non",
            "ce",
            "problema",
            "acqua",
            "essere",
            "per",
            "tu"
          ],
          "phrases": [
            {
              "surface": "Non c’è problema",
              "literalEn": "there is not problem",
              "naturalEn": "no problem",
              "tokenStart": 1,
              "tokenEnd": 3
            }
          ]
        },
        {
          "id": "s08",
          "text": "Giulia ha portato l’acqua senza dire il prezzo, e Marco ha capito.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "giulia",
            "avere",
            "portare",
            "acqua",
            "senza",
            "dire",
            "il",
            "prezzo",
            "e",
            "marco",
            "avere",
            "capire"
          ]
        },
        {
          "id": "s10",
          "text": "Qui è come i miei soldi. Pochi, e sempre gli stessi.",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "qui",
            "essere",
            "come",
            "i",
            "mio",
            "soldi",
            "poco",
            "e",
            "sempre",
            "gli",
            "stesso"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s11",
          "text": "Luca ha sorriso un poco. Marco parlava così con paura.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "sorridere",
            "un",
            "poco",
            "marco",
            "parlare",
            "cosi",
            "con",
            "paura"
          ]
        },
        {
          "id": "s12",
          "text": "Il viaggio è passato. Il biglietto e la valigia li abbiamo trovati. Ricordi?",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "il",
            "viaggio",
            "essere",
            "passare",
            "il",
            "biglietto",
            "e",
            "la",
            "valigia",
            "li",
            "avere",
            "trovare",
            "ricordare"
          ]
        },
        {
          "id": "s13",
          "text": "Sì. Adesso sei a Roma, come noi.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "si_yes",
            "adesso",
            "essere",
            "a",
            "roma",
            "come",
            "noi"
          ]
        },
        {
          "id": "s14",
          "text": "Sì. Ma il lavoro no. Cerco e non trovo.",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "si_yes",
            "ma",
            "il",
            "lavorare",
            "no",
            "cercare",
            "e",
            "non",
            "trovare"
          ]
        },
        {
          "id": "s15",
          "text": "Ogni giorno è lo stesso. Domande, no, e poi a casa.",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "ogni",
            "giorno",
            "essere",
            "lo",
            "stesso",
            "domanda",
            "no",
            "e",
            "poi",
            "a",
            "casa"
          ]
        },
        {
          "id": "s16",
          "text": "Luca ha ascoltato, e ha capito che il problema non era più il treno, ma i soldi di ogni giorno e la paura di non trovare lavoro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "ascoltare",
            "e",
            "avere",
            "capire",
            "che",
            "il",
            "problema",
            "non",
            "essere",
            "piu",
            "il",
            "treno",
            "ma",
            "i",
            "soldi",
            "di",
            "ogni",
            "giorno",
            "e",
            "la",
            "paura",
            "di",
            "non",
            "trovare",
            "lavorare"
          ]
        },
        {
          "id": "s18",
          "text": "Anch’io ho paura. Qui il caffè forse chiude.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "anche",
            "avere",
            "paura",
            "qui",
            "il",
            "caffe",
            "forse",
            "chiudere"
          ]
        },
        {
          "id": "s19",
          "text": "Allora siamo in due. Che bella notizia.",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "allora",
            "essere",
            "in",
            "due",
            "che",
            "bello",
            "notizia"
          ]
        },
        {
          "id": "s20",
          "text": "Ha detto così e ha sorriso un poco. Luca anche.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "dire",
            "cosi",
            "e",
            "avere",
            "sorridere",
            "un",
            "poco",
            "luca",
            "anche"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s21",
          "text": "Se resta il caffè, magari serve più gente un giorno.",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
            "se",
            "restare",
            "il",
            "caffe",
            "magari",
            "servire",
            "piu",
            "gente",
            "un",
            "giorno"
          ]
        },
        {
          "id": "s22",
          "text": "Magari. Adesso cerco ancora. Non voglio solo aspettare.",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "magari",
            "adesso",
            "cercare",
            "ancora",
            "non",
            "volere",
            "solo",
            "aspettare"
          ]
        },
        {
          "id": "s23",
          "text": "Se sento qualcosa, ti chiamo. Ci penso io.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "se",
            "sentire",
            "qualcosa",
            "ti",
            "chiamare",
            "ci",
            "pensare",
            "io"
          ],
          "phrases": [
            {
              "surface": "Ci penso io",
              "literalEn": "I think about it I",
              "naturalEn": "I’ll take care of it",
              "tokenStart": 5,
              "tokenEnd": 7
            }
          ]
        },
        {
          "id": "s24",
          "text": "Marco ha detto grazie. Per un momento sembrava meno solo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "marco",
            "avere",
            "dire",
            "grazie",
            "per",
            "un",
            "momento",
            "sembrare",
            "meno",
            "solo"
          ]
        },
        {
          "id": "s25",
          "text": "Poi ha chiesto del caffè e della notizia di martedì.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "avere",
            "chiedere",
            "del",
            "caffe",
            "e",
            "della",
            "notizia",
            "di",
            "martedi"
          ]
        },
        {
          "id": "s26",
          "text": "Il padrone non ha deciso. Ieri ho parlato con Sofia.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "il",
            "padrone",
            "non",
            "avere",
            "decidere",
            "ieri",
            "avere",
            "parlare",
            "con",
            "sofia"
          ]
        },
        {
          "id": "s27",
          "text": "Lei ascolta e fa domande. Pensa con me.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "lei",
            "ascoltare",
            "e",
            "fare",
            "domanda",
            "pensare",
            "con",
            "io"
          ]
        },
        {
          "id": "s28",
          "text": "Bene. Dobbiamo fare qualcosa, non solo aspettare.",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
            "bene",
            "dovere",
            "fare",
            "qualcosa",
            "non",
            "solo",
            "aspettare"
          ]
        },
        {
          "id": "s29",
          "text": "Io non ho soldi. Ma ho tempo. E ho bisogno degli amici.",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "io",
            "non",
            "avere",
            "soldi",
            "ma",
            "avere",
            "tempo",
            "e",
            "avere",
            "bisogno",
            "dei",
            "amico"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s30",
          "text": "La sala restava quasi vuota mentre parlavano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "sala",
            "restare",
            "quasi",
            "vuoto",
            "mentre",
            "parlare"
          ]
        },
        {
          "id": "s31",
          "text": "Prima di partire, Marco ha chiesto di Sofia e del piano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "prima",
            "di",
            "partire",
            "marco",
            "avere",
            "chiedere",
            "di",
            "sofia",
            "e",
            "del",
            "piano"
          ]
        },
        {
          "id": "s32",
          "text": "Domani andiamo da Nonna Rosa. C’è un’idea, forse.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "domani",
            "andare",
            "dare",
            "nonna",
            "rosa",
            "ce",
            "idea",
            "forse"
          ]
        },
        {
          "id": "s33",
          "text": "Se posso, vengo. Non ho lavoro, ma ho tempo.",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "se",
            "potere",
            "venire",
            "non",
            "avere",
            "lavorare",
            "ma",
            "avere",
            "tempo"
          ]
        },
        {
          "id": "s34",
          "text": "Vieni. Insieme è meglio.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "venire",
            "insieme",
            "essere",
            "meglio"
          ]
        },
        {
          "id": "s35",
          "text": "Io resto qui. Domani parlo con il padrone, se posso.",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
            "io",
            "restare",
            "qui",
            "domani",
            "parlare",
            "con",
            "il",
            "padrone",
            "se",
            "potere"
          ]
        },
        {
          "id": "s36",
          "text": "Marco è uscito nella strada, e Luca è rimasto a lavorare.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "marco",
            "essere",
            "uscire",
            "nella",
            "strada",
            "e",
            "luca",
            "essere",
            "rimanere",
            "a",
            "lavorare"
          ]
        },
        {
          "id": "s37",
          "text": "I problemi erano due — il caffè e i soldi di Marco — e non avevano ancora un piano chiaro, solo un giorno e Nonna Rosa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "i",
            "problema",
            "essere",
            "due",
            "il",
            "caffe",
            "e",
            "i",
            "soldi",
            "di",
            "marco",
            "e",
            "non",
            "avere",
            "ancora",
            "un",
            "piano",
            "chiaro",
            "solo",
            "un",
            "giorno",
            "e",
            "nonna",
            "rosa"
          ]
        },
        {
          "id": "s40",
          "text": "Domani Nonna Rosa. Poi vediamo.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "domani",
            "nonna",
            "rosa",
            "poi",
            "vedere"
          ]
        }
      ]
    }
