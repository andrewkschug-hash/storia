  "events": [
    {
      "id": "ev-40-stay",
      "summary": "Luca’s mother offers two months of bar work near home outside Rome; he understands and chooses to stay in Rome for now.",
      "characterIds": [
        "luca",
        "marta",
        "sofia",
        "giulia",
        "marco"
      ],
      "locationIds": [
        "appartamento-luca",
        "lavoro-caffe"
      ],
      "rememberedFacts": [
        "Mother offers two months of bar work near home, starting next month, more pay",
        "Luca declines for now and stays in Rome",
        "Friends hear the decision; ordinary café work continues"
      ]
    }
  ],
  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Il giorno dopo, nel pomeriggio, la mamma ha chiamato Luca a casa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "giorno",
            "dopo",
            "nel",
            "pomeriggio",
            "la",
            "mamma",
            "avere",
            "chiamare",
            "luca",
            "a",
            "casa"
          ]
        },
        {
          "id": "s02",
          "text": "Luca ha preso il telefono e ha ascoltato bene.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "prendere",
            "il",
            "telefono",
            "e",
            "avere",
            "ascoltare",
            "bene"
          ]
        },
        {
          "id": "s03",
          "text": "C’è un posto in un bar vicino a casa.",
          "speakerId": "marta",
          "kind": "dialogue",
          "lemmas": [
            "ce",
            "un",
            "posto",
            "in",
            "un",
            "bar",
            "vicino",
            "a",
            "casa"
          ]
        },
        {
          "id": "s04",
          "text": "Un amico di famiglia cerca una persona. Il lavoro è per due mesi.",
          "speakerId": "marta",
          "kind": "dialogue",
          "lemmas": [
            "un",
            "amico",
            "di",
            "famiglia",
            "cercare",
            "una",
            "persona",
            "il",
            "lavorare",
            "essere",
            "per",
            "due",
            "mese"
          ]
        },
        {
          "id": "s05",
          "text": "Inizia il mese prossimo. Ci sono più soldi di adesso.",
          "speakerId": "marta",
          "kind": "dialogue",
          "lemmas": [
            "iniziare",
            "il",
            "mese",
            "prossimo",
            "ci",
            "essere",
            "piu",
            "soldi",
            "di",
            "adesso"
          ]
        },
        {
          "id": "s06",
          "text": "Devi rispondere questa settimana. Se dici sì, parti e lasci Roma per un po’.",
          "speakerId": "marta",
          "kind": "dialogue",
          "lemmas": [
            "dovere",
            "rispondere",
            "questo",
            "settimana",
            "se",
            "dire",
            "si_yes",
            "partire",
            "e",
            "lasciare",
            "roma",
            "per",
            "un",
            "poco"
          ]
        },
        {
          "id": "s08",
          "text": "Un lavoro vero, in un’altra città, vicino alla famiglia, per due mesi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "un",
            "lavorare",
            "vero",
            "in",
            "altro",
            "citta",
            "vicino",
            "alla",
            "famiglia",
            "per",
            "due",
            "mese"
          ]
        },
        {
          "id": "s09",
          "text": "Ho capito. Devo pensare. Ti rispondo presto.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "avere",
            "capire",
            "dovere",
            "pensare",
            "ti",
            "rispondere",
            "presto"
          ]
        },
        {
          "id": "s10",
          "text": "Dopo la chiamata si è seduto. Ha guardato la strada fuori dalla finestra.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dopo",
            "la",
            "chiamata",
            "si",
            "essere",
            "sedere",
            "avere",
            "guardare",
            "la",
            "strada",
            "fuori",
            "dalla",
            "finestra"
          ]
        },
        {
          "id": "s11",
          "text": "Ha pensato al caffè e all’orario nuovo. Poi a Giulia, a Marco e a Sofia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "pensare",
            "al",
            "caffe",
            "e",
            "orario",
            "nuovo",
            "poi",
            "a",
            "giulia",
            "a",
            "marco",
            "e",
            "a",
            "sofia"
          ]
        },
        {
          "id": "s12",
          "text": "A Roma aveva una casa, un lavoro, e amici. Non era più il primo giorno.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "a",
            "roma",
            "avere",
            "una",
            "casa",
            "un",
            "lavorare",
            "e",
            "amico",
            "non",
            "essere",
            "piu",
            "il",
            "primo",
            "giorno"
          ]
        },
        {
          "id": "s13",
          "text": "La proposta era buona. Lui doveva scegliere, non lasciare Roma per paura.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "proposta",
            "essere",
            "buono",
            "lui",
            "dovere",
            "scegliere",
            "non",
            "lasciare",
            "roma",
            "per",
            "paura"
          ]
        },
        {
          "id": "s14",
          "text": "Ha messo il telefono sul tavolo e ha preso l’orario di Giulia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "mettere",
            "il",
            "telefono",
            "sul",
            "tavolo",
            "e",
            "avere",
            "prendere",
            "orario",
            "di",
            "giulia"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s15",
          "text": "Lunedì e mercoledì sera erano liberi. Gli altri giorni lavorava di più.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lunedi",
            "e",
            "mercoledi",
            "sera",
            "essere",
            "libero",
            "gli",
            "altro",
            "giorno",
            "lavorare",
            "di",
            "piu"
          ]
        },
        {
          "id": "s16",
          "text": "Marco veniva nei giorni pieni. Il caffè aveva più clienti di prima, abbastanza.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "marco",
            "venire",
            "nei",
            "giorno",
            "pieno",
            "il",
            "caffe",
            "avere",
            "piu",
            "cliente",
            "di",
            "prima",
            "abbastanza"
          ]
        },
        {
          "id": "s17",
          "text": "Se partiva, lasciava queste cose. Se restava, diceva no a soldi e a casa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "se",
            "partire",
            "lasciare",
            "questo",
            "cosa",
            "se",
            "restare",
            "dire",
            "no",
            "a",
            "soldi",
            "e",
            "a",
            "casa"
          ]
        },
        {
          "id": "s18",
          "text": "Non aveva paura della proposta. Aveva bisogno di scegliere bene.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "avere",
            "paura",
            "della",
            "proposta",
            "avere",
            "bisogno",
            "di",
            "scegliere",
            "bene"
          ]
        },
        {
          "id": "s19",
          "text": "Ha camminato un poco, poi ha deciso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "camminare",
            "un",
            "poco",
            "poi",
            "avere",
            "decidere"
          ]
        },
        {
          "id": "s20",
          "text": "Per adesso resto a Roma. Questo lavoro, questa casa, queste persone.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "per",
            "adesso",
            "restare",
            "a",
            "roma",
            "questo",
            "lavorare",
            "questo",
            "casa",
            "questo",
            "persona"
          ]
        },
        {
          "id": "s21",
          "text": "Ha chiamato la mamma di nuovo e ha parlato piano, ma chiaro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "chiamare",
            "la",
            "mamma",
            "di",
            "nuovo",
            "e",
            "avere",
            "parlare",
            "piano",
            "ma",
            "chiaro"
          ]
        },
        {
          "id": "s22",
          "text": "Grazie. La proposta è buona. Ma per adesso resto qui. Non parto.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "grazie",
            "la",
            "proposta",
            "essere",
            "buono",
            "ma",
            "per",
            "adesso",
            "restare",
            "qui",
            "non",
            "partire"
          ]
        },
        {
          "id": "s23",
          "text": "La mamma ha ascoltato. Non era felice del tutto, ma ha capito.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "mamma",
            "avere",
            "ascoltare",
            "non",
            "essere",
            "felice",
            "del",
            "tutto",
            "ma",
            "avere",
            "capire"
          ]
        },
        {
          "id": "s24",
          "text": "Va bene. Se un giorno vuoi partire, mi dici. Il posto resta aperto.",
          "speakerId": "marta",
          "kind": "dialogue",
          "lemmas": [
            "andare",
            "bene",
            "se",
            "un",
            "giorno",
            "volere",
            "partire",
            "mi",
            "dire",
            "il",
            "posto",
            "restare",
            "aprire"
          ],
          "phrases": [
            {
              "surface": "Va bene",
              "literalEn": "it goes well",
              "naturalEn": "okay",
              "tokenStart": 0,
              "tokenEnd": 1
            }
          ]
        },
        {
          "id": "s25",
          "text": "Luca ha detto grazie ancora una volta, e ha chiuso la chiamata.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "luca",
            "avere",
            "dire",
            "grazie",
            "ancora",
            "una",
            "volta",
            "e",
            "avere",
            "chiudere",
            "la",
            "chiamata"
          ]
        },
        {
          "id": "s26",
          "text": "La sera, dopo il lavoro, ha parlato con Giulia mentre chiudeva i tavoli.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "sera",
            "dopo",
            "il",
            "lavorare",
            "avere",
            "parlare",
            "con",
            "giulia",
            "mentre",
            "chiudere",
            "i",
            "tavolo"
          ]
        },
        {
          "id": "s27",
          "text": "La mamma aveva una proposta: un bar vicino a casa, due mesi, più soldi.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "la",
            "mamma",
            "avere",
            "una",
            "proposta",
            "un",
            "bar",
            "vicino",
            "a",
            "casa",
            "due",
            "mese",
            "piu",
            "soldi"
          ]
        },
        {
          "id": "s28",
          "text": "Ho detto no. Per adesso resto. L’orario qui mi va bene.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "avere",
            "dire",
            "no",
            "per",
            "adesso",
            "restare",
            "orario",
            "qui",
            "mi",
            "andare",
            "bene"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s29",
          "text": "Chiaro. Hai scelto. Domani il caffè apre lo stesso.",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
            "chiaro",
            "avere",
            "scegliere",
            "domani",
            "il",
            "caffe",
            "aprire",
            "lo",
            "stesso"
          ]
        },
        {
          "id": "s30",
          "text": "Sofia e Marco sono arrivati poco dopo, perché Luca aveva scritto un messaggio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sofia",
            "e",
            "marco",
            "essere",
            "arrivare",
            "poco",
            "dopo",
            "perche",
            "luca",
            "avere",
            "scrivere",
            "un",
            "messaggio"
          ]
        },
        {
          "id": "s31",
          "text": "C’era una proposta di lavoro fuori Roma. Ho deciso di restare, per adesso.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "ce",
            "una",
            "proposta",
            "di",
            "lavorare",
            "fuori",
            "roma",
            "avere",
            "decidere",
            "di",
            "restare",
            "per",
            "adesso"
          ]
        },
        {
          "id": "s32",
          "text": "Bene. Non perché è facile. Perché vuoi questa vita qui.",
          "speakerId": "sofia",
          "kind": "dialogue",
          "lemmas": [
            "bene",
            "non",
            "perche",
            "essere",
            "facile",
            "perche",
            "volere",
            "questo",
            "vita",
            "qui"
          ]
        },
        {
          "id": "s33",
          "text": "Hai ragione. Non è per sempre. È per adesso.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "avere",
            "ragione",
            "non",
            "essere",
            "per",
            "sempre",
            "essere",
            "per",
            "adesso"
          ],
          "phrases": [
            {
              "surface": "Hai ragione",
              "literalEn": "you have reason",
              "naturalEn": "you’re right",
              "tokenStart": 0,
              "tokenEnd": 1
            }
          ]
        },
        {
          "id": "s34",
          "text": "Marco ha guardato Luca e ha fatto un piccolo segno di sì.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "marco",
            "avere",
            "guardare",
            "luca",
            "e",
            "avere",
            "fare",
            "un",
            "piccolo",
            "segno",
            "di",
            "si_yes"
          ]
        },
        {
          "id": "s35",
          "text": "Va bene. Allora ci vediamo al lavoro. Io sabato ci sono.",
          "speakerId": "marco",
          "kind": "dialogue",
          "lemmas": [
            "andare",
            "bene",
            "allora",
            "ci",
            "vedere",
            "al",
            "lavorare",
            "io",
            "sabato",
            "ci",
            "essere"
          ],
          "phrases": [
            {
              "surface": "Va bene",
              "literalEn": "it goes well",
              "naturalEn": "okay",
              "tokenStart": 0,
              "tokenEnd": 1
            },
            {
              "surface": "Ci vediamo",
              "literalEn": "we see each other",
              "naturalEn": "see you",
              "tokenStart": 3,
              "tokenEnd": 4
            }
          ]
        },
        {
          "id": "s37",
          "text": "Domani apriamo di mattina. L’orario è pronto. Niente di speciale.",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
            "domani",
            "aprire",
            "di",
            "mattina",
            "orario",
            "essere",
            "pronto",
            "niente",
            "di",
            "speciale"
          ]
        },
        {
          "id": "s38",
          "text": "Non hanno fatto una festa. Hanno parlato un poco, poi sono andati a casa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "avere",
            "fare",
            "una",
            "festa",
            "avere",
            "parlare",
            "un",
            "poco",
            "poi",
            "essere",
            "andare",
            "a",
            "casa"
          ]
        },
        {
          "id": "s40",
          "text": "Quando Luca è tornato a casa, ha messo il telefono sul tavolo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "quando",
            "luca",
            "essere",
            "tornare",
            "a",
            "casa",
            "avere",
            "mettere",
            "il",
            "telefono",
            "sul",
            "tavolo"
          ]
        },
        {
          "id": "s41",
          "text": "La proposta restava vera. Lui aveva detto no per adesso, non per sempre.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "proposta",
            "restare",
            "vero",
            "lui",
            "avere",
            "dire",
            "no",
            "per",
            "adesso",
            "non",
            "per",
            "sempre"
          ]
        },
        {
          "id": "s42",
          "text": "Ha preparato le cose per la mattina e ha guardato l’orario una volta ancora.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "preparare",
            "le",
            "cosa",
            "per",
            "la",
            "mattina",
            "e",
            "avere",
            "guardare",
            "orario",
            "una",
            "volta",
            "ancora"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s43",
          "text": "Il giorno dopo ha aperto il caffè con Giulia, come ogni mattina di lavoro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "giorno",
            "dopo",
            "avere",
            "aprire",
            "il",
            "caffe",
            "con",
            "giulia",
            "come",
            "ogni",
            "mattina",
            "di",
            "lavorare"
          ]
        },
        {
          "id": "s44",
          "text": "Marco non c’era, perché non era un giorno pieno. La sala era piccola, come sempre.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "marco",
            "non",
            "ce",
            "perche",
            "non",
            "essere",
            "un",
            "giorno",
            "pieno",
            "la",
            "sala",
            "essere",
            "piccolo",
            "come",
            "sempre"
          ]
        },
        {
          "id": "s45",
          "text": "Due clienti sono entrati. Luca ha portato caffè e acqua, come sempre.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "due",
            "cliente",
            "essere",
            "entrare",
            "luca",
            "avere",
            "portare",
            "caffe",
            "e",
            "acqua",
            "come",
            "sempre"
          ]
        },
        {
          "id": "s47",
          "text": "Oggi lavoriamo. Domani anche. Questo è il lavoro, per adesso.",
          "speakerId": "giulia",
          "kind": "dialogue",
          "lemmas": [
            "oggi",
            "lavorare",
            "domani",
            "anche",
            "questo",
            "essere",
            "il",
            "lavorare",
            "per",
            "adesso"
          ]
        },
        {
          "id": "s48",
          "text": "Sì. Per adesso.",
          "speakerId": "luca",
          "kind": "dialogue",
          "lemmas": [
            "si_yes",
            "per",
            "adesso"
          ]
        },
        {
          "id": "s49",
          "text": "La strada del quartiere era la stessa. I tavoli del caffè erano pronti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "strada",
            "del",
            "quartiere",
            "essere",
            "la",
            "stesso",
            "i",
            "tavolo",
            "del",
            "caffe",
            "essere",
            "pronto"
          ]
        },
        {
          "id": "s51",
          "text": "Lunedì sera libero. Mercoledì sera libero. Il resto, al caffè.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lunedi",
            "sera",
            "libero",
            "mercoledi",
            "sera",
