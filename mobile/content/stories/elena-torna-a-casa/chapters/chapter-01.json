            "la",
            "porta",
            "si",
            "aprire"
          ]
        },
        {
          "id": "s08",
          "text": "C'è mamma Teresa alla porta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ce",
            "mamma",
            "teresa",
            "alla",
            "porta"
          ]
        },
        {
          "id": "s09",
          "text": "Buongiorno, Elena!",
          "speakerId": "teresa",
          "kind": "dialogue",
          "lemmas": [
            "buongiorno",
            "elena"
          ]
        },
        {
          "id": "s10",
          "text": "Ciao, mamma. Sono a casa.",
