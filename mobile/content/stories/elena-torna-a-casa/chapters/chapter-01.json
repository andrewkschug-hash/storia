            "non",
            "essere",
            "solo"
          ]
        },
        {
          "id": "s24",
          "text": "Mamma, papà e Sara sono qui.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "mamma",
            "papa",
            "e",
            "sara",
            "essere",
