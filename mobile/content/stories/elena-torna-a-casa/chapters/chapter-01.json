        },
        {
          "id": "s19",
          "text": "La casa è piccola, ma è bella.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "casa",
            "essere",
            "piccolo",
            "ma",
            "essere",
            "bello"
          ]
        },
        {
          "id": "s20",
          "text": "Elena entra in casa con mamma.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "entrare",
            "in",
            "casa",
            "con",
            "mamma"
          ]
        },
        {
          "id": "s21",
