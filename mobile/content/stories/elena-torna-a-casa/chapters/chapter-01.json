          "kind": "dialogue",
          "lemmas": [
            "ciao",
            "papa"
          ]
        },
        {
          "id": "s14",
          "text": "Ciao, Elena. La casa è tua.",
          "speakerId": "stefano",
          "kind": "dialogue",
          "lemmas": [
            "ciao",
            "elena",
            "la",
            "casa",
