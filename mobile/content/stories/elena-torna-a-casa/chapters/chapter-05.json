  ],
  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "La famiglia è in cucina per la colazione.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": ["la", "famiglia", "essere", "in", "cucina", "per", "la", "colazione"]
        },
        {
          "id": "s02",
          "text": "Sul tavolo ci sono pane, latte e frutta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": ["sul", "tavolo", "ci", "essere", "pane", "latte", "e", "frutta"]
        },
        {
          "id": "s03",
          "text": "Elena ha fame, e Sara ha fame anche lei.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": ["elena", "avere", "fame", "e", "sara", "avere", "fame", "anche", "lei"]
        },
        {
          "id": "s04",
          "text": "Papà Stefano è al tavolo, pronto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": ["papa", "stefano", "essere", "al", "tavolo", "pronto"]
        },
        {
          "id": "s05",
          "text": "Buongiorno. La colazione è pronta.",
          "speakerId": "teresa",
          "kind": "dialogue",
          "lemmas": ["buongiorno", "la", "colazione", "essere", "pronto"]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s06",
          "text": "Elena, vuoi pane?",
          "speakerId": "teresa",
          "kind": "dialogue",
          "lemmas": ["elena", "volere", "pane"]
        },
        {
          "id": "s07",
          "text": "Sì, mamma. Voglio pane e caffè.",
          "speakerId": "elena",
          "kind": "dialogue",
          "lemmas": ["si_yes", "mamma", "volere", "pane", "e", "caffe"]
        },
        {
          "id": "s08",
          "text": "Elena prende il pane e mangia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": ["elena", "prendere", "il", "pane", "e", "mangiare"]
        },
        {
          "id": "s09",
          "text": "Il pane è buono, molto buono.",
          "speakerId": "elena",
          "kind": "dialogue",
          "lemmas": ["il", "pane", "essere", "buono", "molto", "buono"]
        },
        {
          "id": "s10",
          "text": "Sara beve il latte, non il caffè.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": ["sara", "bere", "il", "latte", "non", "il", "caffe"]
        },
        {
          "id": "s11",
          "text": "Io voglio latte, grazie.",
          "speakerId": "sara",
          "kind": "dialogue",
          "lemmas": ["io", "volere", "latte", "grazie"]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s12",
          "text": "Elena beve il caffè e un po' di acqua.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": ["elena", "bere", "il", "caffe", "e", "un", "poco", "di", "acqua"]
        },
        {
          "id": "s13",
          "text": "Stefano prende la frutta dal tavolo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": ["stefano", "prendere", "la", "frutta", "dal", "tavolo"]
        },
        {
          "id": "s14",
          "text": "Vuoi frutta, Elena?",
          "speakerId": "stefano",
          "kind": "dialogue",
          "lemmas": ["volere", "frutta", "elena"]
        },
        {
          "id": "s15",
          "text": "Sì, papà. La frutta è buona.",
          "speakerId": "elena",
          "kind": "dialogue",
          "lemmas": ["si_yes", "papa", "la", "frutta", "essere", "buono"]
        },
        {
          "id": "s16",
          "text": "Elena mangia la frutta e beve acqua.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": ["elena", "mangiare", "la", "frutta", "e", "bere", "acqua"]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s17",
          "text": "Oggi la colazione è insieme, in famiglia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": ["oggi", "la", "colazione", "essere", "insieme", "in", "famiglia"]
        },
        {
          "id": "s18",
          "text": "Elena sta bene, qui al tavolo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": ["elena", "stare", "bene", "qui", "al", "tavolo"]
        },
        {
          "id": "s19",
          "text": "Domani la colazione è di nuovo qui.",
          "speakerId": "teresa",
          "kind": "dialogue",
          "lemmas": ["domani", "la", "colazione", "essere", "di", "nuovo", "qui"]
        },
        {
          "id": "s20",
          "text": "Va bene, mamma. Io ho sempre fame di mattina.",
          "speakerId": "elena",
          "kind": "dialogue",
          "lemmas": ["andare", "bene", "mamma", "io", "avere", "sempre", "fame", "di", "mattina"]
        },
        {
          "id": "s21",
          "text": "Stefano sorride e beve il caffè.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": ["stefano", "sorridere", "e", "bere", "il", "caffe"]
        },
        {
          "id": "s22",
          "text": "La famiglia mangia, beve e parla.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": ["la", "famiglia", "mangiare", "bere", "e", "parlare"]
        },
        {
          "id": "s23",
          "text": "A casa, la colazione è un bel momento.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": ["a", "casa", "la", "colazione", "essere", "un", "bello", "momento"]
        },
        {
          "id": "s24",
          "text": "Elena beve caffè e acqua, e mangia pane.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": ["elena", "bere", "caffe", "e", "acqua", "e", "mangiare", "pane"]
        },
        {
          "id": "s25",
          "text": "Sara beve latte e mangia un po' di frutta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": ["sara", "bere", "latte", "e", "mangiare", "un", "poco", "di", "frutta"]
        },
        {
          "id": "s26",
          "text": "Stefano e Teresa sono al tavolo, con le figlie.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": ["stefano", "e", "teresa", "essere", "al", "tavolo", "con", "le", "figlia"]
        },
        {
          "id": "s27",
          "text": "Ogni mattina la famiglia vuole la colazione insieme.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": ["ogni", "mattina", "la", "famiglia", "volere", "la", "colazione", "insieme"]
        }
      ]
    }
  ],
  "questions": []
}
