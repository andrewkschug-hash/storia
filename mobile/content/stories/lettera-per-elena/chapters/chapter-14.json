      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Venerdì pomeriggio Bruna batte le mani sul bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "venerdi",
            "pomeriggio",
            "bruna",
            "batte",
            "le",
            "mani",
            "sul",
            "banco"
          ]
        },
        {
          "id": "s02",
          "text": "Stasera spritz.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "stasera",
            "spritz"
          ]
        },
        {
          "id": "s03",
          "text": "Tutti.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "tutto"
          ]
        },
        {
          "id": "s04",
          "text": "Anche Pietro?",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "anche",
            "pietro"
          ]
        },
        {
