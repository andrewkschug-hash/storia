    {
      "id": "p6",
      "order": 6,
      "sentences": [
        {
          "id": "s26",
          "text": "Nel libro sarebbero vivi, pieni di paura e di verità.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "nel",
            "libro",
            "sarebbero",
            "voi",
            "pieno",
            "di",
            "paura",
            "e",
            "di",
            "verita"
          ]
        },
        {
          "id": "s27",
          "text": "Qui sono due sedie mute vicino a un bicchiere arancione.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "qui",
            "essere",
            "due",
            "sedia",
            "mute",
            "vicino",
            "a",
            "un",
            "bicchiere",
            "arancione"
          ]
        },
        {
          "id": "s28",
          "text": "Elena pensa alla S cancellata e alla laguna, e non dice niente di questo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "pensare",
            "alla",
            "s",
            "cancellata",
            "e",
            "alla",
            "laguna",
            "e",
            "non",
            "dire",
            "niente",
            "di",
            "questo"
          ]
        },
        {
          "id": "s29",
          "text": "Il telefono di Pietro vibra sul tavolo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "telefono",
            "di",
            "pietro",
            "vibra",
            "sul",
            "tavolo"
          ]
        },
        {
          "id": "s30",
          "text": "Lui guarda lo schermo e diventa serio in un secondo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lui",
            "guardare",
            "lo",
            "schermo",
            "e",
            "diventa",
            "serio",
            "in",
            "un",
            "secondo"
          ]
        }
      ]
    },
    {
      "id": "p7",
      "order": 7,
      "sentences": [
        {
          "id": "s31",
          "text": "Devo andare.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "dovere",
            "andare"
          ]
        },
        {
          "id": "s32",
          "text": "Già?",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "gia"
          ]
        },
        {
          "id": "s33",
          "text": "Sergio.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "sergio"
          ]
        },
        {
          "id": "s34",
          "text": "Mio fratello.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "mio",
            "fratello"
          ]
        },
        {
          "id": "s35",
          "text": "Elena sente il nome per la prima volta, e il libro le torna in testa tutto insieme.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "sentire",
            "il",
            "nome",
            "per",
            "la",
            "prima",
