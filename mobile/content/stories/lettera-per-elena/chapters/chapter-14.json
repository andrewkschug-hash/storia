          ]
        }
      ]
    },
    {
      "id": "p10",
      "order": 10,
      "sentences": [
        {
          "id": "s46",
          "text": "Povero ragazzo.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "povero",
            "ragazzo"
          ]
        },
        {
          "id": "s47",
          "text": "Katia guarda Elena, e Elena guarda il bicchiere.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "guardare",
            "elena",
            "e",
            "elena",
            "guardare",
            "il",
            "bicchiere"
          ]
        },
        {
          "id": "s48",
          "text": "Non dice: è lui.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "dire",
            "essere",
            "lui"
          ]
        },
        {
