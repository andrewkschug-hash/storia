            "peggiore",
            "della",
            "distanza",
            "grande"
          ]
        },
        {
          "id": "s17",
          "text": "Peggio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "peggio"
          ]
        },
        {
          "id": "s18",
          "text": "Parlano tutti insieme: Bruna racconta del bancone e dei clienti difficili.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "parlare",
            "tutto",
            "insieme",
            "bruna",
            "racconta",
            "del",
            "banco",
            "e",
            "dei",
            "cliente",
            "difficile"
          ]
        },
        {
          "id": "s19",
          "text": "Katia fa battute sul frigo e sullo zucchero finito.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "fare",
            "battute",
            "sul",
            "frigo",
            "e",
            "sul",
            "zucchero",
            "finire"
          ]
        },
        {
          "id": "s20",
          "text": "Elena ride al momento giusto, come al lavoro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "ride",
            "al",
            "momento",
            "giusto",
            "come",
            "al",
            "lavorare"
          ]
        }
      ]
    },
    {
      "id": "p5",
      "order": 5,
      "sentences": [
        {
          "id": "s21",
          "text": "Con Pietro scambia due frasi morte, che non dicono niente.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "con",
            "pietro",
            "scambia",
            "due",
            "frasi",
            "morte",
            "che",
            "non",
            "dire",
            "niente"
          ]
        },
        {
          "id": "s22",
          "text": "Buono lo spritz.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "buono",
            "lo",
            "spritz"
          ]
        },
        {
          "id": "s23",
          "text": "Sì.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "si_yes"
          ]
        },
        {
          "id": "s24",
          "text": "Buono.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "buono"
          ]
        },
        {
          "id": "s25",
          "text": "Nel gruppo sono peggiori che al caffè, dove almeno c'è il lavoro tra loro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "nel",
            "gruppo",
            "essere",
            "peggiori",
