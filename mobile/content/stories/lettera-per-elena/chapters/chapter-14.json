          "text": "Ma stasera sta male, e mi chiamano.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "ma",
            "stasera",
            "stare",
            "ma",
            "e",
            "mi",
            "chiamano"
          ]
        },
        {
          "id": "s43",
          "text": "Pietro lascia mezzo spritz sul tavolo e prende le chiavi del furgone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "lasciare",
            "mezzo",
