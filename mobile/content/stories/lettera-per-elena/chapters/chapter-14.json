            "le",
            "chiave",
            "del",
            "furgone"
          ]
        },
        {
          "id": "s44",
          "text": "Esce in fretta, senza guardare Elena a lungo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "uscire",
            "in",
            "fretta",
            "senza",
            "guardare",
            "elena",
            "a",
            "lungo"
          ]
        },
        {
          "id": "s45",
          "text": "Bruna sospira e gira il bicchiere tra le mani.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "sospira",
            "e",
            "gira",
            "il",
            "bicchiere",
