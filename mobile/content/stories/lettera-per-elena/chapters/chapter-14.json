            "e",
            "il",
            "libro",
            "le",
            "tornare",
            "in",
            "testa",
            "tutto",
            "insieme"
          ]
        }
      ]
    },
    {
      "id": "p8",
      "order": 8,
      "sentences": [
        {
          "id": "s36",
          "text": "Sergio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sergio"
          ]
        },
        {
          "id": "s37",
          "text": "Il fratello che non dorme.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "fratello",
            "che",
            "non",
            "dormire"
          ]
        },
        {
          "id": "s38",
          "text": "Il fratello dopo l'incidente.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "fratello",
            "dopo",
            "l'incidente"
          ]
        },
        {
          "id": "s39",
          "text": "Mi dispiace.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "mi",
            "dispiace"
          ]
        },
        {
          "id": "s40",
          "text": "Va bene.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "andare",
            "bene"
          ]
        }
      ]
    },
    {
      "id": "p9",
      "order": 9,
      "sentences": [
        {
          "id": "s41",
          "text": "È in recupero.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "essere",
            "in",
            "recupero"
          ]
        },
        {
