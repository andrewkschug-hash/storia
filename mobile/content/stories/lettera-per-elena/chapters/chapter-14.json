          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "anche",
            "pietro"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s06",
          "text": "Gliel'ho detto ieri, quando ha portato il caffè.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "gliel'ho",
            "dire",
            "ieri",
            "quando",
            "avere",
            "portare",
            "il",
            "caffe"
          ]
        },
        {
          "id": "s07",
          "text": "Elena sente lo stomaco stretto, come prima di un esame.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "sentire",
            "lo",
            "stomaco",
            "stretto",
            "come",
            "prima",
            "di",
            "un",
            "esame"
          ]
        },
        {
          "id": "s08",
          "text": "Alla sera chiudono il Caffè Brenta e camminano fino a un bar vicino, sulla strada di Marina di Brenta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "alla",
            "sera",
            "chiudono",
            "il",
            "caffe",
            "brenta",
            "e",
            "camminare",
            "fino",
            "a",
            "un",
            "bar",
            "vicino",
            "sulla",
            "strada",
            "di",
            "marina",
            "di",
            "brenta"
          ]
        },
        {
          "id": "s09",
          "text": "C'è rumore, luci gialle, e tavolini fuori sotto la nebbia leggera.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ce",
            "rumore",
            "luce",
            "gialle",
            "e",
            "tavolini",
            "fuori",
            "sotto",
            "la",
            "nebbia",
            "leggera"
          ]
        },
        {
          "id": "s10",
          "text": "Bruna ordina quattro spritz e parla con la barista come se fosse ancora al suo bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "ordina",
            "quattro",
            "spritz",
            "e",
            "parlare",
            "con",
            "la",
            "barista",
            "come",
            "se",
            "fosse",
            "ancora",
            "al",
            "suo",
            "banco"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s11",
          "text": "Pietro arriva in ritardo, con il furgone parcheggiato un po' lontano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "arrivare",
            "in",
            "ritardo",
            "con",
            "il",
            "furgone",
            "parcheggiato",
            "un",
            "poco",
            "lontano"
          ]
        },
        {
          "id": "s12",
          "text": "Si siede lontano da Elena, quasi per caso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "si",
            "sedere",
            "lontano",
            "dare",
            "elena",
            "quasi",
            "per",
            "caso"
          ]
        },
        {
          "id": "s13",
          "text": "Poi Katia lo sposta con un gesto pratico.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "katia",
            "lo",
            "sposta",
            "con",
            "un",
            "gesto",
            "pratico"
          ]
        },
        {
          "id": "s14",
          "text": "Qui.",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "qui"
          ]
        },
        {
          "id": "s15",
          "text": "Posto libero.",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "posto",
            "libero"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s16",
          "text": "Ora Pietro è vicino a Elena, e la distanza piccola è peggiore della distanza grande.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ora",
            "pietro",
            "essere",
            "vicino",
            "a",
            "elena",
            "e",
            "la",
            "distanza",
