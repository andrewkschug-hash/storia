  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Sabato mattina Elena arriva a Marina di Brenta con la faccia stanca.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sabato",
            "mattina",
            "elena",
            "arrivare",
            "a",
            "marina",
            "di",
            "brenta",
            "con",
            "la",
            "faccia",
            "stanco"
          ]
        },
        {
          "id": "s02",
          "text": "Ha dormito poco, e ha ripensato alle sue pagine lunghe nel libro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "dormire",
            "poco",
            "e",
            "avere",
            "ripensato",
            "alle",
            "suo",
            "pagine",
            "lunghe",
            "nel",
            "libro"
          ]
        },
        {
          "id": "s03",
          "text": "Ieri ho scritto troppo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ieri",
            "avere",
            "scrivere",
            "troppo"
          ]
        },
        {
          "id": "s04",
          "text": "Lo dice a se stessa mentre gira la chiave del Caffè Brenta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lo",
            "dire",
            "a",
            "se",
            "stesso",
            "mentre",
            "gira",
            "la",
            "chiave",
            "del",
            "caffe",
            "brenta"
          ]
        },
        {
          "id": "s05",
          "text": "Dentro c'è già odore di caffè e di cornetti caldi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dentro",
            "ce",
            "gia",
            "odore",
            "di",
            "caffe",
            "e",
            "di",
            "cornetti",
            "caldi"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s06",
          "text": "Bruna prepara il bancone senza fretta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "preparare",
            "il",
            "banco",
            "senza",
            "fretta"
          ]
        },
        {
          "id": "s07",
          "text": "Hai dormito?",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "avere",
            "dormire"
          ]
        },
        {
          "id": "s08",
          "text": "Poco.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "poco"
          ]
        },
        {
          "id": "s09",
          "text": "Bruna la guarda un secondo, poi torna ai piatti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "la",
            "guardare",
            "un",
            "secondo",
            "poi",
            "tornare",
            "ai",
            "piatto"
          ]
        },
        {
          "id": "s10",
          "text": "Katia arriva con la giacca ancora aperta e i capelli umidi di nebbia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "arrivare",
            "con",
            "la",
            "giacca",
            "ancora",
            "aprire",
            "e",
            "i",
            "capelli",
            "umidi",
            "di",
            "nebbia"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s11",
          "text": "Hai la faccia del libro.",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "avere",
            "la",
            "faccia",
            "del",
            "libro"
          ]
        },
        {
          "id": "s12",
          "text": "Che faccia?",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "che",
            "faccia"
          ]
        },
        {
          "id": "s13",
          "text": "Quella di chi ha scritto e adesso ha vergogna.",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "quello",
            "di",
            "chi",
            "avere",
            "scrivere",
            "e",
            "adesso",
            "avere",
            "vergogna"
          ]
        },
        {
          "id": "s14",
          "text": "Elena non risponde e mette il grembiule.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "non",
            "rispondere",
            "e",
            "mettere",
            "il",
            "grembiule"
          ]
        },
        {
          "id": "s15",
          "text": "Durante il turno lavora bene, quasi meglio del solito.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "durante",
            "il",
            "turno",
            "lavorare",
            "bene",
            "quasi",
            "meglio",
            "del",
            "solito"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s16",
          "text": "Sorride ai clienti, conta i soldi, sistema lo zucchero in due barattoli.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sorridere",
            "ai",
            "cliente",
            "contare",
            "i",
            "soldi",
            "sistema",
            "lo",
            "zucchero",
            "in",
            "due",
            "barattoli"
          ]
        },
        {
          "id": "s17",
          "text": "Il bancone è il suo teatro sicuro: lì sa cosa dire.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "banco",
            "essere",
            "il",
            "suo",
            "teatro",
            "sicuro",
            "li",
            "sapere",
            "cosa",
            "dire"
          ]
        },
        {
          "id": "s18",
          "text": "Sulla carta, invece, ha detto troppo e ha sbagliato il tono.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sulla",
            "carta",
            "invece",
            "avere",
            "dire",
            "troppo",
            "e",
            "avere",
            "sbagliato",
            "il",
            "tono"
          ]
        },
        {
          "id": "s19",
          "text": "Verso le dieci resta sola un minuto vicino allo scaffale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "verso",
            "le",
            "dieci",
            "restare",
            "solo",
            "un",
            "minuto",
            "vicino",
            "al",
            "scaffale"
          ]
        },
        {
          "id": "s20",
          "text": "Apre il libro anche se ha promesso a se stessa di non farlo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "aprire",
            "il",
            "libro",
            "anche",
            "se",
            "avere",
            "promesso",
            "a",
            "se",
            "stesso",
            "di",
            "non",
            "fare"
          ]
        }
      ]
    },
    {
      "id": "p5",
      "order": 5,
      "sentences": [
        {
          "id": "s21",
          "text": "C'è una risposta nuova, scritta con inchiostro scuro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ce",
            "una",
            "risposta",
            "nuovo",
            "scritta",
            "con",
            "inchiostro",
            "scuro"
          ]
        },
        {
          "id": "s22",
          "text": "Non è una rottura.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "essere",
            "una",
            "rottura"
          ]
        },
        {
          "id": "s23",
          "text": "È mio fratello.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "mio",
            "fratello"
          ]
        },
        {
          "id": "s24",
          "text": "Dopo l'incidente.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dopo",
            "l'incidente"
          ]
        },
        {
          "id": "s25",
          "text": "Elena sente caldo alle orecchie e alle mani.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "sentire",
            "caldo",
            "alle",
            "orecchie",
            "e",
            "alle",
            "mani"
          ]
        }
      ]
    },
    {
      "id": "p6",
      "order": 6,
      "sentences": [
        {
          "id": "s26",
          "text": "Ha sbagliato tutto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "sbagliato",
            "tutto"
          ]
        },
        {
          "id": "s27",
          "text": "La sua risposta dolce, piena di consigli su letti vuoti e addii, era fuori posto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "suo",
            "risposta",
            "dolce",
            "pieno",
            "di",
            "consigli",
            "su",
            "letto",
            "vuoto",
            "e",
            "addii",
            "essere",
            "fuori",
            "posto"
          ]
        },
        {
          "id": "s28",
          "text": "Vuole chiudere il libro per sempre e lasciarlo allo zucchero.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "volere",
            "chiudere",
            "il",
            "libro",
            "per",
            "sempre",
            "e",
            "lasciarlo",
            "al",
            "zucchero"
          ]
        },
        {
          "id": "s29",
          "text": "Invece legge ancora, riga dopo riga, come se la vergogna potesse sparire con la lettura.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "invece",
            "leggere",
            "ancora",
            "riga",
            "dopo",
            "riga",
            "come",
            "se",
            "la",
            "vergogna",
            "potesse",
            "sparire",
            "con",
            "la",
            "lettura"
          ]
        },
        {
          "id": "s30",
          "text": "La vergogna non ferma la lettura.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "vergogna",
            "non",
            "fermare",
            "la",
            "lettura"
          ]
        }
      ]
    },
    {
      "id": "p7",
      "order": 7,
      "sentences": [
        {
          "id": "s31",
          "text": "Prende la penna del bancone e scrive poco, questa volta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "prendere",
            "la",
            "penna",
            "del",
            "banco",
            "e",
            "scrivere",
            "poco",
            "questo",
            "volta"
          ]
        },
        {
          "id": "s32",
          "text": "Scusa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "scusa"
          ]
        },
        {
          "id": "s33",
          "text": "Ho capito male.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "capire",
            "ma"
          ]
        },
        {
          "id": "s34",
          "text": "Spero che tuo fratello dorma presto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "spero",
            "che",
            "tuo",
            "fratello",
            "dorma",
            "presto"
          ]
        },
        {
          "id": "s35",
          "text": "Chiude il libro e resta ferma, con la penna ancora in mano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "chiudere",
            "il",
            "libro",
            "e",
            "restare",
            "fermare",
            "con",
            "la",
            "penna",
            "ancora",
            "in",
            "mano"
          ]
        }
      ]
    },
    {
      "id": "p8",
      "order": 8,
      "sentences": [
        {
          "id": "s36",
          "text": "Bruna passa dietro di lei e le tocca la spalla con leggerezza.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "passare",
            "dietro",
            "di",
            "lei",
            "e",
            "le",
            "tocca",
            "la",
            "spalla",
            "con",
            "leggerezza"
          ]
        },
        {
          "id": "s37",
          "text": "Se il libro ti pesa, puoi non scrivere.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "se",
            "il",
            "libro",
            "ti",
            "pesa",
            "potere",
            "non",
            "scrivere"
          ]
        },
        {
          "id": "s38",
          "text": "Lo so.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "lo",
            "sapere"
          ]
        },
        {
          "id": "s39",
          "text": "Ma Elena sa anche un'altra cosa, più scomoda.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ma",
            "elena",
            "sapere",
            "anche",
            "altro",
            "cosa",
            "piu",
            "scomoda"
          ]
        },
        {
          "id": "s40",
          "text": "Se non scrive, aspetta lo stesso la prossima riga.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "se",
            "non",
            "scrivere",
            "aspettare",
            "lo",
            "stesso",
            "la",
            "prossimo",
            "riga"
          ]
        }
      ]
    },
    {
      "id": "p9",
      "order": 9,
      "sentences": [
        {
          "id": "s41",
          "text": "Nel pomeriggio il caffè è pieno e rumoroso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "nel",
            "pomeriggio",
            "il",
            "caffe",
            "essere",
            "pieno",
            "e",
            "rumoroso"
          ]
        },
        {
          "id": "s42",
          "text": "Elena preferisce questo rumore al silenzio di casa, dove i pensieri diventano lunghi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "preferisce",
            "questo",
            "rumore",
            "al",
            "silenzio",
            "di",
            "casa",
            "dove",
            "i",
            "pensieri",
            "diventano",
            "lunghi"
          ]
        },
        {
          "id": "s43",
          "text": "Pensa a un fratello che non dorme, senza conoscere ancora il nome Sergio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pensare",
            "a",
            "un",
            "fratello",
            "che",
            "non",
            "dormire",
            "senza",
            "conoscere",
            "ancora",
            "il",
            "nome",
            "sergio"
          ]
        },
        {
          "id": "s44",
          "text": "Pensa alla sua risposta sbagliata e alle parole inutili che ha messo sulla carta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pensare",
            "alla",
            "suo",
            "risposta",
            "sbagliata",
            "e",
            "alle",
            "parola",
            "inutili",
            "che",
            "avere",
            "mettere",
            "sulla",
            "carta"
          ]
        },
        {
          "id": "s45",
          "text": "Katia, mentre lava le tazze, parla senza guardarla.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "mentre",
            "lavare",
            "le",
            "tazze",
            "parlare",
            "senza",
            "guardarla"
          ]
        }
      ]
    },
    {
      "id": "p10",
      "order": 10,
      "sentences": [
        {
          "id": "s46",
          "text": "Non è un esame, Elena.",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "essere",
            "un",
            "esame",
            "elena"
          ]
        },
        {
          "id": "s47",
          "text": "È solo un libro.",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "essere",
            "solo",
            "un",
            "libro"
          ]
        },
        {
          "id": "s48",
          "text": "Elena annuisce, ma non è d'accordo dentro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "annuisce",
            "ma",
            "non",
            "essere",
            "d'accordo",
            "dentro"
          ]
        },
        {
          "id": "s49",
          "text": "Per lei non è solo un libro: è una voce senza faccia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "per",
            "lei",
            "non",
            "essere",
            "solo",
            "un",
            "libro",
            "essere",
            "una",
            "voce",
            "senza",
            "faccia"
          ]
        },
        {
          "id": "s50",
          "text": "Alla sera, dopo la chiusura, cammina un poco verso la laguna e si ferma presto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "alla",
            "sera",
            "dopo",
            "la",
            "chiusura",
            "camminare",
            "un",
            "poco",
            "verso",
            "la",
            "laguna",
            "e",
            "si",
            "fermare",
            "presto"
          ]
        }
      ]
    },
    {
      "id": "p11",
      "order": 11,
      "sentences": [
        {
          "id": "s51",
          "text": "Non è una giornata per l'acqua aperta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "essere",
            "una",
            "giornata",
            "per",
            "acqua",
            "aprire"
          ]
        },
        {
          "id": "s52",
          "text": "È una giornata per la vergogna e per il libro sullo scaffale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "una",
            "giornata",
            "per",
            "la",
            "vergogna",
            "e",
            "per",
            "il",
            "libro",
            "sul",
            "scaffale"
          ]
        },
        {
          "id": "s53",
          "text": "Tornando indietro, ride amara sotto la nebbia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "tornando",
            "indietro",
            "ride",
            "amara",
            "sotto",
            "la",
            "nebbia"
          ]
        },
        {
          "id": "s54",
          "text": "Prima di aprire, lava le mani e sistema le tazze come ogni sabato.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "prima",
            "di",
            "aprire",
            "lavare",
            "le",
            "mani",
            "e",
            "sistema",
            "le",
            "tazze",
            "come",
            "ogni",
            "sabato"
          ]
        },
        {
          "id": "s55",
          "text": "Il lavoro ordinario la tiene in piedi quando la testa è piena di carta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "lavorare",
            "ordinario",
            "la",
            "tiene",
            "in",
            "piedi",
            "quando",
            "la",
            "testa",
            "essere",
            "pieno",
            "di",
            "carta"
          ]
        }
      ]
    },
    {
      "id": "p12",
      "order": 12,
      "sentences": [
