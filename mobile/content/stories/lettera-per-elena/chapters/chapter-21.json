            "aspettare",
            "piu",
            "solo",
            "l'inchiostro"
          ]
        },
        {
          "id": "s74",
          "text": "Bruna, alla chiusura, sistema lo zucchero.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "alla",
            "chiusura",
            "sistema",
            "lo",
            "zucchero"
          ]
        },
        {
          "id": "s75",
          "text": "Guarda il libro una volta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "guardare",
            "il",
            "libro",
            "una",
            "volta"
          ]
        }
      ]
    },
    {
      "id": "p16",
      "order": 16,
      "sentences": [
        {
          "id": "s76",
          "text": "Parla piano, quasi al marito assente.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "parlare",
            "piano",
            "quasi",
            "al",
            "marito",
            "assente"
          ]
        },
        {
          "id": "s77",
          "text": "Vedi?",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "vedere"
          ]
        },
        {
          "id": "s78",
          "text": "Funziona ancora.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "funzionare",
            "ancora"
          ]
        },
        {
          "id": "s79",
          "text": "Poi spegne le luci.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "spegne",
            "le",
            "luce"
          ]
        },
        {
          "id": "s80",
          "text": "Marina di Brenta fuori è silenziosa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "marina",
            "di",
            "brenta",
            "fuori",
            "essere",
            "silenziosa"
          ]
        }
      ]
    },
    {
      "id": "p17",
      "order": 17,
      "sentences": [
        {
          "id": "s81",
          "text": "Dentro il caffè resta un oggetto semplice.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dentro",
            "il",
            "caffe",
            "restare",
            "un",
            "oggetto",
            "semplice"
          ]
        },
        {
          "id": "s82",
          "text": "Un libro grosso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "un",
            "libro",
            "grosso"
          ]
        },
        {
          "id": "s83",
          "text": "Non vendibile.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "vendibile"
          ]
        },
        {
          "id": "s84",
          "text": "Non sacro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "sacro"
          ]
        },
        {
          "id": "s85",
          "text": "Elena spiega a Bruna che vogliono scrivere ancora, ma di proposito.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "spiegare",
            "a",
            "bruna",
            "che",
            "volere",
            "scrivere",
            "ancora",
            "ma",
            "di",
            "proposito"
          ]
        }
      ]
    },
    {
      "id": "p18",
      "order": 18,
      "sentences": [
        {
          "id": "s86",
          "text": "Bruna ascolta con le braccia conserte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "ascoltare",
            "con",
            "le",
            "braccia",
            "conserte"
          ]
        },
        {
          "id": "s87",
          "text": "Poi abbatte le braccia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "abbatte",
            "le",
            "braccia"
          ]
        },
        {
          "id": "s88",
          "text": "Allora il libro resta.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "allora",
            "il",
            "libro",
            "restare"
          ]
        },
        {
          "id": "s89",
          "text": "Ma se diventa di nuovo un nascondiglio, lo chiudo un'altra volta.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "ma",
            "se",
            "diventa",
            "di",
            "nuovo",
            "un",
            "nascondiglio",
            "lo",
            "chiudo",
            "altro",
            "volta"
          ]
        },
        {
          "id": "s90",
          "text": "Elena accetta la regola.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "accettare",
            "la",
            "regola"
          ]
        }
      ]
    },
    {
      "id": "p19",
      "order": 19,
      "sentences": [
        {
          "id": "s91",
          "text": "Pietro, quando la sente, accetta anche lui.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "quando",
            "la",
            "sentire",
            "accettare",
            "anche",
            "lui"
          ]
        },
        {
          "id": "s92",
          "text": "Nei giorni seguenti lasciano note brevi e chiare.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "nei",
            "giorno",
            "seguenti",
            "lasciare",
            "note",
            "brevi",
            "e",
            "chiare"
          ]
        },
        {
          "id": "s93",
          "text": "Orari.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "orari"
          ]
        },
        {
          "id": "s94",
          "text": "Una battuta sul frigo che ancora rumoreggia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "una",
            "battuta",
            "sul",
            "frigo",
            "che",
            "ancora",
            "rumoreggia"
          ]
        },
        {
          "id": "s95",
          "text": "Una domanda: vuoi un panino dopo il turno?",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "una",
            "domanda",
            "volere",
            "un",
            "panino",
            "dopo",
            "il",
            "turno"
          ]
        }
      ]
    },
    {
      "id": "p20",
      "order": 20,
      "sentences": [
        {
          "id": "s96",
          "text": "Katia legge una volta e dice che ora il libro sembra un gruppo WhatsApp di carta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "leggere",
            "una",
            "volta",
            "e",
            "dire",
            "che",
            "ora",
            "il",
            "libro",
            "sembrare",
            "un",
            "gruppo",
            "whatsapp",
            "di",
            "carta"
          ]
        },
        {
          "id": "s97",
          "text": "Elena ride.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "ride"
          ]
        },
        {
          "id": "s98",
          "text": "Meglio così.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "meglio",
            "cosi"
          ]
        },
        {
          "id": "s99",
          "text": "Una sera Mirella chiede se la persona della carta ha una faccia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "una",
            "sera",
            "mirella",
            "chiedere",
            "se",
            "la",
            "persona",
            "della",
            "carta",
            "avere",
            "una",
            "faccia"
          ]
        },
        {
          "id": "s100",
          "text": "Elena dice di sì.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "dire",
            "di",
            "si_yes"
          ]
        }
      ]
    },
    {
      "id": "p21",
      "order": 21,
      "sentences": [
        {
          "id": "s101",
          "text": "Si chiama Pietro.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "si",
            "chiamare",
            "pietro"
          ]
        },
        {
          "id": "s102",
          "text": "Porta il caffè il martedì.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "porta",
            "il",
            "caffe",
            "il",
            "martedi"
          ]
        },
        {
          "id": "s103",
          "text": "E a volte il giovedì.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "e",
            "a",
            "volta",
            "il",
            "giovedi"
          ]
        },
        {
          "id": "s104",
          "text": "Mirella pensa un momento.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "mirella",
            "pensare",
            "un",
            "momento"
          ]
        },
        {
          "id": "s105",
          "text": "Allora portalo a cena, quando vuoi.",
          "speakerId": "mirella-marini",
          "kind": "dialogue",
          "lemmas": [
            "allora",
            "porta",
            "a",
            "cena",
            "quando",
            "volere"
          ]
        }
      ]
    },
    {
      "id": "p22",
      "order": 22,
      "sentences": [
        {
          "id": "s106",
          "text": "Non subito.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "subito"
          ]
        },
        {
          "id": "s107",
          "text": "Ma sì.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "ma",
            "si_yes"
          ]
        },
        {
          "id": "s108",
          "text": "Un giorno.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "un",
            "giorno"
          ]
        },
        {
          "id": "s109",
          "text": "Il libro resta sul suo scaffale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "libro",
            "restare",
            "sul",
            "suo",
            "scaffale"
          ]
        },
        {
          "id": "s110",
          "text": "Bruna lo spolvera con rispetto, non con culto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "lo",
            "spolvera",
            "con",
            "rispetto",
            "non",
            "con",
            "culto"
          ]
        }
      ]
    },
    {
      "id": "p23",
      "order": 23,
      "sentences": [
        {
          "id": "s111",
          "text": "Il caffè continua.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "caffe",
            "continuare"
          ]
        },
        {
          "id": "s112",
          "text": "Le persone timide possono ancora scrivere.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "le",
            "persona",
            "timide",
            "potere",
            "ancora",
            "scrivere"
          ]
        },
        {
          "id": "s113",
          "text": "Elena e Pietro possono ancora scrivere.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "e",
            "pietro",
            "potere",
            "ancora",
            "scrivere"
          ]
        },
        {
          "id": "s114",
          "text": "La differenza è che adesso sanno anche uscire dalla pagina.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "differenza",
            "essere",
            "che",
            "adesso",
            "sapere",
            "anche",
            "uscire",
            "dalla",
            "pagina"
          ]
        },
        {
          "id": "s115",
          "text": "E rientrare senza nascondersi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "e",
            "rientrare",
            "senza",
            "nascondersi"
          ]
        }
      ]
    },
    {
      "id": "p24",
      "order": 24,
      "sentences": [
        {
          "id": "s116",
          "text": "Un pomeriggio Pietro lascia una nota sul libro e poi la legge ad alta voce a Elena.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "un",
            "pomeriggio",
            "pietro",
            "lasciare",
            "una",
            "nota",
            "sul",
            "libro",
            "e",
            "poi",
            "la",
            "leggere",
            "a",
            "alto",
            "voce",
            "a",
            "elena"
          ]
        },
        {
          "id": "s117",
          "text": "È una prova piccola.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "una",
            "provare",
            "piccolo"
          ]
        },
        {
          "id": "s118",
          "text": "Funziona.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "funzionare"
          ]
        },
        {
          "id": "s119",
          "text": "Elena fa lo stesso con una riga sul latte finito.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "fare",
            "lo",
            "stesso",
            "con",
            "una",
            "riga",
            "sul",
            "latte",
            "finire"
          ]
        },
        {
          "id": "s120",
          "text": "Ridono tutti e due.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ridono",
            "tutto",
            "e",
            "due"
          ]
        }
      ]
    },
    {
      "id": "p25",
      "order": 25,
      "sentences": [
        {
          "id": "s121",
          "text": "Bruna, dal bancone, annuisce come un giudice soddisfatto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "dal",
            "banco",
            "annuisce",
            "come",
            "un",
            "giudice",
            "soddisfatto"
          ]
        },
        {
          "id": "s122",
          "text": "Il libro resta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "libro",
            "restare"
          ]
        },
        {
          "id": "s123",
          "text": "La voce resta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "voce",
            "restare"
          ]
        },
        {
          "id": "s124",
          "text": "Nessuna delle due cancella l'altra.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "nessuno",
            "delle",
            "due",
            "cancella",
            "altro"
          ]
        },
        {
          "id": "s125",
          "text": "Questa è la pace possibile di Marina di Brenta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "questo",
            "essere",
            "la",
            "pace",
            "possibile",
            "di",
            "marina",
            "di",
            "brenta"
          ]
        }
      ]
    },
    {
      "id": "p26",
      "order": 26,
      "sentences": [
        {
          "id": "s126",
          "text": "Non un finale chiuso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "un",
            "finale",
            "chiudere"
          ]
        },
