          "lemmas": [
            "alla",
            "fine",
            "del",
            "turno",
            "chiamare",
            "elena"
          ]
        }
      ]
    },
    {
      "id": "p7",
      "order": 7,
      "sentences": [
        {
          "id": "s31",
