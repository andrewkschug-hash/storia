            "una",
            "riga",
            "corta"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s06",
          "text": "Oggi ho parlato in voce e non è stato un disastro.",
