          "lemmas": [
            "non",
            "essere",
            "piu",
            "un",
            "doppio",
            "gioco"
          ]
        },
        {
          "id": "s29",
          "text": "Bruna vede tutto dal bancone.",
          "speakerId": null,
          "kind": "narration",
