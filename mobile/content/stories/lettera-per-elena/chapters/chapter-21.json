          "text": "Sta raccontando.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "stare",
            "raccontando"
          ]
        },
        {
          "id": "s10",
          "text": "Giovedì Pietro arriva senza casse.",
          "speakerId": null,
