            "non",
            "essere",
            "essere",
            "un",
            "disastro"
          ]
        },
        {
          "id": "s07",
          "text": "Sorride mentre scrive.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sorridere",
            "mentre",
            "scrivere"
          ]
        },
        {
          "id": "s08",
          "text": "Non si nasconde.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "si",
            "nasconde"
