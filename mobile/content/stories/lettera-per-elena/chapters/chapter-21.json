            "nei",
            "giorno",
            "dopo",
            "il",
            "libro",
            "restare",
            "sul",
            "scaffale"
          ]
        },
        {
          "id": "s02",
          "text": "Vicino allo zucchero, come sempre.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "vicino",
            "al",
            "zucchero",
            "come",
            "sempre"
          ]
        },
        {
          "id": "s03",
          "text": "Nessuno lo nasconde sotto il bancone.",
