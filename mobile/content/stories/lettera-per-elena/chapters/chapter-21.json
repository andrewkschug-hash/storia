          "text": "Un modo di continuare.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "un",
            "modo",
            "di",
            "continuare"
          ]
        },
        {
          "id": "s128",
          "text": "Solo aperto a chi vuole scrivere di proposito.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "solo",
            "aprire",
            "a",
            "chi",
            "volere",
            "scrivere",
            "di",
