          "kind": "narration",
          "lemmas": [
            "per",
            "una",
            "stretta",
            "goffa",
            "solo",
            "quello"
          ]
        },
        {
          "id": "s57",
          "text": "Pietro la stringe.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "la",
            "stringe"
          ]
        },
        {
          "id": "s58",
          "text": "Le mani sono calde e un po' sudate.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "le",
            "mani",
            "essere",
            "calde",
            "e",
            "un",
            "poco",
            "sudate"
          ]
        },
        {
          "id": "s59",
          "text": "Perfetto no.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "perfetto",
            "no"
          ]
        },
        {
          "id": "s60",
          "text": "Vero sì.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "vero",
            "si_yes"
          ]
        }
      ]
    },
    {
      "id": "p13",
      "order": 13,
      "sentences": [
        {
          "id": "s61",
          "text": "Katia bussa sullo stipite.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "bussa",
            "sul",
            "stipite"
          ]
        },
        {
          "id": "s62",
          "text": "C'è una fila.",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "ce",
            "una",
            "fila"
          ]
        },
        {
          "id": "s63",
          "text": "Elena ritira la mano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "ritira",
            "la",
            "mano"
          ]
        },
        {
          "id": "s64",
          "text": "Arrivo.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "arrivare"
          ]
        },
        {
          "id": "s65",
          "text": "Pietro resta un secondo nel magazzino.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "restare",
            "un",
            "secondo",
            "nel",
            "magazzino"
          ]
        }
      ]
    },
    {
      "id": "p14",
      "order": 14,
      "sentences": [
        {
          "id": "s66",
          "text": "Poi esce dietro di lei.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "uscire",
            "dietro",
            "di",
            "lei"
          ]
        },
        {
          "id": "s67",
          "text": "Al bancone il lavoro riparte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "al",
            "banco",
            "il",
            "lavorare",
            "riparte"
          ]
        },
        {
          "id": "s68",
          "text": "Cappuccini, zucchero, resti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "cappuccini",
            "zucchero",
            "restare"
          ]
        },
        {
          "id": "s69",
          "text": "Bruna guarda i due e non dice niente.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "guardare",
            "i",
            "due",
            "e",
            "non",
            "dire",
            "niente"
          ]
        },
        {
          "id": "s70",
          "text": "Il silenzio di Bruna è approvazione.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "silenzio",
            "di",
            "bruna",
            "essere",
            "approvazione"
          ]
        }
      ]
    },
    {
      "id": "p15",
      "order": 15,
      "sentences": [
        {
          "id": "s71",
          "text": "Prima di andare Pietro parla ancora, piano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "prima",
            "di",
            "andare",
            "pietro",
            "parlare",
            "ancora",
            "piano"
          ]
        },
        {
          "id": "s72",
          "text": "A giovedì?",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "a",
            "giovedi"
          ]
        },
        {
          "id": "s73",
          "text": "Elena alza gli occhi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "alzare",
            "gli",
            "occhi"
          ]
        },
        {
          "id": "s74",
          "text": "Il tuo giorno è martedì.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "il",
            "tuo",
            "giorno",
            "essere",
            "martedi"
          ]
        },
        {
          "id": "s75",
          "text": "Pietro scrolla le spalle.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "scrolla",
            "le",
