          "lemmas": [
            "pietro",
            "guardare",
            "una",
            "cassa",
            "di",
            "caffe"
          ]
        },
        {
          "id": "s52",
          "text": "Possiamo sbagliare.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "potere",
            "sbagliare"
          ]
        },
        {
          "id": "s53",
          "text": "Possiamo scrivere ancora, a volte.",
