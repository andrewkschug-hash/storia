    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Dopo il rush del mattino Bruna fa un cenno.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dopo",
            "il",
            "rush",
            "del",
            "mattino",
            "bruna",
            "fare",
            "un",
            "cenno"
          ]
        },
        {
          "id": "s02",
          "text": "Katia tiene il bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "tiene",
            "il",
            "banco"
          ]
        },
        {
          "id": "s03",
          "text": "Elena e Pietro vanno nel magazzino.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "e",
            "pietro",
            "andare",
            "nel",
            "magazzino"
          ]
        },
        {
          "id": "s04",
          "text": "L'aria odora di caffè e di cartone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "l'aria",
            "odora",
            "di",
            "caffe",
            "e",
            "di",
            "cartone"
          ]
        },
        {
          "id": "s05",
          "text": "C'è poco spazio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ce",
            "poco",
            "spazio"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s06",
          "text": "Due scaffali, un sacco di zucchero, una lampada fredda.",
