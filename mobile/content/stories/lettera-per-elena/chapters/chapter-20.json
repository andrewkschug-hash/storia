          "kind": "dialogue",
          "lemmas": [
            "ma",
            "non",
            "al",
            "posto",
            "della",
            "voce"
          ]
        },
        {
          "id": "s55",
          "text": "Elena tende la mano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "tende",
            "la",
            "mano"
          ]
        }
      ]
    },
    {
      "id": "p12",
      "order": 12,
      "sentences": [
        {
          "id": "s56",
          "text": "Per una stretta goffa, solo quello.",
