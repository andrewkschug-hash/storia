          "kind": "narration",
          "lemmas": [
            "due",
            "scaffali",
            "un",
            "sacco",
            "di",
            "zucchero",
            "una",
            "lampada",
            "fredda"
          ]
        },
        {
          "id": "s07",
          "text": "Pietro chiude la porta a metà.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "chiudere",
            "la",
            "porta",
            "a",
            "meta"
          ]
        },
        {
          "id": "s08",
          "text": "Non del tutto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "del",
            "tutto"
          ]
        },
        {
          "id": "s09",
          "text": "Elena apprezza questo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "apprezza",
            "questo"
          ]
        },
        {
          "id": "s10",
          "text": "Non è un segreto sporco.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "essere",
            "un",
            "segreto",
            "sporco"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s11",
          "text": "È solo privacy.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "solo",
            "privacy"
          ]
        },
        {
          "id": "s12",
          "text": "Pietro guarda le scarpe.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "guardare",
            "le",
            "scarpe"
          ]
        },
        {
          "id": "s13",
          "text": "Scusa per l'ospedale.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "scusa",
            "per",
            "l'ospedale"
          ]
        },
        {
          "id": "s14",
          "text": "Ero spaventato.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "essere",
            "spaventato"
          ]
        },
        {
          "id": "s15",
          "text": "Elena annuisce.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "annuisce"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s16",
          "text": "Io pure.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "io",
            "pure"
          ]
        },
        {
          "id": "s17",
          "text": "Sono venuta senza chiedere.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "essere",
            "venire",
            "senza",
            "chiedere"
          ]
        },
        {
          "id": "s18",
          "text": "Pietro alza gli occhi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "alzare",
            "gli",
            "occhi"
          ]
        },
        {
          "id": "s19",
          "text": "Sergio sta un po' meglio.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "sergio",
            "stare",
            "un",
            "poco",
            "meglio"
          ]
        },
        {
          "id": "s20",
          "text": "Dorme di più.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "dormire",
            "di",
            "piu"
          ]
        }
      ]
    },
    {
      "id": "p5",
      "order": 5,
      "sentences": [
        {
          "id": "s21",
          "text": "Elena ascolta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "ascoltare"
          ]
        },
        {
          "id": "s22",
          "text": "Questa volta lui parla in voce.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "questo",
            "volta",
            "lui",
            "parlare",
            "in",
            "voce"
          ]
        },
        {
          "id": "s23",
          "text": "Non sulla carta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "sulla",
            "carta"
          ]
        },
        {
          "id": "s24",
          "text": "Nel libro era più facile.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "nel",
            "libro",
            "essere",
            "piu",
            "facile"
          ]
        },
        {
          "id": "s25",
          "text": "Scrivevo e sparivo.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "scrivevo",
            "e",
            "sparivo"
          ]
        }
      ]
    },
    {
      "id": "p6",
      "order": 6,
      "sentences": [
        {
          "id": "s26",
          "text": "Elena sorride senza ridere.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "sorridere",
            "senza",
            "ridere"
          ]
        },
        {
          "id": "s27",
          "text": "Io leggevo e inventavo una persona perfetta.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "io",
            "leggevo",
            "e",
            "inventavo",
            "una",
            "persona",
            "perfetta"
          ]
        },
        {
          "id": "s28",
          "text": "Poi al bancone c'eri tu.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "poi",
            "al",
            "banco",
            "c'eri",
            "tu"
          ]
        },
        {
          "id": "s29",
          "text": "Timido.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "timido"
          ]
        },
        {
          "id": "s30",
          "text": "Vero.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "vero"
          ]
        }
      ]
    },
    {
      "id": "p7",
      "order": 7,
      "sentences": [
        {
          "id": "s31",
          "text": "Diverso dalla carta.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "diverso",
            "dalla",
            "carta"
          ]
        },
        {
          "id": "s32",
          "text": "Pietro balbetta un attimo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "balbetta",
            "un",
            "attimo"
          ]
        },
        {
