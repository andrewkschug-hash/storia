    {
      "id": "p8",
      "order": 8,
      "sentences": [
        {
          "id": "s36",
          "text": "Riparte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "riparte"
          ]
        },
        {
          "id": "s37",
          "text": "Vorrei riprovare.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "volere",
            "riprovare"
          ]
        },
        {
