          "lemmas": [
            "essere",
            "goffa"
          ]
        }
      ]
    },
    {
      "id": "p9",
      "order": 9,
      "sentences": [
        {
          "id": "s41",
          "text": "È vera.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "vero"
          ]
        },
        {
          "id": "s42",
          "text": "Elena sente gli occhi umidi, ma non piange.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "sentire",
            "gli",
            "occhi",
            "umidi",
            "ma",
            "non",
            "piange"
          ]
        },
        {
          "id": "s43",
          "text": "Va bene.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "andare",
            "bene"
          ]
        },
        {
          "id": "s44",
          "text": "Anche io.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "anche",
            "io"
          ]
        },
        {
          "id": "s45",
          "text": "Vorrei riprovare senza nascondermi dietro le pagine.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "volere",
            "riprovare",
            "senza",
            "nascondermi",
            "dietro",
            "le",
            "pagine"
          ]
        }
      ]
    },
    {
      "id": "p10",
      "order": 10,
      "sentences": [
        {
          "id": "s46",
          "text": "Pietro fa un mezzo sorriso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "fare",
            "un",
            "mezzo",
            "sorridere"
          ]
        },
        {
          "id": "s47",
          "text": "Non sarò bravo.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "saro",
            "bravo"
          ]
        },
        {
          "id": "s48",
          "text": "Io nemmeno.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "io",
            "nemmeno"
          ]
        },
        {
          "id": "s49",
          "text": "Al bancone parlo facile.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "al",
            "banco",
            "parlare",
            "facile"
          ]
        },
        {
          "id": "s50",
          "text": "Con te no.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "con",
            "tu",
            "no"
          ]
        }
      ]
    },
    {
      "id": "p11",
      "order": 11,
      "sentences": [
        {
          "id": "s51",
          "text": "Pietro guarda una cassa di caffè.",
          "speakerId": null,
