  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Giovedì mattina la nebbia copre Marina di Brenta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "giovedi",
            "mattina",
            "la",
            "nebbia",
            "copre",
            "marina",
            "di",
            "brenta"
          ]
        },
        {
          "id": "s02",
          "text": "Elena arriva in bicicletta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "arrivare",
            "in",
            "bicicletta"
          ]
        },
        {
          "id": "s03",
          "text": "Apre il Caffè Brenta con Bruna.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "aprire",
            "il",
            "caffe",
            "brenta",
            "con",
            "bruna"
          ]
        },
        {
          "id": "s04",
          "text": "Accendono le luci.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "accendono",
            "le",
            "luce"
          ]
        },
        {
          "id": "s05",
          "text": "Sistemano le tazze.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sistemano",
            "le",
            "tazze"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s06",
          "text": "Lo zucchero è pieno.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lo",
            "zucchero",
            "essere",
            "pieno"
          ]
        },
        {
          "id": "s07",
          "text": "Il libro è sullo scaffale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "libro",
            "essere",
            "sul",
            "scaffale"
          ]
        },
        {
          "id": "s08",
          "text": "Katia arriva con la sciarpa bagnata di nebbia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "arrivare",
            "con",
            "la",
            "sciarpa",
            "bagnata",
            "di",
            "nebbia"
          ]
        },
        {
          "id": "s09",
          "text": "Oggi non è martedì.",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "oggi",
            "non",
            "essere",
            "martedi"
          ]
        },
        {
          "id": "s10",
          "text": "Elena sa cosa intende.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "sapere",
            "cosa",
            "intende"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s11",
          "text": "Verso le nove il van si ferma fuori.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "verso",
            "le",
            "nove",
            "il",
            "van",
            "si",
            "fermare",
            "fuori"
          ]
        },
        {
          "id": "s12",
          "text": "Pietro entra con una piccola cassa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "entrare",
            "con",
            "una",
            "piccolo",
            "cassa"
          ]
        },
        {
          "id": "s13",
          "text": "E con un pezzo di legno.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "e",
            "con",
            "un",
            "pezzo",
            "di",
            "legno"
          ]
        },
        {
          "id": "s14",
          "text": "Per il tavolo.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "per",
            "il",
            "tavolo"
          ]
        },
        {
          "id": "s15",
          "text": "Elena sorride.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "sorridere"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s16",
          "text": "Buongiorno.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "buongiorno"
          ]
        },
        {
          "id": "s17",
          "text": "Buongiorno.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "buongiorno"
          ]
        },
        {
          "id": "s18",
          "text": "Non è un discorso lungo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "essere",
            "un",
            "discorso",
            "lungo"
          ]
        },
        {
          "id": "s19",
          "text": "È un giovedì di lavoro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "un",
            "giovedi",
            "di",
            "lavorare"
          ]
        },
        {
          "id": "s20",
          "text": "Pietro mette il legno sotto la gamba del tavolo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "mettere",
            "il",
            "legno",
            "sotto",
            "la",
            "gamba",
            "del",
            "tavolo"
          ]
        }
      ]
    },
    {
      "id": "p5",
      "order": 5,
      "sentences": [
        {
          "id": "s21",
          "text": "Il tavolo non balla più.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "tavolo",
            "non",
            "balla",
            "piu"
          ]
        },
        {
          "id": "s22",
          "text": "Katia batte le mani una volta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "batte",
            "le",
            "mani",
            "una",
            "volta"
          ]
        },
        {
          "id": "s23",
          "text": "Miracolo.",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "miracolo"
          ]
        },
        {
          "id": "s24",
          "text": "Bruna serve i primi clienti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "servire",
            "i",
            "primo",
            "cliente"
          ]
        },
        {
          "id": "s25",
          "text": "Elena fa cappuccini.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "fare",
            "cappuccini"
          ]
        }
      ]
    },
    {
      "id": "p6",
      "order": 6,
      "sentences": [
        {
          "id": "s26",
          "text": "Pietro aspetta il suo turno senza fretta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "aspettare",
            "il",
            "suo",
            "turno",
            "senza",
            "fretta"
          ]
        },
        {
          "id": "s27",
          "text": "Quando c'è spazio, parla.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "quando",
            "ce",
            "spazio",
            "parlare"
          ]
        },
        {
          "id": "s28",
          "text": "Sergio oggi fa fisioterapia.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "sergio",
            "oggi",
            "fare",
            "fisioterapia"
          ]
        },
        {
          "id": "s29",
          "text": "Io passo dopo.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "io",
            "passare",
            "dopo"
          ]
        },
        {
          "id": "s30",
          "text": "Elena ascolta e risponde.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "ascoltare",
            "e",
            "rispondere"
          ]
        }
      ]
    },
    {
      "id": "p7",
      "order": 7,
      "sentences": [
        {
          "id": "s31",
          "text": "Se vuoi, dopo il turno posso venire fuori dall'ospedale.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "se",
            "volere",
            "dopo",
            "il",
            "turno",
            "potere",
            "venire",
            "fuori",
            "dall'ospedale"
          ]
        },
        {
          "id": "s32",
          "text": "Pietro ci pensa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "ci",
            "pensare"
          ]
        },
        {
          "id": "s33",
          "text": "Sì.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "si_yes"
          ]
        },
        {
          "id": "s34",
          "text": "Ma solo fuori.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "ma",
            "solo",
            "fuori"
          ]
        },
        {
          "id": "s35",
          "text": "Come la volta scorsa, senza litigio.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "come",
            "la",
            "volta",
            "scorsa",
            "senza",
            "litigio"
          ]
        }
      ]
    },
    {
      "id": "p8",
      "order": 8,
      "sentences": [
        {
          "id": "s36",
          "text": "Elena annuisce.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "annuisce"
          ]
        },
        {
          "id": "s37",
          "text": "Senza litigio.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "senza",
            "litigio"
          ]
        },
        {
          "id": "s38",
          "text": "Il mattino scorre.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "mattino",
            "scorre"
          ]
        },
        {
          "id": "s39",
          "text": "Ordini, rumore di tazzine, nebbia ai vetri.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ordini",
            "rumore",
            "di",
            "tazzine",
            "nebbia",
            "ai",
            "vetri"
          ]
        },
        {
          "id": "s40",
          "text": "Pietro aiuta a portare il latte dal magazzino.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "aiutare",
            "a",
            "portare",
            "il",
            "latte",
            "dal",
            "magazzino"
          ]
        }
      ]
    },
    {
      "id": "p9",
      "order": 9,
      "sentences": [
        {
          "id": "s41",
          "text": "Non è il suo lavoro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "essere",
            "il",
            "suo",
            "lavorare"
          ]
        },
        {
          "id": "s42",
          "text": "Lo fa lo stesso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lo",
            "fare",
            "lo",
            "stesso"
          ]
        },
        {
          "id": "s43",
          "text": "Bruna gli mette un grembiule per scherzo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "gli",
            "mettere",
            "un",
            "grembiule",
            "per",
            "scherzo"
          ]
        },
        {
          "id": "s44",
          "text": "Lui lo lascia per dieci minuti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lui",
            "lo",
            "lasciare",
            "per",
            "dieci",
            "minuti"
          ]
        },
        {
          "id": "s45",
          "text": "Poi lo toglie, rosso in faccia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "lo",
            "toglie",
            "rosso",
            "in",
            "faccia"
          ]
        }
      ]
    },
    {
      "id": "p10",
      "order": 10,
      "sentences": [
        {
          "id": "s46",
          "text": "Elena lo trova bello in modo ordinario.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "lo",
            "trovare",
            "bello",
            "in",
            "modo",
            "ordinario"
          ]
        },
        {
          "id": "s47",
          "text": "Non da matrimonio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "dare",
            "matrimonio"
          ]
        },
        {
          "id": "s48",
          "text": "Da giovedì.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dare",
            "giovedi"
          ]
        },
        {
          "id": "s49",
          "text": "A metà mattina aprono il libro insieme.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "a",
            "meta",
            "mattina",
            "aprono",
            "il",
            "libro",
            "insieme"
          ]
        },
        {
          "id": "s50",
          "text": "Scrivono una riga a due mani, quasi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "scrivono",
            "una",
            "riga",
            "a",
            "due",
            "mani",
            "quasi"
          ]
        }
      ]
    },
    {
      "id": "p11",
      "order": 11,
      "sentences": [
        {
          "id": "s51",
          "text": "Oggi il tavolo non balla.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "oggi",
            "il",
            "tavolo",
            "non",
            "balla"
          ]
        },
        {
          "id": "s52",
          "text": "Noi sì, un poco, ma in piedi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "noi",
            "si_yes",
            "un",
            "poco",
            "ma",
            "in",
            "piedi"
          ]
        },
        {
          "id": "s53",
          "text": "Katia legge e scuote la testa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "leggere",
            "e",
            "scuote",
            "la",
            "testa"
          ]
        },
        {
          "id": "s54",
          "text": "Sentimentali.",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "sentimentali"
          ]
        },
        {
          "id": "s55",
          "text": "Elena non si offende.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "non",
            "si",
            "offende"
          ]
        }
      ]
    },
    {
      "id": "p12",
      "order": 12,
      "sentences": [
        {
          "id": "s56",
          "text": "Fuori la nebbia si alza piano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "fuori",
            "la",
            "nebbia",
            "si",
            "alzare",
            "piano"
          ]
        },
        {
          "id": "s57",
          "text": "Si vede un pezzo di strada.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "si",
            "vedere",
            "un",
            "pezzo",
            "di",
            "strada"
          ]
        },
        {
          "id": "s58",
          "text": "Si vedono due biciclette.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "si",
            "vedere",
            "due",
            "biciclette"
          ]
        },
        {
          "id": "s59",
          "text": "Marina di Brenta torna a essere chiara.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "marina",
            "di",
            "brenta",
            "tornare",
            "a",
            "essere",
            "chiaro"
          ]
        },
        {
          "id": "s60",
          "text": "Pietro deve ripartire.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "dovere",
            "ripartire"
          ]
        }
      ]
    },
    {
      "id": "p13",
      "order": 13,
      "sentences": [
        {
          "id": "s61",
          "text": "Ha altre consegne.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "altro",
            "consegne"
          ]
        },
        {
          "id": "s62",
          "text": "Prima di uscire si ferma al bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "prima",
            "di",
            "uscire",
            "si",
            "fermare",
            "al",
            "banco"
          ]
        },
        {
          "id": "s63",
          "text": "A dopo.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "a",
            "dopo"
          ]
        },
        {
          "id": "s64",
          "text": "A dopo.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "a",
            "dopo"
          ]
        },
        {
          "id": "s65",
          "text": "Non annunciano niente.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "annunciano",
            "niente"
          ]
        }
      ]
    },
    {
      "id": "p14",
      "order": 14,
      "sentences": [
        {
          "id": "s66",
          "text": "C'è lavoro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ce",
            "lavorare"
          ]
        },
        {
          "id": "s67",
          "text": "C'è nebbia che va via.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ce",
            "nebbia",
            "che",
            "andare",
            "via"
          ]
        },
        {
          "id": "s68",
          "text": "C'è un uomo che viene anche di giovedì.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ce",
            "un",
            "uomo",
            "che",
            "venire",
            "anche",
            "di",
            "giovedi"
          ]
        },
        {
          "id": "s69",
          "text": "C'è una donna che dice le cose al bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ce",
            "una",
            "donna",
            "che",
            "dire",
            "le",
            "cosa",
            "al",
            "banco"
          ]
        },
        {
          "id": "s70",
          "text": "C'è un libro che resta aperto a chi vuole.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ce",
            "un",
            "libro",
            "che",
            "restare",
            "aprire",
            "a",
            "chi",
            "volere"
          ]
        }
      ]
    },
    {
      "id": "p15",
      "order": 15,
      "sentences": [
        {
          "id": "s71",
          "text": "Bruna conta i soldi del cassetto.",
          "speakerId": null,
          "kind": "narration",
