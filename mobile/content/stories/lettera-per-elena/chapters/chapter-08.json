        }
      ]
    },
    {
      "id": "p5",
      "order": 5,
      "sentences": [
        {
          "id": "s21",
          "text": "Che problemi?",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "che",
            "problema"
          ]
        },
        {
          "id": "s22",
          "text": "Non so. Non chiedo tutto. Non è il mio stile.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "sapere",
            "non",
            "chiedere",
            "tutto",
            "non",
            "essere",
            "il",
            "mio",
            "stile"
          ]
        },
        {
          "id": "s23",
          "text": "Katia lava i bicchieri e parla senza guardare.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "lavare",
            "i",
            "bicchieri",
            "e",
            "parlare",
            "senza",
            "guardare"
          ]
        },
        {
          "id": "s24",
          "text": "Al bancone si sente tutto e niente.",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "al",
            "banco",
            "si",
            "sentire",
            "tutto",
            "e",
            "niente"
          ]
        },
        {
          "id": "s25",
          "text": "Elena pensa al fratello che non dorme.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "pensare",
            "al",
