  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Venerdì Elena apre il libro prima del turno.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "venerdi",
            "elena",
            "aprire",
            "il",
            "libro",
            "prima",
            "del",
            "turno"
          ]
        },
        {
          "id": "s02",
          "text": "Il caffè è ancora quieto. Lo zucchero è già sul bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "caffe",
            "essere",
            "ancora",
            "quieto",
            "lo",
            "zucchero",
            "essere",
            "gia",
            "sul",
            "banco"
          ]
        },
        {
          "id": "s03",
          "text": "C'è una riga nuova, scritta di fretta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ce",
            "una",
            "riga",
            "nuovo",
            "scritta",
            "di",
            "fretta"
          ]
        },
        {
          "id": "s04",
          "text": "Mio fratello non dorme.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "mio",
            "fratello",
            "non",
            "dormire"
          ]
        },
        {
          "id": "s05",
          "text": "La casa è piena di paura quieta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "casa",
            "essere",
            "pieno",
            "di",
            "paura",
            "quieta"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s06",
          "text": "Io resto sveglio con lui e non so cosa dire.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "io",
            "restare",
            "svegliare",
            "con",
            "lui",
            "e",
            "non",
            "sapere",
            "cosa",
            "dire"
          ]
        },
        {
          "id": "s07",
          "text": "Elena legge e immagina una storia sbagliata.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "leggere",
            "e",
            "immagina",
            "una",
            "storia",
            "sbagliata"
          ]
        },
        {
          "id": "s08",
          "text": "Pensa a una relazione finita.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pensare",
            "a",
            "una",
            "relazione",
            "finire"
          ]
        },
        {
          "id": "s09",
          "text": "Pensa a un letto vuoto, a litigi, a un addio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pensare",
            "a",
            "un",
            "leggere",
            "vuoto",
            "a",
            "litigi",
            "a",
            "un",
            "addio"
          ]
        },
        {
          "id": "s10",
          "text": "Nella sua testa il fratello è quasi un ex, non un fratello.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "nella",
            "suo",
            "testa",
            "il",
            "fratello",
            "essere",
            "quasi",
            "un",
            "ex",
            "non",
            "un",
            "fratello"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s11",
          "text": "Scrive una risposta dolce e fuori posto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "scrivere",
            "una",
            "risposta",
            "dolce",
            "e",
            "fuori",
            "posto"
          ]
        },
        {
          "id": "s12",
          "text": "A volte le persone se ne vanno.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "a",
            "volta",
            "le",
            "persona",
            "se",
            "ne",
            "andare"
          ]
        },
        {
          "id": "s13",
          "text": "Non è colpa tua se il silenzio resta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "essere",
            "colpa",
            "tuo",
            "se",
            "il",
            "silenzio",
            "restare"
          ]
        },
        {
          "id": "s14",
          "text": "Il tempo aiuta, anche se adesso non sembra.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "tempo",
            "aiutare",
            "anche",
            "se",
            "adesso",
            "non",
            "sembrare"
          ]
        },
        {
