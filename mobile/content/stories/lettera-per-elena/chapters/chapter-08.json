            "il",
            "turno",
            "bruna",
            "parlare",
            "di",
            "una",
            "consegna",
            "in",
            "ritardo"
          ]
        },
        {
          "id": "s18",
          "text": "Pietro questa settimana è stato in ritardo due volte.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "pietro",
            "questo",
            "settimana",
            "essere",
            "essere",
            "in",
            "ritardo",
            "due",
            "volta"
          ]
        },
        {
          "id": "s19",
          "text": "Ha problemi in famiglia, credo.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "avere",
            "problema",
            "in",
            "famiglia",
            "credo"
          ]
        },
        {
          "id": "s20",
          "text": "Elena alza la testa dal bancone.",
