    {
      "id": "p6",
      "order": 6,
      "sentences": [
        {
          "id": "s26",
          "text": "Nella sua testa resta ancora una rottura d'amore.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "nella",
            "suo",
            "testa",
            "restare",
            "ancora",
            "una",
            "rottura",
            "d'amore"
          ]
        },
        {
          "id": "s27",
          "text": "Non collega Pietro al libro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "collega",
            "pietro",
            "al",
            "libro"
          ]
        },
        {
          "id": "s28",
          "text": "Non sente ancora il nome Sergio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "sentire",
            "ancora",
            "il",
            "nome",
            "sergio"
          ]
        },
        {
          "id": "s29",
          "text": "Nel pomeriggio rilegge la sua risposta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "nel",
            "pomeriggio",
            "rilegge",
            "la",
            "suo",
            "risposta"
          ]
        },
        {
          "id": "s30",
          "text": "Le sembra buona. Le sembra anche un po' fuori posto.",
          "speakerId": null,
