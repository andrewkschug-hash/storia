          "lemmas": [
            "il",
            "tavolo",
            "balla",
            "ancora",
            "un",
            "poco"
          ]
        },
        {
          "id": "s35",
          "text": "Elena sorride alla memoria della prima riga del libro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "sorridere",
            "alla",
            "memoria",
            "della",
