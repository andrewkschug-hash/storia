    },
    {
      "id": "p7",
      "order": 7,
      "sentences": [
        {
          "id": "s31",
          "text": "Ma lei non lo sa ancora.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ma",
            "lei",
            "non",
            "lo",
            "sapere",
            "ancora"
          ]
        },
        {
          "id": "s32",
          "text": "Un cliente chiede lo zucchero per il tavolo vicino alla finestra.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "un",
            "cliente",
            "chiedere",
            "lo",
            "zucchero",
            "per",
            "il",
            "tavolo",
            "vicino",
            "alla",
            "finestra"
          ]
        },
        {
          "id": "s33",
          "text": "Elena lo porta al tavolo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "lo",
            "porta",
            "al",
            "tavolo"
          ]
        },
        {
          "id": "s34",
          "text": "Il tavolo balla ancora un poco.",
