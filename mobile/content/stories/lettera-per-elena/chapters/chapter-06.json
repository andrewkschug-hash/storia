  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Domenica Elena è a casa di sua madre.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "domenica",
            "elena",
            "essere",
            "a",
            "casa",
            "di",
            "suo",
            "madre"
          ]
        },
        {
          "id": "s02",
          "text": "La cucina di Mirella è piccola e calda.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "cucina",
            "di",
            "mirella",
            "essere",
            "piccolo",
            "e",
            "caldo"
          ]
        },
        {
          "id": "s03",
          "text": "C'è odore di caffè e di pane.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ce",
            "odore",
            "di",
            "caffe",
            "e",
            "di",
            "pane"
          ]
        },
        {
          "id": "s04",
          "text": "Mirella mette due tazzine sul tavolo e lo zucchero vicino.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "mirella",
            "mettere",
            "due",
            "tazzine",
            "sul",
            "tavolo",
            "e",
            "lo",
            "zucchero",
            "vicino"
          ]
        },
        {
          "id": "s05",
          "text": "Resti qui, vero?",
          "speakerId": "mirella-marini",
          "kind": "dialogue",
          "lemmas": [
            "restare",
            "qui",
            "vero"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s06",
          "text": "Elena guarda lo zucchero e non la madre.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "guardare",
            "lo",
            "zucchero",
            "e",
            "non",
            "la",
            "madre"
          ]
        },
        {
          "id": "s07",
          "text": "Lavoro al Caffè Brenta. Per ora sì.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "lavorare",
            "al",
            "caffe",
            "brenta",
            "per",
            "ora",
            "si_yes"
          ]
        },
        {
          "id": "s08",
          "text": "Padova è finita.",
          "speakerId": "mirella-marini",
          "kind": "dialogue",
          "lemmas": [
            "padova",
            "essere",
            "finire"
          ]
        },
        {
          "id": "s09",
          "text": "Sì. Il lavoro là è finito.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "si_yes",
            "il",
            "lavorare",
            "la",
            "essere",
            "finire"
          ]
        },
        {
          "id": "s10",
          "text": "Mirella annuisce e riempie le tazzine.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "mirella",
            "annuisce",
            "e",
            "riempie",
            "le",
            "tazzine"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s11",
          "text": "Qui hai casa. Hai me. Hai il caffè.",
          "speakerId": "mirella-marini",
          "kind": "dialogue",
          "lemmas": [
            "qui",
            "avere",
            "casa",
            "avere",
            "io",
            "avere",
            "il",
            "caffe"
          ]
        },
        {
          "id": "s12",
          "text": "Elena sorride, ma è stanca di questa pressione dolce.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "sorridere",
            "ma",
            "essere",
            "stanco",
            "di",
            "questo",
            "pressione",
            "dolce"
          ]
        },
        {
          "id": "s13",
          "text": "Il caffè mi piace. Il bancone mi piace.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "il",
            "caffe",
            "mi",
            "piacere",
            "il",
            "banco",
            "mi",
            "piacere"
          ]
        },
        {
          "id": "s14",
          "text": "Al bancone parli tanto.",
          "speakerId": "mirella-marini",
          "kind": "dialogue",
          "lemmas": [
            "al",
            "banco",
            "parlare",
            "tanto"
          ]
        },
        {
          "id": "s15",
          "text": "A casa parli poco.",
          "speakerId": "mirella-marini",
          "kind": "dialogue",
          "lemmas": [
            "a",
            "casa",
            "parlare",
            "poco"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s16",
          "text": "Elena beve il caffè e sente il silenzio della cucina.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "bere",
            "il",
            "caffe",
            "e",
            "sentire",
            "il",
            "silenzio",
            "della",
            "cucina"
          ]
        },
        {
          "id": "s17",
          "text": "Al bancone è più facile.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "al",
            "banco",
            "essere",
            "piu",
            "facile"
          ]
        },
        {
          "id": "s18",
          "text": "Mirella guarda fuori dalla finestra, verso la nebbia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "mirella",
            "guardare",
            "fuori",
            "dalla",
            "finestra",
            "verso",
            "la",
            "nebbia"
          ]
        },
        {
          "id": "s19",
          "text": "Tuo padre parlava così, sulla carta.",
          "speakerId": "mirella-marini",
          "kind": "dialogue",
          "lemmas": [
            "tuo",
            "padre",
            "parlare",
            "cosi",
            "sulla",
            "carta"
          ]
        },
        {
          "id": "s20",
          "text": "Elena alza gli occhi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "alzare",
            "gli",
            "occhi"
          ]
        }
      ]
    },
    {
      "id": "p5",
      "order": 5,
      "sentences": [
        {
          "id": "s21",
          "text": "Sulla carta?",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "sulla",
            "carta"
          ]
        },
        {
          "id": "s22",
          "text": "Sì. Scriveva biglietti. Scriveva frasi corte.",
          "speakerId": "mirella-marini",
          "kind": "dialogue",
          "lemmas": [
            "si_yes",
            "scrivere",
            "biglietti",
            "scrivere",
            "frasi",
            "corte"
          ]
        },
        {
          "id": "s23",
          "text": "In voce era più chiuso.",
          "speakerId": "mirella-marini",
          "kind": "dialogue",
          "lemmas": [
            "in",
            "voce",
            "essere",
            "piu",
            "chiudere"
          ]
        },
        {
          "id": "s24",
          "text": "Elena resta zitta un momento lungo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "restare",
            "zitta",
            "un",
            "momento",
            "lungo"
          ]
        },
        {
          "id": "s25",
          "text": "Pensa al libro vicino allo zucchero al caffè.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pensare",
            "al",
            "libro",
            "vicino",
            "al",
            "zucchero",
            "al",
            "caffe"
          ]
        }
      ]
    },
    {
      "id": "p6",
      "order": 6,
      "sentences": [
        {
          "id": "s26",
          "text": "Pensa alle sue risposte lunghe e alla paura del silenzio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pensare",
            "alle",
            "suo",
            "risposte",
            "lunghe",
            "e",
            "alla",
            "paura",
            "del",
            "silenzio"
          ]
        },
        {
          "id": "s27",
          "text": "Mamma, io non sono papà.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "mamma",
            "io",
            "non",
            "essere",
            "papa"
          ]
        },
        {
          "id": "s28",
          "text": "Lo so.",
          "speakerId": "mirella-marini",
          "kind": "dialogue",
          "lemmas": [
            "lo",
            "sapere"
          ]
        },
        {
          "id": "s29",
          "text": "Ma a volte ti assomigli.",
          "speakerId": "mirella-marini",
          "kind": "dialogue",
          "lemmas": [
            "ma",
            "a",
            "volta",
            "ti",
            "assomigli"
          ]
        },
        {
          "id": "s30",
          "text": "Dopo pranzo Elena dice che deve andare.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dopo",
            "pranzo",
            "elena",
            "dire",
            "che",
            "dovere",
            "andare"
          ]
        }
      ]
    },
    {
      "id": "p7",
      "order": 7,
      "sentences": [
        {
          "id": "s31",
          "text": "Dove?",
          "speakerId": "mirella-marini",
          "kind": "dialogue",
          "lemmas": [
            "dove"
          ]
        },
        {
          "id": "s32",
          "text": "Al caffè. Devo aiutare Bruna con il bancone.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "al",
            "caffe",
            "dovere",
            "aiutare",
            "bruna",
            "con",
            "il",
            "banco"
          ]
        },
        {
          "id": "s33",
          "text": "È domenica.",
          "speakerId": "mirella-marini",
          "kind": "dialogue",
          "lemmas": [
            "essere",
            "domenica"
          ]
        },
        {
          "id": "s34",
          "text": "Lo so. Solo un'ora.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "lo",
            "sapere",
            "solo",
            "ora"
          ]
        },
        {
          "id": "s35",
          "text": "Mirella non crede del tutto, ma non ferma la figlia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "mirella",
            "non",
            "crede",
            "del",
            "tutto",
            "ma",
            "non",
            "fermare",
            "la",
            "figlia"
          ]
        }
      ]
    },
    {
      "id": "p8",
      "order": 8,
      "sentences": [
        {
          "id": "s36",
          "text": "Elena pedala verso il Caffè Brenta con il vento in faccia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "pedala",
            "verso",
            "il",
            "caffe",
            "brenta",
            "con",
            "il",
            "vento",
            "in",
            "faccia"
          ]
        },
        {
          "id": "s37",
          "text": "Il caffè è chiuso. La porta è scura.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "caffe",
            "essere",
            "chiudere",
            "la",
            "porta",
            "essere",
            "scura"
          ]
        },
        {
          "id": "s38",
          "text": "Lei guarda la serratura e ride di se stessa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lei",
            "guardare",
            "la",
            "serratura",
            "e",
            "ride",
            "di",
            "se",
            "stesso"
          ]
        },
        {
          "id": "s39",
          "text": "Ha usato il caffè come scusa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "usato",
            "il",
            "caffe",
            "come",
            "scusa"
          ]
        },
        {
          "id": "s40",
          "text": "Ha paura di restare troppo nella cucina di Mirella.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "paura",
            "di",
