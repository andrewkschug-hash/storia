          "kind": "narration",
          "lemmas": [
            "pietro",
            "nel",
            "van",
            "guida",
            "verso",
            "altro",
            "bar"
          ]
        },
        {
          "id": "s65",
          "text": "Alla fine del giro ferma il motore.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "alla",
            "fine",
            "del",
            "giro",
            "fermare",
            "il",
            "motore"
          ]
        }
      ]
    },
    {
      "id": "p14",
      "order": 14,
      "sentences": [
        {
