  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Il giorno dopo Bruna arriva prima di tutti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "giorno",
            "dopo",
            "bruna",
            "arrivare",
            "prima",
            "di",
            "tutto"
          ]
        },
        {
          "id": "s02",
          "text": "Prende il libro dallo scaffale vicino allo zucchero.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "prendere",
            "il",
            "libro",
            "dal",
            "scaffale",
            "vicino",
            "al",
            "zucchero"
          ]
        },
        {
          "id": "s03",
          "text": "Lo mette sotto il bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lo",
            "mettere",
            "sotto",
            "il",
            "banco"
          ]
        },
        {
          "id": "s04",
          "text": "Dietro le scatole di tovaglioli.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dietro",
            "le",
            "scatole",
            "di",
            "tovaglioli"
          ]
        },
        {
          "id": "s05",
          "text": "Elena entra e guarda lo scaffale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "entrare",
            "e",
            "guardare",
            "lo",
            "scaffale"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s06",
          "text": "Lo scaffale è vuoto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lo",
            "scaffale",
            "essere",
            "vuoto"
          ]
        },
        {
          "id": "s07",
          "text": "C'è solo lo zucchero.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ce",
            "solo",
            "lo",
            "zucchero"
          ]
        },
        {
          "id": "s08",
          "text": "Dov'è il libro?",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "dove_e",
            "il",
            "libro"
          ]
        },
        {
          "id": "s09",
          "text": "Bruna asciuga una tazza lentamente.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "asciuga",
            "una",
            "tazza",
            "lentamente"
          ]
        },
        {
          "id": "s10",
          "text": "Chiuso.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "chiudere"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s11",
          "text": "Per qualche giorno.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "per",
            "qualche",
            "giorno"
          ]
        },
        {
          "id": "s12",
          "text": "Elena resta senza parole.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "restare",
            "senza",
            "parola"
          ]
        },
        {
          "id": "s13",
          "text": "Perché?",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "perche"
          ]
        },
        {
          "id": "s14",
          "text": "Perché ieri sera ti ho vista.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "perche",
            "ieri",
            "sera",
            "ti",
            "avere",
            "vista"
          ]
        },
        {
          "id": "s15",
          "text": "Sei tornata con gli occhi rossi.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "essere",
            "tornare",
            "con",
            "gli",
            "occhi",
            "rossi"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s16",
          "text": "E Pietro non è venuto a salutare.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "e",
            "pietro",
            "non",
            "essere",
            "venire",
            "a",
            "salutare"
          ]
        },
        {
          "id": "s17",
          "text": "Bruna posa la tazza.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "posa",
            "la",
            "tazza"
          ]
        },
        {
          "id": "s18",
          "text": "Il libro non è un nascondiglio per litigi.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "il",
            "libro",
            "non",
            "essere",
            "un",
            "nascondiglio",
            "per",
            "litigi"
          ]
        },
        {
          "id": "s19",
          "text": "Katia arriva e guarda lo scaffale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "arrivare",
            "e",
            "guardare",
            "lo",
            "scaffale"
          ]
        },
        {
          "id": "s20",
          "text": "Ah.",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "ah"
          ]
        }
      ]
    },
    {
      "id": "p5",
      "order": 5,
      "sentences": [
        {
          "id": "s21",
          "text": "Quindi è serio.",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "quindi",
            "essere",
            "serio"
          ]
        },
        {
          "id": "s22",
          "text": "Elena lavora male tutto il mattino.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "lavorare",
            "ma",
            "tutto",
            "il",
            "mattino"
          ]
        },
        {
          "id": "s23",
          "text": "Mette troppo zucchero in un cappuccino.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "mettere",
            "troppo",
            "zucchero",
            "in",
            "un",
            "cappuccino"
          ]
        },
        {
          "id": "s24",
          "text": "Dimentica un ordine.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dimenticare",
            "un",
            "ordine"
          ]
        },
        {
          "id": "s25",
          "text": "Guarda lo scaffale vuoto ogni dieci minuti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "guardare",
            "lo",
            "scaffale",
            "vuoto",
            "ogni",
            "dieci",
            "minuti"
          ]
        }
      ]
    },
    {
      "id": "p6",
      "order": 6,
      "sentences": [
        {
          "id": "s26",
          "text": "La mano cerca la penna per abitudine.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "mano",
            "cercare",
            "la",
            "penna",
            "per",
            "abitudine"
          ]
        },
        {
          "id": "s27",
          "text": "Poi si ferma.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "si",
            "fermare"
          ]
        },
        {
          "id": "s28",
          "text": "Non c'è pagina da aprire.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "ce",
            "pagina",
            "dare",
            "aprire"
          ]
        },
        {
          "id": "s29",
          "text": "Martedì Pietro porta il caffè.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "martedi",
            "pietro",
            "portare",
            "il",
            "caffe"
          ]
        },
        {
          "id": "s30",
          "text": "Entra con le casse.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "entrare",
            "con",
            "le",
            "casse"
          ]
        }
      ]
    },
    {
      "id": "p7",
      "order": 7,
      "sentences": [
        {
          "id": "s31",
          "text": "Guarda lo scaffale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "guardare",
            "lo",
            "scaffale"
          ]
        },
        {
          "id": "s32",
          "text": "Anche lui cerca il libro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "anche",
            "lui",
            "cercare",
            "il",
            "libro"
          ]
        },
        {
          "id": "s33",
          "text": "Bruna lo osserva senza parlare.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "lo",
            "osserva",
            "senza",
            "parlare"
          ]
        },
        {
          "id": "s34",
          "text": "Pietro firma il foglio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "firma",
            "il",
            "foglio"
          ]
        },
        {
          "id": "s35",
          "text": "Dice buongiorno con voce piatta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dire",
            "buongiorno",
            "con",
            "voce",
            "piatta"
          ]
        }
      ]
    },
    {
      "id": "p8",
      "order": 8,
      "sentences": [
        {
          "id": "s36",
          "text": "Elena dice buongiorno uguale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "dire",
            "buongiorno",
            "uguale"
          ]
        },
        {
          "id": "s37",
          "text": "Non parlano del litigio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "parlare",
            "del",
            "litigio"
          ]
        },
        {
          "id": "s38",
          "text": "Non parlano di Sergio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "parlare",
            "di",
            "sergio"
          ]
        },
        {
          "id": "s39",
          "text": "Non parlano del libro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "parlare",
            "del",
            "libro"
          ]
        },
        {
          "id": "s40",
          "text": "Il bancone resta pieno di lavoro e di silenzio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "banco",
            "restare",
            "pieno",
            "di",
            "lavorare",
            "e",
            "di",
            "silenzio"
          ]
        }
      ]
    },
    {
      "id": "p9",
      "order": 9,
      "sentences": [
        {
          "id": "s41",
          "text": "Quando Pietro esce, Katia sussurra.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "quando",
            "pietro",
            "uscire",
            "katia",
            "sussurra"
          ]
        },
        {
          "id": "s42",
          "text": "Soffrono entrambi.",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "soffrono",
            "entrambi"
          ]
        },
        {
          "id": "s43",
          "text": "Elena non nega.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "non",
            "nega"
          ]
        },
        {
          "id": "s44",
          "text": "Nel pomeriggio apre il cassetto sotto il bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "nel",
            "pomeriggio",
            "aprire",
            "il",
            "cassetto",
            "sotto",
            "il",
            "banco"
          ]
        },
        {
          "id": "s45",
          "text": "Vede l'angolo del libro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "vedere",
            "l'angolo",
            "del",
            "libro"
          ]
        }
      ]
    },
    {
      "id": "p10",
      "order": 10,
      "sentences": [
        {
          "id": "s46",
          "text": "Non lo tocca.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "lo",
            "tocca"
          ]
        },
        {
          "id": "s47",
          "text": "Bruna ha detto tre giorni.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "avere",
            "dire",
            "tre",
            "giorno"
          ]
        },
        {
          "id": "s48",
          "text": "Elena rispetta la regola, a fatica.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "rispetta",
            "la",
            "regola",
            "a",
            "fatica"
          ]
        },
        {
          "id": "s49",
          "text": "Alla sera, a casa di Mirella, mangia poco.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "alla",
            "sera",
            "a",
            "casa",
            "di",
            "mirella",
            "mangiare",
            "poco"
          ]
        },
        {
          "id": "s50",
          "text": "Hai litigato con qualcuno?",
          "speakerId": "mirella-marini",
          "kind": "dialogue",
          "lemmas": [
            "avere",
            "litigato",
            "con",
            "qualcuno"
          ]
        }
      ]
    },
    {
      "id": "p11",
      "order": 11,
      "sentences": [
        {
          "id": "s51",
          "text": "Elena guarda il piatto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "guardare",
            "il",
            "piatto"
          ]
        },
        {
          "id": "s52",
          "text": "Sì.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "si_yes"
          ]
        },
        {
          "id": "s53",
          "text": "Con una persona o con una carta?",
          "speakerId": "mirella-marini",
          "kind": "dialogue",
          "lemmas": [
            "con",
            "una",
            "persona",
            "o",
            "con",
            "una",
            "carta"
          ]
        },
        {
          "id": "s54",
          "text": "Mirella sorride senza allegria.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "mirella",
            "sorridere",
            "senza",
            "allegria"
          ]
        },
        {
          "id": "s55",
          "text": "Elena capisce il riferimento al padre.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "capire",
            "il",
            "riferimento",
            "al",
            "padre"
          ]
        }
      ]
    },
    {
      "id": "p12",
      "order": 12,
      "sentences": [
        {
          "id": "s56",
          "text": "Con tutte e due.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "con",
            "tutto",
            "e",
            "due"
          ]
        },
        {
          "id": "s57",
          "text": "La madre non insiste.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "madre",
            "non",
            "insiste"
          ]
        },
        {
          "id": "s58",
          "text": "Lava i piatti in silenzio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lavare",
            "i",
            "piatto",
            "in",
            "silenzio"
          ]
        },
        {
          "id": "s59",
          "text": "Il secondo giorno è peggio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "secondo",
            "giorno",
            "essere",
            "peggio"
          ]
        },
        {
          "id": "s60",
          "text": "Elena pensa frasi e non ha dove metterle.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "pensare",
            "frasi",
            "e",
            "non",
            "avere",
            "dove",
            "metterle"
          ]
        }
      ]
    },
    {
      "id": "p13",
      "order": 13,
      "sentences": [
        {
          "id": "s61",
          "text": "Vorrei dirti che ho torto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "volere",
            "dire",
            "che",
            "avere",
            "torto"
          ]
        },
        {
          "id": "s62",
          "text": "Vorrei dirti che hai torto tu.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "volere",
            "dire",
            "che",
            "avere",
            "torto",
            "tu"
          ]
        },
        {
          "id": "s63",
          "text": "Vorrei una pagina.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "volere",
            "una",
            "pagina"
          ]
        },
        {
          "id": "s64",
          "text": "Pietro, nel van, guida verso altri bar.",
