          "text": "Poi la cancella.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "la",
            "cancella"
          ]
        },
        {
          "id": "s69",
          "text": "Senza il libro la frase sembra falsa.",
