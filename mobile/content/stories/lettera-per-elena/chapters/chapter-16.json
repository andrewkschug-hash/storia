          "text": "Nel libro.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "nel",
            "libro"
          ]
        },
        {
          "id": "s27",
          "text": "Il silenzio diventa lungo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "silenzio",
            "diventa",
            "lungo"
          ]
        },
        {
          "id": "s28",
          "text": "Una macchina passa lenta sulla strada.",
