            "pietro",
            "avere",
            "le",
            "chiave",
            "del",
            "van",
            "in",
            "mano"
          ]
        },
        {
          "id": "s04",
          "text": "Non ha detto grazie.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "avere",
            "dire",
            "grazie"
          ]
        },
        {
          "id": "s05",
          "text": "Ha detto solo: non dovevi venire.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "dire",
            "solo",
            "non",
            "dove",
            "venire"
