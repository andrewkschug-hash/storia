          "kind": "narration",
          "lemmas": [
            "una",
            "macchina",
            "passare",
            "lenta",
            "sulla",
            "strada"
          ]
        },
        {
          "id": "s29",
          "text": "Un infermiere esce e rientra senza guardarli.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "un",
            "infermiere",
            "uscire",
            "e",
            "rientra",
            "senza",
            "guardarli"
          ]
        },
        {
          "id": "s30",
          "text": "Pietro stringe le chiavi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "stringe",
            "le",
            "chiave"
          ]
        }
      ]
    },
    {
      "id": "p7",
      "order": 7,
      "sentences": [
        {
