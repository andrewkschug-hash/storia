        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s06",
          "text": "Elena non se ne va.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "non",
            "se",
            "ne",
            "andare"
          ]
        },
        {
          "id": "s07",
          "text": "Dentro Sergio dorme, forse.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dentro",
            "sergio",
            "dormire",
            "forse"
          ]
        },
        {
          "id": "s08",
          "text": "Fuori restano loro due e la nebbia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "fuori",
            "restano",
            "loro",
            "due",
            "e",
            "la",
            "nebbia"
          ]
        },
        {
          "id": "s09",
          "text": "Perché sei arrabbiato?",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "perche",
            "essere",
            "arrabbiato"
          ]
        },
        {
          "id": "s10",
          "text": "Perché sei venuta.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "perche",
            "essere",
            "venire"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s11",
          "text": "Volevo solo sapere se stavi bene.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "volere",
            "solo",
            "sapere",
            "se",
            "stare",
            "bene"
          ]
        },
        {
          "id": "s12",
          "text": "Pietro scuote la testa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "scuote",
            "la",
            "testa"
          ]
        },
        {
          "id": "s13",
          "text": "Non è il tuo problema.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "essere",
            "il",
            "tuo",
            "problema"
          ]
        },
        {
          "id": "s14",
          "text": "Elena sente qualcosa di duro nella voce.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "sentire",
            "qualcosa",
            "di",
            "duro",
            "nella",
            "voce"
          ]
        },
        {
          "id": "s15",
          "text": "Ha aspettato fuori perché si preoccupava.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "aspettare",
            "fuori",
            "perche",
            "si",
            "preoccupava"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s16",
          "text": "Ha portato una bottiglia d'acqua e non sa perché.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "portare",
            "una",
            "bottiglia",
            "acqua",
            "e",
            "non",
            "sapere",
            "perche"
          ]
        },
        {
          "id": "s17",
          "text": "Ora l'acqua è ancora nella borsa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ora",
            "acqua",
            "essere",
            "ancora",
            "nella",
            "borsa"
          ]
        },
        {
          "id": "s18",
          "text": "Pietro guarda l'ingresso dell'ospedale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "guardare",
            "l'ingresso",
            "dell'ospedale"
          ]
        },
        {
          "id": "s19",
          "text": "Dentro c'è Sergio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dentro",
            "ce",
            "sergio"
          ]
        },
        {
          "id": "s20",
          "text": "Fuori c'è una donna che conosce le sue frasi segrete.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "fuori",
            "ce",
            "una",
            "donna",
            "che",
            "conoscere",
            "le",
            "suo",
            "frasi",
            "segrete"
          ]
        }
      ]
    },
    {
      "id": "p5",
      "order": 5,
      "sentences": [
        {
          "id": "s21",
          "text": "Questa mescolanza gli fa paura.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "questo",
            "mescolanza",
            "gli",
            "fare",
            "paura"
          ]
        },
        {
          "id": "s22",
          "text": "Non è vero.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "essere",
            "vero"
          ]
        },
        {
          "id": "s23",
          "text": "Tu mi hai già parlato di lui.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "tu",
            "mi",
            "avere",
            "gia",
            "parlare",
            "di",
            "lui"
          ]
        },
        {
          "id": "s24",
          "text": "Pietro alza lo sguardo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "alzare",
            "lo",
            "sguardo"
          ]
        },
        {
          "id": "s25",
          "text": "Quando?",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "quando"
          ]
        }
      ]
    },
    {
      "id": "p6",
      "order": 6,
      "sentences": [
        {
