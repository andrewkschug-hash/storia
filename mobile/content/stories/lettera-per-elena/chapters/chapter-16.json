          "lemmas": [
            "dopo",
            "l'incidente",
            "avere",
            "scrivere",
            "per",
            "non",
            "cadere"
          ]
        },
        {
          "id": "s57",
          "text": "Ma non posso vivere per sempre così.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "ma",
            "non",
            "potere",
            "vivere",
            "per",
            "sempre",
            "cosi"
          ]
        },
        {
          "id": "s58",
          "text": "Elena apre le braccia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "aprire",
            "le",
            "braccia"
          ]
        },
        {
          "id": "s59",
          "text": "E io non voglio mentire a Katia.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "e",
            "io",
            "non",
            "volere",
            "mentire",
            "a",
            "katia"
          ]
        },
        {
          "id": "s60",
          "text": "Non voglio fingere che sei solo il martedì.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "volere",
            "fingere",
            "che",
            "essere",
            "solo",
            "il",
            "martedi"
          ]
        }
      ]
    },
    {
      "id": "p13",
      "order": 13,
      "sentences": [
        {
          "id": "s61",
          "text": "Non voglio amare un'ombra nello zucchero.",
