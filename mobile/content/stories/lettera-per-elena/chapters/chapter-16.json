          "text": "Pietro chiude gli occhi un secondo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "chiudere",
            "gli",
            "occhi",
            "un",
            "secondo"
          ]
        },
