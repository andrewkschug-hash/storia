      "order": 14,
      "sentences": [
        {
          "id": "s66",
          "text": "Tu lo hai iniziato.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "tu",
            "lo",
            "avere",
            "iniziare"
          ]
        },
        {
