          "text": "Allora non leggere più.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "allora",
            "non",
            "leggere",
            "piu"
          ]
        },
        {
          "id": "s64",
          "text": "La frase fa male.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "frase",
            "fare",
            "ma"
          ]
        },
        {
          "id": "s65",
          "text": "Elena resta ferma.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "restare",
            "fermare"
          ]
        }
      ]
    },
    {
