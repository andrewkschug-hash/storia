    {
      "id": "p11",
      "order": 11,
      "sentences": [
        {
          "id": "s51",
          "text": "Perché Sergio…",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "perche",
            "sergio"
          ]
        },
        {
          "id": "s52",
          "text": "La frase non finisce.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "frase",
            "non",
            "finire"
          ]
        },
        {
          "id": "s53",
          "text": "Elena aspetta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "aspettare"
          ]
        },
        {
          "id": "s54",
          "text": "Lui non continua.",
          "speakerId": null,
