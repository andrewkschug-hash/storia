          "lemmas": [
            "fuori",
            "dall'ospedale",
            "il",
            "vento",
            "essere",
            "freddo"
          ]
        },
        {
          "id": "s02",
          "text": "Elena sta ancora vicino al muro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "stare",
            "ancora",
            "vicino",
            "al",
            "muro"
          ]
        },
        {
          "id": "s03",
          "text": "Pietro ha le chiavi del van in mano.",
