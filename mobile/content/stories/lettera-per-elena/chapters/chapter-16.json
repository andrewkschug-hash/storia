          "lemmas": [
            "lui",
            "non",
            "continuare"
          ]
        },
        {
          "id": "s55",
          "text": "Io non voglio una vita solo sulla carta.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "io",
            "non",
            "volere",
            "una",
            "vita",
            "solo",
            "sulla",
            "carta"
          ]
        }
      ]
    },
    {
      "id": "p12",
      "order": 12,
      "sentences": [
        {
          "id": "s56",
          "text": "Dopo l'incidente ho scritto per non cadere.",
