    {
      "id": "ev-lettera-per-elena-02",
      "summary": "Bruna explains the three rules of the book: do not sell it, do not take it home, do not ask who. She almost cries and does not explain why. Katia watches.",
      "characterIds": [
        "elena-marini",
        "bruna",
        "katia"
      ],
      "locationIds": [
        "marina-di-brenta",
        "caffe-brenta",
