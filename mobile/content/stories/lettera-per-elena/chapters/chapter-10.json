            "vivere",
            "nelle",
            "orecchie"
          ]
        },
        {
          "id": "s69",
          "text": "Cammina verso casa e pensa al martedì, al furgone, allo scaffale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
