            "le",
            "restare",
            "sotto",
            "la",
            "pelle"
          ]
        },
        {
          "id": "s64",
          "text": "Mentre chiudono, Elena porta le sedie dentro e conta le luci spente.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
