            "ride",
            "piano"
          ]
        },
        {
          "id": "s67",
          "text": "Domani lavori, oggi ascolti.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "domani",
            "lavorare",
            "oggi",
            "ascoltare"
          ]
        },
        {
          "id": "s68",
          "text": "Elena esce con la frase non è un gioco ancora viva nelle orecchie.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
