            "come",
            "un",
            "eccesso"
          ]
        },
        {
          "id": "s62",
          "text": "Ha usato il libro come un gioco, anche se diceva a se stessa di no.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
