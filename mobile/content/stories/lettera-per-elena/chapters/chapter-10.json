    },
    {
      "id": "p14",
      "order": 14,
      "sentences": [
        {
          "id": "s66",
          "text": "Bruna le dà le chiavi di riserva per sbaglio, poi le riprende e ride piano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
