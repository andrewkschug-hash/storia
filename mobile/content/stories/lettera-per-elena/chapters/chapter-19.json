  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Martedì arriva con nebbia bassa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "martedi",
            "arrivare",
            "con",
            "nebbia",
            "basso"
          ]
        },
        {
          "id": "s02",
          "text": "Il van di Pietro si ferma davanti al caffè.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "van",
            "di",
            "pietro",
            "si",
            "fermare",
            "davanti",
            "al",
            "caffe"
          ]
        },
        {
          "id": "s03",
          "text": "Lui entra con due casse.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lui",
            "entrare",
            "con",
            "due",
            "casse"
          ]
        },
        {
          "id": "s04",
          "text": "Saluta Bruna.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "saluta",
            "bruna"
          ]
        },
        {
          "id": "s05",
          "text": "Saluta Katia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "saluta",
            "katia"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s06",
          "text": "Guarda Elena e poi lo scaffale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "guardare",
            "elena",
            "e",
            "poi",
            "lo",
            "scaffale"
          ]
        },
        {
          "id": "s07",
          "text": "Elena sente lo stomaco stretto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "sentire",
            "lo",
            "stomaco",
            "stretto"
          ]
        },
        {
          "id": "s08",
          "text": "Pietro sistema le casse nel magazzino.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "sistema",
            "le",
            "casse",
            "nel",
            "magazzino"
          ]
        },
        {
          "id": "s09",
          "text": "Torna al bancone per firmare.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "tornare",
            "al",
            "banco",
            "per",
            "firmare"
          ]
        },
        {
          "id": "s10",
          "text": "Le mani tremolano un poco.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "le",
            "mani",
            "tremolano",
            "un",
            "poco"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s11",
          "text": "Bruna va in cucina.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "andare",
            "in",
            "cucina"
          ]
        },
        {
          "id": "s12",
          "text": "Katia lava i bicchieri e finge di non guardare.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "lavare",
            "i",
            "bicchieri",
            "e",
            "finge",
            "di",
            "non",
            "guardare"
          ]
        },
        {
          "id": "s13",
          "text": "Pietro apre il libro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "aprire",
            "il",
            "libro"
          ]
        },
        {
          "id": "s14",
          "text": "Trova il foglio piegato.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "trovare",
            "il",
            "foglio",
            "piegato"
          ]
        },
        {
          "id": "s15",
          "text": "Lo legge in piedi, vicino allo zucchero.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lo",
            "leggere",
            "in",
            "piedi",
            "vicino",
            "al",
            "zucchero"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s16",
          "text": "Il viso cambia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "viso",
            "cambiare"
          ]
        },
        {
          "id": "s17",
          "text": "Diventa rosso e serio insieme.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "diventa",
            "rosso",
            "e",
            "serio",
            "insieme"
          ]
        },
        {
          "id": "s18",
          "text": "Elena aspetta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "aspettare"
          ]
        },
        {
          "id": "s19",
          "text": "Non parla.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "parlare"
          ]
        },
        {
          "id": "s20",
          "text": "Ha già scritto tutto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "gia",
            "scrivere",
            "tutto"
          ]
        }
      ]
    },
    {
      "id": "p5",
      "order": 5,
      "sentences": [
        {
          "id": "s21",
          "text": "Ora tocca alla voce.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ora",
            "tocca",
            "alla",
            "voce"
          ]
        },
        {
          "id": "s22",
          "text": "Pietro ripiega la lettera.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "ripiega",
            "la",
            "lettera"
          ]
        },
        {
          "id": "s23",
          "text": "La mette in tasca.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "mettere",
            "in",
            "tasca"
          ]
        },
        {
          "id": "s24",
          "text": "Si avvicina al bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "si",
            "avvicina",
            "al",
            "banco"
          ]
        },
        {
          "id": "s25",
          "text": "Un cliente entra e chiede un caffè.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "un",
            "cliente",
            "entrare",
            "e",
            "chiedere",
            "un",
            "caffe"
          ]
        }
      ]
    },
    {
      "id": "p6",
      "order": 6,
      "sentences": [
        {
          "id": "s26",
          "text": "Elena lo prepara con mani precise.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "lo",
            "preparare",
            "con",
            "mani",
            "precise"
          ]
        },
        {
          "id": "s27",
          "text": "Il cliente paga e se ne va.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "cliente",
            "pagare",
            "e",
            "se",
            "ne",
            "andare"
          ]
        },
        {
          "id": "s28",
          "text": "Resta lo spazio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "restare",
            "lo",
            "spazio"
          ]
        },
        {
          "id": "s29",
          "text": "Pietro apre la bocca.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "aprire",
            "la",
            "bocca"
          ]
        },
        {
          "id": "s30",
          "text": "Chiude la bocca.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "chiudere",
            "la",
            "bocca"
          ]
        }
      ]
    },
    {
      "id": "p7",
      "order": 7,
      "sentences": [
        {
          "id": "s31",
          "text": "Poi parla come un idiota coraggioso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "parlare",
            "come",
            "un",
            "idiota",
            "coraggioso"
          ]
        },
        {
          "id": "s32",
          "text": "Io… io sono Pietro.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "io",
            "io",
            "essere",
            "pietro"
          ]
        },
        {
          "id": "s33",
          "text": "Elena lo guarda.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "lo",
            "guardare"
          ]
        },
        {
          "id": "s34",
          "text": "Lo sa già.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lo",
            "sapere",
            "gia"
          ]
        },
        {
          "id": "s35",
          "text": "Ma sentirlo è un'altra cosa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ma",
            "sentirlo",
            "essere",
            "altro",
            "cosa"
          ]
        }
      ]
    },
    {
      "id": "p8",
      "order": 8,
      "sentences": [
        {
          "id": "s36",
          "text": "Pietro Baldo.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "pietro",
            "baldo"
          ]
        },
        {
          "id": "s37",
          "text": "Sono io.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "essere",
            "io"
          ]
        },
        {
          "id": "s38",
          "text": "Quello del libro.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "quello",
            "del",
            "libro"
          ]
        },
        {
          "id": "s39",
          "text": "Elena ride.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "ride"
          ]
        },
        {
          "id": "s40",
          "text": "Non è una risata cattiva.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "essere",
            "una",
            "risata",
            "cattiva"
          ]
        }
      ]
    },
    {
      "id": "p9",
      "order": 9,
      "sentences": [
        {
          "id": "s41",
          "text": "È sollievo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "sollievo"
          ]
        },
        {
          "id": "s42",
          "text": "È tenerezza.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "tenerezza"
          ]
        },
        {
          "id": "s43",
          "text": "È la comicità di una verità detta male.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "la",
            "comicita",
            "di",
            "una",
            "verita",
            "detta",
            "ma"
          ]
        },
        {
          "id": "s44",
          "text": "Lo so.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "lo",
            "sapere"
          ]
        },
        {
          "id": "s45",
          "text": "Pietro sbianca.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "sbianca"
          ]
        }
      ]
    },
    {
      "id": "p10",
      "order": 10,
      "sentences": [
        {
          "id": "s46",
          "text": "Lo sapevi?",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "lo",
            "sapevi"
          ]
        },
        {
          "id": "s47",
          "text": "Da un po'.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "dare",
            "un",
            "poco"
          ]
        },
        {
          "id": "s48",
          "text": "Dal frigo.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "dal",
            "frigo"
          ]
        },
        {
          "id": "s49",
          "text": "Pietro porta una mano alla fronte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "porta",
            "una",
            "mano",
            "alla",
            "fronte"
          ]
        },
        {
          "id": "s50",
          "text": "Sono un idiota.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "essere",
            "un",
            "idiota"
          ]
        }
      ]
    },
    {
      "id": "p11",
      "order": 11,
      "sentences": [
        {
          "id": "s51",
          "text": "Elena annuisce, ancora sorridendo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "annuisce",
            "ancora",
            "sorridendo"
          ]
        },
        {
          "id": "s52",
          "text": "Un po'.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "un",
            "poco"
          ]
        },
        {
          "id": "s53",
          "text": "Katia dal lavello dice piano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "dal",
            "lavello",
            "dire",
            "piano"
          ]
        },
        {
          "id": "s54",
          "text": "Finalmente.",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "finalmente"
          ]
        },
        {
          "id": "s55",
          "text": "Bruna torna e capisce subito.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "tornare",
            "e",
            "capire",
            "subito"
          ]
        }
      ]
    },
    {
      "id": "p12",
      "order": 12,
      "sentences": [
        {
          "id": "s56",
          "text": "Non chiede dettagli.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "chiedere",
            "dettagli"
          ]
        },
        {
          "id": "s57",
          "text": "Serve un caffè a Pietro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "servire",
            "un",
            "caffe",
            "a",
            "pietro"
          ]
        },
        {
          "id": "s58",
          "text": "Bevi.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "bere"
          ]
        },
        {
          "id": "s59",
          "text": "Poi parla meglio.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "poi",
            "parlare",
            "meglio"
          ]
        },
        {
          "id": "s60",
          "text": "Pietro beve.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "bere"
          ]
        }
      ]
    },
    {
      "id": "p13",
      "order": 13,
      "sentences": [
        {
          "id": "s61",
          "text": "Guarda Elena sopra la tazza.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "guardare",
            "elena",
            "sopra",
            "la",
            "tazza"
          ]
        },
        {
          "id": "s62",
          "text": "Fuori dal libro è più difficile.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "fuori",
            "dal",
            "libro",
            "essere",
            "piu",
            "difficile"
          ]
        },
        {
          "id": "s63",
          "text": "Lo so.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "lo",
            "sapere"
          ]
        },
        {
          "id": "s64",
          "text": "Ma hai detto il nome.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "ma",
            "avere",
            "dire",
            "il",
            "nome"
          ]
        },
        {
          "id": "s65",
          "text": "Al bancone.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "al",
            "banco"
          ]
        }
      ]
    },
    {
      "id": "p14",
      "order": 14,
      "sentences": [
        {
          "id": "s66",
          "text": "Come ti ho chiesto.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "come",
            "ti",
            "avere",
            "chiedere"
          ]
        },
        {
          "id": "s67",
          "text": "Pietro mette giù la tazza.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "mettere",
            "giu",
            "la",
            "tazza"
          ]
        },
        {
          "id": "s68",
          "text": "Non so cosa fare adesso.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "sapere",
            "cosa",
            "fare",
            "adesso"
          ]
        },
        {
          "id": "s69",
          "text": "Elena asciuga il bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "asciuga",
            "il",
            "banco"
          ]
        },
        {
          "id": "s70",
          "text": "Lavoriamo.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "lavorare"
          ]
        }
      ]
    },
    {
      "id": "p15",
      "order": 15,
      "sentences": [
        {
          "id": "s71",
          "text": "Poi, se vuoi, parliamo dietro.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "poi",
            "se",
            "volere",
            "parlare",
            "dietro"
          ]
        },
        {
          "id": "s72",
          "text": "Non è un film.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "essere",
            "un",
            "film"
          ]
        },
        {
          "id": "s73",
          "text": "È un martedì con nebbia e casse di caffè.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "un",
            "martedi",
            "con",
            "nebbia",
            "e",
            "casse",
            "di",
            "caffe"
          ]
        },
        {
          "id": "s74",
          "text": "Pietro annuisce.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "annuisce"
          ]
        },
        {
          "id": "s75",
          "text": "Va bene.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "andare",
            "bene"
          ]
        }
      ]
    },
    {
      "id": "p16",
      "order": 16,
      "sentences": [
        {
          "id": "s76",
          "text": "Dietro, dopo.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "dietro",
            "dopo"
          ]
        },
        {
          "id": "s77",
          "text": "Katia alza gli occhi al cielo, ma è contenta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "alzare",
            "gli",
            "occhi",
            "al",
            "cielo",
            "ma",
            "essere",
            "contento"
          ]
        },
        {
          "id": "s78",
          "text": "Bruna nasconde un sorriso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "nasconde",
            "un",
            "sorridere"
          ]
        },
        {
          "id": "s79",
          "text": "Elena sente le gambe leggere.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "sentire",
            "le",
            "gambe",
            "leggere"
          ]
        },
        {
          "id": "s80",
          "text": "Ha riso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "riso"
          ]
        }
      ]
    },
    {
      "id": "p17",
      "order": 17,
      "sentences": [
        {
          "id": "s81",
          "text": "Lui ha detto il nome.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lui",
            "avere",
            "dire",
            "il",
            "nome"
          ]
        },
        {
          "id": "s82",
          "text": "Il libro ha fatto il suo lavoro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "libro",
            "avere",
            "fare",
            "il",
            "suo",
            "lavorare"
          ]
        },
        {
          "id": "s83",
          "text": "Adesso tocca alle persone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "adesso",
            "tocca",
            "alle",
            "persona"
          ]
        },
        {
          "id": "s84",
          "text": "Pietro firma il foglio delle consegne.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "firma",
            "il",
            "foglio",
            "delle",
            "consegne"
          ]
        },
        {
          "id": "s85",
          "text": "La firma è storta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "firma",
            "essere",
            "storta"
          ]
        }
      ]
    },
    {
      "id": "p18",
      "order": 18,
      "sentences": [
        {
          "id": "s86",
          "text": "Elena guarda la firma e pensa: anche questa è vera.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "guardare",
            "la",
            "firma",
            "e",
            "pensare",
            "anche",
            "questo",
            "essere",
            "vero"
          ]
        },
        {
          "id": "s87",
          "text": "Solo un nome detto ad alta voce.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "solo",
            "un",
            "nome",
            "dire",
            "a",
            "alto",
            "voce"
          ]
        },
        {
          "id": "s88",
          "text": "Prima di parlare, Pietro sistema una cassa due volte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "prima",
            "di",
            "parlare",
            "pietro",
            "sistema",
            "una",
            "cassa",
            "due",
            "volta"
          ]
        },
        {
          "id": "s89",
          "text": "La mette dritta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "mettere",
            "dritta"
          ]
        },
        {
          "id": "s90",
          "text": "Poi la sposta di un centimetro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "la",
            "sposta",
            "di",
            "un",
            "centimetro"
          ]
        }
      ]
    },
    {
      "id": "p19",
      "order": 19,
      "sentences": [
        {
          "id": "s91",
          "text": "Elena capisce che sta comprando tempo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "capire",
            "che",
            "stare",
            "comprando",
            "tempo"
          ]
        },
        {
          "id": "s92",
          "text": "Anche lei compra tempo con le tazze.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "anche",
            "lei",
            "compra",
            "tempo",
            "con",
            "le",
            "tazze"
          ]
        },
        {
          "id": "s93",
          "text": "Quando finalmente dice il nome, la stanza sembra più piccola.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "quando",
            "finalmente",
            "dire",
            "il",
            "nome",
            "la",
            "stanza",
            "sembrare",
            "piu",
            "piccolo"
          ]
        },
        {
          "id": "s94",
          "text": "Più vera.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "piu",
            "vero"
          ]
        },
        {
          "id": "s95",
          "text": "Elena vorrebbe abbracciarlo e anche no.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "volere",
            "abbracciarlo",
            "e",
            "anche",
            "no"
          ]
        }
      ]
    },
    {
      "id": "p20",
      "order": 20,
      "sentences": [
        {
          "id": "s96",
          "text": "Ride perché il corpo ha bisogno di uscita.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ride",
            "perche",
            "il",
            "corpo",
            "avere",
            "bisogno",
            "di",
            "uscire"
          ]
        },
        {
          "id": "s97",
          "text": "Pietro, dopo la risata, sembra meno di pietra.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "dopo",
            "la",
            "risata",
            "sembrare",
            "meno",
            "di",
            "pietra"
          ]
        },
        {
          "id": "s98",
          "text": "Beve il caffè di Bruna troppo caldo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bere",
            "il",
            "caffe",
            "di",
            "bruna",
            "troppo",
            "caldo"
          ]
        },
        {
          "id": "s99",
          "text": "Soffia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "soffia"
          ]
        },
        {
          "id": "s100",
          "text": "Fa una smorfia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "fare",
            "una",
            "smorfia"
          ]
        }
      ]
    },
    {
      "id": "p21",
      "order": 21,
      "sentences": [
        {
          "id": "s101",
          "text": "Anche questo è umano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "anche",
            "questo",
            "essere",
            "umano"
          ]
        },
        {
          "id": "s102",
          "text": "Katia fischia una melodia corta e poi smette.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "fischia",
            "una",
            "melodia",
            "corta",
            "e",
            "poi",
            "smette"
          ]
        },
        {
          "id": "s103",
          "text": "Non vuole rovinare il momento.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "volere",
            "rovinare",
            "il",
            "momento"
          ]
        },
        {
          "id": "s104",
          "text": "Bruna controlla la vetrina e lascia spazio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "controlla",
            "la",
            "vetrina",
            "e",
            "lasciare",
            "spazio"
          ]
        },
        {
          "id": "s105",
          "text": "Elena spiega in poche parole il frigo e la frase.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "spiegare",
            "in",
            "poco",
            "parola",
            "il",
            "frigo",
            "e",
            "la",
            "frase"
          ]
        }
      ]
    },
    {
      "id": "p22",
      "order": 22,
      "sentences": [
        {
          "id": "s106",
          "text": "Pietro porta le mani sui fianchi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "porta",
            "le",
            "mani",
            "sui",
            "fianchi"
          ]
        },
        {
          "id": "s107",
          "text": "Quindi da allora…",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "quindi",
            "dare",
            "allora"
          ]
        },
        {
          "id": "s108",
          "text": "Da allora ho saputo e non ho detto.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "dare",
            "allora",
            "avere",
            "sapere",
            "e",
            "non",
            "avere",
            "dire"
          ]
        },
        {
          "id": "s109",
          "text": "Scusa.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "scusa"
          ]
        },
        {
          "id": "s110",
          "text": "Anche io.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "anche",
            "io"
          ]
        }
      ]
    },
    {
      "id": "p23",
      "order": 23,
      "sentences": [
        {
          "id": "s111",
          "text": "Per il litigio.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "per",
            "il",
            "litigio"
          ]
        },
        {
          "id": "s112",
          "text": "Per le parole dure fuori dall'ospedale.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "per",
            "le",
            "parola",
            "dure",
            "fuori",
            "dall'ospedale"
          ]
        },
        {
          "id": "s113",
          "text": "Elena accetta la scusa con un cenno.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "accettare",
            "la",
            "scusa",
            "con",
            "un",
            "cenno"
          ]
        },
        {
          "id": "s114",
          "text": "Per ora serve il nome.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "per",
            "ora",
            "servire",
            "il",
            "nome"
          ]
        },
        {
          "id": "s115",
          "text": "Serve il bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "servire",
            "il",
            "banco"
          ]
        }
      ]
    },
    {
      "id": "p24",
      "order": 24,
      "sentences": [
        {
          "id": "s116",
          "text": "Serve il fatto che altri possono sentire.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "servire",
            "il",
            "fare",
            "che",
            "altro",
            "potere",
            "sentire"
          ]
        },
        {
          "id": "s117",
          "text": "Quando Pietro esce con il foglietto firmato, Elena resta un secondo ferma.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "quando",
            "pietro",
            "uscire",
            "con",
            "il",
            "foglietto",
            "firmato",
            "elena",
            "restare",
            "un",
            "secondo",
            "fermare"
          ]
        },
        {
          "id": "s118",
          "text": "Poi lava una tazza e pensa: abbiamo iniziato.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "lavare",
            "una",
            "tazza",
            "e",
            "pensare",
            "avere",
            "iniziare"
          ]
        },
        {
          "id": "s119",
          "text": "Non abbiamo finito.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "avere",
            "finire"
          ]
        },
        {
          "id": "s120",
          "text": "Ma abbiamo iniziato in voce.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ma",
            "avere",
            "iniziare",
            "in",
            "voce"
          ]
        }
      ]
    },
    {
      "id": "p25",
      "order": 25,
      "sentences": [
        {
          "id": "s121",
          "text": "Dopo che Pietro va via, Elena lava lo stesso posto del bancone due volte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dopo",
            "che",
            "pietro",
            "andare",
            "via",
            "elena",
            "lavare",
            "lo",
            "stesso",
            "posto",
            "del",
            "banco",
            "due",
            "volta"
          ]
        },
        {
          "id": "s122",
          "text": "Katia lo nota e non dice niente di cattivo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "lo",
            "nota",
            "e",
            "non",
            "dire",
            "niente",
            "di",
            "cattivo"
          ]
        },
        {
          "id": "s123",
          "text": "Dice solo: oggi hai riso bene.",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "dire",
            "solo",
            "oggi",
            "avere",
            "riso",
            "bene"
          ]
        },
        {
          "id": "s124",
          "text": "Elena annuisce.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "annuisce"
          ]
        },
        {
          "id": "s125",
          "text": "Nel pomeriggio apre il libro e non trova la lettera.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "nel",
            "pomeriggio",
            "aprire",
            "il",
            "libro",
            "e",
            "non",
            "trovare",
            "la",
            "lettera"
          ]
        }
      ]
    },
    {
      "id": "p26",
      "order": 26,
      "sentences": [
        {
          "id": "s126",
          "text": "È in tasca a Pietro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "in",
            "tasca",
            "a",
            "pietro"
          ]
        },
        {
          "id": "s127",
          "text": "Va bene così.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "andare",
            "bene",
            "cosi"
          ]
        },
        {
          "id": "s128",
          "text": "La lettera ha fatto il salto dal libro alla vita.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "lettera",
            "avere",
            "fare",
            "il",
            "salto",
            "dal",
            "libro",
            "alla",
            "vita"
          ]
        },
        {
          "id": "s129",
          "text": "Elena prepara ancora caffè.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "preparare",
            "ancora",
            "caffe"
          ]
        },
        {
          "id": "s130",
          "text": "Il bancone torna normale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "banco",
            "tornare",
            "normale"
          ]
        }
      ]
    },
    {
      "id": "p27",
      "order": 27,
      "sentences": [
        {
          "id": "s131",
          "text": "Però dentro di lei qualcosa è cambiato per sempre.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pero",
            "dentro",
            "di",
            "lei",
            "qualcosa",
            "essere",
            "cambiare",
            "per",
            "sempre"
          ]
        },
        {
          "id": "s132",
          "text": "Un nome detto male e detto vero.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "un",
            "nome",
            "dire",
            "ma",
            "e",
            "dire",
            "vero"
          ]
        },
        {
          "id": "s133",
          "text": "Per oggi basta, ed è tantissimo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "per",
            "oggi",
            "basta",
            "ed",
            "essere",
            "tantissimo"
          ]
        }
      ]
    }
