          "lemmas": [
            "sorridere",
            "solo",
            "un",
            "poco"
          ]
        },
        {
          "id": "s13",
          "text": "Verso le undici il caffè è quieto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "verso",
            "le",
            "undici",
            "il",
            "caffe",
            "essere",
            "quieto"
          ]
        },
        {
          "id": "s14",
          "text": "Bruna è nel magazzino.",
          "speakerId": null,
