    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s06",
          "text": "Una lettera.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "una",
            "lettera"
          ]
        },
        {
          "id": "s07",
          "text": "Katia alza un sopracciglio.",
