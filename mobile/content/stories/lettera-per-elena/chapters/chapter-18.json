          "text": "E anche per lui.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "e",
            "anche",
            "per",
            "lui"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s11",
          "text": "Katia non chiede il nome.",
