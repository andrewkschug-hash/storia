          "kind": "narration",
          "lemmas": [
            "katia",
            "non",
            "chiedere",
            "il",
            "nome"
          ]
        },
        {
          "id": "s12",
          "text": "Sorride solo un poco.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sorridere",
            "solo",
            "un",
            "poco"
          ]
        },
        {
          "id": "s13",
          "text": "Verso le undici il caffè è quieto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "verso",
            "le",
            "undici",
            "il",
            "caffe",
            "essere",
            "quieto"
          ]
        },
        {
          "id": "s14",
          "text": "Bruna è nel magazzino.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "essere",
            "nel",
            "magazzino"
          ]
        },
        {
          "id": "s15",
          "text": "Elena apre il foglio sul bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "aprire",
            "il",
            "foglio",
            "sul",
            "banco"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s16",
          "text": "Scrive in alto un titolo strano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "scrivere",
            "in",
            "alto",
            "un",
            "titolo",
            "strano"
          ]
        },
        {
          "id": "s17",
          "text": "Una lettera per Elena.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "una",
            "lettera",
            "per",
            "elena"
          ]
        },
        {
          "id": "s18",
          "text": "È una battuta e anche una verità.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "una",
            "battuta",
            "e",
            "anche",
            "una",
            "verita"
          ]
        },
        {
          "id": "s19",
          "text": "Perché la lettera è per lei, se lui risponde.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "perche",
            "la",
            "lettera",
            "essere",
            "per",
            "lei",
            "se",
            "lui",
            "rispondere"
          ]
        },
        {
          "id": "s20",
          "text": "E perché lei deve smettere di nascondersi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "e",
            "perche",
            "lei",
            "dovere",
            "smettere",
            "di",
            "nascondersi"
          ]
        }
      ]
    },
    {
      "id": "p5",
      "order": 5,
      "sentences": [
        {
          "id": "s21",
          "text": "Sotto il titolo scrive più piano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sotto",
            "il",
            "titolo",
            "scrivere",
            "piu",
            "piano"
          ]
        },
        {
          "id": "s22",
          "text": "Io sono Elena Marini.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "io",
            "essere",
            "elena",
            "marini"
          ]
        },
        {
          "id": "s23",
          "text": "Lavoro al bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lavorare",
            "al",
            "banco"
          ]
        },
        {
          "id": "s24",
          "text": "Ho letto le tue frasi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "leggere",
            "le",
            "tuo",
            "frasi"
          ]
        },
        {
          "id": "s25",
          "text": "Ho risposto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "rispondere"
          ]
        }
      ]
    },
    {
      "id": "p6",
      "order": 6,
      "sentences": [
        {
          "id": "s26",
          "text": "Ho litigato con te fuori dall'ospedale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "litigato",
            "con",
            "tu",
            "fuori",
            "dall'ospedale"
          ]
        },
        {
          "id": "s27",
          "text": "Hai detto che scrivere non è parlare.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "dire",
            "che",
            "scrivere",
            "non",
            "essere",
            "parlare"
          ]
        },
        {
          "id": "s28",
          "text": "Forse hai ragione.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "forse",
            "avere",
            "ragione"
          ]
        },
        {
          "id": "s29",
          "text": "Allora ti chiedo una cosa semplice.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "allora",
            "ti",
            "chiedere",
            "una",
            "cosa",
            "semplice"
          ]
        },
        {
          "id": "s30",
          "text": "Elena ferma la penna.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "fermare",
            "la",
            "penna"
          ]
        }
      ]
    },
    {
      "id": "p7",
      "order": 7,
      "sentences": [
        {
          "id": "s31",
          "text": "Il cuore le batte forte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "cuore",
            "le",
            "batte",
            "forte"
          ]
        },
        {
          "id": "s32",
          "text": "Scrive la riga più importante.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "scrivere",
            "la",
            "riga",
            "piu",
            "importante"
          ]
        },
        {
          "id": "s33",
          "text": "Se sei Pietro, dimmelo al bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "se",
            "essere",
            "pietro",
            "dimmelo",
            "al",
            "banco"
          ]
        },
        {
          "id": "s34",
          "text": "Rilegge tutto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "rilegge",
            "tutto"
          ]
        },
        {
          "id": "s35",
          "text": "Non c'è poesia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "ce",
            "poesia"
          ]
        }
