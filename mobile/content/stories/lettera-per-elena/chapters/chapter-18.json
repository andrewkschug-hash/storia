          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "rilegge",
            "tutto"
          ]
        },
        {
          "id": "s35",
          "text": "Non c'è poesia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
