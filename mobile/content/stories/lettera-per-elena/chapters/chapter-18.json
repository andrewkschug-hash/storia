          "lemmas": [
            "chiudere",
            "il",
            "libro"
          ]
        },
        {
          "id": "s43",
          "text": "Lo rimette vicino allo zucchero.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lo",
            "rimette",
            "vicino",
            "al",
            "zucchero"
          ]
