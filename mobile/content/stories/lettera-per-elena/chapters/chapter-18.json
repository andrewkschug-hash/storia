        {
          "id": "s73",
          "text": "Domani la lettera può diventare una frase detta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "domani",
            "la",
            "lettera",
            "potere",
            "diventare",
            "una",
            "frase",
            "detta"
          ]
        },
        {
          "id": "s74",
          "text": "O può restare carta morta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "o",
            "potere",
            "restare",
            "carta",
            "morta"
          ]
        },
        {
          "id": "s75",
          "text": "Elena spegne la luce.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "spegne",
            "la",
            "luce"
          ]
        }
      ]
    },
    {
      "id": "p16",
      "order": 16,
      "sentences": [
        {
          "id": "s76",
          "text": "Ha paura.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "paura"
          ]
        },
        {
          "id": "s77",
          "text": "Ha anche fatto la cosa più onesta della settimana.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "anche",
            "fare",
            "la",
            "cosa",
            "piu",
            "onesta",
            "della",
            "settimana"
          ]
        },
        {
          "id": "s78",
          "text": "Ha messo il suo nome dove lui può trovarlo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "mettere",
            "il",
            "suo",
            "nome",
            "dove",
            "lui",
            "potere",
            "trovarlo"
          ]
        },
        {
          "id": "s79",
          "text": "Prima di scrivere, Elena cammina un minuto nel caffè vuoto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "prima",
            "di",
            "scrivere",
            "elena",
            "camminare",
            "un",
            "minuto",
            "nel",
            "caffe",
            "vuoto"
          ]
        },
        {
          "id": "s80",
          "text": "Tocca il tavolo che balla.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "tocca",
            "il",
            "tavolo",
            "che",
            "balla"
          ]
        }
      ]
    },
    {
      "id": "p17",
      "order": 17,
      "sentences": [
        {
          "id": "s81",
          "text": "Sorride senza gioia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sorridere",
            "senza",
            "gioia"
          ]
        },
        {
          "id": "s82",
          "text": "Poi torna al foglio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "tornare",
            "al",
            "foglio"
          ]
        },
        {
          "id": "s83",
          "text": "Scrive anche: non voglio più solo inchiostro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "scrivere",
            "anche",
            "non",
            "volere",
            "piu",
            "solo",
            "inchiostro"
          ]
        },
        {
          "id": "s84",
          "text": "Voglio il tuo nome in aria.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "volere",
            "il",
            "tuo",
            "nome",
            "in",
            "aria"
          ]
        },
        {
          "id": "s85",
          "text": "Se non sei Pietro, lascia la lettera dove l'hai trovata.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "se",
            "non",
            "essere",
            "pietro",
            "lasciare",
            "la",
            "lettera",
            "dove",
            "avere",
            "trovata"
          ]
        }
      ]
    },
    {
      "id": "p18",
      "order": 18,
      "sentences": [
        {
          "id": "s86",
          "text": "Se sei tu, vieni al bancone come una persona.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "se",
            "essere",
            "tu",
            "venire",
            "al",
            "banco",
            "come",
            "una",
            "persona"
          ]
        },
        {
          "id": "s87",
          "text": "Non come un segreto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "come",
            "un",
            "segreto"
          ]
        },
        {
          "id": "s88",
          "text": "Elena piega il foglio con cura.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "piega",
            "il",
            "foglio",
            "con",
            "cura"
          ]
        },
        {
          "id": "s89",
          "text": "Le mani le tremano solo un poco.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "le",
            "mani",
            "le",
            "tremano",
            "solo",
            "un",
            "poco"
          ]
        },
        {
          "id": "s90",
          "text": "Quando mette la lettera nel libro, sente di chiudere una porta e aprirne un'altra.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "quando",
            "mettere",
            "la",
            "lettera",
            "nel",
            "libro",
            "sentire",
            "di",
            "chiudere",
            "una",
            "porta",
            "e",
            "aprirne",
            "altro"
          ]
        }
      ]
    },
    {
      "id": "p19",
      "order": 19,
      "sentences": [
        {
          "id": "s91",
          "text": "Katia, più tardi, le porta un bicchiere d'acqua.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "piu",
            "tardi",
            "le",
            "porta",
            "un",
            "bicchiere",
            "acqua"
          ]
        },
        {
          "id": "s92",
          "text": "Hai fatto la cosa difficile.",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "avere",
            "fare",
            "la",
            "cosa",
            "difficile"
          ]
        },
        {
          "id": "s93",
          "text": "Elena beve.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "bere"
          ]
        },
        {
          "id": "s94",
          "text": "Non ancora.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "non",
            "ancora"
          ]
        },
        {
          "id": "s95",
          "text": "L'ho solo scritta.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "avere",
            "solo",
            "scritta"
          ]
        }
      ]
    },
    {
      "id": "p20",
      "order": 20,
      "sentences": [
        {
          "id": "s96",
          "text": "Katia alza le spalle.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "alzare",
            "le",
            "spalle"
          ]
        },
        {
          "id": "s97",
          "text": "A volte scrivere il nome è già uscire.",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "a",
            "volta",
            "scrivere",
            "il",
            "nome",
            "essere",
            "gia",
            "uscire"
          ]
        },
        {
          "id": "s98",
          "text": "Nel pomeriggio un cliente chiede se il libro si vende.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "nel",
            "pomeriggio",
            "un",
            "cliente",
            "chiedere",
            "se",
            "il",
            "libro",
            "si",
            "vendere"
          ]
        },
        {
          "id": "s99",
          "text": "Bruna dice di no, come sempre.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "dire",
            "di",
            "no",
            "come",
            "sempre"
          ]
        },
        {
          "id": "s100",
          "text": "Elena tocca il bordo della copertina e pensa alla lettera nascosta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "tocca",
            "il",
            "bordo",
            "della",
            "copertina",
            "e",
            "pensare",
            "alla",
            "lettera",
            "nascosta"
          ]
        }
      ]
    },
    {
      "id": "p21",
      "order": 21,
      "sentences": [
        {
          "id": "s101",
          "text": "Dorme male.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dormire",
            "ma"
          ]
        },
        {
          "id": "s102",
          "text": "Si sveglia due volte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "si",
            "svegliare",
            "due",
            "volta"
          ]
        },
        {
          "id": "s103",
          "text": "Controlla il telefono anche se Pietro non le scrive mai di notte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "controlla",
            "il",
            "telefono",
            "anche",
            "se",
            "pietro",
            "non",
            "le",
            "scrivere",
            "mai",
            "di",
            "notte"
          ]
        },
        {
          "id": "s104",
          "text": "Aspetta il martedì come un esame.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "aspettare",
            "il",
            "martedi",
            "come",
            "un",
            "esame"
          ]
        },
        {
          "id": "s105",
          "text": "Ha messo il suo nome in mezzo alle pagine.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "mettere",
            "il",
            "suo",
            "nome",
            "in",
            "mezzo",
            "alle",
            "pagine"
          ]
        }
      ]
    },
    {
      "id": "p22",
      "order": 22,
      "sentences": [
        {
          "id": "s106",
          "text": "Adesso non può ritirarlo senza viverlo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "adesso",
            "non",
            "potere",
            "ritirarlo",
            "senza",
            "viverlo"
          ]
        },
        {
          "id": "s107",
          "text": "Alla fine del turno Elena ripassa la frase a mente.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "alla",
            "fine",
            "del",
            "turno",
            "elena",
            "ripassa",
            "la",
            "frase",
            "a",
            "mente"
          ]
        },
        {
          "id": "s108",
          "text": "Se sei Pietro, dimmelo al bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "se",
            "essere",
            "pietro",
            "dimmelo",
            "al",
            "banco"
          ]
        },
        {
          "id": "s109",
          "text": "Sembra semplice.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "sembrare",
            "semplice"
          ]
        },
        {
          "id": "s110",
          "text": "Non lo è.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "lo",
            "essere"
          ]
        }
      ]
    },
    {
      "id": "p23",
      "order": 23,
      "sentences": [
        {
          "id": "s111",
          "text": "È la cosa più diretta che ha mai chiesto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "la",
            "cosa",
            "piu",
            "diretta",
            "che",
            "avere",
            "mai",
            "chiedere"
          ]
        },
        {
          "id": "s112",
          "text": "Bruna spegne una luce e dice buonanotte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "spegne",
            "una",
            "luce",
            "e",
            "dire",
            "buonanotte"
          ]
        },
        {
          "id": "s113",
          "text": "Elena esce nella nebbia bassa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "uscire",
            "nella",
            "nebbia",
            "basso"
          ]
        },
        {
          "id": "s114",
          "text": "Porta a casa le mani macchiate di inchiostro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "porta",
            "a",
            "casa",
            "le",
            "mani",
            "macchiate",
            "di",
            "inchiostro"
          ]
        },
        {
          "id": "s115",
          "text": "Questa volta l'inchiostro non è un nascondiglio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "questo",
            "volta",
            "l'inchiostro",
            "non",
            "essere",
            "un",
            "nascondiglio"
          ]
        }
      ]
    },
    {
      "id": "p24",
      "order": 24,
      "sentences": [
        {
          "id": "s116",
          "text": "È un invito.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "un",
            "invito"
          ]
        },
        {
          "id": "s117",
          "text": "Dentro il libro, non dietro una bugia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "dentro",
            "il",
            "libro",
            "non",
            "dietro",
            "una",
            "bugia"
          ]
        }
      ]
    }
