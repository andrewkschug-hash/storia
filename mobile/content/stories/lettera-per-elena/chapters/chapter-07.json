          ]
        }
      ]
    },
    {
      "id": "p9",
      "order": 9,
      "sentences": [
        {
          "id": "s41",
          "text": "Pietro guarda lo scaffale del libro un secondo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "guardare",
            "lo",
            "scaffale",
            "del",
            "libro",
            "un",
            "secondo"
          ]
        },
        {
          "id": "s42",
          "text": "Poi prende le chiavi del furgone e saluta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "prendere",
            "le",
            "chiave",
            "del",
            "furgone",
            "e",
            "saluta"
          ]
        },
        {
          "id": "s43",
          "text": "A martedì.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "a",
            "martedi"
          ]
        },
        {
          "id": "s44",
          "text": "Elena resta con la scopa in mano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "restare",
            "con",
            "la",
            "scopa",
            "in",
            "mano"
          ]
        },
        {
          "id": "s45",
          "text": "Ha fallito di nuovo nella voce.",
          "speakerId": null,
