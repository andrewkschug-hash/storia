    },
    {
      "id": "p7",
      "order": 7,
      "sentences": [
        {
          "id": "s31",
          "text": "Almeno oggi non parlate solo di nebbia.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "almeno",
            "oggi",
            "non",
            "parlare",
            "solo",
            "di",
            "nebbia"
          ]
        },
        {
          "id": "s32",
          "text": "Elena e Pietro ridono insieme.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "e",
            "pietro",
            "ridono",
            "insieme"
          ]
        },
        {
          "id": "s33",
          "text": "È una risata corta, goffa, vera.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "una",
            "risata",
            "corta",
            "goffa",
            "vero"
          ]
        },
        {
          "id": "s34",
          "text": "È meglio del silenzio morto di martedì scorso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "essere",
            "meglio",
            "del",
            "silenzio",
            "morto",
            "di",
            "martedi",
            "scorso"
          ]
        },
        {
          "id": "s35",
          "text": "Quando il pavimento è pulito, Pietro firma il foglio sul bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "quando",
            "il",
            "pavimento",
            "essere",
            "pulito",
            "pietro",
            "firma",
            "il",
            "foglio",
            "sul",
            "banco"
          ]
        }
      ]
    },
    {
      "id": "p8",
      "order": 8,
      "sentences": [
        {
          "id": "s36",
          "text": "Elena vuole dire qualcosa di vero prima che lui esca.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "volere",
            "dire",
            "qualcosa",
            "di",
            "vero",
            "prima",
            "che",
            "lui",
            "esca"
          ]
        },
        {
          "id": "s37",
          "text": "Mi piace il martedì.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "mi",
            "piacere",
            "il",
            "martedi"
          ]
        },
        {
          "id": "s38",
          "text": "La frase esce storta e troppo piccola.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "frase",
            "uscire",
            "storta",
            "e",
            "troppo",
            "piccolo"
          ]
        },
