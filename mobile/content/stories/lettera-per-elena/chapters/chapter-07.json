          "id": "s39",
          "text": "Anche a me. Il lavoro.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "anche",
            "a",
            "io",
            "il",
            "lavorare"
          ]
        },
        {
          "id": "s40",
          "text": "Lui pensa al lavoro. Lei pensava a lui.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lui",
            "pensare",
            "al",
            "lavorare",
            "lei",
            "pensare",
            "a",
