  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Martedì di nuovo. Elena aspetta il furgone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "martedi",
            "di",
            "nuovo",
            "elena",
            "aspettare",
            "il",
            "furgone"
          ]
        },
        {
          "id": "s02",
          "text": "Prova frasi vere nella testa, come nel libro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "provare",
            "frasi",
            "vero",
            "nella",
            "testa",
            "come",
            "nel",
            "libro"
          ]
        },
        {
          "id": "s03",
          "text": "Vuole essere la nota: vera, semplice, coraggiosa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "volere",
            "essere",
            "la",
            "nota",
            "vero",
            "semplice",
            "coraggiosa"
          ]
        },
        {
          "id": "s04",
          "text": "Pietro entra con un sacco di chicchi di caffè.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "entrare",
            "con",
            "un",
            "sacco",
            "di",
            "chicchi",
            "di",
            "caffe"
          ]
        },
        {
          "id": "s05",
          "text": "Buongiorno.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "buongiorno"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s06",
          "text": "Buongiorno.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "buongiorno"
          ]
        },
        {
          "id": "s07",
          "text": "Elena respira e prova.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "respira",
            "e",
            "provare"
          ]
        },
        {
          "id": "s08",
          "text": "Oggi... oggi al bancone c'è molto rumore.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "oggi",
            "oggi",
            "al",
            "banco",
            "ce",
            "molto",
            "rumore"
          ]
        },
        {
          "id": "s09",
          "text": "Sì.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "si_yes"
          ]
        },
        {
          "id": "s10",
          "text": "Non è quello che voleva dire.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "essere",
            "quello",
            "che",
            "volere",
            "dire"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s11",
          "text": "Voleva dire: oggi ho paura del silenzio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "volere",
            "dire",
            "oggi",
            "avere",
            "paura",
            "del",
            "silenzio"
          ]
        },
        {
          "id": "s12",
          "text": "Ma la frase resta nel petto e non esce.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ma",
            "la",
            "frase",
            "restare",
            "nel",
            "petto",
            "e",
            "non",
            "uscire"
          ]
        },
        {
          "id": "s13",
          "text": "Il tempo?",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "il",
            "tempo"
          ]
        },
        {
          "id": "s14",
          "text": "Nebbia. Come sempre al martedì.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "nebbia",
            "come",
            "sempre",
            "al",
            "martedi"
          ]
        },
        {
          "id": "s15",
          "text": "Katia sussurra dietro al bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "sussurra",
            "dietro",
            "al",
            "banco"
          ]
        }
      ]
    },
    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s16",
          "text": "Geniale.",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "geniale"
          ]
        },
        {
          "id": "s17",
          "text": "Elena arrossisce e odia il bancone per un secondo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "arrossisce",
            "e",
            "odia",
            "il",
            "banco",
            "per",
            "un",
            "secondo"
          ]
        },
        {
          "id": "s18",
          "text": "Pietro solleva il sacco verso il magazzino.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "solleva",
            "il",
            "sacco",
            "verso",
            "il",
            "magazzino"
          ]
        },
        {
          "id": "s19",
          "text": "Il sacco si apre vicino allo zucchero.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "sacco",
            "si",
            "aprire",
            "vicino",
            "al",
            "zucchero"
          ]
        },
        {
          "id": "s20",
          "text": "I chicchi di caffè cadono sul pavimento con un rumore piccolo e ridicolo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "i",
            "chicchi",
            "di",
            "caffe",
            "cadono",
            "sul",
            "pavimento",
            "con",
            "un",
            "rumore",
            "piccolo",
            "e",
            "ridicolo"
          ]
        }
      ]
    },
    {
      "id": "p5",
      "order": 5,
      "sentences": [
        {
          "id": "s21",
          "text": "Oh no.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "oh",
            "no"
          ]
        },
        {
          "id": "s22",
          "text": "Aspetta. Prendo la scopa.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "aspettare",
            "prendere",
            "la",
            "scopa"
          ]
        },
        {
          "id": "s23",
          "text": "Elena prende la scopa dietro al bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "prendere",
            "la",
            "scopa",
            "dietro",
            "al",
            "banco"
          ]
        },
        {
          "id": "s24",
          "text": "Pietro è in ginocchio e raccoglie i chicchi con le mani.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "essere",
            "in",
            "ginocchio",
            "e",
            "raccoglie",
            "i",
            "chicchi",
            "con",
            "le",
            "mani"
          ]
        },
        {
          "id": "s25",
          "text": "Scusa. Sono goffo.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "scusa",
            "essere",
            "goffo"
          ]
        }
      ]
    },
    {
      "id": "p6",
      "order": 6,
      "sentences": [
        {
          "id": "s26",
          "text": "Va bene. Succede. Anche il tavolo balla, qui.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "andare",
            "bene",
            "succede",
            "anche",
            "il",
            "tavolo",
            "balla",
            "qui"
          ]
        },
        {
          "id": "s27",
          "text": "Pietro alza gli occhi un momento e quasi sorride.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "alzare",
            "gli",
            "occhi",
            "un",
            "momento",
            "e",
            "quasi",
            "sorridere"
          ]
        },
        {
          "id": "s28",
          "text": "Bruna arriva dal magazzino e guarda il pavimento.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "arrivare",
            "dal",
            "magazzino",
            "e",
            "guardare",
            "il",
            "pavimento"
          ]
        },
        {
          "id": "s29",
          "text": "Il caffè sul pavimento è un peccato.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "il",
            "caffe",
            "sul",
            "pavimento",
            "essere",
            "un",
            "peccato"
          ]
        },
        {
          "id": "s30",
          "text": "Ma poi ride e scuote la testa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ma",
            "poi",
            "ride",
            "e",
            "scuote",
            "la",
            "testa"
