          "lemmas": [
            "non",
            "guardare",
            "elena"
          ]
        },
        {
          "id": "s37",
          "text": "Guarda il libro grosso vicino allo zucchero.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "guardare",
            "il",
            "libro",
            "grosso",
            "vicino",
            "al",
            "zucchero"
          ]
        },
        {
          "id": "s38",
          "text": "Solo un secondo, ma Elena lo vede.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "solo",
            "un",
            "secondo",
            "ma",
            "elena",
            "lo",
            "vedere"
          ]
        },
        {
          "id": "s39",
          "text": "Poi lui apre la porta e saluta Bruna.",
