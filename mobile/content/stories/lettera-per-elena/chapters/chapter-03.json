      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Martedì mattina il Caffè Brenta apre presto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "martedi",
            "mattina",
            "il",
            "caffe",
            "brenta",
            "aprire",
            "presto"
          ]
        },
        {
          "id": "s02",
          "text": "Elena mette lo zucchero nelle ciotole sul bancone.",
