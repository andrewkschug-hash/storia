          "text": "Piacere.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "piacere"
          ]
        },
        {
          "id": "s18",
          "text": "Poi c'è un silenzio corto e strano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "ce",
            "un",
            "silenzio",
            "corto",
            "e",
            "strano"
          ]
        },
        {
          "id": "s19",
          "text": "Elena cerca una frase facile.",
