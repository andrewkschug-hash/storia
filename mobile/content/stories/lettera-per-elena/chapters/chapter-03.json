    {
      "id": "p4",
      "order": 4,
      "sentences": [
        {
          "id": "s16",
          "text": "Piacere.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "piacere"
          ]
        },
        {
