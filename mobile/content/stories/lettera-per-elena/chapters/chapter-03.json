            "con",
            "pietro",
            "le",
            "parola",
            "essere",
            "piccolo",
            "e",
            "fredde"
          ]
        },
        {
          "id": "s33",
          "text": "Lei sistema lo zucchero senza motivo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lei",
            "sistema",
            "lo",
            "zucchero",
            "senza",
            "motivo"
          ]
        },
        {
          "id": "s34",
          "text": "Lui tiene le chiavi del furgone in mano.",
