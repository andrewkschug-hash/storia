          "lemmas": [
            "elena",
            "mettere",
            "lo",
            "zucchero",
            "nelle",
            "ciotole",
            "sul",
            "banco"
          ]
        },
        {
          "id": "s03",
          "text": "Katia prepara le tazzine e controlla la macchina del caffè.",
