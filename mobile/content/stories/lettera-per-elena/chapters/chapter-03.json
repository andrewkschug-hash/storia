          "kind": "narration",
          "lemmas": [
            "bruna",
            "guardare",
            "dalla",
            "finestra",
            "e",
            "annuisce"
          ]
        },
        {
          "id": "s07",
          "text": "È Pietro. Martedì.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "essere",
            "pietro",
            "martedi"
          ]
        },
        {
          "id": "s08",
          "text": "Pietro entra con due scatole di caffè.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "entrare",
            "con",
            "due",
            "scatole",
            "di",
            "caffe"
          ]
        },
        {
          "id": "s09",
          "text": "Ha le mani grandi e lo sguardo basso.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "avere",
            "le",
            "mani",
            "grande",
            "e",
            "lo",
            "sguardo",
            "basso"
          ]
        },
        {
          "id": "s10",
          "text": "Porta l'odore del furgone e dei chicchi.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "porta",
            "l'odore",
            "del",
            "furgone",
            "e",
            "dei",
            "chicchi"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s11",
          "text": "Buongiorno.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "buongiorno"
          ]
        },
        {
          "id": "s12",
          "text": "Buongiorno.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "buongiorno"
          ]
        },
        {
          "id": "s13",
          "text": "Bruna fa le presentazioni vicino al bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "fare",
            "le",
            "presentazioni",
            "vicino",
            "al",
            "banco"
          ]
        },
        {
          "id": "s14",
          "text": "Elena, questo è Pietro. Porta il caffè ogni martedì.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "elena",
            "questo",
            "essere",
            "pietro",
            "portare",
            "il",
            "caffe",
            "ogni",
            "martedi"
          ]
        },
        {
          "id": "s15",
          "text": "Pietro, Elena lavora qui da pochi giorni.",
