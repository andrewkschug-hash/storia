            "tazzine",
            "e",
            "controlla",
            "la",
            "macchina",
            "del",
            "caffe"
          ]
        },
        {
          "id": "s04",
          "text": "Fuori c'è nebbia su Marina di Brenta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "fuori",
            "ce",
            "nebbia",
            "su",
            "marina",
            "di",
            "brenta"
          ]
        },
        {
          "id": "s05",
          "text": "Un furgone si ferma davanti al caffè.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "un",
            "furgone",
            "si",
            "fermare",
            "davanti",
            "al",
            "caffe"
