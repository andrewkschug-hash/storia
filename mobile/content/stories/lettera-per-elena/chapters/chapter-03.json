          "kind": "dialogue",
          "lemmas": [
            "no",
            "grazie",
            "dovere",
            "andare"
          ]
        },
        {
          "id": "s27",
          "text": "Parlano ancora del tempo, perché non sanno altro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "parlare",
            "ancora",
            "del",
            "tempo",
            "perche",
            "non",
            "sapere",
            "altro"
          ]
        },
        {
          "id": "s28",
          "text": "Domani forse piove.",
          "speakerId": "elena-marini",
          "kind": "dialogue",
          "lemmas": [
            "domani",
            "forse",
            "piovere"
          ]
        },
        {
          "id": "s29",
          "text": "Forse. In laguna cambia sempre.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "forse",
            "in",
            "laguna",
            "cambiare",
            "sempre"
          ]
        },
        {
          "id": "s30",
          "text": "L'aria tra loro è morta.",
