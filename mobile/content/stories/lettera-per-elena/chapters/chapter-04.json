  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Mercoledì il caffè è pieno fin dal mattino.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "mercoledi",
            "il",
            "caffe",
            "essere",
            "pieno",
            "fin",
            "dal",
            "mattino"
          ]
        },
        {
          "id": "s02",
          "text": "Elena lavora al bancone senza pensare troppo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "lavorare",
            "al",
            "banco",
            "senza",
            "pensare",
            "troppo"
          ]
        },
        {
          "id": "s03",
          "text": "Prepara cappuccini, mette lo zucchero, sorride.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "preparare",
            "cappuccini",
            "mettere",
            "lo",
            "zucchero",
            "sorridere"
          ]
        },
        {
          "id": "s04",
          "text": "Poi, tra due ordini, si ferma vicino allo scaffale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "tra",
            "due",
            "ordini",
            "si",
            "fermare",
            "vicino",
            "al",
            "scaffale"
          ]
        },
        {
          "id": "s05",
          "text": "Apre il libro con le mani ancora umide.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "aprire",
            "il",
            "libro",
            "con",
            "le",
            "mani",
            "ancora",
            "umide"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s06",
          "text": "C'è una riga nuova, scritta con penna nera.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ce",
            "una",
            "riga",
            "nuovo",
            "scritta",
            "con",
            "penna",
            "nera"
          ]
        },
        {
          "id": "s07",
          "text": "Oggi ho paura del silenzio.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "oggi",
            "avere",
            "paura",
            "del",
            "silenzio"
          ]
        },
        {
          "id": "s08",
          "text": "Elena legge due volte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "leggere",
            "due",
            "volta"
          ]
        },
        {
          "id": "s09",
          "text": "La frase è semplice e vera.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "frase",
            "essere",
            "semplice",
            "e",
            "vero"
          ]
        },
        {
          "id": "s10",
          "text": "Le sembra di conoscerla già, dentro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "le",
            "sembrare",
            "di",
            "conoscerla",
            "gia",
            "dentro"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s11",
          "text": "Prende la penna dal bancone.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "prendere",
            "la",
            "penna",
            "dal",
            "banco"
          ]
        },
