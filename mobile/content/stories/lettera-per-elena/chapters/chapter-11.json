            "e",
            "lei",
            "le",
            "nasconde",
            "sotto",
            "il",
            "grembiule"
          ]
        },
        {
          "id": "s40",
          "text": "Nel pomeriggio, quando il caffè cala, apre di nuovo il libro.",
          "speakerId": null,
