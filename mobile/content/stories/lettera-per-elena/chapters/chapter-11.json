          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "non",
            "essere",
            "piu",
            "solo",
            "carta"
          ]
        },
        {
          "id": "s45",
          "text": "È una verità caduta per sbaglio dalla bocca di un uomo quieto.",
