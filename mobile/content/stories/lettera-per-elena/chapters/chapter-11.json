            "sempre",
            "un",
            "poco",
            "in",
            "ritardo"
          ]
        },
        {
          "id": "s02",
          "text": "Pietro entra con le scatole di caffè e i capelli umidi di nebbia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "entrare",
