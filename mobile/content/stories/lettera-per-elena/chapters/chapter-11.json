            "poi",
            "il",
            "libro",
            "vicino",
            "al",
            "zucchero",
            "poi",
            "pietro"
          ]
        }
      ]
    },
    {
      "id": "p7",
      "order": 7,
      "sentences": [
        {
          "id": "s31",
          "text": "Due mondi nella stessa stanza: la carta e la voce.",
