      "order": 9,
      "sentences": [
        {
          "id": "s41",
          "text": "Rilegge la riga antica, quella che conosce a memoria.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "rilegge",
            "la",
            "riga",
