  "events": [
    {
      "id": "ev-lettera-per-elena-11",
      "summary": "Pietro jokes that today he fears silence because of the noisy fridge. Elena freezes at the book line spoken aloud. He does not notice.",
      "characterIds": [
        "elena-marini",
        "pietro-baldo",
        "bruna",
        "katia"
      ],
      "locationIds": [
        "caffe-brenta",
        "bancone-brenta",
        "scaffale-libro",
        "van-pietro"
      ],
      "rememberedFacts": [
        "Pietro says \"oggi ho paura del silenzio\" out loud as a fridge joke",
        "Elena freezes because she knows the line from the book",
        "Pietro does not notice her reaction",
        "Elena begins to suspect Pietro is the writer"
      ]
    }
  ],
  "paragraphs": [
    {
      "id": "p1",
      "order": 1,
      "sentences": [
        {
          "id": "s01",
          "text": "Martedì. Il furgone di Pietro arriva come sempre, un poco in ritardo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "martedi",
            "il",
