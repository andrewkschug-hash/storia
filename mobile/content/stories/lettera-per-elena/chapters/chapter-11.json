          "text": "Costa, però.",
          "speakerId": "bruna",
          "kind": "dialogue",
          "lemmas": [
            "costare",
            "pero"
          ]
        },
        {
          "id": "s30",
          "text": "Elena guarda lo scaffale, poi il libro vicino allo zucchero, poi Pietro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "guardare",
