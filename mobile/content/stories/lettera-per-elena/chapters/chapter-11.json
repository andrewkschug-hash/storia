            "oggi",
            "avere",
            "paura",
            "del",
            "silenzio"
          ]
        },
        {
          "id": "s43",
          "text": "Ora la sente anche in voce, detta come una battuta sul frigo.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
