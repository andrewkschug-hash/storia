          "text": "A martedì.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "a",
            "martedi"
          ]
        },
        {
          "id": "s34",
          "text": "Elena resta ferma finché il motore non parte.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "restare",
            "fermare",
            "finche",
            "il",
            "motore",
            "non",
            "partire"
          ]
        },
        {
          "id": "s35",
          "text": "Katia la osserva dal lavello, con gli occhi stretti.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "la",
            "osserva",
            "dal",
            "lavello",
            "con",
