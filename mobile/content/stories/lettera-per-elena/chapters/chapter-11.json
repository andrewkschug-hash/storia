          "lemmas": [
            "oggi",
            "avere",
            "paura",
            "del",
            "silenzio"
          ]
        },
        {
          "id": "s19",
          "text": "Il cuore le batte forte, e la tazza trema un poco sul piattino.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "cuore",
