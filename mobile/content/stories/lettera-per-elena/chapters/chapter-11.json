            "scatole",
            "di",
            "caffe",
            "e",
            "i",
            "capelli",
            "umidi",
            "di",
            "nebbia"
          ]
        },
        {
          "id": "s03",
          "text": "Nel caffè il frigorifero fa un rumore forte, continuo, quasi arrabbiato.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "nel",
            "caffe",
            "il",
            "frigorifero",
            "fare",
            "un",
            "rumore",
            "forte",
            "continuare",
            "quasi",
            "arrabbiato"
          ]
        },
        {
          "id": "s04",
          "text": "Katia batte sul frigo con il dorso della mano.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "batte",
            "sul",
            "frigo",
            "con",
            "il",
            "dorso",
            "della",
            "mano"
          ]
        },
        {
          "id": "s05",
          "text": "Questo mostro non tace mai.",
          "speakerId": "katia",
          "kind": "dialogue",
          "lemmas": [
            "questo",
            "mostro",
            "non",
            "tace",
            "mai"
          ]
        }
      ]
    },
    {
      "id": "p2",
      "order": 2,
      "sentences": [
        {
          "id": "s06",
          "text": "Bruna ride dal magazzino.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "ride",
            "dal",
            "magazzino"
          ]
        },
        {
          "id": "s07",
          "text": "Pietro lascia le scatole vicino al bancone e firma il foglio della consegna.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "pietro",
            "lasciare",
            "le",
            "scatole",
            "vicino",
            "al",
            "banco",
            "e",
            "firma",
            "il",
            "foglio",
            "della",
            "consegna"
          ]
        },
        {
          "id": "s08",
          "text": "Poi prova una battuta, come fanno le persone quando l'aria è troppo quieta.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "poi",
            "provare",
            "una",
            "battuta",
            "come",
            "fare",
            "le",
            "persona",
            "quando",
            "l'aria",
            "essere",
            "troppo",
            "quieta"
          ]
        },
        {
          "id": "s09",
          "text": "Oggi ho paura del silenzio.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "oggi",
            "avere",
            "paura",
            "del",
            "silenzio"
          ]
        },
        {
          "id": "s10",
          "text": "Con questo frigo, impossibile.",
          "speakerId": "pietro-baldo",
          "kind": "dialogue",
          "lemmas": [
            "con",
            "questo",
            "frigo",
            "impossibile"
          ]
        }
      ]
    },
    {
      "id": "p3",
      "order": 3,
      "sentences": [
        {
          "id": "s11",
          "text": "Bruna ride ancora.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "bruna",
            "ride",
            "ancora"
          ]
        },
        {
          "id": "s12",
          "text": "Katia alza gli occhi al cielo e dice che la battuta è vecchia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "katia",
            "alzare",
            "gli",
            "occhi",
            "al",
            "cielo",
            "e",
            "dire",
            "che",
            "la",
            "battuta",
            "essere",
            "vecchio"
          ]
        },
        {
          "id": "s13",
          "text": "Elena non ride.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "elena",
            "non",
            "ride"
          ]
        },
        {
          "id": "s14",
          "text": "Si ferma con una tazza in mano, a metà strada tra il bancone e lo scaffale.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "si",
            "fermare",
            "con",
            "una",
            "tazza",
            "in",
            "mano",
            "a",
            "meta",
            "strada",
            "tra",
            "il",
            "banco",
            "e",
            "lo",
            "scaffale"
          ]
        },
        {
          "id": "s15",
          "text": "La frase è la stessa del libro.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "frase",
            "essere",
            "la",
            "stesso",
