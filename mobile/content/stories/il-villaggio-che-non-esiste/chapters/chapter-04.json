          "speakerId": "elsa",
          "kind": "dialogue",
          "lemmas": [
            "al",
            "mattino",
            "guardare",
            "la",
            "piazza"
          ]
        },
        {
          "id": "s45",
          "text": "Giada ripete le frasi nella testa, una per una, chiare.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "giada",
            "ripete",
            "le",
            "frasi",
