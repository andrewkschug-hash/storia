            "e",
            "si",
            "alzare"
          ]
        },
        {
          "id": "s49",
          "text": "Questa sera non si esce.",
          "speakerId": "tullio",
          "kind": "dialogue",
          "lemmas": [
            "questo",
            "sera",
            "non",
            "si",
            "uscire"
          ]
        },
        {
          "id": "s50",
          "text": "Giada non ride più, e questo è già un piccolo cambiamento.",
