          "text": "Fuori il sole scende piano verso le colline scure.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "fuori",
            "il",
            "sole",
            "scende",
            "piano",
            "verso",
            "le",
            "colline",
            "scure"
          ]
        },
        {
          "id": "s48",
          "text": "Tullio chiude il thermos con un click secco e si alza.",
          "speakerId": null,
