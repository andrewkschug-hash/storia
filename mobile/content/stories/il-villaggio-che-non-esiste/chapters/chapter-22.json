        }
      ]
    },
    {
      "id": "p13",
      "order": 13,
      "sentences": [
        {
          "id": "s61",
          "text": "Davanti c'è una cucina, un padre, e una storia da raccontare senza miracoli.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "davanti",
            "ce",
            "una",
            "cucina",
            "un",
            "padre",
            "e",
            "una",
            "storia",
            "dare",
            "raccontare",
            "senza",
            "miracoli"
          ]
        },
        {
          "id": "s62",
          "text": "Il treno per Trento è pieno di persone normali con valigie normali.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "treno",
            "per",
            "trento",
            "essere",
            "pieno",
