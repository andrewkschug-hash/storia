            "non",
            "risolvere",
            "e",
            "non",
            "bruciato"
          ]
        },
        {
          "id": "s67",
          "text": "Il paese continuerà a spostare nomi per un'ispezione forse futura.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "il",
            "paese",
            "continuera",
            "a",
