        }
      ]
    },
    {
      "id": "p14",
      "order": 14,
      "sentences": [
        {
          "id": "s66",
          "text": "Ripensa al cartello barrato che resta dietro, non risolto e non bruciato.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ripensa",
            "al",
