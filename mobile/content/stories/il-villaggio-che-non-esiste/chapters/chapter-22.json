            "persona",
            "normali",
            "con",
            "valigie",
            "normali"
          ]
        },
        {
          "id": "s63",
          "text": "Giada appoggia la testa al sedile e non dorme subito.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "giada",
            "appoggia",
            "la",
            "testa",
            "al",
            "sedile",
            "e",
            "non",
            "dormire",
            "subito"
          ]
        },
        {
          "id": "s64",
          "text": "Ripensa al cenno di Tullio, breve come un orologio che conferma l'ora.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ripensa",
            "al",
            "cenno",
            "di",
            "tullio",
            "breve",
            "come",
            "un",
            "orologio",
            "che",
            "conferma",
            "ora"
          ]
        },
        {
          "id": "s65",
          "text": "Ripensa a Neri fermo sulla strada bagnata, senza valigia.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "ripensa",
            "a",
            "neri",
            "fermare",
            "sulla",
            "strada",
            "bagnata",
            "senza",
            "valigia"
