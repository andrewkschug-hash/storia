            "sul",
            "treno",
            "giusto"
          ]
        },
        {
          "id": "s60",
          "text": "Dietro di lei resta un villaggio che non esiste sulle mappe.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
