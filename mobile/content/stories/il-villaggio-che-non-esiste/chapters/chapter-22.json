            "un'ispezione",
            "forse",
            "futura"
          ]
        },
        {
          "id": "s68",
          "text": "La diga continuerà ad aprire l'acqua sulla strada a un'ora precisa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "la",
            "diga",
            "continuera",
            "a",
            "aprire",
            "acqua",
            "sulla",
            "strada",
            "a",
            "ora",
            "precisa"
          ]
        },
        {
          "id": "s69",
          "text": "Lei non tornerà dopo le otto a dimostrare qualcosa.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "lei",
            "non",
            "tornera",
            "dopo",
            "le",
            "otto",
            "a",
            "dimostrare",
            "qualcosa"
          ]
        },
        {
          "id": "s70",
          "text": "Ha usato l'alba, il bus degli operai, e il proprio nome.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
