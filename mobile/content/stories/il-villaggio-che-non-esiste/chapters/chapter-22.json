            "linee",
            "nere",
            "sopra"
          ]
        },
        {
          "id": "s59",
          "text": "Giada sorride poco, stanca, e sale sul treno giusto.",
          "speakerId": null,
          "kind": "narration",
          "lemmas": [
            "giada",
            "sorridere",
            "poco",
