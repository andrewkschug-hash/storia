  "events": [
    {
      "id": "ev-il-villaggio-che-non-esiste-08",
      "summary": "In the inn register Giada finds Anna Rinaldi, age 17, dated today. The ink is old.",
      "characterIds": [
        "giada-rinaldi",
        "elsa",
        "anna-rinaldi"
      ],
      "locationIds": [
