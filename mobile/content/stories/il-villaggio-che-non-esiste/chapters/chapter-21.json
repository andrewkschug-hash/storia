      "id": "ev-il-villaggio-che-non-esiste-21",
      "summary": "Giada refuses to be inhabited proof or Anna. She will take Neri only if he asks his people first; he does not, yet.",
      "characterIds": [
        "giada-rinaldi",
        "ingegnere",
        "elsa",
        "neri",
        "tullio"
      ],
      "locationIds": [
        "piazza-collevento",
